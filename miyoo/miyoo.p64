--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Machine Cults v2.0

local SCRAPPER="Scrapper: whenever an upgrade of another ship within 6\" is disabled, or a squadron within 6\" is destroyed, the closest friendly Scrapper ship gets a scrap marker. Ships may remove scrap markers to give enemies -1 strength each when shooting at them."
local BANKS="Capacity Banks: may not mount weapons in its front facing. Turret gets +1 attack when firing in the front facing."

def_faction{
 id="machine_cults",name="Machine Cults",

 ships={
  {id="server",name="Server Ship",class="Heavy",ups=4,pts=90,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2,
   rules={scrapper=true},special=SCRAPPER},
  {id="resistor",name="Resistor Ship",class="Heavy",ups=4,pts=80,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2,
   rules={capacity=true},caps={front=0,sides=1,rear=1},special=BANKS},
  {id="client",name="Client Ship",class="Medium",ups=3,pts=70,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={scrapper=true},special=SCRAPPER},
  {id="capacitor",name="Capacitor Ship",class="Medium",ups=3,pts=60,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={capacity=true},caps={front=0,sides=1,rear=1},special=BANKS},
  {id="execution",name="Execution Ship",class="Light",ups=2,pts=50,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,
   rules={scrapper=true},special=SCRAPPER},
  {id="circuit",name="Circuit Ship",class="Light",ups=2,pts=40,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,
   rules={capacity=true},caps={front=0,sides=1,rear=1},special=BANKS},
  {id="lag",name="Lag Squadron",class="Squadron",ups=0,pts=10,mv=6,cr=9,rng=2,att=1,str=2,eva=2,tou=2,
   rules={anti_ship=true,deadly=true},special="Anti-Ship, Deadly."},
  {id="crash",name="Crash Squadron",class="Squadron",ups=0,pts=10,mv=8,cr=12,rng=2,att=3,str=0,eva=2,tou=2,
   rules={anti_sq=true},special="Anti-Squadron: +1 to hit squadrons, ships only on 6+."},
  {id="process",name="Process Squadron",class="Squadron",ups=0,pts=20,mv=10,cr=15,rng=2,att=2,str=0,eva=2,tou=2,
   rules={processor=true},special="Processor: whenever this model disables an enemy upgrade or destroys an enemy squadron, you may deploy a new Process Squadron within 2\"."},
 },

 heroes={
  {id="data_lord",name="Data Lord",pts=15,
   desc="This ship always hits on 2+ when targeting enemy ships that have other friendly ships within 12\" of them in all 4 facings."},
  {id="electro_cultist",name="Electro Cultist",pts=10,
   desc="When activated, turret gets +1 strength if it was not fired during this ship's last activation."},
  {id="machine_pontifex",name="Machine Pontifex",pts=15,
   desc="Friendly ships within 12\" may remove scrap markers from this ship as if they were on them."},
 },

 titles={
  {id="aggressive_recycler",name="Aggressive Recycler",pts=10,ai=false,
   desc="This ship may remove 2 scrap markers from itself to use one of its rules that has an effect when activated twice in a row."},
  {id="manufacturer",name="Manufacturer",pts=10,desc="When activated, place a scrap marker on this ship."},
  {id="overclocked",name="Overclocked",pts=20,ai=false,
   desc="Once per round, at the end of its activation, may disable an upgrade to take a cruise action."},
 },

 keywords={
  {id="capacity",name="Capacity Banks",desc="May not mount weapons in its front facing. Turret gets +1 attack when firing in the front facing."},
  {id="contortion",name="Contortion Array",desc="Gets +1 to hit."},
  {id="eraser",name="Eraser Beam",desc="Gets -2 to hit. This weapon deals +3 damage per unblocked hit."},
  {id="graviton",name="Graviton Crusher",desc="This weapon deals damage on successful tough rolls, instead of fails."},
  {id="hijacker",name="Gun Hijacker",desc="Gets +X attacks, where X is the number of weapons on the target."},
  {id="pcannon",name="P-Cannonades",desc="Ignores cover."},
  {id="processor",name="Processor",desc="Whenever this model disables an enemy upgrade or destroys an enemy squadron, you may deploy a new Process Squadron within 2\"."},
  {id="ruin",name="Ruin Cannon",desc="May remove scrap markers to get +X attacks, where X is the number of removed markers."},
  {id="scrapper",name="Scrapper",desc="Whenever the upgrade of another ship within 6\" is disabled, or a squadron within 6\" is destroyed, place a scrap marker on the closest friendly ship with this rule. Ships may remove scrap markers from themselves to give enemies -X strength when shooting at them, where X is the number of removed markers."},
 },

 upgrades={
  {id="anti_impact_system",name="Anti-Impact System",
   desc="When ramming or being rammed, instead of either ship taking damage, they are both pushed X*3\" directly away from each other, where X is the number of damage they would have taken."},
  {id="consumption_drive",name="Consumption Drive",desc="May remove scrap markers to move +X\", where X is the number of removed markers."},
  {id="program_crux",name="Program Crux",desc="When activated, pick a friendly squadron within 6\" and immediately activate it."},
  {id="repair_arms",name="Repair Arms",
   desc="At the end of its activation, remove 1 damage from this ship and all friendly squadrons that were within 2\" of it during its movement."},
  {id="space_splitter",name="Space Splitter",desc="When activated, pick a ship within 8\" and swap position with it, in the same facing as each other."},
  {id="tech_convent",name="Tech Convent",desc="When activated, turret gets +1 attack, +1 strength or Twin-Fire until the end of its activation (pick one)."},
  {id="contortion_array",name="Contortion Array",weapon=true,rng=12,att=1,str=3,rules={twin=true,anti_sq=true,contortion=true},desc="No special rules."},
  {id="eraser_beam",name="Eraser Beam",weapon=true,rng=12,att=1,str=3,rules={eraser=true},desc="No special rules."},
  {id="graviton_crusher",name="Graviton Crusher",weapon=true,rng=12,att=3,str=0,rules={graviton=true},desc="No special rules."},
  {id="gun_hijacker",name="Gun Hijacker",weapon=true,rng=18,att=1,str=2,rules={hijacker=true},desc="No special rules."},
  {id="macro_barage",name="Macro Barage",weapon=true,rng=12,att=3,str=0,rules={blast=true},desc="No special rules."},
  {id="p_cannonades",name="P-Cannonades",weapon=true,rng=18,att=1,str=2,rules={blast=true,broadside=true,pcannon=true},desc="No special rules."},
  {id="r_sniper",name="R-Sniper",weapon=true,rng=6,att=1,str=1,rules={deadly=true,sniper=true},desc="No special rules."},
  {id="ruin_cannon",name="Ruin Cannon",weapon=true,rng=12,att=2,str=1,rules={ruin=true},desc="No special rules."},
 },
}

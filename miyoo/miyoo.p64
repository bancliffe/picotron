--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Rebel Guerrillas v2.0

local VOLATILE="Volatile: when this ship is destroyed, all models within 3\" take as many hits as its number of upgrades."

def_faction{
 id="rebel_guerrillas",name="Rebel Guerrillas",

 ships={
  {id="tanker",name="Tanker Ship",class="Heavy",ups=5,pts=80,mv=2,cr=3,rng=24,att=2,str=2,eva=2,tou=4,rules={volatile=true},special=VOLATILE},
  {id="cargo",name="Cargo Ship",class="Heavy",ups=4,pts=60,mv=2,cr=3,rng=18,att=2,str=2,eva=2,tou=3},
  {id="cadre",name="Cadre Ship",class="Medium",ups=3,pts=70,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={rebel_hq=true},special="Rebel HQ: this ship may take 1 hero and 1 title for -5pts each."},
  {id="second_hand",name="Second-Hand Ship",class="Medium",ups=3,pts=40,mv=4,cr=6,rng=12,att=2,str=1,eva=2,tou=4},
  {id="third_hand",name="Third-Hand Ship",class="Light",ups=2,pts=20,mv=6,cr=9,rng=6,att=2,str=0,eva=3,tou=5},
  {id="fuel_tender",name="Fuel Tender Ship",class="Light",ups=2,pts=20,mv=6,cr=9,rng=6,att=1,str=0,eva=2,tou=6,rules={volatile=true},special=VOLATILE},
  {id="tempest",name="Tempest Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={escort=true},special="Escort: enemy squadrons in range and line of sight may only target enemy squadrons with this rule."},
  {id="earthquake",name="Earthquake Squadron",class="Squadron",ups=0,pts=15,mv=8,cr=12,rng=2,att=2,str=2,eva=5,tou=5,
   rules={anti_ship=true,deadly=true,fragile=true},special="Anti-Ship, Deadly, Fragile."},
  {id="sinkhole",name="Sink-Hole Mine Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=0,att=0,str=0,eva=2,tou=6,
   rules={detonation=true,minefield=true},
   special="Detonation: destroyed by any damage; if overlapped or engaged it blows up for 2 hits at Str 0. Minefield: deploys after everything else, as 5 extra identical copies, anywhere up to its move speed beyond your deployment zone."},
 },

 heroes={
  {id="handler",name="Handler",pts=25,
   desc="Once per game, when activated, pick one enemy squadron within 12\", which only you may control until the end of the game."},
  {id="peoples_hammer",name="People's Hammer",pts=15,desc="Turret gets +1 attack for each friendly ship that has been destroyed during this round."},
  {id="tactician",name="Tactician",pts=25,ai=false,desc="After all ships have been deployed, up to 3 friendly ships may be removed and deployed again."},
 },

 titles={
  {id="dug_in",name="Dug In",pts=5,desc="Whilst inside terrain, enemies get -2 strength against this ship."},
  {id="for_the_cause",name="For the Cause",pts=5,desc="Doesn't count as a ship for the purpose of morale tests."},
  {id="punisher",name="Punisher",pts=5,desc="Turret gets Deadly when targeting enemies in their rear facing."},
 },

 keywords={
  {id="detonation",name="Detonation",desc="This squadron is destroyed if it takes any damage. If this squadron is overlapped or engaged, it is destroyed, and the target takes 2 hits with Str 0."},
  {id="escort",name="Escort",desc="Enemy squadrons in range and line of sight may only target enemy squadrons with this rule."},
  {id="eulogy",name="Eulogy Cannon",desc="Gets as many Att as number of friendly ships that were destroyed during this round."},
  {id="last_gasp",name="Last Gasp Gun",desc="This weapon may immediately be fired when its ship is destroyed."},
  {id="minefield",name="Minefield",desc="This squadron may only be deployed after all other models have been deployed. When deploying this squadron, you may deploy 5 identical copies of it, which may immediately be moved straight by up to their move speed."},
  {id="piranha",name="Piranha Gun",desc="Whenever this weapon is fired, all other Piranha Guns in range of the target may immediately fire at it."},
  {id="rebel_hq",name="Rebel HQ",desc="This ship may take 1 hero and 1 title for -5pts each."},
  {id="volatile",name="Volatile",desc="When this ship is destroyed, all models within 3\" take as many hits as number of upgrades on it."},
 },

 upgrades={
  {id="combatant_bolt_on",name="Combatant Bolt-On",
   desc="When this ship overlaps an enemy ship, this upgrade is immediately disabled, and you may place 4 boarding markers on the target."},
  {id="crumple_hulls",name="Crumple Hulls",desc="Takes -1 damage when ramming or being rammed, and this upgrade takes 3 damage to be disabled."},
  {id="hidden_hangar",name="Hidden Hangar",
   desc="When activated, you may disable this upgrade to place a copy of one friendly squadron within 2\" of this ship, and immediately activate it."},
  {id="lock_tether",name="Lock Tether",
   desc="When activated, pick up to 2 squadrons within 12\" and move them D6+1\" directly towards another ship within 12\"."},
  {id="refit_reactor",name="Refit Reactor",
   desc="Gets +4\" on move and +6\" on cruise/ram actions. This upgrade is immediately disabled if it is the last non-disabled upgrade on this ship."},
  {id="sabotage_cells",name="Sabotage Cells",
   desc="When activated, pick 1 enemy ship within 12\" carrying an objective marker, which takes 1 damage to one upgrade of your choice."},
  {id="assault_scrambler",name="Assault Scrambler",weapon=true,rng=18,att=4,str=0,rules={boarding=true,overheat=true},desc="No special rules."},
  {id="eulogy_cannon",name="Eulogy Cannon",weapon=true,rng=24,att=0,str=3,rules={deadly=true,eulogy=true},desc="No special rules."},
  {id="hazard_gun",name="Hazard Gun",weapon=true,rng=12,att=5,str=1,rules={overheat=true,anti_ship=true},desc="No special rules."},
  {id="improvised_charge",name="Improvised Charge",weapon=true,rng=6,att=1,str=3,rules={blast=true,deadly=true},desc="No special rules."},
  {id="last_gasp_gun",name="Last Gasp Gun",weapon=true,rng=12,att=3,str=1,rules={last_gasp=true},desc="No special rules."},
  {id="piranha_gun",name="Piranha Gun",weapon=true,rng=12,att=1,str=0,rules={piranha=true},desc="No special rules."},
  {id="rotary_cannon",name="Rotary Cannon",weapon=true,rng=12,att=6,str=0,rules={anti_sq=true},desc="No special rules."},
  {id="split_railgun",name="Split Railgun",weapon=true,rng=18,att=1,str=1,rules={sniper=true,twin=true},desc="No special rules."},
 },
}

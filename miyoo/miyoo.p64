--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Alien Hives v2.0

def_faction{
 id="alien_hives",name="Alien Hives",

 ships={
  {id="matriarch",name="Matriarch Ship",class="Heavy",ups=5,pts=85,mv=4,cr=6,rng=0,att=0,str=0,eva=2,tou=2},
  {id="harvester",name="Harvester Ship",class="Heavy",ups=3,pts=60,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2},
  {id="administrator",name="Administrator Ship",class="Medium",ups=3,pts=70,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={administrator=true},special="Administrator: counts as 2 ships for the purpose of morale tests."},
  {id="guardian",name="Guardian Ship",class="Medium",ups=2,pts=40,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3},
  {id="warrior",name="Warrior Ship",class="Light",ups=2,pts=50,mv=8,cr=12,rng=12,att=2,str=0,eva=5,tou=4},
  {id="worker",name="Worker Ship",class="Light",ups=1,pts=20,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4},
  {id="extractor",name="Extractor Squadron",class="Squadron",ups=0,pts=20,mv=10,cr=15,rng=2,att=3,str=0,eva=4,tou=5,
   rules={finisher=true,fragile=true},
   special="Finisher: +1 to hit and +1 strength against ships for each other friendly squadron within 2\" of the target, but only hits squadrons on 6+. Fragile: the first time it takes damage each round it takes +1 damage."},
  {id="tentacle",name="Tentacle Squadron",class="Squadron",ups=0,pts=15,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={anti_sq=true,swarm=true},
   special="Anti-Squadron: +1 to hit squadrons, ships only on 6+. Swarm: enemies only hit this squadron on 6+ unless they have Anti-Squadron."},
  {id="broodling",name="Broodling Squadron",class="Squadron",ups=0,pts=5,mv=10,cr=15,rng=0,att=0,str=0,eva=4,tou=5,
   rules={fragile=true,shielder=true},
   special="Fragile: the first time it takes damage each round it takes +1 damage. Shielder: whenever a friendly squadron within 2\" takes hits, this squadron may take one of them instead."},
 },

 heroes={
  {id="infinite_adaptation",name="Infinite Adaptation",pts=10,ai=false,
   desc="When this ship is activated, you may re-assign one of its weapons to an unoccupied facing."},
  {id="mother_ship",name="Mother Ship",pts=20,
   desc="Once per activation, place 2 new Broodling Squadrons fully within 2\" of this ship."},
  {id="tyrant_champion",name="Tyrant Champion",pts=10,
   desc="This ship gets +4 to hit and +4 strength when attacking enemy heroes with its turret."},
 },

 titles={
  {id="chameleon_shroud",name="Chameleon Shroud",pts=5,
   desc="Enemies get -1 to hit when targeting this ship, as long as it hasn't taken any damage."},
  {id="specialised",name="Specialised",pts=10,
   desc="After deployment, this ship's turret gets the Anti-Squadron or Anti-Ship special rule (pick one)."},
  {id="symbiosis",name="Symbiosis",pts=5,desc="Counts as a squadron for the purpose of the Shielder rule."},
 },

 keywords={
  {id="administrator",name="Administrator",desc="This ship counts as 2 ships for the purpose of morale tests."},
  {id="finisher",name="Finisher",desc="Gets +1 to hit and +1 strength against ships for each other friendly squadron within 2\" of the target, but only hits squadrons on 6+."},
  {id="juice",name="Juice Rifle",desc="Must destroy a friendly squadron within 2\" in order to fire this weapon."},
  {id="mortal",name="Mortal Missile",desc="Gets +1 to hit when fired."},
  {id="psy",name="Psy-Aria",desc="Ships must take a morale test per hit, instead of rolling to block. For each failed test, they take 1 damage."},
  {id="shielder",name="Shielder",desc="Whenever a friendly squadron within 2\" takes any hits, this squadron may take one of those hits instead."},
  {id="swarm",name="Swarm",desc="Enemies only hit this squadron on 6+ unless they have the Anti-Squadron special rule."},
  {id="swarmer",name="Swarmer",desc="Take a morale test when firing this weapon, if passed it gets +6 attacks."},
 },
 upgrades={
  {id="constriction",name="Constriction",
   desc="When ramming, instead of comparing upgrades, you may destroy this ship to place 2 boarding markers on the target for each upgrade this ship had."},
  {id="nerve_cluster",name="Nerve Cluster",desc="When activated, pick a friendly squadron within 6\" and immediately activate it."},
  {id="nutrient_repo",name="Nutrient Repo",
   desc="Once per activation, you may destroy one friendly squadron within 2\" and remove 1 damage from this ship."},
  {id="pheromone_glands",name="Pheromone Glands",
   desc="At the end of this ship's activation, friendly squadrons within 12\" may move directly towards this ship by up to their move speed."},
  {id="predator_cysts",name="Predator Cysts",
   desc="Turret gets +1 to hit and +1 strength if the target has a higher max. number of upgrades than this ship."},
  {id="spore_vents",name="Spore Vents",
   desc="Once per activation, this ship may take 1 damage to place a spore marker within 2\". Models within 2\" of the marker count as being in cover."},
  {id="acid_spray",name="Acid Spray",weapon=true,rng=6,att=4,str=0,rules={broadside=true},
   desc="Broadside: sides only, and may fire from both sides at once."},
  {id="bio_cannon",name="Bio-Cannon",weapon=true,rng=12,att=2,str=0,rules={blast=true},
   desc="Blast: if the target is hit, all models within 4\" of it are also hit."},
  {id="juice_rifle",name="Juice Rifle",weapon=true,rng=24,att=3,str=3,rules={juice=true},
   desc="Juice Rifle: must destroy a friendly squadron within 2\" in order to fire this weapon."},
  {id="mortal_missile",name="Mortal Missile",weapon=true,rng=24,att=3,str=0,rules={mortal=true},
   desc="Mortal Missile: gets +1 to hit when fired."},
  {id="psy_aria",name="Psy-Aria",weapon=true,rng=24,att=3,str=0,rules={psy=true},
   desc="Psy-Aria: ships must take a morale test per hit instead of rolling to block. For each failed test they take 1 damage."},
  {id="saturation_pod",name="Saturation Pod",weapon=true,rng=18,att=1,str=0,rules={boarding=true,blast=true},
   desc="Boarding Pod, Blast: hits give boarding markers instead of damage, and all ships within 4\" of the target are also hit."},
  {id="spike_launcher",name="Spike Launcher",weapon=true,rng=12,att=4,str=0,rules={anti_ship=true},
   desc="Anti-Ship: +1 to hit ships, but only hits squadrons on 6+."},
  {id="swarmer",name="Swarmer",weapon=true,rng=6,att=2,str=0,rules={swarmer=true},
   desc="Swarmer: take a morale test when firing this weapon; if passed it gets +6 attacks."},
 },
}

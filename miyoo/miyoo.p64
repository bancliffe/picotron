  {id="charged_munitions",name="Charged Munitions",desc="Turret gets the Deadly rule when shooting at targets that are 6\" or closer to it."},
  {id="fuel_dispensers",name="Fuel Dispensers",desc="Friendly squadrons within 4\" get +2\" on move and +3\" on cruise actions."},
  {id="gunnery_crew",name="Gunnery Crew",desc="Turret gets +1 to hit and +1 strength when shooting at targets that are 12\" or closer to it."},

--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- classify by upgrades: ram gear vs guns
function ai_type(m)
 if m.sq then return can_ram(m) and "ramming" or "shooting" end
 if m.hull.rules.missile_ship then return "hybrid" end
 local shoot,ram=0,0
 for up in all(m.ups) do
  local id=up.id
  if up.upg.weapon or id=="nuclear_ammo" or id=="tracking_servo" then shoot+=1 end
  if id=="reinforced_ram" or id=="gravity_bumper" or id=="ablative_armor" or id=="pulse_engine"
   or id=="chain_prow" or id=="faith_of_the_broken" or id=="agitator_ram" or id=="constriction" then ram+=1 end
 end
 if ram>=2 and shoot<=1 then return "ramming" end
 if shoot>=2 and ram==0 then return "shooting" end
 return "hybrid"
end

function ai_turn(phase)
 local m=pick(eligible("ai",phase))
 ai_activate(m)
 bt.last_active=m
 bt.sel=nil
end

function ai_activate(m)
 bt.sel=m
 say("The AI activates "..m.name.." ("..m.ai_type..")")
 wait(20)
 m.activated=true
 check_rift_rush(m)
 start_activation(m)
 boarding_rolls(m)
 if m.state=="table" then ai_abilities(m) end
 bt.sel=m
 if m.state=="table" then
  local plan=ai_plan(m)
  blog(m.name.." "..plan.why,8)
  commit(m,plan.action,plan.res,plan.tgt)
 end
 end_activation(m)
 wait(10)
end

function ai_abilities(m)
 if m.sq then return end
 if has(m,"teleporter_pods") then
  local e=nearest(m.x,m.y,enemy_ships_within(m,6))
  if e then e.boarding+=1 blog(m.name.." teleports boarders onto "..e.name,8) end
 end
 if m.hero=="handler" and not m.handled then
  local s=nearest(m.x,m.y,enemy_squadrons_within(m,12))
  if s then m.handled=true steal_squadron(m,s) end
 end
 if m.hero=="divine_frog" then
  local kind=pick({"piranha","jaguar","serpent"})
  for i=1,2 do spawn_squadron(m.side,m.fac,kind,m,2-2*SQ_RADIUS) end
 end
 if has(m,"wrath_spines") then
  if zeal_test(m,"Wrath Spines") then m.wrath_round=bt.round else m.wrath_fail_round=bt.round end
 end
 if has(m,"sabotage_cells") then
  local e=nearest(m.x,m.y,carriers_within(m,12))
  if e then blog(m.name.."'s saboteurs strike "..e.name,8) deal(e,1,"ai") end
 end
 if has(m,"grav_trap_launcher") then
  local e=nearest(m.x,m.y,enemies_of(m))
  if e then
   local a=ang(e.x-m.x,e.y-m.y)
   local d=min(6,mdist(m,e))
   add(bt.traps,{x=m.x+cos(a)*(d+m.r),y=m.y+dsin(a)*(d+m.r),side=m.side})
   blog(m.name.." deploys a grav-trap",8)
  end
 end
 if has(m,"tech_convent") then m.convent="att" end
 if has(m,"artificial_malevolence") then
  local e=nearest(m.x,m.y,whisper_targets(m))
  if e then malevolence(m,e) end
 end
 if has(m,"gravity_pulse") then
  local foes={}
  for o in all(ships_within(m,8)) do if o.side~=m.side then add(foes,o) end end
  local e=nearest(m.x,m.y,foes)
  if e then push(e,ang(e.x-m.x,e.y-m.y),d6()+1) end
 end
 if m.hero=="communications_master" then
  local e=nearest(m.x,m.y,whisper_targets(m))
  if e then e.targeting+=1 blog(m.name.." marks "..e.name.." with a targeting token",8) end
 end
 if has(m,"coolant_tether") and m.coolant==0 then m.coolant+=1 end
 if has(m,"repair_shuttles") then
  local best
  for o in all(friendly_ships_within(m,12)) do if is_damaged(o) and (not best or hp_left(o)<hp_left(best)) then best=o end end
  if best then repair(best,1) blog(m.name.."'s shuttles repair "..best.name,8) end
 end
 if has(m,"security_systems") then
  local best
  for o in all(friendly_ships_within(m,12,true)) do if o.boarding>0 and (not best or o.boarding>best.boarding) then best=o end end
  if best then local n=d3() best.boarding=max(0,best.boarding-n) blog(m.name.."'s security teams clear boarders from "..best.name,8) end
 end
 if has(m,"mag_lock_array") then
  -- reel in up to 3 friendly squadrons as escorts
  local mine={}
  for s in all(maglock_targets(m)) do if s.side==m.side and mdist(s,m)>2 and #mine<3 then add(mine,s) end end
  if #mine>0 then
   local d=d6()+1
   blog(m.name.."'s mag-lock pulls "..#mine.." squadron(s) "..d.."\"",8)
   for s in all(mine) do drag(s,m,d) end
  end
 end
 if has(m,"violent_whisper") then
  local best
  for e in all(whisper_targets(m)) do if e.boarding>0 and (not best or e.boarding>best.boarding) then best=e end end
  if best then
   blog(m.name.."'s violent whisper torments "..best.name,8)
   boarding_rolls(best)
  end
 end
 if has(m,"wormhole_door") then
  local e=pick(whisper_targets(m))
  if e then
   e.boarding+=1
   blog(m.name.." opens a wormhole onto "..e.name,8)
  end
 end
 if m.hero=="digital_master" then
  local best,bv,bs,be
  for e in all(digital_targets(m)) do
   for s in all(model_shots(e)) do
    for t in all(puppet_targets(e,s)) do
     if t.side==e.side then
      local v=shot_value(e,s,t)
      if not bv or v>bv then best,bv,bs,be=t,v,s,e end
     end
    end
   end
  end
  if best then
   be.lasers-=2
   blog(m.name.." hijacks "..be.name.."'s fire control!",8)
   resolve_shot(be,bs,best)
   bt.sel=m
   if m.state~="table" then return end
  end
 end
 if m.hero=="strike_leader" and #strike_squadrons(m)>0 and zeal_test(m,"Strike Leader") then
  local n=0
  for s in all(strike_squadrons(m)) do
   local e=nearest(s.x,s.y,enemies_of(s))
   if n<3 and e and #engaged_list(s)==0 then
    n+=1
    exec_move(s,ai_path(s,"move",e.x,e.y),"move")
   end
  end
 end
 if has(m,"evacuation_pulse") then
  local foes=0
  for o in all(enemies_of(m,true)) do if mdist(m,o)<=8 then foes+=1 end end
  if foes>0 then evacuation_pulse(m) end
  if m.state~="table" then return end
 end
 if has(m,"precision_teleporter") then
  local best
  for e in all(teleport_targets(m)) do if not best or e.lasers>best.lasers then best=e end end
  if best then teleport_lasers(m,best) end
 end
 if has(m,"fanatic_engineers") and zeal_test(m,"Fanatic Engineers") then m.engineers_round=bt.round end
 if has(m,"fanatic_gunners") and zeal_test(m,"Fanatic Gunners") then m.gunners_round=bt.round end
 if has(m,"orders_of_grief") and is_damaged(m) and zeal_test(m,"Orders of Grief") then repair(m,2) end
 if m.title=="unchained" and zeal_test(m,"Unchained") then m.unchained_round=bt.round end
 if m.hero=="mother_ship" then spawn_broodlings(m) end
 if has(m,"nerve_cluster") or has(m,"program_crux") or m.hero=="primal_bellower" then
  local s=pick(nerve_targets(m))
  if s then
   blog(m.name.."'s nerve cluster stirs "..s.name,8)
   ai_activate(s)
   if m.state~="table" then return end
  end
 end
 if has(m,"nutrient_repo") and is_damaged(m) then
  local food
  for s in all(nutrient_targets(m)) do
   if not food or s.hull.pts<food.hull.pts then food=s end
  end
  if food then
   destroy(food,"consumed")
   repair(m,1)
   blog(m.name.." consumes "..food.name.." and repairs 1 damage",8)
  end
 end
 if has(m,"spore_vents") and working_ups(m)>=3 and not in_cover(m,m) then
  local e,d=nearest(m.x,m.y,enemies_of(m))
  if e and d<30 then
   add(bt.spores,{x=m.x,y=m.y})
   blog(m.name.." vents spores",8)
   deal(m,1)
   if m.state~="table" then return end
  end
 end
 if has(m,"repair_bay") then
  local best,bd
  for o in all(repair_targets(m)) do
   local d=0
   for up in all(o.ups) do d+=up.dmg end
   if not bd or d>bd then best,bd=o,d end
  end
  if best then repair(best,1) blog(m.name.." repairs "..best.name,8) end
 end
 if m.hero=="expert_sapper" then
  local e,d=nearest(m.x,m.y,enemies_of(m))
  if e then
   local a=ang(e.x-m.x,e.y-m.y)
   local r=min(4+m.r,d)
   add(bt.mines,{x=m.x+cos(a)*r,y=m.y+dsin(a)*r,side="ai"})
   blog(m.name.." lays a mine",8)
  end
 end
 if has(m,"tractor_beam") then
  local e=nearest(m.x,m.y,tractor_targets(m))
  if e then pull(e,m,d6()+1) end
 end
 local dis=disabled_ups(m)
 if m.evolution>0 and #dis>0 then
  local old=pick(dis)
  local opts=evolve_options(m,old)
  if #opts>0 then
   local upg=pick(opts)
   m.evolution-=1
   blog(m.name.."'s "..old.upg.name.." evolves into "..upg.name.."!",8)
   replace_upgrade(m,old,upg)
  end
 end
 dis=disabled_ups(m)
 if has(m,"proliferation_pustule") and #dis>0 then
  local old=pick(dis)
  blog(m.name.."'s "..old.upg.name.." becomes a proliferation pustule",8)
  replace_upgrade(m,old,by_id(m.fac.upgrades,"proliferation_pustule"))
 end
end

-- nearest objective the AI doesn't hold: loose markers, or enemy ships
-- carrying them. squadrons can't pick markers up, so they only hunt carriers.
function ai_objective(m)
 local list={}
 if not m.sq then for o in all(bt.objs) do add(list,o) end end
 for e in all(enemies_of(m,true)) do
  if e.markers>0 then add(list,e) end
 end
 return nearest(m.x,m.y,list)
end

function enemies_in_way(m,obj)
 local out={}
 local od=dist(m.x,m.y,obj.x,obj.y)
 for e in all(enemies_of(m)) do
  if e~=obj and dist(m.x,m.y,e.x,e.y)<od and seg_dist(e.x,e.y,m.x,m.y,obj.x,obj.y)<3+e.r then add(out,e) end
 end
 return out
end

function ai_path(m,action,tx,ty)
 if action=="move" and m.hull.rules.blink and speed(m,"move")<=2 then return ai_blink(m,tx,ty) end
 if m.sq then return plan_to(m,action,tx,ty) end
 local D=speed(m,action)
 local cands={}
 for fi=0,5 do
  for k=-8,8 do
   local s={D=D,f=0.5+fi*0.1,th=pivot_max(m,action)*k/8,deflect=deflects(m,action)}
   local ex,ey=path_end(m,D,s.f,s.th)
   add(cands,{s=s,sc=dist(ex,ey,tx,ty)})
  end
 end
 -- insertion sort, then fully simulate the most promising few
 for i=2,#cands do
  local c=cands[i]
  local j=i-1
  while j>=1 and cands[j].sc>c.sc do cands[j+1]=cands[j] j-=1 end
  cands[j+1]=c
 end
 local best,bs
 for i=1,min(10,#cands) do
  local res=simulate(m,cands[i].s)
  local sc=dist(res.x,res.y,tx,ty)+(res.off and 40 or 0)+#res.dangerous*5+#res.mines*6+(res.blocked and 3 or 0)
  for o in all(on_table()) do
   if o~=m and not o.sq and dist(res.x,res.y,o.x,o.y)<m.r+o.r then sc+=4 end
  end
  if not bs or sc<bs then best,bs=res,sc end
 end
 return best
end

-- enemies any of m's weapons could target if it ended up at res (x,y,h)
-- having taken action (which matters for hold-only range bonuses)
function targets_from(m,res,action)
 local x,y,h,ca=m.x,m.y,m.h,m.cur_action
 m.x,m.y,m.h,m.cur_action=res.x or x,res.y or y,res.h or h,action
 local out,seen={},{}
 for s in all(model_shots(m)) do
  for t in all(shot_targets(m,s)) do
   if not seen[t] then seen[t]=true add(out,t) end
  end
 end
 m.x,m.y,m.h,m.cur_action=x,y,h,ca
 return out
end

function can_shoot_from(m,res)
 return not res.off and #targets_from(m,res,m.cur_action)>0
end

function ai_plan(m)
 if #engaged_list(m)>0 and not can_move_engaged(m) then
  return {action="hold",res={pts={},h=m.h},why="is engaged and holds"}
 end

 local obj=ai_objective(m)
 local enemy=nearest(m.x,m.y,enemies_of(m))
 local carrying=not m.sq and m.markers>0

 local function toward(action,t,why)
  return {action=action,res=ai_path(m,action,t.x,t.y),why=why}
 end
 local function ram_from(list)
  if not can_ram(m) then return nil end
  local opts={}
  for t in all(list) do
   if not t.sq then
    local res=find_ram(m,t)
    if res then add(opts,{t=t,res=res}) end
   end
  end
  if #opts>0 then
   local o=pick(opts)
   return {action="ram",res=o.res,tgt=o.t,why="rams "..o.t.name}
  end
 end
 local function move_or_cruise(t,what)
  local p=toward("move",t,"moves toward "..what.." and shoots")
  -- missile ships only launch on hold/move actions, so they prefer moving
  if can_shoot_from(m,p.res) or m.hull.rules.missile_ship then return p end
  return toward("cruise",t,"cruises toward "..what)
 end
 local function hunt()
  if not enemy then return {action="hold",res={pts={},h=m.h},why="holds (no enemies in sight)"} end
  return move_or_cruise(enemy,"the enemy")
 end

 if m.ai_type=="hybrid" then
  if obj and not carrying then
   local way=enemies_in_way(m,obj)
   if #way>0 then
    local p=ram_from(way)
    if p then return p end
    p=toward("move",obj,"moves toward an objective and shoots")
    if can_shoot_from(m,p.res) then return p end
    return toward("cruise",obj,"cruises toward an objective")
   end
   local d=dist(m.x,m.y,obj.x,obj.y)
   if d>speed(m,"move") and d<=speed(m,"cruise") then
    return toward("cruise",obj,"cruises onto an objective")
   end
   return move_or_cruise(obj,"an objective")
  end
  return ram_from(enemies_of(m,true)) or hunt()
 elseif m.ai_type=="shooting" then
  if obj and not carrying then return move_or_cruise(obj,"an objective") end
  return hunt()
 else
  if obj and not carrying then
   local way=enemies_in_way(m,obj)
   if #way>0 then
    local p=ram_from(way)
    if p then return p end
   end
   return toward("cruise",obj,"cruises toward an objective")
  end
  local p=ram_from(enemies_of(m,true))
  if p then return p end
  if not enemy then return hunt() end
  return toward("cruise",enemy,"cruises toward the enemy")
 end
end

function shot_value(m,shot,t)
 local att=shot_att(shot,t)
 local ph=(7-hit_need(m,shot,t))/6
 if shot.boarding then return att*ph*0.5 end
 local pf=(block_need(m,shot,t)-1)/6
 local v=att*ph*pf*((shot.deadly or (shot.side_deadly and side_shot(m,t))) and 2 or 1)
 if t.markers>0 then v*=1.5 end
 return v+rnd(0.01)
end

function ai_shoot(m,only)
 for shot in all(model_shots(m)) do
  if m.state~="table" then return end
  local targets=(only and not shot[only]) and {} or shot_targets(m,shot)
  local multi=multi_targets(shot,targets)
  if #multi>0 then
   for t in all(multi) do
    if m.state=="table" and t.state=="table" then resolve_shot(m,shot,t) wait(8) end
   end
  else
   local best,bv,flex
   for t in all(targets) do
    local v=shot_value(m,shot,t)
    if not bv or v>bv then best,bv,flex=t,v,false end
    if shot.turret and has(m,"flexible_payload") then
     shot.flex=true
     local fv=shot_value(m,shot,t)
     shot.flex=nil
     if fv>bv then best,bv,flex=t,fv,true end
    end
   end
   if best then
    shot.flex=flex or nil
    resolve_shot(m,shot,best)
    wait(14)
    barrage(m,shot)
   end
  end
 end
end
:: src/battle_extra.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- rules helpers for Eternal Dynasty, Havoc Brothers, High Elf Fleets,
-- Human Defense Force and Machine Cults. battle_rules.lua and
-- battle_flow.lua call these at the matching moments.

-- which facing of ship t the point (x,y) is in: "front"/"sides"/"rear"
function facing_at(t,x,y)
 if in_arc(t,"front",x,y) then return "front" end
 if in_arc(t,"rear",x,y) then return "rear" end
 return "sides"
end

function weapon_count(t)
 local n=0
 for up in all(t.ups) do if up.upg.weapon and not up.dis then n+=1 end end
 return n
end

-- Warlord Shield: does ship t have a weapon mounted in that facing?
function facing_has_weapon(t,fc)
 for up in all(t.ups) do
  if up.upg.weapon and not up.dis and up.facing==fc then return true end
 end
 return false
end

-- Data Lord: the target has friendly (to m) ships in all 4 of its facings within 12"
function data_lord_ok(m,t)
 local seen={}
 for o in all(on_table(m.side)) do
  if not o.sq and mdist(o,t)<=12 then
   local fc=facing_at(t,o.x,o.y)
   if fc=="sides" then fc=in_arc(t,"left",o.x,o.y) and "left" or "right" end
   seen[fc]=true
  end
 end
 return seen.front and seen.rear and seen.left and seen.right
end

-- Falconer: +1 per facing of the target with a friendly unengaged squadron within 2"
function falconer_bonus(m,t)
 local seen,n={},0
 for o in all(on_table(m.side)) do
  if o.sq and mdist(o,t)<=2 and #engaged_list(o)==0 then
   local fc=t.sq and "any" or facing_at(t,o.x,o.y)
   if not seen[fc] then seen[fc]=true n+=1 end
  end
 end
 return n
end

-- Support Vessel: -1 to hit unless it's the shooter's closest enemy
function support_cover(m,t)
 if not t.hull.rules.support then return false end
 return nearest(m.x,m.y,enemies_of(m))~=t
end

-- Champion's Throne morale modifier for ship m
function throne_mod(m)
 local mod=0
 for o in all(on_table()) do
  if o.hero=="champions_throne" and mdist(o,m)<=18 then
   mod+=((o.side==m.side) and 1 or -1)
  end
 end
 return mod
end

-- scrap markers m can spend: its own, then a friendly Machine Pontifex within 12"
function scrap_pool(m)
 local n=m.scrap
 for o in all(on_table(m.side)) do
  if o~=m and o.hero=="machine_pontifex" and mdist(o,m)<=12 then n+=o.scrap end
 end
 return n
end

function spend_scrap(m,n)
 local take=min(n,m.scrap)
 m.scrap-=take n-=take
 for o in all(on_table(m.side)) do
  if n>0 and o~=m and o.hero=="machine_pontifex" and mdist(o,m)<=12 then
   take=min(n,o.scrap) o.scrap-=take n-=take
  end
 end
end

-- Scrapper: something near a scrapper was broken, feed the closest one
function scrap_event(x,y,victim)
 for side in all({"p","ai"}) do
  local best,bd
  for o in all(on_table(side)) do
   if o~=victim and o.hull.rules.scrapper then
    local d=dist(o.x,o.y,x,y)-o.r
    if d<=6 and (not bd or d<bd) then best,bd=o,d end
   end
  end
  if best then
   best.scrap+=1
   blog("  "..best.name.." salvages a scrap marker",SIDE_COL[side])
  end
 end
end

-- Processor: a Process Squadron that breaks something builds another
function processor_event(victim)
 local a=bt.attacker
 if a and a.state=="table" and a.side~=victim.side and a.hull.rules.processor then
  local go=a.side=="ai" or choose_option("Processor: deploy a new Process Squadron near "..a.name.."?",{{true,"Deploy"},{false,"No"}})
  if go then spawn_squadron(a.side,a.fac,"process",a,2-2*SQ_RADIUS) end
 end
end

-- Spatial Superposition: when disabled, the ship may jump up to 6"
function superposition(m)
 if m.state~="table" then return end
 local function ok(p) return dist(m.x,m.y,p.x,p.y)<=6 and place_ok(m,p.x,p.y) end
 local spot
 if m.side=="p" then
  bt.sel=m
  local r=await{
   prompt="Spatial Superposition: place "..m.name.." anywhere within 6\", or stay.",
   buttons={{"stay","Stay"}},
   hover=function(p) return {ghost=m,x=p.x,y=p.y,h=m.h,ok=ok(p),ring={x=m.x,y=m.y,r=6}} end,
   click=function(p) if ok(p) then return p end end,
  }
  spot=r.click
 else
  local e=nearest(m.x,m.y,enemies_of(m))
  if e then
   local a=ang(m.x-e.x,m.y-e.y)
   for d=6,1,-1 do
    local p={x=m.x+cos(a)*d,y=m.y+dsin(a)*d}
    if ok(p) then spot=p break end
   end
  end
 end
 if spot then
  m.x,m.y=spot.x,spot.y
  blog(m.name.." shifts through space (Spatial Superposition)",SIDE_COL[m.side])
 end
end

-- Untethered: after taking shooting damage, may slip up to 2"
function untethered_move(m,attacker)
 if m.state~="table" or not m.hull.rules.untethered then return end
 local function ok(p) return dist(m.x,m.y,p.x,p.y)<=2 and place_ok(m,p.x,p.y) end
 local spot
 if m.side=="p" then
  local r=await{
   prompt="Untethered: move "..m.name.." up to 2\" in any direction, or stay.",
   buttons={{"stay","Stay"}},
   hover=function(p) return {ghost=m,x=p.x,y=p.y,h=m.h,ok=ok(p),ring={x=m.x,y=m.y,r=2}} end,
   click=function(p) if ok(p) then return p end end,
  }
  spot=r.click
 else
  local a=ang(m.x-attacker.x,m.y-attacker.y)
  local p={x=m.x+cos(a)*2,y=m.y+dsin(a)*2}
  if ok(p) then spot=p end
 end
 if spot then m.x,m.y=spot.x,spot.y blog("  "..m.name.." slips away (Untethered)",SIDE_COL[m.side]) end
end

-- Gravity Hook: turn the target up to 45 degrees per damage, rear toward the shooter
function gravity_hook(t,m,n)
 local want=ang(t.x-m.x,t.y-m.y)
 local d=nturn(want-t.h)
 local lim=0.125*n
 t.h+=mid(-lim,d,lim)
 blog("  "..t.name.." is wrenched around (Gravity Hook)",9)
end

-- Delegatus: a fallen hero passes to the closest Delegatus ship
function delegatus(m)
 if not m.hero then return end
 local best,bd
 for o in all(on_table(m.side)) do
  if o.title=="delegatus" and not o.hero then
   local d=mdist(o,m)
   if not bd or d<bd then best,bd=o,d end
  end
 end
 if best then
  best.hero=m.hero
  if m.hero=="new_strain" then best.evolution=1 end
  blog("  "..best.name.." takes up the mantle: "..by_id(m.fac.heroes,m.hero).name.." (Delegatus)",SIDE_COL[m.side])
 end
end

-- Phantasm: deploying makes a decoy twin; the first one to act is real
function phantasm_collapse(m)
 local twin=m.twin
 if not twin then return end
 m.twin,twin.twin=nil,nil
 if twin.state~="dead" then
  twin.state="dead"
  add(bt.booms,{x=twin.x,y=twin.y,t=20})
  blog(twin.name.." was only a phantasm and fades away",SIDE_COL[m.side])
 end
end

function make_twin(m)
 local t={}
 for k,v in pairs(m) do t[k]=v end
 t.ups={}
 for up in all(m.ups) do
  local c={} for k,v in pairs(up) do c[k]=v end
  add(t.ups,c)
 end
 t.embarked={}
 t.name=m.name.." (twin)"
 t.twin,m.twin=m,t
 add(bt.models,t)
 return t
end

-- effects when a model starts its activation (called once per activation)
function start_activation(m)
 phantasm_collapse(m)
 m.speed_freak=nil
 if m.title=="tyrant_vessel" and not m.turret_fired_last then
  m.electro_round=bt.round
  blog(m.name.."'s turret is primed (Tyrant Vessel)",SIDE_COL[m.side])
 end
 if m.title=="spider_nodes" and not m.sq then
  local dmg,fixed=0,0
  for up in all(m.ups) do dmg+=up.dmg end
  for r in all(roll_dice(dmg,6,m.name.."'s spider nodes","to repair")) do if r>=6 then fixed+=1 end end
  if fixed>0 then repair(m,fixed) blog(m.name.."'s spider nodes repair "..fixed.." damage",SIDE_COL[m.side]) end
 end
 if m.title=="manufacturer" then
  m.scrap+=1
  blog(m.name.." manufactures a scrap marker",SIDE_COL[m.side])
 end
 if m.hero=="electro_cultist" and not m.turret_fired_last then
  m.electro_round=bt.round
  blog(m.name.."'s turret is charged (Electro Cultist)",SIDE_COL[m.side])
 end
end

-- Rift Rush is worked out as the activation begins
function check_rift_rush(m)
 if m.hull.rules.rift_rush and in_own_zone(m) then m.rush_round=bt.round end
end

-- simple target lists for the HDF / Machine Cult / Elf abilities
function friendly_ships_within(m,r,self_ok)
 local out={}
 for o in all(on_table(m.side)) do
  if not o.sq and (o~=m or self_ok) and mdist(o,m)<=r then add(out,o) end
 end
 return out
end

function ships_within(m,r)
 local out={}
 for o in all(on_table()) do
  if not o.sq and o~=m and mdist(o,m)<=r then add(out,o) end
 end
 return out
end

-- in your deployment zone, or near one of your rift markers (Rift Rush)
function in_own_zone(m)
 if zone_sd(m.side,m.x,m.y)<=0 then return true end
 for r in all(bt.rifts or {}) do
  if r.side==m.side and dist(m.x,m.y,r.x,r.y)-m.r<=4 then return true end
 end
 return false
end

-- reserve kinds: which models may (or must) start off the table
function reserve_kind(m)
 if m.hull.rules.shadow then return "shadow" end
 if m.hero=="tactical_master" then return "tactical" end
 if m.hero=="ex_nihilo" then return "ex_nihilo" end
 if has(m,"rift_scanner") then return "rift" end
end

function reserve_valid(m,x,y)
 local k=m.reserve_kind
 if k=="ex_nihilo" then return ex_nihilo_ok(m,x,y) end
 if not place_ok(m,x,y) then return false end
 if k=="rift" then
  local old={m.x,m.y}
  m.x,m.y=x,y
  local ok=in_own_zone(m)
  m.x,m.y=old[1],old[2]
  return ok
 end
 if k=="shadow" then
  for o in all(on_table(m.side)) do
   if o.hero=="shadow_emperor" and dist(x,y,o.x,o.y)-o.r-m.r<=6 then return true end
  end
  for o in all(enemies_of(m)) do
   if dist(x,y,o.x,o.y)-m.r-o.r<=12 then return false end
  end
  return true
 end
 return reserve_ok(m,x,y)
end

RESERVE_TXT={
 tactical="Tactical Master: deploy anywhere over 9\" from enemies",
 ex_nihilo="Ex-Nihilo: deploy within 6\" of an enemy ship's rear, out of other enemies' front arcs",
 shadow="Shadow: deploy anywhere over 12\" from enemies (or within 6\" of a Shadow Emperor)",
 rift="Rift Scanner: deploy anywhere in your deployment zone (or near a rift marker)",
}

-- AI: find a valid reserve spot near an objective or the enemy
function ai_reserve_place(m)
 if m.reserve_kind=="ex_nihilo" then ai_ex_nihilo(m) return end
 local best,bd
 for x=2,TABLE_W-2,2 do
  for y=1,TABLE_H-1,1.5 do
   if reserve_valid(m,x,y) then
    local o,d=nearest(x,y,bt.objs)
    if not o then o,d=nearest(x,y,enemies_of(m)) end
    d=d or 0
    if not bd or d<bd then best,bd={x=x,y=y,o=o},d end
   end
  end
 end
 if best then
  m.x,m.y,m.state=best.x,best.y,"table"
  m.h=best.o and ang(best.o.x-m.x,best.o.y-m.y) or deploy_face(m.side)
  blog(m.name.." arrives from reserve",8)
 end
end

-- Flicker (and Art of War): at the end of the activation, reposition
function flicker(m)
 if m.state~="table" or not m.hull.rules.flicker then return end
 local r=2
 if m.title=="art_of_war" then
  for e in all(enemies_of(m,true)) do
   if mdist(m,e)<=6 and in_arc(e,"rear",m.x,m.y) then r=6 end
  end
 end
 local function ok(p) return dist(m.x,m.y,p.x,p.y)<=r and place_ok(m,p.x,p.y) end
 local spot
 if m.side=="p" then
  bt.sel=m
  local a=await{
   prompt="Flicker: place "..m.name.." anywhere within "..r.."\" of where it is, or stay.",
   buttons={{"stay","Stay"}},wheel=false,
   hover=function(p) return {ghost=m,x=p.x,y=p.y,h=m.h,ok=ok(p),ring={x=m.x,y=m.y,r=r}} end,
   click=function(p) if ok(p) then return p end end,
  }
  spot=a.click
 else
  local o=nearest(m.x,m.y,bt.objs) or nearest(m.x,m.y,enemies_of(m))
  if o then
   local a=ang(o.x-m.x,o.y-m.y)
   for d=r,0.5,-0.5 do
    local p={x=m.x+cos(a)*d,y=m.y+dsin(a)*d}
    if ok(p) then spot=p break end
   end
  end
 end
 if not spot then return end
 m.x,m.y=spot.x,spot.y
 blog(m.name.." flickers",SIDE_COL[m.side])
 -- Flicker Dancer: may move one weapon to another free facing
 if has(m,"flicker_dancer") and m.side=="p" then
  local list={}
  for up in all(m.ups) do
   if up.upg.weapon and #model_free_facings(m,up.upg,up)>1 then add(list,up) end
  end
  if #list>0 and choose_option("Flicker Dancer: swap a weapon's facing?",{{true,"Yes"},{false,"No"}}) then
   local up=choose_upgrade(m,list,"Flicker Dancer: choose a weapon to move.")
   local opts={}
   for fc in all(model_free_facings(m,up.upg,up)) do if fc~=up.facing then add(opts,{fc,"Move to "..fc}) end end
   up.facing=choose_option("Move "..up.upg.name.." to:",opts)
  end
 end
end

-- Mirth: may back up 3" at the end of the activation
function mirth(m)
 if m.state~="table" or (m.title~="mirth" and not m.hull.rules.goblin_crew) or m.side~="p" then return end
 local a=m.h+0.5
 local p={x=m.x+cos(a)*3,y=m.y+dsin(a)*3}
 if place_ok(m,p.x,p.y) and choose_option("Mirth: move "..m.name.." 3\" backwards?",{{true,"Yes"},{false,"No"}}) then
  m.x,m.y=p.x,p.y
  blog(m.name.." withdraws",12)
 end
end

-- end of activation repairs: Regenerative Skin, Wraith Frame, Repair Arms
function regen(m)
 if m.state~="table" then return end
 for up in all(m.ups) do
  if up.id=="regenerative_skin" and up.dmg>0 and not up.dis then
   up.dmg-=1
   blog(m.name.."'s skin regenerates",SIDE_COL[m.side])
  end
 end
 if m.sq and m.hull.rules.wraith_frame and m.dmg>0 then
  m.dmg-=1
  blog(m.name.." mends (Wraith Frame)",SIDE_COL[m.side])
 end
 if has(m,"repair_arms") then
  repair(m,1)
  for s in all(on_table(m.side)) do
   if s.sq and s.dmg>0 and mdist(s,m)<=2 then s.dmg-=1 end
  end
  blog(m.name.."'s repair arms get to work",SIDE_COL[m.side])
 end
end

-- Rift Master: once per game drop a rift marker within 3"
function rift_master(m)
 if m.state~="table" or m.hero~="rift_master" or m.rift_used then return end
 local spot
 if m.side=="p" then
  if not choose_option("Rift Master: place your rift marker near "..m.name.." now?",{{true,"Place"},{false,"Later"}}) then return end
  local r=await{
   prompt="Rift Master: click within 3\" of "..m.name.." to place the rift marker.",
   buttons={{"skip","Cancel"}},
   hover=function(p) return {mine=p,ok=dist(m.x,m.y,p.x,p.y)-m.r<=3,ring={x=m.x,y=m.y,r=m.r+3}} end,
   click=function(p) if dist(m.x,m.y,p.x,p.y)-m.r<=3 then return p end end,
  }
  spot=r.click
 elseif bt.round>=2 then
  spot={x=m.x,y=m.y}
 end
 if spot then
  m.rift_used=true
  add(bt.rifts,{x=spot.x,y=spot.y,side=m.side})
  blog(m.name.." tears open a rift",SIDE_COL[m.side])
 end
end

-- Drift: slide sideways up to the move distance, then face the solar wind
-- marker nearest the mouse (with no marker the ship keeps its heading)
function plan_drift(m,D,p)
 local side=m.h+0.25
 local s=(p.x-m.x)*cos(side)+(p.y-m.y)*dsin(side)
 s=mid(-D,s,D)
 local a=s>=0 and side or side+0.5
 local res=simulate_dir(m,a,abs(s))
 local w=nearest(p.x,p.y,solar_winds(m))
 res.h=w and ang(w.x-res.x,w.y-res.y) or m.h
 return res
end

-- solar wind markers a drifting ship may face: an unleashed False Sun
-- outshines all of them for the round
function solar_winds(m)
 local out={}
 for s in all(bt.suns) do
  if s~=m and s.state=="table" then add(out,s) end
 end
 if #(bt.suns)>0 then return out end
 return bt.winds
end

-- Wind Reader: snap a point to the nearest table edge; it's valid inside
-- the enemy deployment zone
function wind_spot(side,p)
 local x,y=mid(0.5,p.x,TABLE_W-0.5),mid(0.5,p.y,TABLE_H-0.5)
 local d=min(min(p.x,TABLE_W-p.x),min(p.y,TABLE_H-p.y))
 if d==p.x then x=0.5 elseif d==TABLE_W-p.x then x=TABLE_W-0.5
 elseif d==p.y then y=0.5 else y=TABLE_H-0.5 end
 if zone_sd(other(side),x,y)<=0 then return {x=x,y=y,side=side} end
end

function wind_reader_deploy()
 for m in all(on_table()) do
  if m.hero=="wind_reader" then
   local spot
   if m.side=="p" then
    local r=await{
     prompt="Wind Reader: click the rear edge of the enemy deployment zone to place a solar wind marker.",
     hover=function(p) local w=wind_spot("p",p) return {mine=w or p,ok=w~=nil} end,
     click=function(p) return wind_spot("p",p) end,
    }
    spot=r.click
   else
    -- the AI puts it in the middle of the player's back edge
    local list={}
    for i=0,TABLE_W do
     for e in all({{x=i,y=0},{x=i,y=TABLE_H}}) do local w=wind_spot("ai",e) if w then add(list,w) end end
    end
    for j=0,TABLE_H do
     for e in all({{x=0,y=j},{x=TABLE_W,y=j}}) do local w=wind_spot("ai",e) if w then add(list,w) end end
    end
    local z=bt.zinfo.p
    spot=nearest(z.cx,z.cy,list)
   end
   if spot then
    add(bt.winds,spot)
    blog(m.name.." places a solar wind marker (Wind Reader)",SIDE_COL[m.side])
   end
  end
 end
end

-- False Sun Keeper: at the start of each round the ship may become the
-- only solar wind marker until the round ends
function false_sun()
 bt.suns={}
 for m in all(on_table()) do
  if m.hull.rules.false_sun then
   local go
   if m.side=="p" then
    go=choose_option("False Sun Keeper: unleash the false sun from "..m.name.." this round?",{{true,"Unleash"},{false,"No"}})
   else
    -- the AI doesn't drift, so it only uses it to deny the player's markers
    for o in all(on_table("p")) do if o.hull.rules.drift then go=true end end
   end
   if go then
    add(bt.suns,m)
    blog(m.name.." unleashes the false sun!",SIDE_COL[m.side])
   end
  end
 end
end

-- straight move in a given direction (for drift and sidesteps)
function simulate_dir(m,a,d)
 local h=m.h
 m.h=a
 local res=simulate(m,{D=d,f=1,th=0})
 m.h=h
 res.h=h
 for p in all(res.pts) do p.h=h end
 return res
end

-- Lightning Drive: full straight move, then a 2" sidestep instead of pivoting
function plan_sidestep(m,action,p)
 local res=simulate(m,{D=speed(m,action),f=1,th=0})
 if res.off or res.blocked then return res end
 local side=m.h+0.25
 local s=mid(-2,(p.x-res.x)*cos(side)+(p.y-res.y)*dsin(side),2)
 local x,y=res.x+cos(side)*s,res.y+dsin(side)*s
 if place_ok(m,x,y) then
  add(res.pts,{x=x,y=y,h=m.h})
  res.x,res.y=x,y
 end
 res.h=m.h
 return res
end

-- Companion Vanes: friendly squadrons near the drift path follow the ship
function companion_vanes(m,ox,oy)
 if not has(m,"companion_vanes") then return end
 for s in all(on_table(m.side)) do
  if s.sq and (dist(s.x,s.y,ox,oy)-s.r-m.r<=6 or mdist(s,m)<=6) then
   for i=1,12 do
    local a=rnd()
    local d=m.r+s.r+rnd(2)
    local x,y=m.x+cos(a)*d,m.y+dsin(a)*d
    if place_ok(s,x,y) then s.x,s.y=x,y break end
   end
  end
 end
 blog(m.name.."'s companion vanes gather its squadrons",SIDE_COL[m.side])
end

-- Barrage Master: a friendly ship within 12" may fire a weapon again,
-- disabling it afterwards (once per round)
function barrage(m,shot)
 if shot.turret or not shot.up or shot.up.dis or bt.barrage_used==m.side..bt.round then return end
 local master
 for o in all(on_table(m.side)) do
  if o.hero=="barrage_master" and (o==m or mdist(o,m)<=12) then master=o end
 end
 if not master then return end
 local list=shot_targets(m,shot)
 if #list==0 then return end
 local t
 if m.side=="p" then
  if not choose_option("Barrage Master: fire "..shot.name.." again? It will be disabled afterwards.",{{true,"Fire again"},{false,"No"}}) then return end
  t=pick_model("Barrage Master: click a target for "..shot.name..".",list)
 else
  t=shot.target and shot.target.state=="table" and has_val(list,shot.target) and shot.target or nil
 end
 if not t then return end
 bt.barrage_used=m.side..bt.round
 blog(master.name.." orders a barrage!",SIDE_COL[m.side])
 resolve_shot(m,shot,t)
 shot.up.dmg,shot.up.dis=shot.up.cap,true
 blog("  "..m.name.."'s "..shot.name.." burns out",9)
 if m.state=="table" and working_ups(m)==0 then destroy(m,"destroyed") end
end

-- Overclocked: once per round, disable an upgrade for an extra cruise
function overclock(m)
 if m.state~="table" or m.title~="overclocked" or m.side~="p" or m.overclock_round==bt.round then return end
 local live={}
 for up in all(m.ups) do if not up.dis then add(live,up) end end
 if #live<2 then return end
 if not choose_option("Overclocked: disable an upgrade to take an extra cruise action?",{{true,"Overclock"},{false,"No"}}) then return end
 local up=choose_upgrade(m,live,"Overclocked: choose an upgrade to burn out.")
 up.dmg,up.dis=up.cap,true
 m.overclock_round=bt.round
 local r=await{
  prompt="Overclocked: cruise "..speed(m,"cruise").."\": click where to go.",
  buttons={{"cancel","Cancel"}},cancel=true,
  hover=function(p) return plan_to(m,"cruise",p.x,p.y) end,
  click=function(p) return bt.preview end,
 }
 if r.click then exec_move(m,r.click,"cruise") end
end
:: src/battle_extra2.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- rules helpers for Orc Marauders, Ratmen Clans, Rebel Guerrillas,
-- Robot Legions and Saurian Starhosts.

-- nexus: a direct link between two friendly models
function nexus_link(a,b)
 if a==b or a.side~=b.side or a.state~="table" or b.state~="table" then return false end
 local an,bn=a.hull.rules.nexus,b.hull.rules.nexus
 if b.sq and an and mdist(a,b)<=12 then return true end
 if a.sq and bn and mdist(a,b)<=12 then return true end
 if not a.sq and not b.sq and (an or bn) and dist(a.x,a.y,b.x,b.y)<=12 and los(a.x,a.y,b.x,b.y) then return true end
 return false
end

-- connected via nexus (a Nexus Lord links everything connected to it)
function connected(a,b)
 if nexus_link(a,b) then return true end
 for l in all(on_table(a.side)) do
  if l.hero=="nexus_lord" and (l==a or nexus_link(l,a)) and (l==b or nexus_link(l,b)) and a~=b then return true end
 end
 return false
end

function connected_ships(m)
 local out={}
 for o in all(on_table(m.side)) do
  if o~=m and not o.sq and connected(m,o) then add(out,o) end
 end
 return out
end

-- Ratpack: another friendly ratpack ship within 12" of the target on its opposite side
function ratpack_ok(m,t)
 if not m.hull.rules.ratpack then return false end
 local a1=ang(m.x-t.x,m.y-t.y)
 for o in all(on_table(m.side)) do
  if o~=m and o.hull.rules.ratpack and not o.sq and mdist(o,t)<=12 then
   if t.sq then
    if abs(nturn(ang(o.x-t.x,o.y-t.y)-a1))>=0.375 then return true end
   else
    local f1,f2=facing_at(t,m.x,m.y),facing_at(t,o.x,o.y)
    if (f1=="front" and f2=="rear") or (f1=="rear" and f2=="front") then return true end
    if f1=="sides" and f2=="sides" and in_arc(t,"left",m.x,m.y)~=in_arc(t,"left",o.x,o.y) then return true end
   end
  end
 end
 return false
end

-- friendly ships destroyed this round (Eulogy Cannon, People's Hammer)
function losses(side)
 return (bt.losses[side] or {})[bt.round] or 0
end

-- hits from an explosion (Volatile, Cascade Resonator, Toxin Battery)
function blast_hits(src,radius,hits,str,label)
 for o in all(on_table()) do
  if o~=src and mdist(o,src)<=radius then
   local bn=block_need(src,{str=str},o)
   local fails=0
   for r in all(roll_dice(hits,bn,o.name.." blocks "..label,"to block")) do if r<bn then fails+=1 end end
   blog("  "..label.." hits "..o.name..": "..fails.." damage",fails>0 and 8 or 5)
   deal(o,fails)
  end
 end
end

-- Last Gasp Gun: fires as its ship dies
function last_gasp(m)
 for up in all(m.ups) do
  if up.id=="last_gasp_gun" then
   local w=up.upg
   local shot=apply_rules({name=w.name,rng=w.rng,att=w.att,str=w.str,arc=up.facing or "all",owner=m},w.rules)
   local was=m.state
   m.state="table"
   local list=shot_targets(m,shot)
   local t
   if #list>0 then
    if m.side=="p" then t=pick_model("Last Gasp Gun: click a target for "..m.name.."'s final shot.",list)
    else
     local bv
     for o in all(list) do local v=shot_value(m,shot,o) if not bv or v>bv then t,bv=o,v end end
    end
   end
   if t then
    blog(m.name.." fires its Last Gasp Gun!",SIDE_COL[m.side])
    resolve_shot_inner(m,shot,t)
   end
   m.state=was
  end
 end
end

-- Piranha Gun: other friendly Piranha Guns in range join in
function piranha_chain(m,shot,t)
 if not shot.piranha or shot.chained then return end
 for o in all(on_table(m.side)) do
  if o~=m and t.state=="table" then
   for s in all(model_shots(o)) do
    if s.piranha and has_val(shot_targets(o,s),t) then
     s.chained=true
     blog("  "..o.name.."'s piranha gun joins in",SIDE_COL[o.side])
     resolve_shot(o,s,t)
     break
    end
   end
  end
 end
end

-- snap fire at a model (Motion-Tracker after it moves, Spike Projector on overlap)
function snap_fire(e,flag,target,what)
 if e.state~="table" or target.state~="table" or e[flag.."_round"]==bt.round then return end
 for s in all(model_shots(e)) do
  if s[flag] and has_val(shot_targets(e,s),target) then
   local go=e.side=="ai" or choose_option(what.." "..e.name.." can fire at "..target.name..". Fire?",{{true,"Fire"},{false,"Hold fire"}})
   if go then
    e[flag.."_round"]=bt.round
    blog(e.name.."'s "..s.name.." snaps onto "..target.name,SIDE_COL[e.side])
    resolve_shot(e,s,target)
   end
   return
  end
 end
end

function motion_trackers(mover)
 for e in all(enemies_of(mover)) do
  if mover.state~="table" then return end
  snap_fire(e,"motion_tracker",mover,"Motion-Tracker:")
 end
end

-- Brood Ship: once per round a destroyed friendly squadron comes back
function brood_ship(m)
 for b in all(on_table(m.side)) do
  if b.hero=="brood_ship" and b.brood_round~=bt.round then
   for i=1,30 do
    local a,d=rnd(),b.r+m.r+rnd(2-2*m.r)
    local x,y=b.x+cos(a)*d,b.y+dsin(a)*d
    if place_ok(m,x,y) then
     b.brood_round=bt.round
     m.x,m.y,m.dmg,m.state=x,y,0,"table"
     blog("  "..b.name.." hatches "..m.name.." anew (Brood Ship)",SIDE_COL[m.side])
     return true
    end
   end
  end
 end
 return false
end

-- Warp Tunneler: at the end of a round, move a friendly ship onto the marker
function warp_tunnels()
 for w in all(bt.warps) do
  if w.side=="p" then
   local list={}
   for o in all(on_table("p")) do if not o.sq then add(list,o) end end
   if #list>0 then
    local s=pick_model("Warp Tunneler: click a friendly ship to move to the warp marker, or skip.",list)
    if s and place_ok(s,w.x,w.y) then
     s.x,s.y=w.x,w.y
     del(bt.warps,w)
     blog(s.name.." tunnels through the warp",12)
    end
   end
  end
 end
end

-- Spirit: squadrons may hop back to a friendly Vassal ship within 18"
function spirit_jump(m)
 if m.state~="table" or not m.hull.rules.spirit or m.side~="p" or #engaged_list(m)>0 then return end
 local list={}
 for o in all(on_table(m.side)) do
  if o.hull.rules.vassal and mdist(o,m)<=18 then add(list,o) end
 end
 if #list==0 then return end
 local v=pick_model("Spirit: click a friendly Vassal ship to jump "..m.name.." next to, or skip.",list)
 if not v then return end
 for i=1,30 do
  local a,d=rnd(),v.r+m.r+rnd(2)
  local x,y=v.x+cos(a)*d,v.y+dsin(a)*d
  if place_ok(m,x,y) then m.x,m.y=x,y blog(m.name.." returns to "..v.name.." (Spirit)",12) return end
 end
end

-- Blink: hop up to 2" from here, or within 2" of a connected friendly ship
function blink_ok(m,p)
 if not place_ok(m,p.x,p.y) then return false end
 if dist(m.x,m.y,p.x,p.y)<=2 then return true end
 for o in all(connected_ships(m)) do
  if dist(o.x,o.y,p.x,p.y)-o.r-m.r<=2 then return true end
 end
 return false
end

function blink_res(m,p)
 local res={pts={{x=p.x,y=p.y,h=m.h}},mines={},dangerous={},pickups={},terrains={},x=p.x,y=p.y,h=m.h,blink=true}
 for o in all(bt.objs) do
  if not m.sq and dist(p.x,p.y,o.x,o.y)<=m.r then add(res.pickups,o) end
 end
 return res
end

-- AI blink: best spot toward a point
function ai_blink(m,tx,ty)
 local best,bd
 local anchors={m}
 for o in all(connected_ships(m)) do add(anchors,o) end
 for a in all(anchors) do
  for i=1,16 do
   local an=i/16
   local d=(a==m and 2 or a.r+m.r+1.5)
   local p={x=a.x+cos(an)*d,y=a.y+dsin(an)*d}
   if blink_ok(m,p) then
    local s=dist(p.x,p.y,tx,ty)
    if not bd or s<bd then best,bd=p,s end
   end
  end
 end
 return best and blink_res(m,best) or {pts={},x=m.x,y=m.y,h=m.h,mines={},dangerous={},pickups={},terrains={}}
end

-- Minefield: placement up to the squadron's move speed beyond the zone
function mine_ok(m,x,y)
 return place_ok(m,x,y) and zone_sd(m.side,x,y)<=m.hull.mv
end

function deploy_minefield(m)
 local copies={m}
 if m.side=="p" then
  if choose_option("Minefield: deploy 5 identical copies of "..m.name.."?",{{true,"Deploy 5 copies"},{false,"Just this one"}}) then
   for i=1,5 do
    local c=make_model(new_unit(m.kind),m.side,m.fac)
    c.name=m.name.." "..(i+1)
    c.ai_type=ai_type(c)
    add(bt.models,c)
    add(copies,c)
   end
  end
  for c in all(copies) do
   bt.sel=c
   local r=await{
    prompt="Minefield: place "..c.name.." in your zone or up to "..c.hull.mv.."\" beyond it.",
    hover=function(p) return {ghost=c,x=p.x,y=p.y,h=deploy_face("p"),ok=mine_ok(c,p.x,p.y)} end,
    click=function(p) if mine_ok(c,p.x,p.y) then return p end end,
   }
   c.x,c.y,c.h,c.state=r.click.x,r.click.y,deploy_face("p"),"table"
  end
  bt.sel=nil
 else
  for i=1,5 do
   local c=make_model(new_unit(m.kind),m.side,m.fac)
   c.name=m.name.." "..(i+1)
   c.ai_type=ai_type(c)
   add(bt.models,c)
   add(copies,c)
  end
  for c in all(copies) do
   for k=1,60 do
    local o=pick(bt.objs) or {x=36,y=24}
    local x,y=mid(1,o.x+rnd(16)-8,TABLE_W-1),mid(1,o.y+rnd(16)-8,TABLE_H-1)
    if mine_ok(c,x,y) then c.x,c.y,c.h,c.state=x,y,deploy_face("ai"),"table" break end
   end
   if c.state~="table" then c.state="dead" end
  end
 end
 blog("Mines are laid ("..#copies..")",SIDE_COL[m.side])
end

-- Vassal Link: damage to connected friends may go onto this upgrade instead
function vassal_for(m)
 for o in all(on_table(m.side)) do
  if o~=m and has(o,"vassal_link") and connected(o,m) then return o end
 end
end

-- Vassal: morale may borrow another Vassal ship's upgrade count
function vassal_ups(m,n)
 if not m.hull.rules.vassal then return n end
 for o in all(on_table(m.side)) do
  if o~=m and o.hull.rules.vassal and mdist(o,m)<=18 then n=max(n,working_ups(o)) end
 end
 return n
end

-- Kingly Throne: +2 morale for it and ships connected to it
function kingly_mod(m)
 for o in all(on_table(m.side)) do
  if o.hero=="kingly_throne" and (o==m or connected(o,m)) then return 2 end
 end
 return 0
end

-- Handler: take control of an enemy squadron for the rest of the game
function steal_squadron(m,s)
 s.side=m.side
 s.fac=s.fac
 s.name=(m.side=="ai" and "AI " or "")..s.hull.name.." (stolen)"
 s.activated=true
 blog(m.name.." takes control of "..s.name.."!",SIDE_COL[m.side])
end

function enemy_squadrons_within(m,r)
 local out={}
 for o in all(enemies_of(m)) do if o.sq and mdist(o,m)<=r then add(out,o) end end
 return out
end

function enemy_ships_within(m,r)
 local out={}
 for o in all(enemies_of(m,true)) do if mdist(o,m)<=r then add(out,o) end end
 return out
end

function squadrons_near(m,r)
 local out={}
 for o in all(on_table()) do if o.sq and mdist(o,m)<=r then add(out,o) end end
 return out
end

function carriers_within(m,r)
 local out={}
 for o in all(enemies_of(m,true)) do if o.markers>0 and mdist(o,m)<=r then add(out,o) end end
 return out
end

function friendly_squadrons_within(m,r)
 local out={}
 for o in all(on_table(m.side)) do if o.sq and mdist(o,m)<=r then add(out,o) end end
 return out
end
:: src/battle_flow.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- the whole game runs as one coroutine. await() hands control back to
-- the scene until the player clicks the table or presses a panel button.

-- style: index into DEPLOY_STYLES, or nil to roll one
function bt_start(pf,af,challenge,style)
 bt={
  models={},objs={},mines={},spores={},rifts={},traps={},warps={},winds={},suns={},losses={},flashes={},booms={},logs={},terrain={},stars={},
  round=0,phase=0,challenge=challenge,ai_hit_bonus=0,ai_tou_bonus=0,
  last_mb=0,tip_t=0,ai_name=af.name.." ("..faction_of(af).name..")",
  style=DEPLOY_STYLES[style] or pick(DEPLOY_STYLES),
  pzone=rnd()<0.5 and "a" or "b",
 }
 zone_setup()
 explosions={}
 for side_fleet in all({{"p",pf},{"ai",af}}) do
  local side,f=side_fleet[1],side_fleet[2]
  local fac=faction_of(f)
  local counts,seen={},{}
  for u in all(f.units) do counts[u.kind]=(counts[u.kind] or 0)+1 end
  for u in all(f.units) do
   local m=make_model(u,side,fac)
   if counts[u.kind]>1 then
    seen[u.kind]=(seen[u.kind] or 0)+1
    m.name..=" "..seen[u.kind]
   end
   if side=="ai" then m.name="AI "..m.name end
   -- outbreak ships wait off-table until an enemy dies infected
   if m.hull.rules.outbreak then m.state="outbreak" end
   if m.hull.rules.twin_ship then
    local t2=make_model(u,side,fac)
    t2.name=m.name.." (twin)"
    add(bt.models,t2)
   end
   if m.title=="ship_of_martyrs" then m.blazing=true end
   add(bt.models,m)
  end
 end
 for m in all(bt.models) do m.ai_type=ai_type(m) end
 for i=1,140 do add(bt.stars,{x=rnd(TABLE_W*S),y=rnd(TABLE_H*S),c=rnd()<0.2 and 6 or 5}) end
 gen_terrain()
 rec_start(pf)
 bt.co=CO_CREATE(bt_flow)
 bt.ui_dirty=true
 set_scene(battle_scene)
end

function gen_terrain()
 local kinds={"nebula","nebula","nebula","asteroids","asteroids","asteroids","planetoid","planetoid","debris","debris"}
 local n=10+flr(rnd(3))
 for tries=1,600 do
  if #bt.terrain>=n then break end
  local k=pick(kinds)
  local r=k=="planetoid" and 1.5+rnd(1.5) or 2.5+rnd(2)
  local x,y=5+rnd(TABLE_W-10),7+rnd(TABLE_H-14)
  local ok=true
  for t in all(bt.terrain) do
   if dist(x,y,t.x,t.y)<t.r+r+2 then ok=false end
  end
  if ok then
   local t={kind=k,x=x,y=y,r=r,bits={}}
   for i=1,flr(r*5) do
    local a,d=rnd(),sqrt(rnd())*r*0.9
    add(t.bits,{x=cos(a)*d,y=dsin(a)*d,s=rnd()})
   end
   add(bt.terrain,t)
  end
 end
end

function await(o)
 rec_check()
 bt.wait_o=o
 bt.prompt=o.prompt
 bt.answer=nil
 bt.preview=nil
 bt.pv_dirty=true
 bt.ui_dirty=true
 while not bt.answer do YIELD() end
 local a=bt.answer
 bt.answer,bt.wait_o,bt.preview=nil,nil,nil
 bt.ui_dirty=true
 return a
end

function say(s) bt.prompt=s bt.ui_dirty=true end

function bt_flow()
 blog("Deployment: "..bt.style.name..". You deploy in the "..bt.style[bt.pzone]..". Fighting: "..bt.ai_name,7)
 bt.first=rnd()<0.5 and "p" or "ai"
 blog((bt.first=="p" and "You win" or "The AI wins").." the deployment roll and will activate first.",7)

 place_objectives()
 player_deploy()
 ai_deploy()
 prospector_deploy()
 for m in all(bt.models) do
  if m.state=="pending" and m.hull.rules.minefield then deploy_minefield(m) end
 end
 formation_redeploy()
 tactician_redeploy()
 wind_reader_deploy()

 bt.start_ships={p=morale_ships("p"),ai=morale_ships("ai")}
 for round=1,4 do
  bt.round=round
  start_round()
  local first=round%2==1 and bt.first or other(bt.first)
  for phase=1,4 do
   bt.phase=phase
   local side=first
   while true do
    if #eligible(side,phase)==0 then side=other(side) end
    if #eligible(side,phase)==0 then break end
    bt.last_active=nil
    if side=="p" then player_turn(phase) else ai_turn(phase) end
    if game_over() then return end
    -- Late Stage: may activate a second time in the final round
    local m=bt.last_active
    if m and round==4 and m.hero=="late_stage" and not m.late_used and m.state=="table" then
     m.late_used=true
     m.activated=false
     blog(m.name.." (Late Stage) may activate again this round",m.side=="p" and 12 or 8)
    end
    side=other(side)
   end
  end
  end_round()
  if game_over() then return end
 end
 local p,a=side_markers("p"),side_markers("ai")
 finish(p>a and "p" or a>p and "ai" or "draw","Objectives held: you "..p..", AI "..a)
end

function place_objectives()
 local n=d3()+2
 local side=rnd()<0.5 and "p" or "ai"
 blog("Placing "..n.." objectives. "..(side=="p" and "You" or "The AI").." place first.",7)
 bt.show_obj_band=true
 for i=1,n do
  if not obj_room() then blog("No room left for more objectives.",7) break end
  if side=="p" then
   local r=await{
    prompt="Place objective "..i.."/"..n.." in the highlighted band, over 9\" from other objectives.",
    hover=function(p) return {objghost=p,ok=obj_valid(p.x,p.y)} end,
    click=function(p) if obj_valid(p.x,p.y) then return p end end,
   }
   add(bt.objs,{x=r.click.x,y=r.click.y})
  else
   say("The AI is placing an objective...")
   wait(20)
   ai_place_objective()
  end
  side=other(side)
 end
 bt.show_obj_band=false
end

-- divide the table into 6 squares, roll for one, place in its centre or
-- the nearest valid spot
function ai_place_objective()
 for tries=1,20 do
  local sq=flr(rnd(6))
  local cx,cy=12+(sq%3)*24,12+(sq\3)*24
  local best,bd
  for x=0,TABLE_W,1 do
   for y=0,TABLE_H,0.5 do
    if obj_valid(x,y) then
     local d=dist(x,y,cx,cy)
     if not bd or d<bd then best,bd={x=x,y=y},d end
    end
   end
  end
  if best then
   add(bt.objs,best)
   blog("The AI rolls square "..(sq+1).." and places an objective.",8)
   return
  end
 end
end

function player_deploy()
 local ships,sqds={},{}
 for m in all(bt.models) do
  if m.side=="p" and m.state=="pending" and m.hero~="advance_prospector" and not m.hull.rules.minefield then add(m.sq and sqds or ships,m) end
 end
 for m in all(ships) do deploy_one(m) end
 for m in all(sqds) do deploy_one(m) end
 bt.sel=nil
end

function deploy_face(side) return bt.zinfo[side].face end

function deploy_one(m)
 bt.sel=m
 bt.deploy_h=deploy_face("p")
 local btns={}
 if reserve_kind(m) then add(btns,{"reserve","Hold in reserve"}) end
 if m.sq then
  for c in all(on_table("p")) do
   if c.hero=="ace_carrier" and #c.embarked<c.hull.ups then add(btns,{c,"Embark: "..c.name}) end
  end
 end
 local r=await{
  prompt="Deploy "..m.name.." in your zone. Mouse wheel or left/right rotates.",
  buttons=btns,wheel=true,
  hover=function(p) return {ghost=m,x=p.x,y=p.y,h=bt.deploy_h,ok=zone_ok("p",m,p.x,p.y)} end,
  click=function(p) if zone_ok("p",m,p.x,p.y) then return p end end,
 }
 if r.button=="reserve" then
  m.state="reserve"
  m.reserve_kind=reserve_kind(m)
  blog(m.name.." waits in reserve.",12)
 elseif r.button then
  m.state="embarked"
  m.carrier=r.button
  add(r.button.embarked,m)
  blog(m.name.." embarks on "..r.button.name..".",12)
 else
  m.x,m.y,m.h=r.click.x,r.click.y,bt.deploy_h
  m.state="table"
  if m.hero=="phantasm" and not m.twin and not m.is_twin
   and choose_option("Phantasm: deploy an identical twin? The first copy to act or be targeted is the real one.",{{true,"Deploy a twin"},{false,"No"}}) then
   local t=make_twin(m)
   t.state,t.is_twin="pending",true
   deploy_one(t)
  end
  if m.title=="specialised" then
   m.turret_rule=choose_option("Specialised: pick a special rule for "..m.name.."'s turret.",
    {{"anti_ship","Anti-Ship (+1 vs ships)"},{"anti_sq","Anti-Squadron (+1 vs squadrons)"}})
  end
  if m.title=="vanguard" then
   local mv=speed(m,"move")
   local r2=await{
    prompt=m.name.." (Vanguard) may advance up to "..mv.."\". Click a point ahead or skip.",
    buttons={{"skip","Skip"}},
    hover=function(p)
     local d=mid(0,(p.x-m.x)*cos(m.h)+(p.y-m.y)*dsin(m.h),mv)
     return simulate(m,{D=d,f=1,th=0})
    end,
    click=function(p) return bt.preview end,
   }
   if r2.click then exec_move(m,r2.click,"vanguard") end
  end
 end
end

-- Advance Prospector: deploys last, then may move up to 6" ignoring terrain
function prospector_deploy()
 for m in all(bt.models) do
  if m.side=="p" and m.state=="pending" and m.hero=="advance_prospector" then
   deploy_one(m)
   if m.state=="table" then
    local function ok(p) return dist(m.x,m.y,p.x,p.y)<=6 and place_ok(m,p.x,p.y) end
    local r=await{
     prompt="Advance Prospector: move "..m.name.." up to 6\" in any direction (ignores terrain), or stay.",
     buttons={{"stay","Stay here"}},
     hover=function(p) return {ghost=m,x=p.x,y=p.y,h=m.h,ok=ok(p),ring={x=m.x,y=m.y,r=6}} end,
     click=function(p) if ok(p) then return p end end,
    }
    if r.click then m.x,m.y=r.click.x,r.click.y blog(m.name.." prospects ahead",12) end
   end
  end
 end
 bt.sel=nil
end

-- Tactician: up to 3 friendly ships may be redeployed
function tactician_redeploy()
 local has_t=false
 for m in all(on_table("p")) do if m.hero=="tactician" then has_t=true end end
 if not has_t then return end
 for i=1,3 do
  local list={}
  for o in all(on_table("p")) do if not o.sq and not o.tactic_moved then add(list,o) end end
  local m=pick_model("Tactician: click a ship to redeploy ("..(4-i).." left), or skip.",list)
  if not m then return end
  m.tactic_moved=true
  bt.sel=m
  bt.deploy_h=m.h
  local r=await{
   prompt="Tactician: place "..m.name.." anywhere in your zone.",
   wheel=true,
   hover=function(p) return {ghost=m,x=p.x,y=p.y,h=bt.deploy_h,ok=zone_ok("p",m,p.x,p.y)} end,
   click=function(p) if zone_ok("p",m,p.x,p.y) then return p end end,
  }
  m.x,m.y,m.h=r.click.x,r.click.y,bt.deploy_h
  bt.sel=nil
 end
end

-- Formation Expert: after everything is deployed, may redeploy
function formation_redeploy()
 for m in all(bt.models) do
  if m.side=="p" and m.hero=="formation_expert" and m.state=="table" then
   bt.sel=m
   bt.deploy_h=m.h
   local r=await{
    prompt="Formation Expert: redeploy "..m.name.." anywhere in your zone, or keep it where it is.",
    buttons={{"keep","Keep position"}},wheel=true,
    hover=function(p) return {ghost=m,x=p.x,y=p.y,h=bt.deploy_h,ok=zone_ok("p",m,p.x,p.y)} end,
    click=function(p) if zone_ok("p",m,p.x,p.y) then return p end end,
   }
   if r.click then
    m.x,m.y,m.h=r.click.x,r.click.y,bt.deploy_h
    blog(m.name.." redeploys (Formation Expert)",12)
   end
   bt.sel=nil
  end
 end
end

-- AI deploys in 3 groups, each in a randomly rolled third of its zone,
-- each model as close as possible to the nearest objective
function ai_deploy()
 local list={}
 for m in all(bt.models) do
  if m.side=="ai" and m.state=="pending" and not m.hull.rules.minefield then
   if m.hero=="ex_nihilo" or m.hull.rules.shadow then
    m.state="reserve"
    m.reserve_kind=reserve_kind(m)
   else
    add(list,m)
   end
  end
 end
 shuffle(list)
 local groups=min(3,#list)
 local secs
 repeat
  secs={d3(),d3(),d3()}
 until groups<2 or not (secs[1]==secs[2] and (groups==2 or secs[2]==secs[3]))
 for i,m in ipairs(list) do m.sec=secs[(i-1)%3+1] end
 shuffle(list)
 -- Advance Prospectors go last
 for i=#list,1,-1 do
  if list[i].hero=="advance_prospector" then add(list,deli(list,i)) end
 end
 for m in all(list) do
  say("The AI is deploying...")
  ai_place(m)
  if m.hero=="phantasm" and m.state=="table" and not m.twin then
   local t=make_twin(m)
   t.state,t.is_twin="pending",true
   ai_place(t)
  end
  if m.hero=="advance_prospector" and m.state=="table" then
   local o=nearest(m.x,m.y,bt.objs)
   if o then
    local a=ang(o.x-m.x,o.y-m.y)
    for d=6,1,-1 do
     local x,y=m.x+cos(a)*d,m.y+dsin(a)*d
     if place_ok(m,x,y) then m.x,m.y,m.h=x,y,a break end
    end
   end
  end
  wait(6)
 end
end

function ai_place(m)
 local z=bt.zinfo.ai
 for pass=1,2 do
  local x0,x1,y0,y1=0,TABLE_W,0,TABLE_H
  -- first try the rolled third, along the zone's longer side
  if pass==1 then
   if z.x1-z.x0>=z.y1-z.y0 then
    local w=(z.x1-z.x0)/3
    x0=z.x0+(m.sec-1)*w x1=x0+w
   else
    local h=(z.y1-z.y0)/3
    y0=z.y0+(m.sec-1)*h y1=y0+h
   end
  end
  local best,bd
  for x=x0,x1,1 do
   for y=y0,y1,1 do
    if zone_ok("ai",m,x,y) and not terrain_at(x,y,"asteroids") and not terrain_at(x,y,"debris") then
     local o,d=nearest(x,y,bt.objs)
     d=d or 0
     if not bd or d<bd then best,bd={x=x,y=y,o=o},d end
    end
   end
  end
  if best then
   m.x,m.y=best.x,best.y
   m.h=best.o and ang(best.o.x-m.x,best.o.y-m.y) or deploy_face("ai")
   m.state="table"
   if m.title=="specialised" then m.turret_rule="anti_ship" end
   if m.title=="vanguard" then
    local res=simulate(m,{D=speed(m,"move"),f=1,th=0})
    if not res.off and not res.blocked and #res.dangerous==0 and #res.mines==0 then exec_move(m,res,"vanguard") end
   end
   return
  end
 end
 m.state="dead" -- nowhere to deploy
end

function start_round()
 blog("--- Round "..bt.round.." ---",7)
 for m in all(bt.models) do m.activated=false end
 if bt.challenge then
  local p,a=side_markers("p"),side_markers("ai")
  bt.ai_hit_bonus,bt.ai_tou_bonus=0,0
  if a==p then bt.ai_hit_bonus=1 blog("Challenge bonus: AI +1 to hit this round",8)
  elseif a<p then bt.ai_hit_bonus,bt.ai_tou_bonus=1,1 blog("Challenge bonus: AI +1 to hit and toughness this round",8) end
 end
 if bt.round>=2 then
  for m in all(bt.models) do
   if m.state=="reserve" and not m.reserve_kind then m.reserve_kind=reserve_kind(m) end
   if m.side=="ai" and m.state=="reserve" then
    ai_reserve_place(m)
   elseif m.side=="p" and m.state=="reserve" then
    bt.sel=m
    bt.deploy_h=deploy_face("p")
    local ok=reserve_valid
    local r=await{
     prompt=(RESERVE_TXT[m.reserve_kind] or "Deploy from reserve").." - "..m.name..", or wait.",
     buttons={{"wait","Not yet"}},wheel=true,
     hover=function(p) return {ghost=m,x=p.x,y=p.y,h=bt.deploy_h,ok=ok(m,p.x,p.y)} end,
     click=function(p) if ok(m,p.x,p.y) then return p end end,
    }
    if r.click then
     m.x,m.y,m.h=r.click.x,r.click.y,bt.deploy_h
     m.state="table"
     blog(m.name.." arrives from reserve!",12)
    end
    bt.sel=nil
   end
  end
 end
 false_sun()
end

function reserve_ok(m,x,y)
 if not place_ok(m,x,y) then return false end
 for o in all(enemies_of(m)) do
  if dist(x,y,o.x,o.y)-m.r-o.r<=9 then return false end
 end
 return true
end

function end_round()
 blaze_tick()
 warp_tunnels()
 for m in all(bt.models) do
  if m.state=="off" then return_to_table(m) end
 end
 for side in all({"p","ai"}) do morale(side) end
 rec_check()
 rec_save()
end

function return_to_table(m)
 local e=m.exit
 local dl,dr,dt,db=e.x,TABLE_W-e.x,e.y,TABLE_H-e.y
 local mn=min(min(dl,dr),min(dt,db))
 for off in all({0,1,-1,2,-2,3,-3,4,-4}) do
  local x,y,h
  if mn==dl then x,y,h=m.r+0.1,e.y+off,0
  elseif mn==dr then x,y,h=TABLE_W-m.r-0.1,e.y+off,0.5
  elseif mn==dt then x,y,h=e.x+off,m.r+0.1,0.25
  else x,y,h=e.x+off,TABLE_H-m.r-0.1,0.75 end
  if place_ok(m,x,y) then
   m.x,m.y,m.h=x,y,h
   m.state="table"
   m.held=false
   blog(m.name.." returns to the table.",5)
   return
  end
 end
end

-- ships still in play for morale purposes (Administrators count double)
-- Pirate Royalty: the other side has one in play
function pirate_royalty_vs(side)
 for o in all(bt.models) do
  if o.side~=side and o.hero=="pirate_royalty" and o.state~="dead" then return true end
 end
 return false
end

function morale_ships(side)
 local n=0
 for m in all(bt.models) do
  if m.side==side and not m.sq and m.state~="dead" and m.state~="pending" and m.state~="outbreak" then
   if not (pirate_royalty_vs(side) and working_ups(m)==1) and m.title~="for_the_cause" then
    n+=(m.hero=="omega_boss" and 3 or m.hull.rules.administrator and 2 or 1)
   end
  end
 end
 return n
end

function morale(side)
 local ships=morale_ships(side)
 if ships>0 and ships*2<=bt.start_ships[side] then
  blog((side=="p" and "Your" or "The AI's").." fleet is broken: morale tests!",9)
  for m in all(bt.models) do
   if m.side==side and not m.sq and m.state=="table" then
    local ok,r,n=morale_test(m)
    if ok then
     blog("  "..m.name..": "..morale_txt(r,n).." - holds firm",5)
    else
     if m.title=="disciplined" then
      blog("  "..m.name..": "..morale_txt(r,n).." - holds by discipline, 1 damage",9)
      deal(m,1)
     else
      blog("  "..m.name..": "..morale_txt(r,n).." - surrenders",9)
      destroy(m,"surrendering")
     end
    end
   end
  end
 end
 if in_play(side,true)==0 then
  for m in all(bt.models) do
   if m.side==side and m.sq and m.state~="dead" and m.state~="pending" then destroy(m,"surrendering") end
  end
 end
end

function game_over()
 local p,a=in_play("p"),in_play("ai")
 if p>0 and a>0 then return false end
 finish(p>0 and "p" or a>0 and "ai" or "draw",
  p==0 and a==0 and "Both fleets were wiped out." or p==0 and "Your fleet was wiped out." or "The AI fleet was wiped out.")
 return true
end

function finish(winner,why)
 bt.sel,bt.highlight=nil,nil
 bt.result={winner=winner,why=why}
 blog(winner=="p" and "VICTORY!" or winner=="ai" and "DEFEAT!" or "DRAW!",10)
 blog(why,10)
 rec_check()
 rec_save()
 await{prompt="The battle is over. "..why,buttons={{"menu","Return to menu"}}}
 set_scene(menu_scene)
end

-- player turns

function player_turn(phase)
 while true do
  local list=eligible("p",phase)
  if #list==0 then return end
  local m
  if #list==1 then
   m=list[1]
  else
   bt.highlight=list
   local r=await{
    prompt="Your turn: select a "..PHASE_ONE[phase].." to activate.",
    click=function(p) return model_at(p,list) end,
   }
   bt.highlight=nil
   m=r.click
  end
  if player_activate(m,#list>1) then return end
 end
end

ABILITIES={pods=true,overcharge=true,gravtrap=true,tether=true,treachery=true,hangar=true,locktether=true,
 sabotage=true,handler=true,gshunt=true,frog=true,shaman=true,claw=true,horizon=true,wrath=true,
 malevolence=true,gpulse=true,comms=true,coolant=true,shuttles=true,security=true,
 telemetry=true,unity=true,splitter=true,convent=true,bindings=true,consume=true,maglock=true,whisper=true,wormhole=true,digital=true,strike=true,evac=true,teleport=true,avenger=true,sapper=true,repair=true,tractor=true,launch=true,evolve=true,pustule=true,
 adapt=true,brood=true,nerve=true,nutrient=true,spores=true,
 engineers=true,gunners=true,grief=true,unchained=true}

-- Infinite Adaptation: weapons that have an unoccupied facing to move to
function adapt_weapons(m)
 local out={}
 for up in all(m.ups) do
  if up.upg.weapon and #model_free_facings(m,up.upg,up)>1 then add(out,up) end
 end
 return out
end

-- Nerve Cluster: friendly squadrons within 6" (an extra activation, so
-- squadrons that already activated this round count too)
function nerve_targets(m)
 local out={}
 for s in all(on_table(m.side)) do
  if s.sq and mdist(s,m)<=6 then add(out,s) end
 end
 return out
end

-- Nutrient Repo: friendly squadrons within 2" to consume
function nutrient_targets(m)
 local out={}
 for s in all(on_table(m.side)) do
  if s.sq and mdist(s,m)<=2 then add(out,s) end
 end
 return out
end

function disabled_ups(m)
 local out={}
 for up in all(m.ups) do if up.dis then add(out,up) end end
 return out
end

-- action variants that resolve as a normal move or cruise
ACTION_BASE={drift="move",drift_cruise="cruise",side_move="move",side_cruise="cruise",blink="move",stardrive="cruise"}

function player_activate(m,can_back)
 bt.sel=m
 bt.last_active=m
 check_rift_rush(m)
 local used={}
 local started=false
 local function start()
  if not started then started=true start_activation(m) end
 end
 while true do
  local btns={}
  local engaged=#engaged_list(m)>0
  add(btns,{"hold",m.sq and "Hold" or "Hold (pivot, shoot)"})
  if not engaged or can_move_engaged(m) then
   add(btns,{"move","Move "..speed(m,"move").."\" (shoot)"})
   add(btns,{"cruise","Cruise "..speed(m,"cruise").."\""})
   if m.hull.rules.drift then add(btns,{"drift","Drift "..speed(m,"move").."\" (shoot)"}) end
   if m.hull.rules.drift and m.hero=="ring_master" then add(btns,{"drift_cruise","Drift cruise "..speed(m,"cruise").."\""}) end
   if m.hull.rules.blink then add(btns,{"blink","Blink (shoot)"}) end
   if has(m,"star_drive") and not used.stardrive then add(btns,{"stardrive","Star Drive"}) end
   if has(m,"lightning_drive") then
    add(btns,{"side_move","Move + 2\" sidestep"})
    add(btns,{"side_cruise","Cruise + 2\" sidestep"})
   end
   if m.sq and can_ram(m) then add(btns,{"ram",(m.hull.rules.pyre and "Pyre" or m.hull.rules.crawl and "Crawl Within"
    or m.hull.rules.boarding_robot and "Boarding Robot" or "Burrow Within").." (ram)"}) end
  end
  if not m.sq then
   add(btns,{"ram","Ram"})
   local dis=#disabled_ups(m)>0
   if m.title=="avenger" and not used.avenger then add(btns,{"avenger","Avenger: jump"}) end
   if m.hero=="expert_sapper" and not used.sapper then add(btns,{"sapper","Sapper: lay mine"}) end
   if has(m,"repair_bay") and not used.repair and #repair_targets(m)>0 then add(btns,{"repair","Repair Bay"}) end
   if has(m,"tractor_beam") and not used.tractor and #tractor_targets(m)>0 then add(btns,{"tractor","Tractor Beam"}) end
   if m.hero=="ace_carrier" and not m.launched and #m.embarked>0 then add(btns,{"launch","Launch squadrons"}) end
   if m.evolution>0 and dis then add(btns,{"evolve","New Strain: evolve"}) end
   if has(m,"proliferation_pustule") and not used.pustule and dis then add(btns,{"pustule","Proliferate pustule"}) end
   if has(m,"fanatic_engineers") and not used.engineers then add(btns,{"engineers","Fanatic Engineers"}) end
   if has(m,"fanatic_gunners") and not used.gunners then add(btns,{"gunners","Fanatic Gunners"}) end
   if has(m,"orders_of_grief") and not used.grief and is_damaged(m) then add(btns,{"grief","Orders of Grief"}) end
   if m.title=="unchained" and not used.unchained then add(btns,{"unchained","Unchained: extra pivot"}) end
   if m.hero=="digital_master" and not used.digital and #digital_targets(m)>0 then add(btns,{"digital","Digital Master"}) end
   if m.hero=="strike_leader" and not used.strike and #strike_squadrons(m)>0 then add(btns,{"strike","Strike Leader"}) end
   if has(m,"mag_lock_array") and not used.maglock and #maglock_targets(m)>0 then add(btns,{"maglock","Mag-Lock Array"}) end
   if has(m,"violent_whisper") and not used.whisper and #whisper_targets(m)>0 then add(btns,{"whisper","Violent Whisper"}) end
   if has(m,"wormhole_door") and not used.wormhole and #whisper_targets(m)>0 then add(btns,{"wormhole","Wormhole Door"}) end
   if has(m,"evacuation_pulse") and not used.evac then add(btns,{"evac","Evacuation Pulse"}) end
   if has(m,"precision_teleporter") and not used.teleport and #teleport_targets(m)>0 then add(btns,{"teleport","Precision Teleporter"}) end
   if m.hero=="infinite_adaptation" and not used.adapt and #adapt_weapons(m)>0 then add(btns,{"adapt","Adapt: move a weapon"}) end
   if m.hero=="mother_ship" and not used.brood then add(btns,{"brood","Mother Ship: spawn"}) end
   if (has(m,"nerve_cluster") or has(m,"program_crux") or m.hero=="primal_bellower") and not used.nerve and #nerve_targets(m)>0 then
    add(btns,{"nerve",has(m,"program_crux") and "Program Crux" or "Nerve Cluster"})
   end
   if has(m,"artificial_malevolence") and not used.malevolence and #whisper_targets(m)>0 then add(btns,{"malevolence","Artificial Malevolence"}) end
   if has(m,"gravity_pulse") and not used.gpulse and #ships_within(m,8)>0 then add(btns,{"gpulse","Gravity Pulse"}) end
   if m.hero=="communications_master" and not used.comms and #whisper_targets(m)>0 then add(btns,{"comms","Targeting token"}) end
   if has(m,"coolant_tether") and not used.coolant then add(btns,{"coolant","Coolant Tether"}) end
   if has(m,"repair_shuttles") and not used.shuttles and #friendly_ships_within(m,12)>0 then add(btns,{"shuttles","Repair Shuttles"}) end
   if has(m,"security_systems") and not used.security and #friendly_ships_within(m,12)>0 then add(btns,{"security","Security Systems"}) end
   if has(m,"telemetry_banks") and not used.telemetry and #friendly_ships_within(m,12)>0 then add(btns,{"telemetry","Telemetry Banks"}) end
   if has(m,"unity_channel") and not used.unity and #friendly_ships_within(m,12)>0 then add(btns,{"unity","Unity Channel"}) end
   if has(m,"space_splitter") and not used.splitter and #ships_within(m,8)>0 then add(btns,{"splitter","Space Splitter"}) end
   if has(m,"tech_convent") and not used.convent then add(btns,{"convent","Tech Convent"}) end
   if has(m,"loose_bindings") and not used.bindings then add(btns,{"bindings","Loose Bindings"}) end
   if has(m,"consumption_drive") and not used.consume and scrap_pool(m)>0 then add(btns,{"consume","Consumption Drive"}) end
   if has(m,"teleporter_pods") and not used.pods and #enemy_ships_within(m,6)>0 then add(btns,{"pods","Teleporter Pods"}) end
   if has(m,"overcharged_thrusters") and not used.overcharge then add(btns,{"overcharge","Over-charge thrusters"}) end
   if has(m,"grav_trap_launcher") and not used.gravtrap then add(btns,{"gravtrap","Grav-Trap Launcher"}) end
   if has(m,"tether_emitter") and not used.tether and #enemy_ships_within(m,8)>0 then add(btns,{"tether","Tether Emitter"}) end
   if has(m,"treachery_relay") and not used.treachery and #enemy_squadrons_within(m,6)>0 then add(btns,{"treachery","Treachery Relay"}) end
   if has(m,"hidden_hangar") and not used.hangar and working_ups(m)>1 and #friendly_squadrons_within(m,99)>0 then add(btns,{"hangar","Hidden Hangar"}) end
   if has(m,"lock_tether") and not used.locktether and #squadrons_near(m,12)>0 then add(btns,{"locktether","Lock Tether"}) end
   if has(m,"sabotage_cells") and not used.sabotage and #carriers_within(m,12)>0 then add(btns,{"sabotage","Sabotage Cells"}) end
   if m.hero=="handler" and not m.handled and #enemy_squadrons_within(m,12)>0 then add(btns,{"handler","Handler: steal a squadron"}) end
   if has(m,"gravity_shunt") and not used.gshunt and #ships_within(m,8)>0 then add(btns,{"gshunt","Gravity Shunt"}) end
   if m.hero=="divine_frog" and not used.frog then add(btns,{"frog","Divine Frog: spawn"}) end
   if m.title=="spirit_shaman" and not used.shaman and #friendly_squadrons_within(m,2)>0 then add(btns,{"shaman","Spirit Shaman"}) end
   if has(m,"defense_claw") and not used.claw and #enemy_squadrons_within(m,2)>0 then add(btns,{"claw","Defense Claw"}) end
   if has(m,"event_horizon") and not used.horizon and #ships_within(m,12)>0 then add(btns,{"horizon","Event Horizon"}) end
   if has(m,"wrath_spines") and not used.wrath then add(btns,{"wrath","Wrath Spines"}) end
   if m.title=="aggressive_recycler" and m.scrap>=2 and next(used) then add(btns,{"recycle","Recycle 2 scrap: reuse abilities"}) end
   if has(m,"nutrient_repo") and not used.nutrient and is_damaged(m) and #nutrient_targets(m)>0 then add(btns,{"nutrient","Nutrient Repo"}) end
   if has(m,"spore_vents") and not used.spores then add(btns,{"spores","Spore Vents"}) end
  end
  if m.hull.rules.rogue and bt.phase==1 and not next(used) then add(btns,{"rogue","Rogue: wait for later"}) end
  if can_back and not next(used) then add(btns,{"back","Pick another"}) end
  local r=await{
   prompt="Activate "..m.name..(engaged and " (engaged)" or "")..": choose an action.",
   buttons=btns,
  }
  local b=r.button
  if b=="back" then bt.sel=nil return false end
  if b=="rogue" then
   m.rogue_round=bt.round
   blog(m.name.." lurks (Rogue)",12)
   bt.sel=nil
   return true
  end
  if b=="recycle" then
   -- Aggressive Recycler: spend 2 scrap to use this activation's abilities again
   m.scrap-=2
   used={}
   blog(m.name.." recycles 2 scrap to repeat its systems",12)
  elseif ABILITIES[b] then
   start()
   used[b]=true
   player_ability(m,b)
  elseif b then
   local res,tgt=player_aim(m,b)
   if res then
    start()
    m.activated=true
    boarding_rolls(m)
    local ox,oy=m.x,m.y
    if m.state=="table" then commit(m,ACTION_BASE[b] or b,res,tgt) end
    if (b=="drift" or b=="drift_cruise") and m.state=="table" then companion_vanes(m,ox,oy) end
    end_activation(m)
    break
   end
  end
 end
 -- squadrons launched by an Ace Carrier may activate immediately
 local launched=bt.launched or {}
 bt.launched=nil
 for s in all(launched) do
  if s.state=="table" and not s.activated then player_activate(s,false) end
 end
 bt.sel=nil
 return true
end

function player_aim(m,action)
 -- when the action lets the ship shoot afterwards, the preview also lists
 -- the enemies it could target from there (drawn as red lines)
 local base=ACTION_BASE[action] or action
 local shoots=base=="move" or base=="hold"
 local function aim(hover)
  return function(p)
   local pv=hover(p)
   if shoots and pv and not pv.off and pv.ok~=false then pv.targets=targets_from(m,pv,base) end
   return pv
  end
 end
 if action=="blink" then
  local r=await{
   prompt="Blink: click within 2\" of "..m.name..", or within 2\" of a connected friendly ship.",
   buttons={{"cancel","Cancel"}},cancel=true,
   hover=aim(function(p) return {ghost=m,x=p.x,y=p.y,h=m.h,ok=blink_ok(m,p),ring={x=m.x,y=m.y,r=m.r+2}} end),
   click=function(p) if blink_ok(m,p) then return blink_res(m,p) end end,
  }
  return r.click
 end
 if action=="stardrive" then
  local ok,r,n=morale_test(m)
  blog(m.name.." engages its star drive: "..morale_txt(r,n)..(ok and ", passed" or ", failed"),SIDE_COL[m.side])
  if not ok then return nil end
  local D=speed(m,"cruise")
  local function fine(p) return dist(m.x,m.y,p.x,p.y)<=D and place_ok(m,p.x,p.y) end
  local a=await{
   prompt="Star Drive: place "..m.name.." anywhere within "..D.."\" (same facing).",
   hover=function(p) return {ghost=m,x=p.x,y=p.y,h=m.h,ok=fine(p),ring={x=m.x,y=m.y,r=D}} end,
   click=function(p) if fine(p) then return blink_res(m,p) end end,
  }
  return a.click
 end
 if action=="drift" or action=="drift_cruise" then
  local D=speed(m,action=="drift" and "move" or "cruise")
  local r=await{
   prompt="Drift "..D.."\": click where to slide (sideways only); the ship turns to face the solar wind marker nearest the mouse.",
   buttons={{"cancel","Cancel"}},cancel=true,
   hover=aim(function(p) return plan_drift(m,D,p) end),
   click=function(p) return bt.preview end,
  }
  return r.click
 end
 if action=="side_move" or action=="side_cruise" then
  local r=await{
   prompt="Lightning Drive: move straight "..speed(m,base).."\", then sidestep up to 2\" toward the mouse.",
   buttons={{"cancel","Cancel"}},cancel=true,
   hover=aim(function(p) return plan_sidestep(m,base,p) end),
   click=function(p) return bt.preview end,
  }
  return r.click
 end
 if action=="hold" then
  if m.sq then return {pts={},h=m.h} end
  local r=await{
   prompt="Hold: click to pivot (any direction), or keep facing.",
   buttons={{"keep","Keep facing"},{"cancel","Cancel"}},cancel=true,
   hover=aim(function(p) return {pts={},x=m.x,y=m.y,h=ang(p.x-m.x,p.y-m.y)} end),
   click=function(p) return bt.preview end,
  }
  if r.button=="keep" then return {pts={},h=m.h} end
  return r.click
 end
 if action=="ram" then
  local ships=enemies_of(m,true)
  local cache={}
  local function ram_for(t)
   if cache[t]==nil then cache[t]=find_ram(m,t) or false end
   return cache[t]
  end
  local r=await{
   prompt=m.sq and "Burrow Within: click an enemy ship within "..speed(m,"ram").."\". The squadron is spent."
    or "Ram: click an enemy ship within "..speed(m,"ram").."\" (45 degree pivot).",
   buttons={{"cancel","Cancel"}},cancel=true,
   hover=function(p)
    local t=model_at(p,ships)
    if t then return ram_for(t) or {pts={},x=m.x,y=m.y,h=m.h,noram=t} end
   end,
   click=function(p)
    local t=model_at(p,ships)
    if t and ram_for(t) then return {res=ram_for(t),t=t} end
   end,
  }
  if r.click then return r.click.res,r.click.t end
  return nil
 end
 local r=await{
  prompt=(action=="move" and "Move" or "Cruise").." "..speed(m,action).."\": click where to go. Right-click cancels.",
  buttons={{"cancel","Cancel"}},cancel=true,
  hover=aim(function(p) return plan_to(m,action,p.x,p.y) end),
  click=function(p) return bt.preview end,
 }
 return r.click
end

function commit(m,action,res,tgt)
 local was_engaged=#engaged_list(m)>0
 m.cur_action=action
 m.lockdown=nil
 local start={x=m.x,y=m.y,h=m.h}
 if m.hull.rules.missile_ship and (action=="hold" or action=="move") then
  blog(m.name.." launches smart missiles",SIDE_COL[m.side])
  for i=1,2 do spawn_squadron(m.side,m.fac,"smart_missile",m,2-2*SQ_RADIUS) end
 end
 if m.hull.rules.striker and #engaged_list(m)==0 then m.striker_round=bt.round end
 local shoots=action=="hold" or action=="move"
 -- Maximum Lockdown: holding means no shooting, but damage saves until next activation
 if action=="hold" and has(m,"maximum_lockdown") then
  shoots=false
  m.lockdown=true
  blog(m.name.." locks down",SIDE_COL[m.side])
 end
 if action=="cruise" and m.title=="speed_freak" then m.speed_freak=true end
 if m.hull.rules.scram and was_engaged and action~="hold" then shoots=false end
 if res and res.blink and m.title=="hyperspace_hunter" and dist(start.x,start.y,res.x,res.y)>6 then
  m.hyper_round=bt.round
  blog(m.name.." strikes from hyperspace",SIDE_COL[m.side])
 end
 -- Rogue squadrons activating late may only move or shoot
 if m.hull.rules.rogue and bt.phase>1 and action~="hold" then shoots=false end
 -- Reflex: may shoot before moving
 local first=false
 if action=="move" and (m.title=="reflex" or m.hull.rules.battle_suit or has(m,"fade_drive")) then
  if m.side=="p" then
   first=choose_option("Reflex: shoot before or after moving?",{{true,"Shoot first"},{false,"Move first"}})
  else
   first=can_shoot_from(m,{x=m.x,y=m.y,h=m.h}) and not can_shoot_from(m,res)
  end
  if first then shoot_with(m) end
 end
 if m.state~="table" then return end
 if action=="hold" then
  m.h=res.h
  m.held=not m.sq
  blog(m.name.." holds position",SIDE_COL[m.side])
 else
  blog(m.name.." "..(action=="move" and "moves" or action=="cruise" and "cruises" or "rams")
   ..(res.halved and " (slowed by asteroids)" or ""),SIDE_COL[m.side])
  exec_move(m,res,action)
 end
 if action=="ram" and res.contact and m.state=="table" and tgt.state=="table" then
  resolve_ram(m,tgt)
  if m.state=="table" and has(m,"jump_scare_drive") then
   m.x,m.y,m.h=start.x,start.y,start.h
   blog(m.name.." jumps back to where it started (Jump Scare Drive)",SIDE_COL[m.side])
  end
 end
 if shoots and not first and m.state=="table" then shoot_with(m) end
 -- Lightning Oars may fire after a cruise
 if action=="cruise" and m.state=="table" then shoot_with(m,"oars") end
end

function shoot_with(m,only)
 if m.side=="p" then player_shoot(m,only) else ai_shoot(m,only) end
end

-- facings a replacement weapon could use on a battle model
function model_free_facings(m,upg,except)
 return free_facings(m.ups,upg,except,m.hull.caps)
end

-- turn upgrade 'up' into a fresh copy of upgrade definition 'upg'
function replace_upgrade(m,up,upg)
 local fresh=make_up(m.fac,upg.id,upg.weapon and model_free_facings(m,upg,up)[1] or nil)
 for k,v in pairs(fresh) do up[k]=v end
 up.dis=false
end

-- New Strain: what a disabled upgrade could evolve into
function evolve_options(m,old)
 local out={}
 for upg in all(m.fac.upgrades) do
  local fitted=false
  for up in all(m.ups) do if up.id==upg.id then fitted=true end end
  if not fitted and (not upg.weapon or #model_free_facings(m,upg,old)>0) then add(out,upg) end
 end
 return out
end

-- click one of a list on the table (nil if skipped)
-- Artificial Malevolence: a failed morale test brands the target
function malevolence(m,e)
 local ok,r,n=morale_test(e)
 blog(m.name.." whispers to "..e.name..": "..morale_txt(r,n)..(ok and ", resisted" or ", 2 beacon markers"),SIDE_COL[m.side])
 if not ok then e.beacons+=2 end
end

function pick_model(prompt,list)
 bt.highlight=list
 local r=await{prompt=prompt,buttons={{"skip","Skip"}},click=function(p) return model_at(p,list) end}
 bt.highlight=nil
 return r.click
end

function player_ability(m,b)
 if b=="pods" then
  local e=pick_model("Teleporter Pods: click an enemy ship within 6\" to board.",enemy_ships_within(m,6))
  if e then e.boarding+=1 blog(m.name.." teleports boarders onto "..e.name,12) end
 elseif b=="overcharge" then
  local d=d3()
  blog(m.name.." over-charges its thrusters ("..d.." damage, +9\" cruise)",12)
  m.overcharge=true
  deal(m,d)
 elseif b=="gravtrap" then
  local r=await{
   prompt="Grav-Trap: click within 6\" to place the trap (enemies within 4\" of it move at half speed).",
   buttons={{"skip","Skip"}},
   hover=function(p) return {mine=p,ok=dist(m.x,m.y,p.x,p.y)-m.r<=6,ring={x=m.x,y=m.y,r=m.r+6}} end,
   click=function(p) if dist(m.x,m.y,p.x,p.y)-m.r<=6 then return p end end,
  }
  if r.click then add(bt.traps,{x=r.click.x,y=r.click.y,side=m.side}) blog(m.name.." deploys a grav-trap",12) end
 elseif b=="tether" then
  local e=pick_model("Tether Emitter: click an enemy ship within 8\" to haul toward.",enemy_ships_within(m,8))
  if e then pull(m,e,d6()+1,m.name.." hauls itself toward "..e.name) end
 elseif b=="treachery" then
  local s=pick_model("Treachery Relay: click an enemy squadron within 6\" to control for one activation.",enemy_squadrons_within(m,6))
  if s then
   local old=s.side
   s.side=m.side
   blog(m.name.." hijacks "..s.name,12)
   player_activate(s,false)
   s.side=old
   s.activated=true
   bt.sel=m
  end
 elseif b=="hangar" then
  local list=friendly_squadrons_within(m,99)
  local src=pick_model("Hidden Hangar: click a friendly squadron to copy.",list)
  if src then
   for up in all(m.ups) do if up.id=="hidden_hangar" then up.dis,up.dmg=true,up.cap end end
   local s=spawn_squadron(m.side,m.fac,src.kind,m,2-2*SQ_RADIUS)
   if s then s.activated=false player_activate(s,false) s.activated=true end
   bt.sel=m
  end
 elseif b=="locktether" then
  local picked={}
  for i=1,2 do
   local list={}
   for s in all(squadrons_near(m,12)) do if not has_val(picked,s) then add(list,s) end end
   local s=#list>0 and pick_model("Lock Tether: click a squadron within 12\" ("..(3-i).." left), or skip.",list)
   if not s then break end
   add(picked,s)
  end
  if #picked>0 then
   local list={}
   for o in all(ships_within(m,12)) do add(list,o) end
   local dest=pick_model("Lock Tether: click the ship to drag them toward.",list)
   if dest then
    local d=d6()+1
    for s in all(picked) do drag(s,dest,d) end
    blog(m.name.." tethers "..#picked.." squadron(s) toward "..dest.name,12)
   end
  end
 elseif b=="sabotage" then
  local e=pick_model("Sabotage Cells: click an enemy objective carrier within 12\".",carriers_within(m,12))
  if e then blog(m.name.."'s saboteurs strike "..e.name,12) deal(e,1,"p") end
 elseif b=="handler" then
  local s=pick_model("Handler: click an enemy squadron within 12\" to take over for the rest of the game.",enemy_squadrons_within(m,12))
  if s then m.handled=true steal_squadron(m,s) end
 elseif b=="gshunt" then
  local e=pick_model("Gravity Shunt: click a ship within 8\"; "..m.name.." moves away from it.",ships_within(m,8))
  if e then push(m,ang(m.x-e.x,m.y-e.y),d6()+1) end
 elseif b=="frog" then
  local kind=choose_option("Divine Frog: which squadrons should hatch?",{{"piranha","2 Piranha"},{"jaguar","2 Jaguar"},{"serpent","2 Serpent"}})
  for i=1,2 do spawn_squadron(m.side,m.fac,kind,m,2-2*SQ_RADIUS) end
 elseif b=="shaman" then
  if zeal_test(m,"Spirit Shaman") then
   local s=pick_model("Spirit Shaman: click a friendly squadron within 2\" to activate now.",friendly_squadrons_within(m,2))
   if s then player_activate(s,false) bt.sel,bt.last_active=m,m end
  end
 elseif b=="claw" then
  local tur
  for s in all(model_shots(m)) do if s.turret then tur=copy_shot(s) end end
  if tur then
   tur.arc="all"
   local list={}
   for s in all(enemy_squadrons_within(m,2)) do add(list,s) end
   local t=pick_model("Defense Claw: click a squadron within 2\" for the turret.",list)
   if t then resolve_shot(m,tur,t) end
  end
 elseif b=="horizon" then
  if zeal_test(m,"Event Horizon") then
   for i=1,2 do
    local list=ships_within(m,12)
    local e=#list>0 and pick_model("Event Horizon: click a ship within 12\" to drag 6\" closer ("..(3-i).." left), or skip.",list)
    if not e then break end
    pull(e,m,6,m.name.."'s event horizon drags "..e.name)
   end
  end
 elseif b=="wrath" then
  if zeal_test(m,"Wrath Spines") then m.wrath_round=bt.round else m.wrath_fail_round=bt.round end
 elseif b=="malevolence" then
  local e=pick_model("Artificial Malevolence: click an enemy ship within 12\" to test its morale.",whisper_targets(m))
  if e then malevolence(m,e) end
 elseif b=="gpulse" then
  local e=pick_model("Gravity Pulse: click a ship within 8\" to push away.",ships_within(m,8))
  if e then push(e,ang(e.x-m.x,e.y-m.y),d6()+1) end
 elseif b=="comms" then
  local e=pick_model("Communications Master: click an enemy ship within 12\" for a targeting token.",whisper_targets(m))
  if e then e.targeting+=1 blog(m.name.." marks "..e.name.." with a targeting token",12) end
 elseif b=="coolant" then
  local e=pick_model("Coolant Tether: click a friendly ship within 4\" for a coolant token.",friendly_ships_within(m,4,true))
  if e then e.coolant+=1 blog(m.name.." tethers coolant to "..e.name,12) end
 elseif b=="shuttles" then
  local e=pick_model("Repair Shuttles: click another friendly ship within 12\" to repair 1 damage.",friendly_ships_within(m,12))
  if e then repair(e,1) blog(m.name.."'s shuttles repair "..e.name,12) end
 elseif b=="security" then
  local e=pick_model("Security Systems: click another friendly ship within 12\" to clear D3 boarding markers.",friendly_ships_within(m,12))
  if e then local n=d3() e.boarding=max(0,e.boarding-n) blog(m.name.."'s security teams clear "..n.." boarders from "..e.name,12) end
 elseif b=="telemetry" then
  local e=pick_model("Telemetry Banks: click another friendly ship within 12\" to pivot.",friendly_ships_within(m,12))
  if e then
   bt.sel=e
   local r=await{
    prompt="Telemetry Banks: click to pivot "..e.name.." (up to 45 degrees).",
    buttons={{"skip","Skip"}},
    hover=function(p) return {pts={},x=e.x,y=e.y,h=e.h+mid(-0.125,nturn(ang(p.x-e.x,p.y-e.y)-e.h),0.125)} end,
    click=function(p) return bt.preview end,
   }
   if r.click then e.h=r.click.h blog(e.name.." realigns (Telemetry Banks)",12) end
   bt.sel=m
  end
 elseif b=="unity" then
  local e=pick_model("Unity Channel: click another friendly ship within 12\" to move forward up to 4\".",friendly_ships_within(m,12))
  if e then
   bt.sel=e
   local r=await{
    prompt="Unity Channel: click how far forward to move "..e.name.." (up to 4\").",
    buttons={{"skip","Skip"}},
    hover=function(p)
     local d=mid(0,(p.x-e.x)*cos(e.h)+(p.y-e.y)*dsin(e.h),4)
     return simulate(e,{D=d,f=1,th=0})
    end,
    click=function(p) return bt.preview end,
   }
   if r.click then exec_move(e,r.click,"move") end
   bt.sel=m
  end
 elseif b=="splitter" then
  local e=pick_model("Space Splitter: click a ship within 8\" to swap places with.",ships_within(m,8))
  if e then
   m.x,m.y,e.x,e.y=e.x,e.y,m.x,m.y
   m.h,e.h=e.h,m.h
   blog(m.name.." swaps places with "..e.name.." (Space Splitter)",12)
  end
 elseif b=="convent" then
  m.convent=choose_option("Tech Convent: boost the turret until the end of this activation.",
   {{"att","+1 attack"},{"str","+1 strength"},{"twin","Twin-Fire"}})
 elseif b=="bindings" then
  m.boarding+=2
  m.bindings_round=bt.round
  blog(m.name.." loosens its bindings: +1 to hit, 2 boarding markers",12)
 elseif b=="consume" then
  local opts={}
  for i=1,scrap_pool(m) do add(opts,{i,"Burn "..i.." scrap: +"..i.."\""}) end
  local n=choose_option("Consumption Drive: burn scrap for extra movement this activation.",opts)
  spend_scrap(m,n)
  m.consume_bonus=n
  blog(m.name.." burns "..n.." scrap for speed",12)
 elseif b=="maglock" then
  local picked={}
  for i=1,3 do
   local list={}
   for s in all(maglock_targets(m)) do if not has_val(picked,s) then add(list,s) end end
   if #list==0 then break end
   local s=pick_model("Mag-Lock Array: click a squadron within 12\" to pull ("..(4-i).." left), or skip.",list)
   if not s then break end
   add(picked,s)
  end
  if #picked>0 then
   local d=d6()+1
   blog(m.name.."'s mag-lock pulls "..#picked.." squadron(s) "..d.."\"",12)
   for s in all(picked) do drag(s,m,d) end
  end
 elseif b=="whisper" then
  local e=pick_model("Violent Whisper: click an enemy ship within 12\" to roll for its boarding markers.",whisper_targets(m))
  if e then
   blog(m.name.."'s violent whisper torments "..e.name,12)
   boarding_rolls(e)
  end
 elseif b=="wormhole" then
  local e=pick_model("Wormhole Door: click an enemy ship within 12\" to receive a boarding marker.",whisper_targets(m))
  if e then
   e.boarding+=1
   blog(m.name.." opens a wormhole onto "..e.name,12)
  end
 elseif b=="digital" then
  local e=pick_model("Digital Master: click an enemy ship within 18\" with 2+ laser markers.",digital_targets(m))
  if not e then return end
  e.lasers-=2
  local opts={}
  for s in all(model_shots(e)) do
   if #puppet_targets(e,s)>0 then add(opts,{s,s.name.." ("..weapon_stats(s)..")"}) end
  end
  if #opts==0 then blog(e.name.." has nothing to shoot at",5) return end
  local shot=choose_option("Digital Master: which of "..e.name.."'s weapons fires?",opts)
  local t=pick_model("Digital Master: click the target for "..e.name.."'s "..shot.name..".",puppet_targets(e,shot))
  if t then
   blog(m.name.." hijacks "..e.name.."'s fire control!",12)
   resolve_shot(e,shot,t)
  end
  bt.sel=m
 elseif b=="strike" then
  if not zeal_test(m,"Strike Leader") then return end
  local moved={}
  for i=1,3 do
   local list={}
   for s in all(strike_squadrons(m)) do if not has_val(moved,s) then add(list,s) end end
   if #list==0 then break end
   local s=pick_model("Strike Leader: click a squadron to move ("..(4-i).." left), or skip.",list)
   if not s then break end
   add(moved,s)
   bt.sel=s
   local r=await{
    prompt="Strike Leader: move "..s.name.." up to "..speed(s,"move").."\".",
    buttons={{"cancel","Don't move"}},cancel=true,
    hover=function(p) return plan_to(s,"move",p.x,p.y) end,
    click=function(p) return bt.preview end,
   }
   if r.click then exec_move(s,r.click,"move") end
  end
  bt.sel=m
 elseif b=="evac" then
  evacuation_pulse(m)
 elseif b=="teleport" then
  local e=pick_model("Precision Teleporter: click an enemy ship within 12\" with laser markers.",teleport_targets(m))
  if e then teleport_lasers(m,e) end
 elseif b=="engineers" then
  if zeal_test(m,"Fanatic Engineers") then m.engineers_round=bt.round end
 elseif b=="gunners" then
  if zeal_test(m,"Fanatic Gunners") then m.gunners_round=bt.round end
 elseif b=="grief" then
  if zeal_test(m,"Orders of Grief") then repair(m,2) end
 elseif b=="unchained" then
  if zeal_test(m,"Unchained") then m.unchained_round=bt.round end
 elseif b=="adapt" then
  local up=choose_upgrade(m,adapt_weapons(m),"Infinite Adaptation: choose a weapon to move.")
  local opts={}
  for fc in all(model_free_facings(m,up.upg,up)) do
   if fc~=up.facing then add(opts,{fc,"Move to "..fc}) end
  end
  up.facing=choose_option("Move "..up.upg.name.." from "..up.facing.." to:",opts)
  blog(m.name.." adapts: "..up.upg.name.." now faces "..up.facing,12)
 elseif b=="brood" then
  spawn_broodlings(m)
 elseif b=="nerve" then
  local list=nerve_targets(m)
  bt.highlight=list
  local r=await{
   prompt="Nerve Cluster: click a friendly squadron within 6\" to activate it now.",
   buttons={{"skip","Skip"}},
   click=function(p) return model_at(p,list) end,
  }
  bt.highlight=nil
  if r.click then
   player_activate(r.click,false)
   bt.sel,bt.last_active=m,m
  end
 elseif b=="nutrient" then
  local list=nutrient_targets(m)
  bt.highlight=list
  local r=await{
   prompt="Nutrient Repo: click a friendly squadron within 2\" to consume.",
   buttons={{"skip","Skip"}},
   click=function(p) return model_at(p,list) end,
  }
  bt.highlight=nil
  if r.click then
   destroy(r.click,"consumed")
   repair(m,1)
   blog(m.name.." feeds and repairs 1 damage",12)
  end
 elseif b=="spores" then
  local function ok(p) return dist(m.x,m.y,p.x,p.y)<=m.r+2 end
  local r=await{
   prompt="Spore Vents: take 1 damage to place a spore marker within 2\" (cover within 2\" of it), or skip.",
   buttons={{"skip","Skip"}},
   hover=function(p) return {mine=p,ok=ok(p),ring={x=m.x,y=m.y,r=m.r+2}} end,
   click=function(p) if ok(p) then return p end end,
  }
  if r.click then
   add(bt.spores,{x=r.click.x,y=r.click.y})
   blog(m.name.." vents spores",12)
   deal(m,1)
  end
 elseif b=="evolve" then
  local old=choose_upgrade(m,disabled_ups(m),"New Strain: choose a disabled upgrade to evolve.")
  local opts={}
  for upg in all(evolve_options(m,old)) do add(opts,{upg,upg.name..(upg.weapon and " ("..weapon_stats(upg)..")" or "")}) end
  if #opts==0 then return end
  local upg=choose_option("Evolve "..old.upg.name.." into:",opts)
  m.evolution-=1
  blog(m.name.."'s "..old.upg.name.." evolves into "..upg.name.."!",12)
  replace_upgrade(m,old,upg)
 elseif b=="pustule" then
  local old=choose_upgrade(m,disabled_ups(m),"Proliferation Pustule: choose a disabled upgrade to replace.")
  blog(m.name.."'s "..old.upg.name.." becomes a proliferation pustule",12)
  replace_upgrade(m,old,by_id(m.fac.upgrades,"proliferation_pustule"))
 elseif b=="avenger" then
  local d=d3()+1
  blog(m.name.." (Avenger) may jump up to "..d.."\"",12)
  local r=await{
   prompt="Avenger: click to place "..m.name.." within "..d.."\", or skip.",
   buttons={{"skip","Skip"}},
   hover=function(p)
    local ok=dist(m.x,m.y,p.x,p.y)<=d and place_ok(m,p.x,p.y)
    return {ghost=m,x=p.x,y=p.y,h=m.h,ok=ok,ring={x=m.x,y=m.y,r=d}}
   end,
   click=function(p) if dist(m.x,m.y,p.x,p.y)<=d and place_ok(m,p.x,p.y) then return p end end,
  }
  if r.click then m.x,m.y=r.click.x,r.click.y m.held=false end
 elseif b=="sapper" then
  local r=await{
   prompt="Lay a mine within 4\" of "..m.name..", or skip.",
   buttons={{"skip","Skip"}},
   hover=function(p) return {mine=p,ok=mdist(m,{x=p.x,y=p.y,r=0})<=4,ring={x=m.x,y=m.y,r=4+m.r}} end,
   click=function(p) if mdist(m,{x=p.x,y=p.y,r=0})<=4 then return p end end,
  }
  if r.click then add(bt.mines,{x=r.click.x,y=r.click.y,side="p"}) blog(m.name.." lays a mine",12) end
 elseif b=="repair" then
  local list=repair_targets(m)
  bt.highlight=list
  local r=await{
   prompt="Repair Bay: click a damaged friendly ship within 4\".",
   buttons={{"skip","Skip"}},
   click=function(p) return model_at(p,list) end,
  }
  bt.highlight=nil
  if r.click then repair(r.click,1) blog(m.name.." repairs "..r.click.name,12) end
 elseif b=="tractor" then
  local list=tractor_targets(m)
  bt.highlight=list
  local r=await{
   prompt="Tractor Beam: click an enemy ship within 8\".",
   buttons={{"skip","Skip"}},
   click=function(p) return model_at(p,list) end,
  }
  bt.highlight=nil
  if r.click then pull(r.click,m,d6()+1) end
 elseif b=="launch" then
  m.launched=true
  bt.launched={}
  for s in all(m.embarked) do
   local r=await{
    prompt="Place "..s.name.." within 2\" of "..m.name..".",
    hover=function(p)
     local ok=dist(m.x,m.y,p.x,p.y)-m.r-s.r<=2 and place_ok(s,p.x,p.y)
     return {ghost=s,x=p.x,y=p.y,h=m.h,ok=ok,ring={x=m.x,y=m.y,r=m.r+2+s.r}}
    end,
    click=function(p) if dist(m.x,m.y,p.x,p.y)-m.r-s.r<=2 and place_ok(s,p.x,p.y) then return p end end,
   }
   s.x,s.y,s.h=r.click.x,r.click.y,m.h
   s.state="table"
   add(bt.launched,s)
  end
  m.embarked={}
  blog(m.name.." launches its squadrons!",12)
 end
end

function player_shoot(m,only)
 for shot in all(model_shots(m)) do
  if m.state~="table" then return end
  local list=(only and not shot[only]) and {} or shot_targets(m,shot)
  local sqs=multi_targets(shot,list)
  if #sqs>0 then
   -- Proximity Guns / Ring of Fire: fire once at every target in range
   blog(m.name.."'s "..shot.name.." fires at everything in range",12)
   for t in all(sqs) do
    if m.state=="table" and t.state=="table" then resolve_shot(m,shot,t) wait(8) end
   end
  elseif #list>0 then
   if shot.turret and has(m,"flexible_payload") then
    shot.flex=choose_option("Flexible Payload: fire the turret with +1 strength and -1 to hit?",
     {{false,"Normal shot"},{true,"Flexible: +1 Str, -1 to hit"}}) or nil
   end
   bt.highlight=list
   local r=await{
    prompt="Fire "..shot.name.." ("..weapon_stats(shot)..", "..arc_name(shot.arc).."): click a target.",
    buttons={{"skip","Skip weapon"},{"done","Stop shooting"}},
    hover=function(p)
     local t=model_at(p,list)
     if t then return {aim=t,hit=hit_need(m,shot,t),block=block_need(m,shot,t),from=m} end
    end,
    click=function(p) return model_at(p,list) end,
   }
   bt.highlight=nil
   if r.button=="done" then return end
   if r.click then
    resolve_shot(m,shot,r.click)
    wait(12)
    barrage(m,shot)
   end
  end
 end
end
:: src/battle_rules.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
TABLE_W,TABLE_H=72,48
S,TX,TY=4.5,4,14 -- pixels per inch, table origin on screen
PX=TX+TABLE_W*S+4 -- side panel

-- deployment styles. sd(x,y) is the signed distance in inches from zone A
-- (<=0 inside); zone B is zone A turned 180 degrees about the table centre.
-- a and b say where each zone is, for the battle log.
local CX,CY=TABLE_W/2,TABLE_H/2
local DIAG=sqrt(TABLE_W*TABLE_W+TABLE_H*TABLE_H)
local RHOMB=sqrt(CX*CX+CY*CY)
DEPLOY_STYLES={
 {name="Front Line",desc="12\" deep zones on the long edges",a="top edge",b="bottom edge",
  sd=function(x,y) return y-12 end},
 {name="Long Haul",desc="24\" deep zones on the short edges",a="left edge",b="right edge",
  sd=function(x,y) return x-24 end},
 -- zones lie over 12" either side of the table diagonal
 {name="Side Battle",desc="Corners, split by a 24\" diagonal",a="bottom-left corner",b="top-right corner",
  sd=function(x,y) return (TABLE_H*x-TABLE_W*y)/DIAG+12 end},
 -- outside the diamond joining the edge midpoints; A is the top half
 {name="Encircled",desc="Corner triangles around a diamond",a="top corners",b="bottom corners",
  sd=function(x,y) return max((CX*CY-CY*abs(x-CX)-CX*abs(y-CY))/RHOMB,y-CY) end},
 -- triangle on the left edge with its tip 24" in, at the centre line
 {name="Spearhead",desc="Edge triangles, tips 24\" apart",a="left edge",b="right edge",
  sd=function(x,y) return (x+abs(y-CY)-24)/sqrt(2) end},
 {name="Flank Assault",desc="24\" squares in opposite corners",a="top-left corner",b="bottom-right corner",
  sd=function(x,y) return max(x-24,y-24) end},
}

-- signed distance from zone "a" or "b" of a deployment style
function style_sd(st,zone,x,y)
 if zone=="a" then return st.sd(x,y) end
 return st.sd(TABLE_W-x,TABLE_H-y)
end
PHASE_NAMES={"Squadrons","Light Ships","Medium Ships","Heavy Ships"}
PHASE_ONE={"squadron","light ship","medium ship","heavy ship"}
CLASS_PHASE={Squadron=1,Light=2,Medium=3,Heavy=4}
CLASS_RADIUS={Heavy=1.6,Medium=1.3,Light=1.0}
SQ_RADIUS=0.6
PIVOT={hold=0.5,move=0.25,cruise=0.125,ram=0.125}
SIDE_COL={p=12,ai=8}
SIDE_DIM={p=13,ai=2}

-- picotron's sin/atan2 may be y-inverted like pico-8; normalise so that
-- angle a (in turns) points along (cos a, dsin a) in screen space (y down)
SIN_S=sin(0.25)>0 and 1 or -1
ATAN_S=abs(atan2(0,1)-0.25)<0.01 and 1 or -1
function dsin(a) return SIN_S*sin(a) end
function ang(dx,dy) return atan2(dx,ATAN_S*dy) end
function nturn(a) return (a+0.5)%1-0.5 end

CO_CREATE=cocreate or coroutine.create
CO_RESUME=coresume or coroutine.resume
CO_STATUS=costatus or coroutine.status
YIELD=yield or coroutine.yield

function dist(ax,ay,bx,by) local dx,dy=bx-ax,by-ay return sqrt(dx*dx+dy*dy) end
function mdist(a,b) return dist(a.x,a.y,b.x,b.y)-a.r-b.r end -- base to base
function d6() return flr(rnd(6))+1 end
function d3() return flr(rnd(3))+1 end

-- roll n dice that each pass on need+ (a number, or a table of per-die needs)
-- and show them in the dice popup. returns the rolls in order. what is the
-- goal shown after the target ("to hit", "to block"...).
function roll_dice(n,need,title,what)
 local rolls={}
 for i=1,n do add(rolls,d6()) end
 show_dice(rolls,need,title,what)
 return rolls
end

DICE_STOP=0.5 -- seconds between each die settling

-- blocks the battle coroutine until the dice popup is confirmed (see
-- bt_input). outside the coroutine (no way to wait) it does nothing.
function show_dice(rolls,need,title,what)
 if #rolls==0 or not bt.co or coroutine.running()~=bt.co then return end
 rec_check()
 local d={rolls=rolls,need=need,title=title,what=what,t0=time()}
 bt.dice=d
 while not d.done do YIELD() end
 bt.dice=nil
end

function dice_settled(d) return time()>=d.t0+#d.rolls*DICE_STOP end

function dice_need(need,i) return type(need)=="table" and need[i] or need end
function pick(t) return t[flr(rnd(#t))+1] end
function other(side) return side=="p" and "ai" or "p" end
function has_val(t,v) for e in all(t) do if e==v then return true end end return false end

function shuffle(t)
 for i=#t,2,-1 do
  local j=flr(rnd(i))+1
  t[i],t[j]=t[j],t[i]
 end
 return t
end

function seg_dist(px_,py_,ax,ay,bx,by)
 local dx,dy=bx-ax,by-ay
 local l2=dx*dx+dy*dy
 local t=l2>0 and mid(0,((px_-ax)*dx+(py_-ay)*dy)/l2,1) or 0
 return dist(px_,py_,ax+dx*t,ay+dy*t)
end

function blog(s,col)
 add(bt.logs,{s=s,c=col or 6})
 if bt.rec_log then add(bt.rec_log,{s=s,c=col or 6}) end
 if #bt.logs>60 then deli(bt.logs,1) end
end

function wait(n)
 rec_check()
 for i=1,n do YIELD() end
end

-- models

function make_model(u,side,fac)
 local h=hull_of(fac,u.kind)
 local m={
  side=side,fac=fac,kind=u.kind,hull=h,sq=h.ups==0,name=h.name,
  r=h.ups==0 and SQ_RADIUS or CLASS_RADIUS[h.class],
  x=0,y=0,h=0,ups={},hero=u.hero,title=u.title,
  dmg=0,markers=0,boarding=0,lasers=0,beacons=0,scrap=0,targeting=0,coolant=0,embarked={},
  evolution=u.hero=="new_strain" and 1 or 0,
  state="pending",phase=CLASS_PHASE[h.class],
 }
 for up in all(u.ups) do add(m.ups,make_up(fac,up.id,up.facing)) end
 if h.rules.hardened then
  for up in all(m.ups) do if not up.upg.weapon then up.cap+=1 end end
 end
 return m
end

function make_up(fac,id,facing)
 return {id=id,upg=by_id(fac.upgrades,id),facing=facing,dmg=0,
  cap=id=="armored_plating" and 4 or (id=="razor_shield" or id=="regenerative_skin" or id=="crumple_hulls") and 3 or 2}
end

-- new squadron mid-battle (Lineage Author, Sprouting)
function spawn_squadron(side,fac,kind,near,rng)
 local m=make_model(new_unit(kind),side,fac)
 bt.spawned=(bt.spawned or 0)+1
 m.name=(side=="ai" and "AI " or "")..m.name.." #"..bt.spawned
 for i=1,40 do
  local a,d=rnd(),near.r+m.r+rnd(rng)
  local x,y=near.x+cos(a)*d,near.y+dsin(a)*d
  if place_ok(m,x,y) then
   m.x,m.y,m.h,m.state=x,y,a,"table"
   m.activated=true
   m.ai_type=ai_type(m)
   add(bt.models,m)
   blog(m.name.." appears!",side=="p" and 12 or 8)
   return m
  end
 end
end

-- Mother Ship: 2 broodlings fully within 2"
function spawn_broodlings(m)
 blog(m.name.." spawns broodlings",m.side=="p" and 12 or 8)
 for i=1,2 do spawn_squadron(m.side,m.fac,"broodling",m,2-2*SQ_RADIUS) end
end

-- at the end of an activation, Pheromone Glands pull friendly squadrons in
function pheromone_pull(m)
 if m.state~="table" or not has(m,"pheromone_glands") then return end
 local list={}
 for s in all(on_table(m.side)) do
  if s.sq and mdist(s,m)<=12 and mdist(s,m)>0.5 then add(list,s) end
 end
 if #list==0 then return end
 if m.side=="p" and not choose_option("Pheromone Glands: pull "..#list.." squadron(s) toward "..m.name.."?",
  {{true,"Yes"},{false,"No"}}) then return end
 blog(m.name.."'s pheromones call its squadrons",m.side=="p" and 12 or 8)
 for s in all(list) do
  if s.state=="table" and #engaged_list(s)==0 then
   local d=max(0,min(speed(s,"move"),mdist(s,m)-0.3))
   local a=ang(m.x-s.x,m.y-s.y)
   exec_move(s,simulate(s,{D=d,a=a,spd=speed(s,"move")}),"move")
  end
 end
end

function has(m,id)
 for up in all(m.ups) do if up.id==id and not up.dis then return true end end
 return false
end

function working_ups(m)
 local n=0
 for up in all(m.ups) do if not up.dis then n+=1 end end
 return n
end

function speed(m,action)
 local h=m.hull
 local mv,cr=h.mv,h.cr
 if has(m,"pulse_engine") then mv+=2 cr+=3 end
 if m.title=="sacrificial_skin" and has_disabled(m) then mv+=2 cr+=3 end
 if m.engineers_round==bt.round then mv+=4 cr+=6 end -- Fanatic Engineers
 if m.rush_round==bt.round then mv+=4 cr+=6 end -- Rift Rush
 if has(m,"perfection_drive") and not is_damaged(m) then mv+=4 cr+=6 end
 if m.consume_bonus then mv+=m.consume_bonus cr+=m.consume_bonus end -- Consumption Drive
 if has(m,"refit_reactor") then mv+=4 cr+=6 end
 if m.overcharge then cr+=9 end -- Over-Charged Thrusters
 if m.sq then
  for o in all(on_table(m.side)) do
   if has(o,"fuel_dispensers") and mdist(o,m)<=4 then mv+=2 cr+=3 break end
  end
 end
 return action=="move" and mv or cr
end

function has_disabled(m)
 for up in all(m.ups) do if up.dis then return true end end
 return false
end

function on_table(side)
 local out={}
 for m in all(bt.models) do
  if m.state=="table" and (not side or m.side==side) then add(out,m) end
 end
 return out
end

function enemies_of(m,ships_only)
 local out={}
 for o in all(on_table(other(m.side))) do
  if not ships_only or not o.sq then add(out,o) end
 end
 return out
end

function engaged_list(m)
 local out={}
 if not m.sq then return out end
 for o in all(enemies_of(m)) do
  local reach=(o.hull.rules.defender or m.hull.rules.defender) and 4 or 2
  if o.sq and mdist(m,o)<=reach then add(out,o) end
 end
 return out
end

function model_at(p,list)
 local best,bd
 for m in all(list) do
  local d=dist(p.x,p.y,m.x,m.y)
  if d<=m.r+0.8 and (not bd or d<bd) then best,bd=m,d end
 end
 return best
end

function eligible(side,phase)
 local out={}
 for m in all(bt.models) do
  local early=m.title=="predatory_instinct" or has(m,"phase_components")
  local ok=m.phase==phase or (early and m.phase==phase+1)
  if m.hull.rules.rogue and m.rogue_round==bt.round then ok=phase>1 end
  if m.side==side and m.state=="table" and not m.activated and ok then add(out,m) end
 end
 return out
end

function side_markers(side)
 local n=0
 for m in all(bt.models) do
  if m.side==side and m.state~="dead" then n+=m.markers end
 end
 return n
end

function in_play(side,ships_only)
 local n=0
 for m in all(bt.models) do
  if m.side==side and m.state~="dead" and m.state~="pending" and m.state~="outbreak"
   and (not ships_only or not m.sq) then n+=1 end
 end
 return n
end

-- arcs: front/rear are 90 degree arcs, the sides fill the rest

function in_arc(m,arc,x,y)
 if arc=="all" then return true end
 if arc=="notfront" then return not in_arc(m,"front",x,y) end
 local rel=nturn(ang(x-m.x,y-m.y)-m.h)
 local a=abs(rel)
 if arc=="front" then return a<=0.125 end
 if arc=="rear" then return a>=0.375 end
 local side=a>0.125 and a<0.375
 if arc=="sides" then return side end
 if arc=="left" then return side and rel<0 end
 return side and rel>0
end

function los(ax,ay,bx,by)
 for t in all(bt.terrain) do
  if t.kind=="planetoid" and seg_dist(t.x,t.y,ax,ay,bx,by)<t.r then return false end
 end
 return true
end

function in_cover(t,attacker)
 for tr in all(bt.terrain) do
  if tr.kind=="nebula" and dist(t.x,t.y,tr.x,tr.y)<tr.r then return true end
 end
 for sp in all(bt.spores) do
  if dist(t.x,t.y,sp.x,sp.y)-t.r<=2 then return true end
 end
 return has(t,"stealth_rig") and mdist(t,attacker)>12
end

-- D6 + working upgrades, 6+ passes (also used by Psy-Aria and Swarmer)
function morale_test(m)
 if lord_of_glory_near(m) then return true,"Lord of Glory",0 end
 if m.title=="code_of_honour" then return true,"Code of Honour",0 end
 local n=vassal_ups(m,working_ups(m))
 if not m.sq then n+=throne_mod(m)+kingly_mod(m) end
 if m.hull.rules.mania then n+=1 end -- Mania: +1 to morale tests
 -- shown as the die alone needing 6-n
 local r=roll_dice(1,max(1,6-n),m.name.." morale test (+"..n..")","to pass")[1]
 return r+n>=6,r,n
end

function morale_txt(r,n)
 return type(r)=="string" and r or "rolls "..r.."+"..n
end

-- Lord of Glory: it and friendly ships within 24" auto-pass morale tests
function lord_of_glory_near(m)
 if m.sq then return false end
 for o in all(on_table(m.side)) do
  if o.hero=="lord_of_glory" and (o==m or mdist(o,m)<=24) then return true end
 end
 return false
end

-- friendly squadrons within 2" of a target (Finisher)
function finisher_bonus(m,t)
 local n=0
 for o in all(on_table(m.side)) do
  if o.sq and o~=m and mdist(o,t)<=2 then n+=1 end
 end
 return n
end

-- friendly squadron a Juice Rifle can consume, cheapest first
function juice_feed(m)
 local best
 for o in all(on_table(m.side)) do
  if o.sq and mdist(o,m)<=2 and (not best or o.hull.pts<best.hull.pts) then best=o end
 end
 return best
end

-- Shielder squadrons near a model that could take hits for it
function shielders_for(o)
 local out={}
 if not o.sq and o.title~="symbiosis" then return out end
 for s in all(on_table(o.side)) do
  if s~=o and s.hull.rules.shielder and mdist(s,o)<=2 then add(out,s) end
 end
 return out
end

function terrain_at(x,y,kind)
 for t in all(bt.terrain) do
  if t.kind==kind and dist(x,y,t.x,t.y)<t.r then return t end
 end
end

-- weapons

function copy_shot(s)
 local c={}
 for k,v in pairs(s) do c[k]=v end
 return c
end

-- copy rules flags (anti_ship, deadly, ...) onto a shot. a flag must never
-- share a name with one of the shot's own fields.
SHOT_FIELDS={name=true,rng=true,att=true,str=true,arc=true,turret=true,target=true}
function apply_rules(s,rules)
 for k,v in pairs(rules) do
  assert(not SHOT_FIELDS[k],"rules flag '"..k.."' clashes with a shot field")
  s[k]=v
 end
 return s
end

-- every shot a model can take this activation: the turret plus each
-- working weapon (broadside = one shot per side, twin-fire = two shots)
function model_shots(m)
 local h=m.hull
 local shots={}
 local att=h.att
 for up in all(m.ups) do
  if up.id=="revenge_creche" and up.dis then att+=1 end
 end
 if h.rules.spite and has_disabled(m) then att*=2 end
 if m.gunners_round==bt.round then att+=1 end -- Fanatic Gunners
 if h.rng>0 and att>0 then
  local str=h.str+(has(m,"nuclear_ammo") and 1 or 0)
  if m.striker_round==bt.round then str+=1 end -- Striker
  local tur={name="Turret",rng=h.rng,att=att,str=str,turret=true,arc="all"}
  apply_rules(tur,h.rules)
  if has(m,"support_refit") then tur.spotting=true end
  if has(m,"hunting_refit") then tur.beacon=true end
  if m.electro_round==bt.round then tur.str+=1 end -- Electro Cultist
  if m.convent=="att" then tur.att+=1 elseif m.convent=="str" then tur.str+=1 elseif m.convent=="twin" then tur.twin=true end
  tur.owner=m
  if m.turret_rule then tur[m.turret_rule]=true end -- Specialised title
  if m.wrath_round==bt.round then tur.att+=2 end -- Wrath Spines
  if m.hyper_round==bt.round then tur.hyper=true end -- Hyperspace Hunter
  if m.hero=="peoples_hammer" then tur.att+=losses(m.side) end
  if has(m,"grand_spine") then tur.twin=true tur.arc="sides" end
  if h.rules.shell_prow then tur.arc=tur.arc=="sides" and "sides" or "notfront" end
  if m.wrath_fail_round~=bt.round then
   add(shots,tur)
   if tur.twin then
    local t2=copy_shot(tur)
    t2.twin_of=tur
    add(shots,t2)
   end
  end
 end
 for up in all(m.ups) do
  local w=up.upg
  if w.weapon and not up.dis then
   local rules=w.rules
   if h.rules.line and (rules.broadside or rules.twin) then
    -- Line Vessel: broadsides get twin-fire and twin-fire gets broadside
    rules={} for k,v in pairs(w.rules) do rules[k]=v end
    rules.broadside,rules.twin=true,true
   end
   local all_arcs=rules.ring or rules.threat or rules.soul or rules.wound
   local base=apply_rules({name=w.name,rng=w.rng,att=w.att,str=w.str,arc=all_arcs and "all" or up.facing},rules)
   base.owner,base.up,base.facing=m,up,up.facing
   if up.facing=="front" then
    if h.rules.grand_battleship then base.rng+=6 base.str+=1 end
    if h.rules.artillery then base.rng+=6 end
    if h.rules.siege then base.deadly=true end
   end
   -- Obliteration Master / Beam Latice: may fire outside the mounted facing
   if not all_arcs and (m.hero=="obliteration_master" or rules.latice) then
    base.mounted=base.arc
    base.arc="all"
   end
   local arcs={base}
   if rules.broadside and not base.mounted then
    local l,r=copy_shot(base),copy_shot(base)
    l.arc,r.arc="left","right"
    arcs={l,r}
   end
   for s in all(arcs) do
    add(shots,s)
    if rules.quad then
     local group={}
     s.group=group
     for q=2,4 do local sq=copy_shot(s) sq.group=group add(shots,sq) end
    end
    if rules.twin then
     local s2=copy_shot(s)
     s2.twin_of=s
     add(shots,s2)
    end
   end
  end
 end
 return shots
end

-- Digital Master: enemy ships within 18" with 2+ laser markers
function digital_targets(m)
 local out={}
 for o in all(enemies_of(m,true)) do
  if mdist(m,o)<=18 and o.lasers>=2 then add(out,o) end
 end
 return out
end

-- anything a hijacked ship could shoot at with this weapon (either side)
function puppet_targets(e,shot)
 local out={}
 for t in all(on_table()) do
  if t~=e and mdist(e,t)<=shot.rng and in_arc(e,shot.arc,t.x,t.y) and sees(e,shot,t)
   and not (shot.boarding and t.sq) and shot_att(shot,t)>0 then add(out,t) end
 end
 return out
end

function teleport_targets(m)
 local out={}
 for o in all(enemies_of(m,true)) do
  if mdist(m,o)<=12 and o.lasers>0 then add(out,o) end
 end
 return out
end

function strike_squadrons(m)
 local out={}
 for s in all(on_table(m.side)) do
  if s.sq and mdist(s,m)<=12 then add(out,s) end
 end
 return out
end

-- Evacuation Pulse: push every other ship within 8" away by D3+1"
function evacuation_pulse(m)
 local d=d3()+1
 blog(m.name.." fires an evacuation pulse ("..d.."\")",SIDE_COL[m.side])
 for o in all(on_table()) do
  if o~=m and not o.sq and mdist(m,o)<=8 and o.state=="table" then
   push(o,ang(o.x-m.x,o.y-m.y),d)
  end
 end
end

function teleport_lasers(m,e)
 blog(m.name.." teleports boarders onto "..e.name.." ("..e.lasers.." laser -> boarding)",SIDE_COL[m.side])
 e.boarding+=e.lasers
 e.lasers=0
end

-- points of damage a model can still take before it is destroyed
-- damage a squadron can take (Heavy: 3)
function sq_hp(m) return (m.hull.rules.heavy or m.hull.rules.wraith_frame) and 3 or 2 end

function hp_left(m)
 if m.sq then return max(0,sq_hp(m)-m.dmg) end
 local n=0
 for up in all(m.ups) do if not up.dis then n+=up.cap-up.dmg end end
 return n
end

-- Raid Master: boarding markers from a destroyed ship jump to another
-- enemy ship within 12" of it
function raid_master(dead,side)
 local master
 for o in all(on_table(side)) do
  if o.hull.rules.raid_master and mdist(o,dead)<=12 then master=o end
 end
 if not master then return end
 local list={}
 for o in all(on_table(dead.side)) do
  if not o.sq and mdist(o,dead)<=12 then add(list,o) end
 end
 if #list==0 then return end
 local t
 if side=="p" then
  t=pick_model("Raid Master: click an enemy ship within 12\" to receive "..dead.boarding.." boarding marker(s), or skip.",list)
 else
  t=nearest(dead.x,dead.y,list)
 end
 if t then
  t.boarding+=dead.boarding
  blog("  "..master.name.." sends the boarders on to "..t.name.." (Raid Master)",SIDE_COL[side])
 end
end

-- Raiding Barge: at the end of its activation, board a ship within 2"
function raiding_barge(m)
 if m.state~="table" or not m.hull.rules.raiding_barge then return end
 local list={}
 for o in all(enemies_of(m,true)) do if mdist(o,m)<=2 then add(list,o) end end
 if #list==0 then return end
 local t=m.side=="p" and pick_model("Raiding Barge: click an enemy ship within 2\" to board, or skip.",list) or list[1]
 if t then
  t.boarding+=1
  blog(m.name.." boards "..t.name.." (Raiding Barge)",SIDE_COL[m.side])
 end
end

function whisper_targets(m)
 local out={}
 for o in all(enemies_of(m,true)) do if mdist(o,m)<=12 then add(out,o) end end
 return out
end

-- Ex-Nihilo: behind an enemy ship (rear facing, within 6") and not in
-- the front facing of any other enemy ship
function ex_nihilo_ok(m,x,y)
 if not place_ok(m,x,y) then return false end
 local behind=false
 for e in all(enemies_of(m,true)) do
  local d=dist(x,y,e.x,e.y)-m.r-e.r
  if d<=6 and in_arc(e,"rear",x,y) then behind=true
  elseif in_arc(e,"front",x,y) then return false end
 end
 return behind
end

function ai_ex_nihilo(m)
 for e in all(shuffle(enemies_of(m,true))) do
  for i=1,24 do
   local a=e.h+0.5+(rnd()-0.5)*0.24
   local d=e.r+m.r+0.5+rnd(5)
   local x,y=e.x+cos(a)*d,e.y+dsin(a)*d
   if ex_nihilo_ok(m,x,y) then
    m.x,m.y,m.h=x,y,ang(e.x-x,e.y-y)
    m.state="table"
    blog(m.name.." appears from nowhere behind "..e.name.."! (Ex-Nihilo)",8)
    return
   end
  end
 end
end

-- weapons that fire once at every target in range
function multi_targets(shot,list)
 if shot.ring or shot.threat or shot.soul or shot.wound or shot.arc_missiles then return list end
 if shot.proximity then return squadrons_in(list) end
 return {}
end

-- Blazing: 1 damage at the end of each round
function blaze_tick()
 bt.attacker=nil
 for m in all(on_table()) do
  if m.blazing then
   blog(m.name.." burns (blazing)",9)
   deal(m,1)
  end
 end
end

-- abilities that take a morale test on activation
function zeal_test(m,what)
 local ok,r,n=morale_test(m)
 blog(m.name.." "..what..": "..morale_txt(r,n)..(ok and ", passed" or ", failed"),ok and SIDE_COL[m.side] or 5)
 return ok
end

function squadrons_in(list)
 local out={}
 for t in all(list) do if t.sq then add(out,t) end end
 return out
end

function shot_att(shot,t)
 local a
 if shot.arc_missiles then a=t.lasers
 elseif shot.guillotine then a=t.boarding
 elseif shot.stream then a=t.sq and 0 or t.hull.ups
 elseif shot.eulogy then a=shot.owner and losses(shot.owner.side) or 0
 else a=shot.att end
 local m=shot.owner
 if m and a>0 then
  if shot.hijacker then a+=weapon_count(t) end
  if shot.switch and not t.sq and facing_at(t,m.x,m.y)==shot.facing then a+=2 end
  if shot.turret and shot.capacity and in_arc(m,"front",t.x,t.y) then a+=1 end
  if shot.obsidian and mdist(m,t)<=12 then a+=2 end
 end
 return a
end

function arc_name(a)
 if a=="all" then return "any arc" end
 if a=="left" or a=="right" then return a.." side" end
 return a
end

-- Shadow Fleet: only targetable within 12" of one of the shooter's ships
function shadow_hidden(m,t)
 if t.title~="shadow_fleet" and t.title~="change_disciple" then return false end
 for o in all(on_table(m.side)) do
  if not o.sq and mdist(o,t)<=12 then return false end
 end
 return true
end

-- Specter: can't be shot until it shoots, takes damage or carries an objective
function specter_hidden(t)
 return t.hero=="specter" and not (t.revealed or t.hurt or t.markers>0)
end

function sees(m,shot,t)
 return has(m,"seeker_rounds") or shot.arc_missiles or (t.lasers>0 and has(m,"extremis_arc"))
  or los(m.x,m.y,t.x,t.y)
end

-- Indolence Rifle: +12" when the ship is holding
function shot_range(m,shot)
 local r=shot.rng+((shot.indolence and m.cur_action=="hold") and 12 or 0)
 if not shot.turret and m.cur_action=="hold" and has(m,"vector_analysis_lab") then r+=6 end
 return r
end

-- Destroyer / Shift Module: a weapon may fire from a connected friendly ship
function shot_origins(m,shot)
 if (m.hull.rules.destroyer and not shot.turret) or (shot.turret and has(m,"shift_module")) then
  local out={m}
  for o in all(connected_ships(m)) do add(out,o) end
  return out
 end
end

function shot_targets(m,shot)
 local origins=shot_origins(m,shot)
 if not origins then return shot_targets_from(m,shot) end
 local out,seen={},{}
 shot.origins={}
 local x,y=m.x,m.y
 for o in all(origins) do
  m.x,m.y=o.x,o.y
  for t in all(shot_targets_from(m,shot)) do
   if not seen[t] then seen[t]=true add(out,t) shot.origins[t]=o end
  end
 end
 m.x,m.y=x,y
 return out
end

function shot_targets_from(m,shot)
 local out={}
 if shot.juice and not juice_feed(m) then return out end
 if (shot.rail_lock or shot.neutron) and m.cur_action~="hold" then return out end
 local closest=shot.arc_tongue and nearest(m.x,m.y,enemies_of(m))
 local eng=engaged_list(m)
 local excl=shot.twin_of and shot.twin_of.target
 for t in all(enemies_of(m)) do
  local far=(has(t,"nemesis_evader") and in_arc(t,"rear",m.x,m.y)) and 6 or 0
  if t.hero=="distortion_lord" then far+=6 end
  if t~=excl and mdist(m,t)+far<=shot_range(m,shot) and in_arc(m,shot.arc,t.x,t.y)
   and not (closest and t~=closest)
   and not (shot.tandem and not ratpack_ok(m,t))
   and not (shot.group and has_val(shot.group,t))
   and not (m.title=="code_of_honour" and not t.sq and in_arc(t,"rear",m.x,m.y))
   and not (shot.profile and (t.sq or working_ups(t)<=working_ups(m)))
   and sees(m,shot,t) and not shadow_hidden(m,t) and not specter_hidden(t) and not (shot.boarding and t.sq)
   and not (shot.tainted and (t.sq or t.markers==0))
   and shot_att(shot,t)>0
   and (#eng==0 or has_val(eng,t)) then
   add(out,t)
  end
 end
 -- Escort: squadrons that can see an escort must shoot the escort
 if m.sq then
  local esc={}
  for t in all(out) do if t.hull.rules.escort then add(esc,t) end end
  if #esc>0 then return esc end
 end
 return out
end

-- turret bonuses that depend on the target (Tyrant Champion, Predator Cysts)
function turret_bonus(m,shot,t)
 if not shot.turret then return 0 end
 local b=0
 if m.hero=="tyrant_champion" and t.hero then b+=4 end
 if has(m,"predator_cysts") and t.hull.ups>m.hull.ups then b+=1 end
 return b
end

-- inside any terrain piece the ship can be in (Dug In)
function in_any_terrain(t)
 for tr in all(bt.terrain) do
  if tr.kind~="planetoid" and dist(t.x,t.y,tr.x,tr.y)<tr.r then return true end
 end
 return false
end

-- shot from behind a ship (Over-Engineered cancels the bonuses)
function rear_shot(m,t)
 return not t.sq and in_arc(t,"rear",m.x,m.y) and not has(t,"over_engineered")
end

-- attacker sits in the target ship's side arc (Mass Cascade Gun, Particle Cannon)
function side_shot(m,t)
 return not t.sq and in_arc(t,"sides",m.x,m.y)
end

function hit_need(m,shot,t)
 if shot.casualty or shot.hyper_scyth then return 2 end -- always hits on 2+
 if m.hero=="data_lord" and not t.sq and data_lord_ok(m,t) then return 2 end
 if (shot.anti_ship and t.sq) or (shot.anti_sq and not t.sq) then return 6 end
 if shot.finisher and t.sq then return 6 end
 if t.hull.rules.swarm and not shot.anti_sq then return 6 end
 local pulpit=t.hero=="saints_pulpit" and not t.hurt -- only hit on 5-6
 if not t.sq and t.held and t.title~="castle_doctrine" then return pulpit and 5 or 2 end -- easy target
 local mods=turret_bonus(m,shot,t)
 if shot.turret and m.hero=="agressor_prima" and mdist(m,t)<=2 then mods+=1 end
 if m.title=="ship_of_martyrs" then mods+=1 end
 if shot.cherubs then mods+=1 end
 if rear_shot(m,t) then mods+=1 end
 if t.hero=="contempt" and (m.sq or m.hull.class=="Light") then mods-=1 end
 if shot.turret and m.title=="honourable" and t.dmg_round~=bt.round then mods+=1 end
 if shot.flex then mods-=1 end
 if m.sq and t.sq then mods+=1 end
 if shot.turret and has(m,"tracking_servo") then mods+=1 end
 if shot.anti_ship and not t.sq then mods+=1 end
 if shot.anti_sq and t.sq then mods+=1 end
 if shot.finisher then mods+=finisher_bonus(m,t) end
 if shot.mortal or shot.mass_acc then mods+=1 end
 if shot.keel_breaker then mods-=2 end
 if m.hero=="steel_emperor" and t.hero then mods+=1 end
 if support_cover(m,t) then mods-=1 end
 if not shot.turret and has(m,"targeting_array") and mdist(m,t)>=12 then mods+=1 end
 if m.bindings_round==bt.round then mods+=1 end -- Loose Bindings
 if m.title=="falconer" then mods+=falconer_bonus(m,t) end
 if m.title=="reaper" and not t.sq and in_arc(m,"front",t.x,t.y) and not in_arc(t,"front",m.x,m.y) then mods+=1 end
 if shot.latice and shot.mounted and not in_arc(m,shot.mounted,t.x,t.y) then mods-=1 end
 if shot.contortion then mods+=1 end
 local d=mdist(m,t)
 if m.hull.rules.orc_crew and d>=12 then mods-=1 end
 if m.hull.rules.goblin_crew and d<12 then mods-=1 end
 if shot.turret and has(m,"gunnery_crew") and d<=12 then mods+=1 end
 if (shot.turret or shot.tandem) and ratpack_ok(m,t) then mods+=1 end
 if shot.hyper then mods+=1 end
 if t.throne_round==bt.round then mods-=1 end -- Throne Master
 if t.speed_freak then mods-=1 end
 if has(t,"shell_shield") and not t.sq and not facing_has_weapon(t,facing_at(t,m.x,m.y)) then mods-=1 end
 if shot.eraser then mods-=2 end
 if t.title=="chameleon_shroud" and not t.hurt then mods-=1 end
 if m.side=="ai" then mods+=bt.ai_hit_bonus end
 local eva=shot.inversion and t.hull.tou or t.hull.eva
 return mid(pulpit and 5 or 2,eva-mods,6)
end

function block_need(m,shot,t)
 local n=(shot.inversion and t.hull.eva or t.hull.tou)+shot.str+turret_bonus(m,shot,t)
 if shot.carving and has_disabled(t) then n+=2 end
 if shot.finisher and not t.sq then n+=finisher_bonus(m,t) end
 if shot.turret and m.title=="hunter" and not t.sq and t.markers>0 then n+=1 end
 if shot.flex then n+=1 end
 if shot.cherubs then n+=1 end
 if shot.branding and t.blazing then n+=3 end
 if shot.flagellation and has_disabled(t) then n+=2 end
 if shot.unity and t.boarding>0 then n+=2 end
 if t.title=="ship_of_martyrs" then n-=1 end
 if rear_shot(m,t) then n+=1 end
 if not (shot.arc_missiles or shot.shishi or shot.pcannon) and in_cover(t,m) then n-=1 end
 if m.hero=="steel_emperor" and t.title and not t.sq then n+=1 end
 if shot.gnaw and not t.sq and in_arc(t,"rear",m.x,m.y) then n+=1 end
 if shot.turret and has(m,"gunnery_crew") and mdist(m,t)<=12 then n+=1 end
 if (shot.turret or shot.tandem) and ratpack_ok(m,t) then n+=1 end
 if shot.hyper then n+=1 end
 if t.throne_round==bt.round then n-=1 end
 if t.title=="dug_in" and in_any_terrain(t) then n-=2 end
 if t.hull.rules.shell_prow and shot.str>0 and in_arc(t,"front",m.x,m.y) then n-=1 end
 if has(t,"warlord_shield") and not t.sq and facing_has_weapon(t,facing_at(t,m.x,m.y)) then n-=1 end
 if has(t,"fortified_bow") and not t.sq and in_arc(t,"front",m.x,m.y) then n-=1 end
 if shot.gyro and mdist(m,t)>12 then n+=3 end
 if t.side=="ai" then n-=bt.ai_tou_bonus end
 return mid(2,n,6)
end

-- hit rolls that can't be improved (only-on-6 rules)
function forced_six(m,shot,t)
 return (shot.anti_ship and t.sq) or (shot.anti_sq and not t.sq) or (shot.finisher and t.sq)
  or (t.hull.rules.swarm and not shot.anti_sq)
end

function resolve_shot(m,shot,t)
 local o=shot.origins and shot.origins[t]
 local x,y=m.x,m.y
 if o and o~=m then
  m.x,m.y=o.x,o.y
  blog(m.name.." fires through "..o.name.."'s position",SIDE_COL[m.side])
 end
 bt.attack_shot=shot
 resolve_shot_inner(m,shot,t)
 bt.attack_shot=nil
 if o and o~=m and m.state=="table" then m.x,m.y=x,y end
 piranha_chain(m,shot,t)
 -- Point Defence System: ships shot at by squadrons shoot back
 if m.sq and t.state=="table" and m.state=="table" and not t.sq and has(t,"point_defence_system") then
  blog(t.name.."'s point defence returns fire",SIDE_COL[t.side])
  resolve_shot_inner(t,{name="Point Defence",rng=99,att=3,str=0,arc="all"},m)
 end
end

function resolve_shot_inner(m,shot,t)
 phantasm_collapse(t)
 if shot.group then add(shot.group,t) end
 if shot.turret then m.turret_fired_now=true end -- Electro Cultist
 shot.target=t
 bt.attacker=m
 m.revealed=true -- Specter
 add(bt.flashes,{x1=m.x,y1=m.y,x2=t.x,y2=t.y,t=24,c=SIDE_COL[m.side]})
 local need=hit_need(m,shot,t)
 local att=shot_att(shot,t)
 if shot.brutality then
  -- choose up to 5 attacks (each 1 rolled overheats)
  if m.side=="p" then
   local opts={}
   for i=1,5 do add(opts,{i,i.." attack"..(i==1 and "" or "s")}) end
   att=choose_option("Brutality Emitter: how many attacks? (each roll of 1 deals 1 damage to "..m.name..")",opts)
  else
   att=3
  end
 end
 local side=side_shot(m,t)
 local blast=shot.blast or (shot.side_blast and side)
 local deadly=shot.deadly or (shot.side_deadly and side)
  or (shot.gyro and mdist(m,t)>12) or (shot.brawlers and not t.sq and in_arc(t,"front",m.x,m.y))
  or (shot.turret and has(m,"rocket_shells") and mdist(m,t)>=18)
  or (shot.decapitator and not t.sq and in_arc(t,"rear",m.x,m.y))
  or (shot.turret and has(m,"charged_munitions") and mdist(m,t)<=6)
  or (shot.turret and m.title=="punisher" and not t.sq and in_arc(t,"rear",m.x,m.y))
  or (shot.predator and has_disabled(t))
 -- Deck Shaker: needs a passed morale test to fire
 if shot.protocol then
  local pick_=m.side=="p" and choose_option("Protocol Convent: pick a boost for this shot.",
   {{"att","+1 attack"},{"str","+1 strength"},{"deadly","Deadly"},{"twin","Twin-Fire (fire twice)"}}) or "att"
  if pick_=="att" then att+=1 elseif pick_=="str" then shot=copy_shot(shot) shot.str+=1
  elseif pick_=="deadly" then deadly=true else att*=2 end
 end
 if not shot.turret and has(m,"deconstruction_engram") and m.engram_act~=bt.round then
  local go=m.side=="ai" or choose_option("Deconstruction Engram: take a morale test for +1 attack with "..shot.name.."?",{{true,"Test"},{false,"No"}})
  if go then
   m.engram_act=bt.round
   local ok,r,n=morale_test(m)
   if ok then att+=1 end
   blog(m.name.."'s engram "..(ok and "boosts" or "fails to boost").." its "..shot.name,SIDE_COL[m.side])
  end
 end
 if shot.deck_shaker or shot.god_talon or shot.psi_shock or shot.tempest_portal then
  local ok,r,n=morale_test(m)
  if not ok then blog(m.name.."'s crew won't fire the "..shot.name.." ("..morale_txt(r,n)..")",5) return end
 end
 -- Ruin Cannon: scrap for extra attacks
 if shot.ruin and scrap_pool(m)>0 then
  local use=scrap_pool(m)
  if m.side=="p" then
   local opts={}
   for i=0,use do add(opts,{i,i==0 and "No scrap" or "Spend "..i.." scrap (+"..i.." attacks)"}) end
   use=choose_option("Ruin Cannon: spend scrap markers for extra attacks?",opts)
  end
  if use>0 then spend_scrap(m,use) att+=use blog(m.name.." feeds "..use.." scrap into its Ruin Cannon",SIDE_COL[m.side]) end
 end
 -- spend Spotting Laser markers on the target for +1 to hit each
 local floor=(t.hero=="saints_pulpit" and not t.hurt) and 5 or 2
 if t.lasers>0 and need>floor and not forced_six(m,shot,t) and att>0 then
  local useful=min(t.lasers,need-floor)
  local use=useful
  if m.side=="p" then
   local opts={}
   for i=0,useful do add(opts,{i,i==0 and "Don't spend any" or "Spend "..i.." (hit on "..(need-i).."+)"}) end
   use=choose_option(t.name.." has "..t.lasers.." laser marker(s). Spend some for +1 to hit each?",opts)
  end
  if use>0 then
   t.lasers-=use
   need-=use
   blog(m.name.." uses "..use.." laser marker(s) on "..t.name,SIDE_COL[m.side])
  end
 end
 if shot.juice then
  local food=juice_feed(m)
  blog(m.name.." feeds "..food.name.." to its Juice Rifle",9)
  destroy(food,"consumed")
 end
 if shot.swarmer then
  local ok,r,n=morale_test(m)
  if ok then att+=6 end
  blog(m.name.." Swarmer morale test: "..morale_txt(r,n)..(ok and ", +6 attacks!" or ", failed"),SIDE_COL[m.side])
 end
 local hits,ones,sixes=0,0,0
 local rolls=""
 for r in all(roll_dice(att,need,m.name..": "..shot.name.." at "..t.name,"to hit")) do
  rolls..=(rolls=="" and "" or ",")..r
  if r==1 then ones+=1 elseif r>=need then hits+=1 if r==6 then sixes+=1 end end
 end
 blog(m.name.." "..shot.name.." -> "..t.name..": rolls "..rolls.." vs "..need.."+, "..hits.." hit(s)",SIDE_COL[m.side])
 local hot=shot.overheat or (shot.mounted and m.hero=="obliteration_master" and not in_arc(m,shot.mounted,t.x,t.y))
 if (hot or shot.destructor) and ones>0 then
  local self=ones*(shot.destructor and 2 or 1)
  if hot and m.coolant>0 then
   m.coolant-=1 self=0
   blog(m.name.." vents coolant and ignores overheating",SIDE_COL[m.side])
  elseif m.title=="risk_doctrine" and m.risk_round~=bt.round then
   m.risk_round=bt.round self-=1
   blog(m.name.." shrugs off the first overheat (Risk Doctrine)",SIDE_COL[m.side])
  end
  if self>0 then
   blog(m.name.."'s "..shot.name.." overheats!",9)
   deal(m,self)
  end
 end
 if hits==0 or t.state~="table" then return end
 if shot.spotting then
  t.lasers+=hits
  blog(t.name.." is painted: "..t.lasers.." laser marker(s)",SIDE_COL[m.side])
  return
 end
 if shot.beacon then
  t.beacons+=hits
  blog(t.name.." is tagged: "..t.beacons.." beacon marker(s)",SIDE_COL[m.side])
  return
 end
 if shot.ignition then
  t.blazing=true
  blog(t.name.." is set ablaze!",9)
  return
 end
 if shot.agitator then
  blog(t.name.." is agitated!",9)
  boarding_rolls(t)
  return
 end
 if shot.lineage then spawn_squadron(m.side,m.fac,"bloat",t,3) end
 local victims={{t,hits}}
 if blast then
  for o in all(bt.models) do
   if o~=t and o~=m and o.state=="table" and mdist(o,t)<=4 then add(victims,{o,1}) end
  end
 end
 if shot.boarding then
  for v in all(victims) do
   local o,n=v[1],v[2]
   if not o.sq then
    o.boarding+=n
    blog(o.name.." is boarded ("..o.boarding.." boarding markers)",9)
   end
  end
  return
 end
 -- Shielder squadrons may each take one hit meant for a nearby friend
 for i=1,#victims do
  local o,n=victims[i][1],victims[i][2]
  for s in all(shielders_for(o)) do
   if n>0 then
    n-=1
    add(victims,{s,1})
    blog("  "..s.name.." shields "..o.name,o.side=="p" and 12 or 8)
   end
  end
  victims[i][2]=n
 end
 for v in all(victims) do
  local o,n=v[1],v[2]
  if n>0 and o.state=="table" then
   local fails,shard=0,0
   if (shot.psy or shot.phantom) and not o.sq then
    -- Psy-Aria / Phantom Bombs: a morale test per hit instead of blocking
    for i=1,n do if not morale_test(o) then fails+=1 end end
    blog("  "..o.name.." takes "..n.." morale test(s) ("..shot.name.."): "..fails.." failed",fails>0 and 8 or 5)
   elseif shot.erosion then
    -- Erosion Missiles: roll a die per point of damage left, each 1 hurts
    for i=1,n do
     for r in all(roll_dice(hp_left(o),2,o.name.." resists "..shot.name,"(1s erode)")) do if r==1 then fails+=1 end end
    end
    blog("  "..o.name.." erodes: "..fails.." damage",fails>0 and 8 or 5)
   else
    local bn=block_need(m,shot,o)
    -- Scrapper: spend scrap to weaken the shot
    if scrap_pool(o)>0 and bn>2 then
     local useful=min(scrap_pool(o),bn-2)
     local use=o.side=="ai" and min(1,useful) or useful
     if o.side=="p" then
      local opts={}
      for i=0,useful do add(opts,{i,i==0 and "No scrap" or "Spend "..i.." (block on "..(bn-i).."+)"}) end
      use=choose_option(o.name.." can spend scrap to weaken the shot (-1 strength each).",opts)
     end
     if use>0 then spend_scrap(o,use) bn-=use blog("  "..o.name.." burns "..use.." scrap",SIDE_COL[o.side]) end
    end
    -- High Elf Shard Cannons: unmodified 6s to hit get +2 strength
    local hard=(shot.shard6 and o==t) and sixes or 0
    local brolls=""
    local needs={}
    for i=1,n do add(needs,i<=hard and min(6,bn+2) or bn) end
    for i,r in ipairs(roll_dice(n,needs,o.name.." blocks "..m.name.."'s "..shot.name,"to block")) do
     local need_i=needs[i]
     brolls..=(brolls=="" and "" or ",")..r
     if r<need_i then fails+=1 end
     if r==1 and (shot.shard or shot.gauss) then shard+=1 end -- Shard Cannons / Gauss Banks
    end
    -- Graviton Crusher: damage comes from successful blocks instead
    if shot.graviton then fails=n-fails end
    blog("  "..o.name.." rolls "..brolls.." to block on "..bn.."+: "..(n-fails).." blocked, "..fails.." failed"
     ..(shard>0 and " (+"..shard.." shard)" or ""),fails>0 and 8 or 5)
   end
   local per=1+(deadly and 1 or 0)+(shot.eraser and 3 or 0)+((shot.destructor or shot.disintegrator) and 2 or 0)
   local dmg=fails*per+shard
   -- Communications Master: a targeting token adds +1 damage
   if fails>0 and o.targeting>0 then
    o.targeting-=1 dmg+=1
    blog("  targeting token on "..o.name.." used: +1 damage",SIDE_COL[m.side])
   end
   if fails>0 and (o.vengeance or 0)>0 and not deadly then
    o.vengeance-=1 dmg+=1
    blog("  vengeance token on "..o.name.." used: a hit becomes Deadly",SIDE_COL[m.side])
   end
   local taken=deal(o,dmg,shot.sniper and m.side)
   if ((shot.vector and shot.turret) or shot.symphonium or shot.distortion_cannon) and not o.sq and taken>0 and o.state=="table" then
    o.boarding+=taken
    blog("  "..o.name.." is infected: "..taken.." boarding marker(s)",9)
   end
   if taken>0 and o.state=="table" then
    if shot.distortion_lance and not o.sq then push(o,ang(o.x-m.x,o.y-m.y),3) end
    if shot.gravity_hook and not o.sq then gravity_hook(o,m,taken) end
    untethered_move(o,m)
   end
  end
 end
end

-- damage

-- popup asking the player which upgrade takes a point of damage
function choose_upgrade(m,list,title)
 if #list==1 then return list[1] end
 local was=bt.sel
 bt.sel=m
 local btns={}
 for up in all(list) do add(btns,{up,up.upg.name}) end
 local r=await{prompt=title,popup=title,buttons=btns}
 bt.sel=was
 return r.button
end

-- which upgrade takes the next point of damage. sniper is the side of a
-- sniper attacker, who gets to pick instead of the defender.
function damage_target(m,sniper,left)
 local live={}
 for up in all(m.ups) do if not up.dis then add(live,up) end end
 if sniper=="p" then
  return choose_upgrade(m,live,"Sniper hit! Choose which of "..m.name.."'s upgrades takes the damage.")
 elseif sniper then
  -- the AI finishes off whatever is closest to breaking, preferring weapons
  local best,bs
  for up in all(live) do
   local s=up.dmg/up.cap+(up.upg.weapon and 0.1 or 0)
   if not bs or s>bs then best,bs=up,s end
  end
  return best
 end
 -- a damaged upgrade must keep taking damage until it is disabled
 for up in all(live) do if up.dmg>0 then return up end end
 if m.side=="p" then
  return choose_upgrade(m,live,m.name.." takes damage ("..left.." point"..(left==1 and "" or "s")
   .." left to assign). Choose an upgrade; it keeps taking damage until disabled.")
 end
 return pick(live)
end

-- returns how many points of damage were actually taken
function deal(m,n,sniper)
 local taken=0
 -- Fragile: the first damage each round is +1
 if n>0 and m.hull.rules.fragile and m.fragile_round~=bt.round then
  m.fragile_round=bt.round
  n+=1
 end
 for i=1,n do
  if m.state=="dead" then break end
  if m.title=="plague_disciple" and m.plague_round~=bt.round then
   m.plague_round=bt.round
   blog("  "..m.name.." ignores a point of damage (Plague Disciple)",SIDE_COL[m.side])
  elseif m.lockdown and has(m,"maximum_lockdown") and roll_dice(1,4,m.name.."'s maximum lockdown","to ignore damage")[1]>=4 then
   blog("  "..m.name.."'s maximum lockdown ignores a point of damage",12)
  elseif has(m,"tide_shield") and bt.round>2 and roll_dice(1,4,m.name.."'s tide shield","to ignore damage")[1]>=4 then
   blog("  "..m.name.."'s tide shield ignores a point of damage",12)
  elseif has(m,"shield_booster") and roll_dice(1,5,m.name.."'s shield booster","to absorb damage")[1]>=5 then
   blog("  "..m.name.."'s shield booster absorbs a point of damage",12)
  elseif vassal_for(m) then
   -- Vassal Link: the damage goes onto the link upgrade instead
   local v=vassal_for(m)
   for up in all(v.ups) do
    if up.id=="vassal_link" and not up.dis then
     up.dmg+=1
     blog("  "..v.name.."'s vassal link takes the damage for "..m.name,SIDE_COL[v.side])
     if up.dmg>=up.cap then up.dis=true blog("  "..v.name.."'s Vassal Link is disabled",9) end
     break
    end
   end
   if working_ups(v)==0 then destroy(v,"destroyed") end
  elseif m.sq then
   taken+=1
   m.dmg+=1
   if m.dmg>=sq_hp(m) or is_bomb(m) then destroy(m,"destroyed") end
  elseif (m.title=="prime_crew" or m.title=="alchemical_crew") and working_ups(m)==1 and last_point(m) and roll_dice(1,4,m.name.."'s crew","to keep flying")[1]>=4 then
   blog("  "..m.name.."'s "..(m.title=="prime_crew" and "prime" or "alchemical").." crew keeps it flying!",12)
  else
   local up=damage_target(m,sniper,n-i+1)
   if not up then destroy(m,"destroyed") break end -- nothing left to absorb it
   taken+=1
   up.dmg+=1
   if up.dmg>=up.cap then
    up.dis=true
    local a=bt.attacker
    if a and a.side~=m.side and a.title=="confirmation_bias" and a.state=="table" then
     m.lasers+=1
     blog("  Confirmation Bias: laser marker on "..m.name,SIDE_COL[a.side])
    end
    blog("  "..m.name.."'s "..up.upg.name.." is disabled",9)
    scrap_event(m.x,m.y,m)
    processor_event(m)
    if up.id=="retaliation_cherubs" then retaliate(m) end
    if up.id=="spatial_superposition" then superposition(m) end
    if m.title=="throne_master" then m.throne_round=bt.round end
    -- Refit Reactor shuts down when it's the last thing working
    if working_ups(m)==1 and has(m,"refit_reactor") then
     for u2 in all(m.ups) do
      if u2.id=="refit_reactor" then u2.dis=true blog("  "..m.name.."'s Refit Reactor shuts down",9) end
     end
    end
    if m.title=="sprouting" then
     blog("  "..m.name.." sprouts new life",m.side=="p" and 12 or 8)
     spawn_squadron(m.side,m.fac,"bloat",m,3)
     spawn_squadron(m.side,m.fac,"bloat",m,3)
    end
   end
   if working_ups(m)==0 then
    if phoenix_rise(m) then break end
    if m.hero=="scrap_king" and not m.scrap_king_used then
     -- Scrap King: the first time, restore an upgrade instead of dying
     m.scrap_king_used=true
     local up2=pick(m.ups)
     up2.dmg,up2.dis=0,false
     blog("  "..m.name.." bolts its "..up2.upg.name.." back together (Scrap King)",SIDE_COL[m.side])
     break
    end
    destroy(m,"destroyed")
   end
  end
 end
 local a=bt.attacker
 if taken>0 and a and a.side~=m.side and a.hero=="flame_emperor" and m.state=="table" then
  m.beacons+=taken
  blog("  Flame Emperor brands "..m.name.." ("..taken.." beacon)",SIDE_COL[a.side])
 end
 if taken>0 then
  m.hurt=true -- ends Chameleon Shroud
  m.dmg_round=bt.round -- for Honourable
 end
 return taken
end

-- would the next point of damage disable a ship's last working upgrade?
function last_point(m)
 for up in all(m.ups) do
  if not up.dis then return up.dmg+1>=up.cap end
 end
 return false
end

-- Retaliation Cherubs: fire the turret right away with +1 to hit and strength
function retaliate(m)
 local tur
 for s in all(model_shots(m)) do if s.turret then tur=s end end
 if not tur or m.state~="table" then return end
 tur=copy_shot(tur)
 tur.cherubs=true
 tur.name="Retaliation"
 local list=shot_targets(m,tur)
 if #list==0 then return end
 local t
 if m.side=="p" then
  bt.highlight=list
  local r=await{
   prompt="Retaliation Cherubs! Click a target for "..m.name.."'s turret (+1 to hit and strength).",
   buttons={{"skip","Skip"}},
   click=function(p) return model_at(p,list) end,
  }
  bt.highlight=nil
  t=r.click
 else
  local bv
  for o in all(list) do
   local v=shot_value(m,tur,o)
   if not bv or v>bv then t,bv=o,v end
  end
 end
 if t then
  blog(m.name.."'s retaliation cherubs open fire!",SIDE_COL[m.side])
  resolve_shot(m,tur,t)
 end
end

-- Phoenix Mark: the first time the ship would be destroyed it returns to
-- its deployment zone, at least 3" from other ships, fully repaired
function phoenix_rise(m)
 if m.hero~="phoenix_mark" or m.phoenix_used then return false end
 m.phoenix_used=true
 local function ok(x,y)
  if not zone_ok(m.side,m,x,y) then return false end
  for o in all(on_table()) do
   if o~=m and not o.sq and dist(x,y,o.x,o.y)-o.r-m.r<3 then return false end
  end
  return true
 end
 local spot
 if m.side=="p" then
  bt.sel=m
  local r=await{
   prompt="Phoenix Mark! Place "..m.name.." in your deployment zone, at least 3\" from other ships.",
   buttons={{"no","Let it die"}},
   hover=function(p) return {ghost=m,x=p.x,y=p.y,h=m.h,ok=ok(p.x,p.y)} end,
   click=function(p) if ok(p.x,p.y) then return p end end,
  }
  spot=r.click
 else
  local best,bd
  for x=2,TABLE_W-2,2 do
   for y=1,TABLE_H-1,1 do
    if ok(x,y) then
     local o,d=nearest(x,y,bt.objs)
     d=d or 0
     if not bd or d<bd then best,bd={x=x,y=y},d end
    end
   end
  end
  spot=best
 end
 if not spot then return false end
 for up in all(m.ups) do up.dmg,up.dis=0,false end
 m.x,m.y=spot.x,spot.y
 m.h=deploy_face(m.side)
 add(bt.booms,{x=m.x,y=m.y,t=30})
 blog(m.name.." rises from the ashes (Phoenix Mark)!",m.side=="p" and 12 or 8)
 return true
end

-- M.A.D.: a destroyed squadron deals 3 hits to enemy squadrons within 2"
function mad_explode(m)
 for o in all(on_table(other(m.side))) do
  if o.sq and mdist(o,m)<=2 then
   local bn=block_need(m,{str=0},o)
   local fails=0
   for r in all(roll_dice(3,bn,o.name.." blocks "..m.name.."'s M.A.D.","to block")) do if r<bn then fails+=1 end end
   blog("  "..m.name.."'s M.A.D. hits "..o.name..": "..fails.." damage",fails>0 and 8 or 5)
   deal(o,fails)
  end
 end
end

-- a Detonation squadron that is overlapped or engaged blows up on target
-- upgrades counted when comparing rams (Unbelievable Bulk +2)
function ram_ups(m)
 return m.hull.ups+(has(m,"unbelievable_bulk") and 2 or 0)+(m.hull.rules.orc_crew and 1 or 0)
end

-- Possessive Eye: fires once per round at an enemy that grabs an objective
function possessive_eye(m)
 for o in all(enemies_of(m)) do
  if m.state~="table" then return end
  if o.eye_round~=bt.round then
   for s in all(model_shots(o)) do
    if s.eye and mdist(o,m)<=s.rng and in_arc(o,s.arc,m.x,m.y) and sees(o,s,m) then
     local go=o.side=="ai" or choose_option("Possessive Eye: "..o.name.." can fire at "..m.name.." for grabbing an objective. Fire?",
      {{true,"Fire"},{false,"Hold fire"}})
     if go then
      o.eye_round=bt.round
      blog(o.name.."'s possessive eye fires!",SIDE_COL[o.side])
      resolve_shot(o,s,m)
     end
     break
    end
   end
  end
 end
end

-- Greed Incarnate: drag an objective within 18" D6+1" toward the ship
function greed_incarnate(m)
 if m.hero~="greed_incarnate" or m.state~="table" then return end
 local list={}
 for o in all(bt.objs) do if dist(m.x,m.y,o.x,o.y)-m.r<=18 then add(list,o) end end
 if #list==0 then return end
 local o
 if m.side=="p" then
  local r=await{
   prompt="Greed Incarnate: click an objective within 18\" to pull toward "..m.name..", or skip.",
   buttons={{"skip","Skip"}},
   click=function(p)
    local best,bd=nearest(p.x,p.y,list)
    if best and bd<=1.5 then return best end
   end,
  }
  o=r.click
 else
  o=nearest(m.x,m.y,list)
 end
 if not o then return end
 local d=min(d6()+1,max(0,dist(m.x,m.y,o.x,o.y)-m.r-0.3))
 local a=ang(m.x-o.x,m.y-o.y)
 o.x,o.y=o.x+cos(a)*d,o.y+dsin(a)*d
 blog(m.name.." drags an objective "..flr(d).."\" closer (Greed Incarnate)",SIDE_COL[m.side])
end

-- Restoration Guilds: a die per point of damage, each 5+ repairs 1
function restoration(m)
 if m.state~="table" or not has(m,"restoration_guilds") then return end
 local dmg,fixed=0,0
 for up in all(m.ups) do dmg+=up.dmg end
 for r in all(roll_dice(dmg,5,m.name.."'s restoration guilds","to repair")) do if r>=5 then fixed+=1 end end
 if fixed>0 then
  repair(m,fixed)
  blog(m.name.."'s restoration guilds repair "..fixed.." damage",SIDE_COL[m.side])
 end
end

-- Mag-Lock Array: pull a squadron toward the ship
function drag(s,m,d)
 local a=ang(m.x-s.x,m.y-s.y)
 local step=min(d,max(0,mdist(s,m)-0.2))
 s.x,s.y=s.x+cos(a)*step,s.y+dsin(a)*step
end

function maglock_targets(m)
 local out={}
 for s in all(on_table()) do
  if s.sq and mdist(s,m)<=12 then add(out,s) end
 end
 return out
end

-- things that happen at the end of a model's activation
function end_activation(m)
 -- Flesh-Eater: board every enemy ship within 4"
 if m.state=="table" and m.title=="flesh_eater" then
  for o in all(enemies_of(m,true)) do
   if mdist(o,m)<=4 then o.boarding+=1 blog("  "..m.name.." feeds on "..o.name.." (boarding marker)",SIDE_COL[m.side]) end
  end
 end
 -- Slinking: a free 45 degree turn
 if m.state=="table" and m.title=="slinking" and m.side=="p" then
  local r=await{
   prompt="Slinking: click to pivot "..m.name.." up to 45 degrees, or skip.",
   buttons={{"skip","Skip"}},
   hover=function(p) return {pts={},x=m.x,y=m.y,h=m.h+mid(-0.125,nturn(ang(p.x-m.x,p.y-m.y)-m.h),0.125)} end,
   click=function(p) return bt.preview end,
  }
  if r.click then m.h=r.click.h end
 end
 spirit_jump(m)
 m.overcharge=nil
 pheromone_pull(m)
 run_deck_pull(m)
 raiding_barge(m)
 greed_incarnate(m)
 restoration(m)
 regen(m)
 flicker(m)
 mirth(m)
 rift_master(m)
 overclock(m)
 -- per-activation effects end
 m.convent,m.consume_bonus=nil,nil
 if m.state=="table" then m.turret_fired_last=m.turret_fired_now end
 m.turret_fired_now=nil
end

-- squadrons that blow up when overlapped or engaged
function is_bomb(m)
 return m.hull.rules.detonation or m.hull.rules.smart
end

function detonate(sq,target)
 if sq.state~="table" or target.state~="table" then return end
 blog(sq.name.." detonates next to "..target.name.."!",9)
 add(bt.booms,{x=sq.x,y=sq.y,t=30})
 bt.attacker=sq
 local shot={name="Detonation",str=0}
 local hits=2
 if sq.hull.rules.smart then
  -- Smart Detonation: 1 hit, +1 per laser marker removed from the target
  hits=1+target.lasers
  if target.lasers>0 then blog("  using "..target.lasers.." laser marker(s)",9) end
  target.lasers=0
  for o in all(on_table(sq.side)) do
   if o.hero=="master_of_missile" then shot.str=1 end
  end
 end
 destroy(sq,"destroyed")
 local bn=block_need(sq,shot,target)
 local fails=0
 for r in all(roll_dice(hits,bn,target.name.." blocks "..sq.name,"to block")) do if r<bn then fails+=1 end end
 blog("  "..target.name.." blocks on "..bn.."+: "..fails.." damage",fails>0 and 8 or 5)
 deal(target,fails)
end

-- ask the player a yes/no style question with a popup
function choose_option(title,opts)
 local r=await{prompt=title,popup=title,buttons=opts}
 return r.button
end

-- Outbreak: an enemy ship destroyed with boarding markers on it (or a
-- friendly Rebirth ship) can be replaced by a waiting outbreak ship
function try_outbreak(dead,side,same_class)
 local opts={}
 for o in all(bt.models) do
  if o.side==side and o.state=="outbreak" and (not same_class or o.hull.class==dead.hull.class) then add(opts,o) end
 end
 if #opts==0 then return end
 local pickm
 if side=="p" then
  local btns={}
  for o in all(opts) do add(btns,{o,o.name}) end
  add(btns,{"no","Not now"})
  local r=choose_option("Outbreak! Deploy a ship in place of "..dead.name.."?",btns)
  if r~="no" then pickm=r end
 else
  pickm=opts[1]
 end
 if pickm then
  pickm.x,pickm.y,pickm.h=dead.x,dead.y,dead.h
  pickm.state="table"
  pickm.activated=true
  blog(pickm.name.." bursts out of the wreck of "..dead.name.."!",side=="p" and 12 or 8)
 end
end

function destroy(m,how)
 local was_on=m.state=="table"
 m.state="dead"
 blog(m.name.." is "..how.."!",m.side=="p" and 8 or 11)
 if was_on then
  explode(m.x,m.y,m.r)
  for i=1,m.markers do
   add(bt.objs,{x=mid(0.5,m.x+rnd(2)-1,TABLE_W-0.5),y=mid(0.5,m.y+rnd(2)-1,TABLE_H-0.5)})
  end
  if m.markers>0 then blog("  It drops "..m.markers.." objective(s).",10) end
 end
 m.markers=0
 for s in all(m.embarked) do if s.state=="embarked" then s.state="dead" end end
 if how~="destroyed" or not was_on then return end
 local foe=other(m.side)
 if m.sq and brood_ship(m) then return end
 if not m.sq then
  bt.losses[m.side]=bt.losses[m.side] or {}
  bt.losses[m.side][bt.round]=(bt.losses[m.side][bt.round] or 0)+1
 end
 local a,shot=bt.attacker,bt.attack_shot
 if shot and shot.cascade then blast_hits(m,4,2,0,"Cascade Resonator") end
 if shot and shot.toxin then blast_hits(m,4,2,2,"Toxin Battery") end
 if not m.sq then
  if m.hull.rules.volatile then blast_hits(m,3,m.hull.ups,0,m.name.."'s explosion") end
  last_gasp(m)
  if m.hero=="warp_tunneler" then add(bt.warps,{x=m.x,y=m.y,side=m.side}) blog("  a warp marker remains",SIDE_COL[m.side]) end
  if shot and a and a.side~=m.side and a.state=="table" then
   for o in all(bt.models) do
    if o.side==m.side and o.hero=="mistress_of_retaliation" and o.state~="dead" then
     a.vengeance=(a.vengeance or 0)+1
     blog("  "..a.name.." earns a vengeance token",SIDE_COL[m.side])
     break
    end
   end
  end
  if a and a.side~=m.side and a.state=="table" and has(a,"matter_recombinator") then
   local fixed=0
   for r in all(roll_dice(m.hull.ups,4,a.name.."'s matter recombinator","to repair")) do if r>=4 then fixed+=1 end end
   if fixed>0 then repair(a,fixed) blog("  "..a.name.." recombines "..fixed.." damage",SIDE_COL[a.side]) end
  end
  for o in all(on_table(m.side)) do
   if has(o,"salvage_commune") and mdist(o,m)<=6 then
    local fixed=0
    for r in all(roll_dice(m.hull.ups,4,o.name.."'s salvage commune","to repair")) do if r>=4 then fixed+=1 end end
    if fixed>0 then repair(o,fixed) blog("  "..o.name.." salvages "..fixed.." damage",SIDE_COL[o.side]) end
   end
  end
  for o in all(on_table(foe)) do
   if o.hero=="heart_eater" and mdist(o,m)<=18 and is_damaged(o) then
    repair(o,1) blog("  "..o.name.." devours the wreck (Heart Eater)",SIDE_COL[o.side])
   end
  end
 end
 if m.sq and m.hull.rules.mad then mad_explode(m) end
 if m.sq then scrap_event(m.x,m.y,m) processor_event(m) end
 if not m.sq then delegatus(m) end
 if m.sq then
  for o in all(on_table(foe)) do
   if has(o,"recruitment_tendrils") and mdist(o,m)<=6 and is_damaged(o) then
    blog("  "..o.name.."'s tendrils feed: 1 damage repaired",12)
    repair(o,1)
   end
  end
  return
 end
 for o in all(on_table(m.side)) do
  if o.title=="defiant" and not o.sq and mdist(o,m)<=6 then
   blog("  "..o.name.." is Defiant and repairs 2 damage",12)
   repair(o,2)
  end
 end
 if m.boarding>0 then try_outbreak(m,foe,true) end
 if m.boarding>0 then raid_master(m,foe) end
 if m.title=="rebirth" then try_outbreak(m,m.side,false) end
 for o in all(on_table(foe)) do
  if o.title=="scent_of_death" and not o.sq and mdist(o,m)<=18 then
   local go=o.side=="ai" or choose_option(o.name.." smells death. Turn and move up to 6\" toward the wreck?",
    {{true,"Yes"},{false,"No"}})
   if go then
    o.h=ang(m.x-o.x,m.y-o.y)
    local d=max(0,min(6,dist(o.x,o.y,m.x,m.y)-o.r-m.r-0.1))
    blog("  "..o.name.." is drawn by the Scent of Death",o.side=="p" and 12 or 8)
    exec_move(o,simulate(o,{D=d,f=1,th=0}),"scent")
   end
  end
 end
end

function repair(m,n)
 for i=1,n do
  local up
  for u in all(m.ups) do if not u.dis and u.dmg>0 then up=u end end
  if not up then for u in all(m.ups) do if u.dis then up=u end end end
  if not up then return end
  up.dmg-=1
  if up.dmg<up.cap then up.dis=false end
 end
end

function is_damaged(m)
 for up in all(m.ups) do if up.dmg>0 then return true end end
 return false
end

function boarding_rolls(m)
 if m.boarding==0 or m.state~="table" then return end
 local crew=has(m,"crew_replenishment")
 local need=(crew or has(m,"razor_shield") or has(m,"castle_compound")) and 3 or 4
 if m.title=="beast_home" then need=2 end
 for o in all(enemies_of(m)) do
  if o.hero=="war_chanter" and mdist(o,m)<=12 and o.chant_round~=bt.round then
   o.chant_round=bt.round
   need=min(6,need+1)
   blog("  "..o.name.."'s war chant rattles "..m.name.."'s crew",SIDE_COL[o.side])
   break
  end
 end
 for o in all(enemies_of(m)) do
  if has(o,"fury_inhibitor") and mdist(o,m)<=6 and in_arc(m,"rear",o.x,o.y) then
   need=min(6,need+2) -- Fury Inhibitor
   break
  end
 end
 local fails=0
 for r in all(roll_dice(m.boarding,need,m.name.." fights boarders","to repel")) do if r<need then fails+=1 end end
 local removed=m.boarding-fails
 m.boarding=fails
 blog(m.name.." fights boarders: "..removed.." repelled, "..fails.." remain and deal damage",9)
 if (crew or has(m,"fulgent_huntsmen")) and removed>0 then repair(m,removed) end
 deal(m,fails)
end

-- movement

-- end point of a ship move: straight for f*D, pivot by th, straight for the rest
function path_end(m,D,f,th)
 local a=f*D
 local h2=m.h+th
 return m.x+cos(m.h)*a+cos(h2)*(D-a),m.y+dsin(m.h)*a+dsin(h2)*(D-a),h2
end

-- trace a move without applying it. spec is {D,f,th} for ships or
-- {D,a,spd} for squadrons, plus ram=target.
function simulate(m,spec,halved)
 local res={pts={},mines={},dangerous={},pickups={},terrains={}}
 local D=spec.D
 if halved then D=m.sq and min(D,spec.spd/2) or D/2 end
 local fd=m.sq and D or spec.f*D
 local h2=m.sq and spec.a or m.h+spec.th
 local h1=m.sq and spec.a or m.h
 local bx,by=m.x+cos(h1)*fd,m.y+dsin(h1)*fd
 local n=ceil(D/0.25)
 -- squadrons already engaged (moving thanks to a Control Center) can leave
 local was_engaged=m.sq and engaged_list(m) or {}
 local no_escape={}
 if m.sq then
  for g in all(on_table(other(m.side))) do
   if has(g,"no_escape_module") and mdist(g,m)<=4 then add(no_escape,g) end
  end
 end
 for i=1,n do
  local s=min(i*0.25,D)
  local x,y,h
  if s<=fd then x,y,h=m.x+cos(h1)*s,m.y+dsin(h1)*s,h1
  else x,y,h=bx+cos(h2)*(s-fd),by+dsin(h2)*(s-fd),h2 end

  if x<0 or x>TABLE_W or y<0 or y>TABLE_H then
   res.off=true
   add(res.pts,{x=x,y=y,h=h})
   break
  end
  local stop=false
  if not halved then
   for g in all(on_table(other(m.side))) do
    if g.title=="grip_of_iron" and dist(x,y,g.x,g.y)-g.r-m.r<=4 then return simulate(m,spec,true) end
   end
   for tr in all(bt.traps) do
    if tr.side~=m.side and dist(x,y,tr.x,tr.y)-m.r<=4 then return simulate(m,spec,true) end
   end
  end
  -- No-Escape Module: enemy squadrons that start within 4" can't get further than 4"
  if m.sq then
   for g in all(no_escape) do
    if dist(x,y,g.x,g.y)-g.r-m.r>4 then stop=true end
   end
   if stop then res.blocked=true break end
  end
  for t in all(bt.terrain) do
   local d=dist(x,y,t.x,t.y)
   if t.kind=="planetoid" and d<t.r+m.r*0.7 then stop=true break end
   if d<t.r then
    -- spec.deflect: Deflection Screen ignores difficult and dangerous terrain
    if t.kind=="asteroids" and not halved and not spec.deflect then return simulate(m,spec,true) end
    if is_dangerous(t,m.side) and not spec.deflect and not has_val(res.dangerous,t) then add(res.dangerous,t) end
    if not has_val(res.terrains,t) then add(res.terrains,t) end
   end
  end
  if stop then res.blocked=true break end
  for mn in all(bt.mines) do
   if mn.side~=m.side and dist(x,y,mn.x,mn.y)<=3 and not has_val(res.mines,mn) then add(res.mines,mn) end
  end
  if not m.sq then
   for o in all(bt.objs) do
    if dist(x,y,o.x,o.y)<=m.r and not has_val(res.pickups,o) then add(res.pickups,o) end
   end
  end
  add(res.pts,{x=x,y=y,h=h})
  if spec.ram and dist(x,y,spec.ram.x,spec.ram.y)<=m.r+spec.ram.r+0.05 then res.contact=true break end
  if m.sq then
   for o in all(enemies_of(m)) do
    if o.sq and not has_val(was_engaged,o) and dist(x,y,o.x,o.y)-m.r-o.r<=2 then stop=true end
   end
   if stop then res.engaged=true break end
  end
 end
 res.halved=halved
 local e=res.pts[#res.pts]
 res.x,res.y,res.h=e and e.x or m.x,e and e.y or m.y,e and e.h or m.h
 -- ships pivot even if the pivot point is at the very end
 if not m.sq and not res.contact and not res.off then res.h=h2 end
 return res
end

-- best pivot for a ship heading toward (tx,ty): pure geometry, no terrain
function best_ship_spec(m,D,maxp,tx,ty)
 local best,bs
 for fi=0,5 do
  local f=0.5+fi*0.1
  for k=-12,12 do
   local th=maxp*k/12
   local ex,ey,eh=path_end(m,D,f,th)
   local sc=dist(ex,ey,tx,ty)+0.5*abs(nturn(eh-ang(tx-ex,ty-ey)))
   if not bs or sc<bs then best,bs={D=D,f=f,th=th},sc end
  end
 end
 return best
end

-- max pivot for an action (Emergency Thrusters add a 45 degree pivot to moves)
function pivot_max(m,action)
 local p=PIVOT[action]
 if (action=="cruise" or action=="ram") and (m.title=="lust_disciple" or m.title=="ravager") then p+=0.125 end
 if action=="move" then
  if has(m,"emergency_thrusters") then p+=0.125 end
  if m.unchained_round==bt.round then p+=0.25 end
 end
 return p
end

function deflects(m,action)
 return (action=="cruise" and has(m,"deflection_screen")) or m.title=="impetuous"
end

function plan_to(m,action,tx,ty)
 local D=speed(m,action)
 if m.sq then
  return simulate(m,{D=min(dist(m.x,m.y,tx,ty),D),a=ang(tx-m.x,ty-m.y),spd=D})
 end
 local spec=best_ship_spec(m,D,pivot_max(m,action),tx,ty)
 spec.deflect=deflects(m,action)
 return simulate(m,spec)
end

-- Control Center: friendly squadrons within 12" may move even if engaged
function can_move_engaged(m)
 if m.hull.rules.battle_suit or m.hull.rules.grit or m.hull.rules.scram then return true end
 for o in all(engaged_list(m)) do
  if o.hull.rules.grit then return true end -- Grit: its foes may move too
 end
 for o in all(on_table(m.side)) do
  if has(o,"control_center") and mdist(o,m)<=12 then return true end
 end
 return false
end

-- Run Deck: at the end of a squadron's activation it may fly toward a
-- friendly Run Deck ship within 12"
function run_deck_pull(s)
 if s.state~="table" or not s.sq then return end
 local ship
 for o in all(on_table(s.side)) do
  if has(o,"run_deck") and mdist(o,s)<=12 and mdist(o,s)>0.5 then ship=o end
 end
 if not ship then return end
 if s.side=="p" then
  if not choose_option("Run Deck: move "..s.name.." toward "..ship.name.."?",{{true,"Yes"},{false,"No"}}) then return end
 elseif #engaged_list(s)==0 then
  return -- the AI only uses it to pull engaged squadrons out
 end
 local d=max(0,min(speed(s,"move"),mdist(s,ship)-0.3))
 blog(s.name.." returns to "..ship.name.."'s run deck",s.side=="p" and 12 or 8)
 exec_move(s,simulate(s,{D=d,a=ang(ship.x-s.x,ship.y-s.y),spd=speed(s,"move")}),"move")
end

-- debris storms, plus terrain an enemy Bile Trail has passed through
function is_dangerous(t,side)
 if t.kind=="debris" or (t.bile and t.bile~=side) then return true end
 for o in all(bt.models) do
  if o.state=="table" and o.side~=side and has(o,"corruption_spreader") and dist(o.x,o.y,t.x,t.y)<t.r then return true end
 end
 return false
end

function can_ram(m)
 local r=m.hull.rules
 return not m.sq or r.burrow or r.pyre or r.crawl or r.boarding_robot or r.invade or r.suicide
end

function find_ram(m,t)
 if not can_ram(m) or t.sq then return nil end
 local D=speed(m,"ram")
 if mdist(m,t)>D then return nil end
 if m.sq then
  -- burrowing squadrons fly straight at the target
  local res=simulate(m,{D=min(D,dist(m.x,m.y,t.x,t.y)),a=ang(t.x-m.x,t.y-m.y),spd=D,ram=t})
  return res.contact and res or nil
 end
 local best,bs
 for fi=0,5 do
  for k=-6,6 do
   local res=simulate(m,{D=D,f=0.5+fi*0.1,th=PIVOT.ram*k/6,ram=t})
   if res.contact then
    local sc=#res.pts+abs(k)
    if not bs or sc<bs then best,bs=res,sc end
   end
  end
 end
 return best
end

-- move animations (battle and replay): eased along the path, taking longer
-- for longer moves up to MOVE_FRAMES
MOVE_FRAMES=30

function move_frames(len) return mid(6,ceil(len*2.5),MOVE_FRAMES) end -- len in inches
function ease(k) return k*k*(3-2*k) end

function path_len(path)
 local n=0
 for i=2,#path do n+=dist(path[i-1].x,path[i-1].y,path[i].x,path[i].y) end
 return n
end

-- position and heading part way (k from 0 to 1) along a path of {x,y,h}
function path_at(path,k)
 if #path==1 then return path[1].x,path[1].y,path[1].h end
 local f=1+k*(#path-1)
 local i=min(flr(f),#path-1)
 local a,b,t=path[i],path[i+1],f-i
 return a.x+(b.x-a.x)*t,a.y+(b.y-a.y)*t,a.h+nturn(b.h-a.h)*t
end

function animate(m,pts)
 if #pts==0 then return end
 local path={{x=m.x,y=m.y,h=m.h}}
 for p in all(pts) do add(path,p) end
 rec_path(m,path)
 local frames=move_frames(path_len(path))
 for f=1,frames do
  m.x,m.y,m.h=path_at(path,ease(f/frames))
  YIELD()
 end
end

function disengage(m,x,y)
 m.state="off"
 m.exit={x=mid(0,x,TABLE_W),y=mid(0,y,TABLE_H)}
 blog(m.name.." leaves the table and will return at the end of the round",5)
end

function exec_move(m,res,action)
 animate(m,res.pts)
 m.h=res.h
 m.held=false
 for mn in all(res.mines) do
  if has_val(bt.mines,mn) then
   del(bt.mines,mn)
   blog(m.name.." triggers a mine!",9)
   deal(m,2)
  end
 end
 for t in all(res.dangerous) do
  local n=d3()
  blog(m.name.." moves through "..(t.kind=="debris" and "a debris storm" or "a bile trail")..": "..n.." damage",9)
  deal(m,n)
 end
 if m.state~="table" then return end
 if has(m,"bile_trail") then
  for t in all(res.terrains) do
   if t.bile~=m.side then
    t.bile=m.side
    blog(m.name.." leaves a bile trail",m.side=="p" and 12 or 8)
   end
  end
 end
 for o in all(res.pickups) do
  if has_val(bt.objs,o) then
   del(bt.objs,o)
   m.markers+=1
   blog(m.name.." picks up an objective!",10)
   possessive_eye(m)
  end
 end
 if res.off then disengage(m,res.x,res.y) return end
 if #res.pts>0 then motion_trackers(m) end
 if m.state~="table" then return end
 if m.sq then
  shove_off_ships(m)
  if action~="ram" then check_engagement_detonation(m) end
 else
  resolve_overlap(m)
  if m.state=="table" then shove_squadrons(m) end
 end
end

-- Detonation squadrons blow up when they become engaged
function check_engagement_detonation(m)
 for o in all(engaged_list(m)) do
  if m.state~="table" then return end
  if is_bomb(o) then detonate(o,m)
  elseif is_bomb(m) then detonate(m,o) end
 end
end

-- a ship ending on another ship keeps going until 1" clear of all ships
function resolve_overlap(m)
 local ships={}
 for o in all(on_table()) do if o~=m and not o.sq then add(ships,o) end end
 local over=false
 for o in all(ships) do if mdist(m,o)<0 then over=true end end
 if not over then return end
 local through={}
 for i=1,200 do
  local clear=true
  for o in all(ships) do
   local d=mdist(m,o)
   if d<0 and not has_val(through,o) then add(through,o) end
   if d<1 then clear=false end
  end
  if clear then break end
  m.x+=cos(m.h)*0.25 m.y+=dsin(m.h)*0.25
  YIELD()
  if m.x<0 or m.x>TABLE_W or m.y<0 or m.y>TABLE_H then disengage(m,m.x,m.y) break end
 end
 local self_dmg=false
 for o in all(through) do
  local enemy=o.side~=m.side
  blog(m.name.." collides with "..o.name,9)
  local slip=enemy and (m.title=="slippery" or o.title=="slippery")
  if not (enemy and has(m,"ablative_armor")) and not slip then self_dmg=true end
  if enemy and has(m,"combatant_bolt_on") then
   for up in all(m.ups) do if up.id=="combatant_bolt_on" then up.dis,up.dmg=true,up.cap end end
   o.boarding+=4
   blog("  "..m.name.."'s boarding bolts latch on: 4 boarding markers on "..o.name,SIDE_COL[m.side])
  end
  if enemy then snap_fire(m,"spike",o,"Spike Projector:") end
  if slip then
   blog("  they slip past each other (Slippery)",5)
  elseif enemy and m.hull.rules.shadow_walker then
   o.boarding+=1
   blog("  Shadow Walker: boarding marker on "..o.name,9)
  elseif not (enemy and has(o,"ablative_armor")) then
   deal(o,1+((m.title=="war_disciple" and enemy) and 1 or 0))
  end
  if enemy and m.hero=="patient_zero" and o.state=="table" then
   o.boarding+=1
   blog("  Patient Zero infects "..o.name.." (boarding marker)",9)
  end
 end
 if self_dmg then deal(m,1+(m.title=="war_disciple" and 1 or 0)) end
 warp_gate(m,through)
end

-- Warp Gate: a model with fewer upgrades overlapping a gate ship is sent
-- through to another gate ship instead
function warp_gate(m,through)
 if m.state~="table" then return end
 for g in all(through) do
  if g.hull.rules.warp_gate and ram_ups(m)<g.hull.ups then
   for o in all(on_table()) do
    if o~=g and o.hull.rules.warp_gate then
     for i=1,20 do
      local a=rnd()
      local d=o.r+m.r+rnd(3)
      local x,y=o.x+cos(a)*d,o.y+dsin(a)*d
      if place_ok(m,x,y) then
       m.x,m.y=x,y
       blog(m.name.." is pulled through the warp gate to "..o.name,12)
       return
      end
     end
    end
   end
  end
 end
end

function shove_squadrons(m)
 for o in all(on_table()) do
  if o.sq and o.side~=m.side and is_bomb(o) and dist(m.x,m.y,o.x,o.y)<m.r+o.r then
   detonate(o,m)
  end
  if m.state~="table" then return end
  if o.state=="table" and o.sq and o.side~=m.side and has(m,"star_gills") and dist(m.x,m.y,o.x,o.y)<m.r+o.r then
   blog("  "..m.name.."'s star gills shred "..o.name,9)
   deal(o,1)
  end
  if o.state=="table" and o.sq and o.side~=m.side and has(m,"shadow_caster") and dist(m.x,m.y,o.x,o.y)<m.r+o.r then
   local a=ang(o.x-m.x,o.y-m.y)
   o.x,o.y=mid(o.r,o.x+cos(a)*6,TABLE_W-o.r),mid(o.r,o.y+dsin(a)*6,TABLE_H-o.r)
   blog("  "..m.name.."'s shadow caster flings "..o.name.." away",SIDE_COL[m.side])
  end
  if o.state=="table" and o.sq and m.hero=="maw_of_industry" and dist(m.x,m.y,o.x,o.y)<m.r+o.r and roll_dice(1,4,m.name.."'s Maw of Industry vs "..o.name)[1]>=4 then
   if o.side==m.side then
    o.dmg=max(0,o.dmg-1)
    blog("  Maw of Industry patches up "..o.name,SIDE_COL[m.side])
   else
    blog("  Maw of Industry mauls "..o.name,SIDE_COL[m.side])
    deal(o,1)
   end
  end
  if o.state=="table" and o.sq and dist(m.x,m.y,o.x,o.y)<m.r+o.r then
   local a=ang(o.x-m.x,o.y-m.y)
   if o.x==m.x and o.y==m.y then a=rnd() end
   local d=m.r+o.r+0.4
   o.x,o.y=mid(o.r,m.x+cos(a)*d,TABLE_W-o.r),mid(o.r,m.y+dsin(a)*d,TABLE_H-o.r)
  end
 end
end

function shove_off_ships(m)
 for o in all(on_table()) do
  -- a bloat flying onto an enemy ship counts as being overlapped
  if is_bomb(m) and not o.sq and o.side~=m.side and dist(m.x,m.y,o.x,o.y)<m.r+o.r then
   detonate(m,o)
   return
  end
  if not o.sq and dist(m.x,m.y,o.x,o.y)<m.r+o.r then
   local a=ang(m.x-o.x,m.y-o.y)
   local d=m.r+o.r+0.4
   m.x,m.y=mid(m.r,o.x+cos(a)*d,TABLE_W-m.r),mid(m.r,o.y+dsin(a)*d,TABLE_H-m.r)
  end
 end
end

function push(t,a,d,why)
 blog(t.name.." is pushed "..d.."\"",5)
 local steps=flr(d/0.25)
 local hit_danger={}
 for i=1,steps do
  local nx,ny=t.x+cos(a)*0.25,t.y+dsin(a)*0.25
  if nx<0 or nx>TABLE_W or ny<0 or ny>TABLE_H then disengage(t,nx,ny) return end
  for o in all(on_table()) do
   if o~=t and not o.sq and dist(nx,ny,o.x,o.y)<t.r+o.r then
    blog("  and slams into "..o.name,9) deal(t,1) return
   end
  end
  for tr in all(bt.terrain) do
   if tr.kind=="planetoid" and dist(nx,ny,tr.x,tr.y)<tr.r+t.r*0.7 then
    blog("  and slams into a planetoid",9) deal(t,1) return
   end
  end
  for db in all(bt.terrain) do
   if is_dangerous(db,t.side) and dist(nx,ny,db.x,db.y)<db.r and not has_val(hit_danger,db) then
    add(hit_danger,db)
    local n=d3() blog("  into dangerous terrain: "..n.." damage",9) deal(t,n)
    if t.state~="table" then return end
   end
  end
  t.x,t.y=nx,ny
  YIELD()
 end
 shove_squadrons(t)
end

function resolve_ram(m,t)
 bt.attacker=m
 phantasm_collapse(t)
 if m.sq and m.hull.rules.suicide then
  blog(m.name.." makes a suicide run into "..t.name.."!",9)
  destroy(m,"spent")
  deal(t,1)
  return
 end
 if m.sq and (m.hull.rules.crawl or m.hull.rules.boarding_robot) then
  local n=m.hull.rules.crawl and 2 or 1
  blog(m.name.." crawls into "..t.name.."! ("..n.." boarding marker"..(n>1 and "s" or "")..")",9)
  t.boarding+=n
  if m.hull.rules.boarding_robot and t.beacons>0 then
   t.boarding+=t.beacons
   blog("  "..t.beacons.." beacon marker(s) become boarding markers",9)
   t.beacons=0
  end
  destroy(m,"spent")
  return
 end
 if m.sq and m.hull.rules.pyre then
  blog(m.name.." immolates itself against "..t.name.."! It is blazing",9)
  t.blazing=true
  destroy(m,"spent")
  return
 end
 if m.sq then
  -- Burrow Within: the squadron is spent, the target gets 3 boarding markers
  blog(m.name.." burrows into "..t.name.."! (3 boarding markers)",9)
  t.boarding+=3
  destroy(m,"spent")
  return
 end
 if has(m,"agitator_ram") then
  blog(m.name.."'s agitator ram stirs up the boarders",9)
  boarding_rolls(t)
  if t.state~="table" then return end
 end
 if has(m,"constriction") then
  local n=2*m.hull.ups
  local use
  if m.side=="p" then
   use=choose_option("Constriction: destroy "..m.name.." to place "..n.." boarding markers on "..t.name.."?",
    {{true,"Yes, constrict"},{false,"No, ram normally"}})
  else
   use=working_ups(m)*2<=m.hull.ups -- AI sacrifices ships that are half wrecked
  end
  if use then
   blog(m.name.." constricts "..t.name.."! ("..n.." boarding markers)",9)
   t.boarding+=n
   destroy(m,"consumed")
   return
  end
 end
 local a,b=ram_ups(m),ram_ups(t)
 -- Impact Beacon markers on the target: spend for +1 upgrade each, or
 -- (Boarding Dynasty) turn them all into boarding markers
 if t.beacons>0 then
  local choice
  if m.side=="p" then
   local opts={{"bonus","Spend "..t.beacons.." beacon(s): +"..t.beacons.." upgrades for this ram"},{"keep","Keep them"}}
   if m.title=="boarding_dynasty" then add(opts,{"board","Turn them into boarding markers"},2) end
   choice=choose_option(t.name.." has "..t.beacons.." beacon marker(s).",opts)
  else
   choice=m.title=="boarding_dynasty" and "board" or "bonus"
  end
  if choice=="bonus" then
   a+=t.beacons
   blog("  "..m.name.." homes in on "..t.beacons.." beacon(s)",SIDE_COL[m.side])
   t.beacons=0
  elseif choice=="board" then
   t.boarding+=t.beacons
   blog("  Boarding Dynasty: "..t.beacons.." beacon(s) become boarding markers",SIDE_COL[m.side])
   t.beacons=0
  end
 end
 if has(t,"castle_compound") then
  m.boarding+=2
  blog("  "..t.name.."'s castle compound boards "..m.name.." (2 boarding markers)",SIDE_COL[t.side])
 end
 if m.title=="asteroid_cracker" and a>=2*b then
  blog(m.name.." cracks "..t.name.." open! (Asteroid Cracker)",9)
  add(bt.booms,{x=(m.x+t.x)/2,y=(m.y+t.y)/2,t=20})
  deal(t,4)
  deal(m,1)
  if t.state=="table" then push(t,ang(t.x-m.x,t.y-m.y),d6()+d6()) end
  return
 end
 local dm,dt=1,1
 if a<b then dm=2 elseif a>b then dt=2 end
 if has(m,"reinforced_ram") then dt+=1 end
 if has(t,"ablative_armor") then dm+=1 end
 if has(m,"reinforced_spine") or has(m,"crumple_hulls") then dm=max(0,dm-1) end
 if has(t,"reinforced_spine") or has(t,"crumple_hulls") then dt=max(0,dt-1) end
 local bump=has(m,"gravity_bumper")
 if has(m,"anti_impact_system") or has(t,"anti_impact_system") then
  -- Anti-Impact System: no damage, both bounce apart 3" per point instead
  blog(m.name.." and "..t.name.." bounce apart (Anti-Impact System)",9)
  local a1=ang(t.x-m.x,t.y-m.y)
  if dt>0 then push(t,a1,dt*3) end
  if dm>0 and m.state=="table" then push(m,a1+0.5,dm*3) end
  return
 end
 blog(m.name.." rams "..t.name.."! ("..dt.." damage dealt, "..dm.." taken)",9)
 add(bt.booms,{x=(m.x+t.x)/2,y=(m.y+t.y)/2,t=20})
 -- these are part of the ram, so check them before the ram damage lands
 local prow,faith,spike=has(m,"chain_prow"),has(m,"faith_of_the_broken"),has(m,"boarding_spike")
 deal(t,dt)
 if m.title=="vulture" and t.state=="dead" then
  blog("  "..m.name.." feeds on the wreck (Vulture)",SIDE_COL[m.side])
  repair(m,1)
 else
  deal(m,dm)
 end
 local broken=0
 for up in all(m.ups) do if up.dis then broken+=1 end end
 if prow and t.state=="table" then
  local bn=block_need(m,{str=1},t)
  local fails=0
  for r in all(roll_dice(2,bn,t.name.." blocks "..m.name.."'s chain prow","to block")) do if r<bn then fails+=1 end end
  blog("  "..m.name.."'s chain prow: "..fails.." of 2 hits get through",fails>0 and 8 or 5)
  deal(t,fails)
 end
 if spike and t.state=="table" then
  t.boarding+=1
  blog("  "..m.name.."'s boarding spike sticks: 1 boarding marker",9)
 end
 if faith and broken>0 and t.state=="table" then
  t.boarding+=broken
  blog("  Faith of the Broken: "..broken.." boarding marker(s) on "..t.name,9)
 end
 if t.state=="table" and b<=a then
  local d=d6()+(bump and d6() or 0)
  push(t,ang(t.x-m.x,t.y-m.y),d)
 end
end

function pull(t,m,d,label)
 blog((label or m.name.."'s tractor beam drags "..t.name).." "..d.."\"",12)
 add(bt.flashes,{x1=m.x,y1=m.y,x2=t.x,y2=t.y,t=30,c=12})
 local a=ang(m.x-t.x,m.y-t.y)
 for i=1,flr(d/0.25) do
  local nx,ny=t.x+cos(a)*0.25,t.y+dsin(a)*0.25
  for o in all(on_table()) do
   if o~=t and not o.sq and dist(nx,ny,o.x,o.y)<t.r+o.r then return end
  end
  for tr in all(bt.terrain) do
   if tr.kind=="planetoid" and dist(nx,ny,tr.x,tr.y)<tr.r+t.r*0.7 then return end
  end
  t.x,t.y=nx,ny
  YIELD()
 end
 shove_squadrons(t)
end

function repair_targets(m)
 local out={}
 for o in all(on_table(m.side)) do
  if o~=m and not o.sq and mdist(m,o)<=4 and is_damaged(o) then add(out,o) end
 end
 return out
end

function tractor_targets(m)
 local out={}
 for o in all(enemies_of(m,true)) do
  if mdist(m,o)<=8 then add(out,o) end
 end
 return out
end

-- placement

function place_ok(m,x,y)
 if x<m.r or x>TABLE_W-m.r or y<m.r or y>TABLE_H-m.r then return false end
 for t in all(bt.terrain) do
  if t.kind=="planetoid" and dist(x,y,t.x,t.y)<t.r+m.r then return false end
 end
 for o in all(on_table()) do
  if o~=m and dist(x,y,o.x,o.y)<o.r+m.r+0.2 then return false end
 end
 return true
end

-- signed distance in inches from a side's deployment zone (<=0 inside)
function zone_sd(side,x,y)
 local zone=(side=="p")==(bt.pzone=="a") and "a" or "b"
 return style_sd(bt.style,zone,x,y)
end

function zone_ok(side,m,x,y)
 return zone_sd(side,x,y)<=0 and place_ok(m,x,y)
end

-- objectives go over 9" from the table edges and both deployment zones
function obj_area(x,y)
 return x>9 and x<TABLE_W-9 and y>9 and y<TABLE_H-9 and zone_sd("p",x,y)>9 and zone_sd("ai",x,y)>9
end

-- is there anywhere left to put an objective?
function obj_room()
 for x=9.5,TABLE_W-9.5,0.5 do
  for y=9.5,TABLE_H-9.5,0.5 do
   if obj_valid(x,y) then return true end
  end
 end
 return false
end

-- each side's zone centre, bounding box and facing, plus the outline dots
-- (player white, AI red; the objective band green)
function zone_setup()
 bt.zinfo,bt.zdots,bt.odots={},{},{}
 for side,col in pairs({p=7,ai=8}) do
  edge_dots(function(x,y) return zone_sd(side,x,y)<=0 end,col,bt.zdots)
  local n,sx,sy,x0,y0,x1,y1=0,0,0,TABLE_W,TABLE_H,0,0
  for x=0.5,TABLE_W,1 do
   for y=0.5,TABLE_H,1 do
    if zone_sd(side,x,y)<=0 then
     n+=1 sx+=x sy+=y
     x0,y0,x1,y1=min(x0,x),min(y0,y),max(x1,x),max(y1,y)
    end
   end
  end
  bt.zinfo[side]={cx=sx/n,cy=sy/n,x0=x0,y0=y0,x1=x1,y1=y1}
 end
 for side in all({"p","ai"}) do
  local z,e=bt.zinfo[side],bt.zinfo[other(side)]
  z.face=ang(e.cx-z.cx,e.cy-z.cy)
 end
 edge_dots(obj_area,3,bt.odots)
end

-- screen dots (every 3px) along the inner edge of the area where f is true
function edge_dots(f,col,out)
 local g,n,m={},(TABLE_W*S-2)\3,(TABLE_H*S-2)\3
 for i=0,n do
  g[i]={}
  for j=0,m do g[i][j]=f((i*3+1)/S,(j*3+1)/S) end
 end
 for i=0,n do
  for j=0,m do
   if g[i][j] and (g[i][j-1]==false or g[i][j+1]==false
    or (g[i-1] and g[i-1][j]==false) or (g[i+1] and g[i+1][j]==false)) then
    add(out,{TX+i*3+1,TY+j*3+1,col})
   end
  end
 end
end

function obj_valid(x,y)
 if not obj_area(x,y) then return false end
 for o in all(bt.objs) do if dist(x,y,o.x,o.y)<=9 then return false end end
 for t in all(bt.terrain) do
  if t.kind=="planetoid" and dist(x,y,t.x,t.y)<t.r+0.5 then return false end
 end
 return true
end

function nearest(x,y,list)
 local best,bd
 for o in all(list) do
  local d=dist(x,y,o.x,o.y)
  if not bd or d<bd then best,bd=o,d end
 end
 return best,bd
end
:: src/battle_scene.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
battle_scene={}

-- build the gui now: a scene switch can happen mid-frame, so draw may run before update
function battle_scene.enter() bt.ui_dirty=false bt_build_ui() end

function battle_scene.update()
 if bt.ui_dirty then bt.ui_dirty=false bt_build_ui() end
 bt.gui:update_all()
 bt_input()
 if bt.co and CO_STATUS(bt.co)~="dead" then
  local ok,err=CO_RESUME(bt.co)
  if not ok then bt.error=tostring(err) printh("battle error: "..bt.error) end
 end
 for f in all(bt.flashes) do f.t-=1 if f.t<=0 then del(bt.flashes,f) end end
 for b in all(bt.booms) do b.t-=1 if b.t<=0 then del(bt.booms,b) end end
 update_explosions()
end

function bt_input()
 local mx,my,mb,wx,wy=mouse()
 mb=mb or 0
 local p
 if mx>=TX and mx<TX+TABLE_W*S and my>=TY and my<TY+TABLE_H*S then
  p={x=(mx-TX)/S,y=(my-TY)/S}
 end
 local moved=(p==nil)~=(bt.mp==nil) or (p and (p.x~=bt.mp.x or p.y~=bt.mp.y))
 bt.mp=p
 bt.hover_m=p and model_at(p,on_table())
 -- the info card follows the hovered model, and stays put while the
 -- mouse is over the panel so its tooltips can be read
 if p then bt.card_m=bt.hover_m elseif mx<PX-2 then bt.card_m=nil end
 -- how long the mouse has rested on the same model (for the status box)
 if bt.hover_m and bt.hover_m==bt.tip_m then bt.tip_t+=1 else bt.tip_m,bt.tip_t=bt.hover_m,0 end
 local lclick=mb&1==1 and bt.last_mb&1==0
 local rclick=mb&2==2 and bt.last_mb&2==0
 bt.last_mb=mb

 -- dice popup: a click while rolling settles all the dice at once; once
 -- settled, only its Continue button (or O/X) lets the battle go on
 local d=bt.dice
 if d then
  local press=btnp(4) or btnp(5)
  if not dice_settled(d) then
   if lclick or press then d.t0=time()-#d.rolls*DICE_STOP end
  elseif press or lclick and d.btn and point_in(mx,my,unpack(d.btn)) then
   d.done=true
  end
  return
 end

 local o=bt.wait_o
 if not o or bt.answer then return end
 if o.wheel then
  local d=wy or 0
  if btnp(0) then d-=1 end
  if btnp(1) then d+=1 end
  if d~=0 then bt.deploy_h=(bt.deploy_h+d/32)%1 bt.pv_dirty=true end
 end
 if o.hover then
  if not p then
   bt.preview=nil
  elseif moved or bt.pv_dirty then
   bt.preview=o.hover(p)
   bt.pv_dirty=false
  end
 end
 if lclick and p and o.click then
  local v=o.click(p)
  if v~=nil then bt.answer={click=v} end
 end
 if rclick and o.cancel then bt.answer={button="cancel"} end
end

function bt_build_ui()
 local gui=create_gui()
 bt.gui=gui
 fb_button(gui,442,1,34,"Menu",function()
  fb_pulldown(376,14,100,{
   {label="Abandon battle",action=function() rec_check() rec_save() set_scene(menu_scene) end},
   {label="Keep fighting"},
  },gui)
 end)
 local o=bt.wait_o
 if o and o.popup then bt_build_popup(gui,o) return end
 local btns=o and o.buttons or {}
 local by=TY+TABLE_H*S-#btns*14
 for i,b in ipairs(btns) do
  fb_button(gui,PX,by+(i-1)*14,476-PX,b[2],function()
   -- ignore taps on buttons left over from an earlier prompt
   if bt.wait_o==o and not bt.answer then bt.answer={button=b[1]} end
  end)
 end
 bt.btn_top=by
end

-- modal list of upgrades (buttons hold the upgrade tables), centred on screen
function bt_build_popup(gui,o)
 local pw,rh=220,14
 local lines=fb_wrap(o.popup,pw-12)
 local head=8+#lines*8
 local ph=head+#o.buttons*rh+6
 local x0,y0=(480-pw)\2,(270-ph)\2
 local box=gui:attach{
  x=x0,y=y0,width=pw,height=ph,
  draw=function(self)
   panel(0,0,self.width,self.height,0,8)
   for i,l in ipairs(lines) do print(l,6,5+(i-1)*8,7) end
  end
 }
 for i,b in ipairs(o.buttons) do
  local val=b[1]
  -- fitted upgrades get damage pips, anything else is a plain label
  local up=type(val)=="table" and val.upg and val
  box:attach{
   x=6,y=head+(i-1)*rh,width=pw-12,height=rh-2,
   draw=function(self)
    local hot=fb_hot(self)
    rectfill(0,0,self.width-1,self.height-1,hot and 13 or 1)
    if not up then
     print(b[2],4,3,hot and 7 or 6)
     -- upgrade definitions (New Strain) and models (Outbreak) explain themselves
     if type(val)=="table" and val.desc then
      tip_area(self.sx,self.sy,self.width,self.height,val.name,upgrade_tip(bt.sel,{upg=val}))
     elseif type(val)=="table" and val.hull then
      tip_area(self.sx,self.sy,self.width,self.height,val.name,model_summary(val))
     end
     return
    end
    tip_area(self.sx,self.sy,self.width,self.height,up.upg.name,upgrade_tip(bt.sel,up))
    local s=up.upg.name
    if up.facing then s..=" ("..up.facing..")" end
    print(s,4,3,hot and 7 or 6)
    for k=1,up.cap do
     local bx=self.width-4-k*5
     rectfill(bx,3,bx+3,self.height-4,k<=up.cap-up.dmg and 11 or 8)
    end
   end,
   tap=function()
    if bt.wait_o==o and not bt.answer then bt.answer={button=val} end
   end
  }
 end
 bt.btn_top=nil
end

-- drawing

-- dice popup (see show_dice): every die tumbles, then they settle one by
-- one, DICE_STOP apart; passes turn green, fails red
function draw_dice()
 local d=bt.dice
 if not d then return end
 local n=#d.rolls
 local per=min(n,10)
 local ds,gap=15,5
 local rows=ceil(n/per)
 local pw=max(180,per*(ds+gap)-gap+24)
 local lines=fb_wrap(d.title or "",pw-12)
 local dy=20+#lines*8
 local ph=dy+rows*(ds+gap)-gap+38
 local x0,y0=(480-pw)\2,(270-ph)\2
 panel(x0,y0,pw,ph,0,7)
 for i,l in ipairs(lines) do print_centered(l,240,y0+5+(i-1)*8,7) end

 -- target: one number, or a range when the dice need different rolls
 local lo,hi=7,0
 for i=1,n do local v=dice_need(d.need,i) lo,hi=min(lo,v),max(hi,v) end
 local tgt="Need "..lo..(hi>lo and "-"..hi or "").."+"..(d.what and " "..d.what or "")
 print_centered(tgt,240,y0+7+#lines*8,10)

 local el=time()-d.t0
 local ok,settled=0,0
 local rx=x0+(pw-(per*(ds+gap)-gap))\2
 for i,r in ipairs(d.rolls) do
  local x=rx+(i-1)%per*(ds+gap)
  local y=y0+dy+(i-1)\per*(ds+gap)
  if el>=i*DICE_STOP then
   settled+=1
   local pass=r>=dice_need(d.need,i)
   if pass then ok+=1 end
   draw_die(x,y,ds,r,pass and 11 or 8)
  else
   -- tumbling: flick through faces and wobble
   local f=flr(time()*14+i*3)%6+1
   draw_die(x,y+flr(sin(time()*3+i/5)*2),ds,f,7)
  end
 end

 local msg=settled<n and "rolling... (click to skip)" or ok.." of "..n.." passed"
 print_centered(msg,240,y0+ph-28,settled<n and 5 or ok>0 and 11 or 8)

 -- continue button, once every die has settled
 if settled==n then
  local bw,bh=70,13
  d.btn={240-bw\2,y0+ph-bh-4,bw,bh}
  local mx,my=mouse()
  draw_button("Continue",d.btn[1],d.btn[2],bw,bh,point_in(mx,my,unpack(d.btn)))
 else
  d.btn=nil
 end
end

local PIPS={
 {{2,2}},
 {{1,1},{3,3}},
 {{1,1},{2,2},{3,3}},
 {{1,1},{3,1},{1,3},{3,3}},
 {{1,1},{3,1},{2,2},{1,3},{3,3}},
 {{1,1},{3,1},{1,2},{3,2},{1,3},{3,3}},
}

function draw_die(x,y,s,v,col)
 rrectfill(x,y,s,s,2,col)
 for p in all(PIPS[v]) do
  local cx,cy=x+p[1]*s\4,y+p[2]*s\4
  rectfill(cx-1,cy-1,cx,cy,0)
 end
end

function px(x) return TX+x*S end
function py(y) return TY+y*S end

-- the table and everything on it except the models. b holds stars, zdots,
-- terrain, mines, rifts, spores and objs (a battle, or a replay frame)
function draw_board(b)
 local W,H=TABLE_W*S,TABLE_H*S
 rectfill(TX,TY,TX+W-1,TY+H-1,0)
 for s in all(b.stars) do pset(TX+s.x,TY+s.y,s.c) end

 -- deployment zones
 for d in all(b.zdots) do pset(d[1],d[2],d[3]) end

 for t in all(b.terrain) do draw_terrain(t) end

 for mn in all(b.mines) do
  local x,y=px(mn.x),py(mn.y)
  circ(x,y,3*S,mn.side=="p" and 1 or 2)
  line(x-2,y-2,x+2,y+2,9) line(x-2,y+2,x+2,y-2,9)
 end

 for r in all(b.rifts) do circ(px(r.x),py(r.y),4*S,r.side=="p" and 1 or 2) circfill(px(r.x),py(r.y),2,13) end
 -- solar wind markers, greyed out while a False Sun outshines them
 local eclipsed=#(b.suns or {})>0
 for w in all(b.winds or {}) do
  local x,y=px(w.x),py(w.y)
  circfill(x,y,2,eclipsed and 5 or 10) circ(x,y,4,eclipsed and 5 or 9)
 end
 for s in all(b.suns or {}) do circ(px(s.x),py(s.y),2*S,10) end
 for sp in all(b.spores) do
  local x,y=px(sp.x),py(sp.y)
  circ(x,y,2*S,3)
  circfill(x,y,1,11)
 end

 for o in all(b.objs) do draw_objective(px(o.x),py(o.y),10) end
end

-- round/phase and objective counts above the table
function draw_top_bar(round,phase,you,ai,loose)
 print(round>0 and "ROUND "..round.."/4 - "..PHASE_NAMES[max(1,phase)] or "SETUP",TX,3,7)
 print("OBJECTIVES  YOU "..you.."  AI "..ai.."  LOOSE "..loose,160,3,10)
end

function battle_scene.draw()
 local W,H=TABLE_W*S,TABLE_H*S
 draw_board(bt)
 if bt.show_obj_band then
  for d in all(bt.odots) do pset(d[1],d[2],d[3]) end
 end

 for m in all(bt.models) do
  if m.state=="table" then draw_model(m) end
 end

 -- highlights
 local blink=(time()*3)\1%2==0
 if bt.highlight and blink then
  for m in all(bt.highlight) do circ(px(m.x),py(m.y),m.r*S+3,10) end
 end
 if bt.sel and bt.sel.state=="table" then
  circ(px(bt.sel.x),py(bt.sel.y),bt.sel.r*S+3+sin(time()*2),7)
 end

 draw_preview(bt.preview)

 for f in all(bt.flashes) do
  line(px(f.x1),py(f.y1),px(f.x2),py(f.y2),f.t%4<2 and 7 or f.c)
 end
 for b in all(bt.booms) do
  circ(px(b.x),py(b.y),(30-b.t)/2,b.t%6<3 and 10 or 9)
 end
 draw_explosions()

 rect(TX-1,TY-1,TX+W,TY+H,5)

 draw_top_bar(bt.round,bt.phase,side_markers("p"),side_markers("ai"),#bt.objs)

 draw_panel()
 draw_log()
 local popup=bt.wait_o and bt.wait_o.popup or bt.dice
 if popup then tips={} end -- only the popup's own tooltips
 bt.gui:draw_all()
 if not popup and bt.hover_m and bt.tip_t>=HOVER_DELAY then draw_status_tip(bt.hover_m) end
 draw_dice()
 draw_tips()

 if bt.error then
  rectfill(0,0,479,30,8)
  print("error: "..sub(bt.error,1,90),2,2,7)
  print(sub(bt.error,91,180),2,12,7)
 end
end

-- explosions (destroyed models): a white flash, a shockwave ring, sparks
-- that cool as they fly out and smoke that drifts and fades. they live in
-- screen pixels so the battle and the replay viewer can both show them.
explosions={}
local SPARK_COLS={7,10,10,9,9,8,8,2} -- hot to cold

-- r: the model's radius in inches, which sets the size of the blast
function explode(x,y,r)
 local s=r*S
 local e={x=px(x),y=py(y),s=s,t=0,life=40+flr(s*3),parts={}}
 for i=1,flr(6+s*4) do
  local a,v=rnd(),(0.4+rnd(1.6))*s/4
  add(e.parts,{x=e.x,y=e.y,dx=cos(a)*v,dy=sin(a)*v,smoke=i%3==0,life=15+rnd(e.life-15)})
 end
 add(explosions,e)
end

function update_explosions()
 for e in all(explosions) do
  e.t+=1
  for p in all(e.parts) do
   p.x+=p.dx p.y+=p.dy
   local drag=p.smoke and 0.9 or 0.95
   p.dx*=drag p.dy*=drag
  end
  if e.t>=e.life then del(explosions,e) end
 end
end

function draw_explosions()
 for e in all(explosions) do
  local t=e.t
  if t<8 then circfill(e.x,e.y,e.s*(1.6-t*0.15),t<3 and 7 or 10) end
  if t<20 then circ(e.x,e.y,e.s+t*e.s/5,t<10 and 9 or 2) end
  for p in all(e.parts) do
   if t<p.life then
    local k=t/p.life
    if p.smoke then circfill(p.x,p.y,1+k*e.s/3,k<0.5 and 5 or 1)
    else pset(p.x,p.y,SPARK_COLS[1+flr(k*#SPARK_COLS)]) end
   end
  end
 end
end

-- nebula colours: kept clear of the side colours (SIDE_COL, SIDE_DIM) and
-- the dark blue of ship bases, so ships stay visible inside them
NEBULA_COL,NEBULA_WISP,NEBULA_SPECK=3,5,11

function draw_terrain(t)
 local x,y,r=px(t.x),py(t.y),t.r*S
 if t.kind=="nebula" then
  circfill(x,y,r,NEBULA_COL)
  for b in all(t.bits) do circfill(x+b.x*S,y+b.y*S,1.5+b.s*2,NEBULA_WISP) end
  for b in all(t.bits) do if b.s>0.8 then pset(x+b.x*S,y+b.y*S,NEBULA_SPECK) end end
 elseif t.kind=="asteroids" then
  circ(x,y,r,5)
  for b in all(t.bits) do circfill(x+b.x*S,y+b.y*S,b.s*1.8,b.s>0.5 and 4 or 5) end
 elseif t.kind=="planetoid" then
  circfill(x,y,r,5)
  circfill(x-r*0.25,y-r*0.25,r*0.65,13)
  circfill(x-r*0.4,y-r*0.4,r*0.25,6)
  circ(x,y,r,1)
 else
  circ(x,y,r,8)
  for b in all(t.bits) do pset(x+b.x*S,y+b.y*S,b.s>0.6 and 10 or b.s>0.3 and 9 or 8) end
 end
 -- bile trail: dangerous to the other side
 if t.bile then circ(x,y,r+1,11) circ(x,y,r+2,3) end
end

function draw_objective(x,y,c)
 line(x,y-3,x+3,y,c) line(x+3,y,x,y+3,c) line(x,y+3,x-3,y,c) line(x-3,y,x,y-3,c)
 pset(x,y,c)
end

function ship_shape(m,x,y,h,col,fill)
 local r=m.r*S
 local cx,cy=px(x),py(y)
 local nx,ny=cx+cos(h)*r*1.25,cy+dsin(h)*r*1.25
 local lx,ly=cx+cos(h+0.38)*r,cy+dsin(h+0.38)*r
 local rx,ry=cx+cos(h-0.38)*r,cy+dsin(h-0.38)*r
 if fill then
  local n=flr(r*2)+2
  for i=0,n do
   local t=i/n
   line(nx,ny,lx+(rx-lx)*t,ly+(ry-ly)*t,fill)
  end
 end
 line(nx,ny,lx,ly,col) line(lx,ly,rx,ry,col) line(rx,ry,nx,ny,col)
end

function draw_sq_shape(m,x,y,col,ghost)
 local cx,cy=px(x),py(y)
 if ghost then circ(cx,cy,3,col) return end
 local r=m.hull.rules
 if r.detonation then circ(cx,cy,2,col) circfill(cx,cy,1,9)
 elseif r.burrow or r.pyre then line(cx,cy-2,cx+2,cy+2,col) line(cx+2,cy+2,cx-2,cy+2,col) line(cx-2,cy+2,cx,cy-2,col)
 elseif r.anti_sq then circ(cx,cy,2,col) pset(cx,cy,col)
 elseif r.anti_ship then rectfill(cx-2,cy-2,cx+2,cy+2,col)
 else circfill(cx,cy,2,col) end
end

function draw_model(m)
 local col=m.activated and SIDE_DIM[m.side] or SIDE_COL[m.side]
 local cx,cy=px(m.x),py(m.y)
 if m.sq then
  draw_sq_shape(m,m.x,m.y,col)
  if m.dmg>0 then pset(cx+3,cy-3,8) end
 else
  circ(cx,cy,m.r*S,1)
  ship_shape(m,m.x,m.y,m.h,7,col)
  -- upgrade health pips
  local n=#m.ups
  local x0=cx-n*1.5
  for i,up in ipairs(m.ups) do
   pset(x0+(i-1)*3,cy+m.r*S+2,up.dis and 8 or up.dmg>0 and 9 or 11)
   pset(x0+(i-1)*3+1,cy+m.r*S+2,up.dis and 8 or up.dmg>0 and 9 or 11)
  end
  if m.held then print("H",cx+m.r*S,cy-m.r*S-4,5) end
 end
 for i=1,m.markers do circfill(cx-m.r*S-2+i*3,cy-m.r*S-3,1,10) end
 if m.blazing then pset(cx-m.r*S-1,cy+1,9) pset(cx-m.r*S-1,cy,10) pset(cx-m.r*S-2,cy+1,8) end
 if m.boarding>0 then circfill(cx+m.r*S+1,cy,1,7) end
 if m.lasers>0 then circfill(cx+m.r*S+1,cy-3,1,14) end
 if m.beacons>0 then circfill(cx+m.r*S+1,cy+3,1,9) end
 if m.scrap>0 then pset(cx-m.r*S-2,cy-2,6) pset(cx-m.r*S-3,cy-2,5) end
 if m.targeting>0 then pset(cx,cy-m.r*S-2,8) end
end

function draw_preview(pv)
 if not pv then return end
 -- enemies the ship could shoot from where it would end up
 for t in all(pv.targets or {}) do line(px(pv.x),py(pv.y),px(t.x),py(t.y),8) end
 if pv.objghost then
  local p=pv.objghost
  draw_objective(px(p.x),py(p.y),pv.ok and 10 or 8)
 end
 if pv.ring then circ(px(pv.ring.x),py(pv.ring.y),pv.ring.r*S,5) end
 if pv.mine then
  local x,y=px(pv.mine.x),py(pv.mine.y)
  circ(x,y,3*S,pv.ok and 1 or 2)
  line(x-2,y-2,x+2,y+2,pv.ok and 9 or 8) line(x-2,y+2,x+2,y-2,pv.ok and 9 or 8)
 end
 if pv.ghost then
  local m=pv.ghost
  local c=pv.ok and 11 or 8
  if m.sq then draw_sq_shape(m,pv.x,pv.y,c,true)
  else circ(px(pv.x),py(pv.y),m.r*S,1) ship_shape(m,pv.x,pv.y,pv.h,c) end
 end
 if pv.pts then
  local m=bt.sel
  for i=1,#pv.pts,2 do
   local p=pv.pts[i]
   pset(px(p.x),py(p.y),6)
  end
  if m then
   local c=pv.off and 8 or 6
   if m.sq then draw_sq_shape(m,pv.x,pv.y,c,true)
   else ship_shape(m,pv.x,pv.y,pv.h,c) end
   local notes={}
   if pv.off then add(notes,"leaves table") end
   if pv.blocked then add(notes,"blocked") end
   if pv.halved then add(notes,"slowed") end
   if pv.engaged then add(notes,"engages") end
   if pv.contact then add(notes,"RAM!") end
   if pv.noram then add(notes,"can't reach") end
   if pv.dangerous and #pv.dangerous>0 then add(notes,"debris!") end
   if pv.mines and #pv.mines>0 then add(notes,"mine!") end
   if pv.pickups and #pv.pickups>0 then add(notes,"objective") end
   local s=""
   for n in all(notes) do s..=(s=="" and "" or ", ")..n end
   if s~="" then print(s,px(pv.x)+6,py(pv.y)-3,pv.off and 8 or 10) end
  end
 end
 if pv.aim then
  local m,t=pv.from,pv.aim
  line(px(m.x),py(m.y),px(t.x),py(t.y),5)
  print("hit "..pv.hit.."+ / block "..pv.block.."+",px(t.x)+6,py(t.y)-3,10)
 end
end

function draw_panel()
 local x,y,w=PX,TY,476-PX
 panel(x-2,y,w+4,TABLE_H*S,0,5)
 local m=bt.card_m or bt.sel
 if m then draw_card(m,x+2,y+3,w-4) end

 -- prompt above the buttons
 if bt.prompt then
  local lines=fb_wrap(bt.prompt,w-4)
  local ty=(bt.btn_top or y+TABLE_H*S)-4-#lines*8
  for i,l in ipairs(lines) do print(l,x+2,ty+(i-1)*8,bt.wait_o and 10 or 6) end
 end
end

function draw_card(m,x,y,w)
 local h=m.hull
 print(m.name,x,y,SIDE_COL[m.side])
 y+=10
 print(h.class..(m.side=="ai" and " - "..m.ai_type.." AI" or ""),x,y,5)
 y+=9
 print("Move "..speed(m,"move").."\" Cruise "..speed(m,"cruise").."\"",x,y,6) y+=8
 print("Evasion "..h.eva.."+ Toughness "..h.tou.."+",x,y,6) y+=8
 local tur=h.rng>0 and "Turret "..h.rng.."\" A"..h.att.." S"..(h.str+(has(m,"nuclear_ammo") and 1 or 0)) or "No turret"
 print(tur,x,y,6) y+=10
 -- hull keywords (plus a Specialised turret rule), hoverable
 local kws=kw_list(m.fac,h.rules)
 if m.turret_rule then add(kws,find_keyword(m.turret_rule,m.fac)) end
 if #kws>0 then
  local lay,n=layout_tokens("Special:",kws,w)
  draw_tokens(lay,x,y,6,12,0,0)
  y+=n*8+2
 end
 if m.sq then
  print("Damage "..m.dmg.."/"..sq_hp(m),x,y,m.dmg>0 and 9 or 6) y+=8
 end
 for up in all(m.ups) do
  local c=up.dis and 5 or up.dmg>0 and 9 or 7
  local s=up.upg.name
  if up.facing then s..=" ("..sub(up.facing,1,1)..")" end
  print(s,x,y,c)
  tip_area(x,y-1,w-4*up.cap-2,8,up.upg.name,upgrade_tip(m,up))
  for i=1,up.cap do
   local bx=x+w-i*4
   rectfill(bx,y+1,bx+2,y+4,i<=up.cap-up.dmg and 11 or 8)
  end
  y+=8
 end
 if m.hero then
  local e=by_id(m.fac.heroes,m.hero)
  print("Hero: "..e.name..(m.evolution>0 and " (evolve ready)" or ""),x,y,12)
  tip_area(x,y-1,w,8,e.name,e.desc)
  y+=8
 end
 if m.title then
  local e=by_id(m.fac.titles,m.title)
  print("Title: "..e.name,x,y,12)
  tip_area(x,y-1,w,8,e.name,e.desc)
  y+=8
 end
 local st=model_status(m)
 if #st>0 then
  local lay,n=layout_tokens("",st,w)
  draw_tokens(lay,x,y,10,10,0,0)
 end
end

-- markers and conditions on a model, as {name,desc} tokens
function model_status(m)
 local st={}
 if m.markers>0 then add(st,{name=m.markers.." objective(s)",desc="Carrying objective markers. They are dropped where the ship is destroyed."}) end
 if m.held then add(st,{name="easy target",desc="Used a hold action: models shooting at this ship always hit on 2+ until it moves again."}) end
 if m.blazing then add(st,find_keyword("blazing") or {name="blazing",desc=""}) end
 if m.boarding>0 then add(st,{name=m.boarding.." boarders",desc=find_keyword("boarding").desc}) end
 if specter_hidden(m) then add(st,{name="hidden",desc="Specter: can't be shot until it shoots, takes damage or carries an objective."}) end
 if m.beacons>0 then add(st,{name=m.beacons.." beacon(s)",desc=find_keyword("beacon").desc}) end
 if m.scrap>0 then add(st,{name=m.scrap.." scrap",desc=find_keyword("scrapper").desc}) end
 if m.targeting>0 then add(st,{name=m.targeting.." targeting token(s)",desc="Communications Master: when this ship fails to block a hit, a token is removed to deal +1 damage."}) end
 if m.coolant>0 then add(st,{name=m.coolant.." coolant",desc="Coolant Tether: removed when firing to ignore the overheating rule."}) end
 if m.twin then add(st,{name="phantasm?",desc="Phantasm: one of two identical copies. The first to act or be targeted is real; the other fades away."}) end
 if m.lasers>0 then add(st,{name=m.lasers.." laser marker(s)",desc=find_keyword("spotting").desc}) end
 if m.state=="table" and #engaged_list(m)>0 then add(st,{name="engaged",desc="Within 2\" of an enemy squadron: engaged squadrons can't move, and may only shoot at squadrons they are engaged with."}) end
 if m.lockdown then add(st,{name="locked down",desc="Maximum Lockdown: until its next activation, ignores damage on a 4+."}) end
 if m.activated then add(st,{name="activated",desc="This model has already activated this round."}) end
 return st
end

-- plain-text summary of a model (for tooltips)
function model_summary(m)
 local s=m.hull.class
 if m.sq then s..="\nDamage "..m.dmg.."/"..sq_hp(m) end
 for up in all(m.ups) do
  s..="\n"..up.upg.name..": "..(up.dis and "disabled" or up.dmg.."/"..up.cap.." damage")
 end
 for e in all(model_status(m)) do s..="\n"..e.name end
 return s
end

-- tooltip text for a fitted upgrade: stats, keywords and rules text
function upgrade_tip(m,up)
 local u=up.upg
 local fac=m and m.fac
 local s=up.dis and "DISABLED. " or ""
 if up.dmg and up.dmg>0 and not up.dis then s..="Damaged "..up.dmg.."/"..up.cap..". " end
 if u.weapon then
  local kws=kw_list(fac,u.rules)
  s..=weapon_stats(u)..(up.facing and ", "..up.facing.." facing" or "")
  for k in all(kws) do s..="\n"..k.name..": "..k.desc end
  if u.desc~="No special rules." and #kws==0 then s..="\n"..u.desc end
  return s
 end
 return s..u.desc
end

HOVER_DELAY=8 -- frames the mouse rests on a model before its status box shows

-- floating status box for the model under the mouse. status is a list of
-- condition names; in battle it comes from model_status()
function draw_status_tip(m,status)
 local rows={} -- {text,col,up}
 add(rows,{m.name,SIDE_COL[m.side]})
 add(rows,{m.hull.class..(m.state~="table" and " ("..m.state..")" or ""),5})
 if m.sq then
  add(rows,{"Damage "..m.dmg.."/"..sq_hp(m),m.dmg>0 and 9 or 6})
 end
 for up in all(m.ups) do
  local s=up.upg.name..(up.facing and " ("..sub(up.facing,1,1)..")" or "")
  add(rows,{s,up.dis and 5 or up.dmg>0 and 9 or 7,up})
 end
 if m.hero then add(rows,{"Hero: "..by_id(m.fac.heroes,m.hero).name,12}) end
 if m.title then add(rows,{"Title: "..by_id(m.fac.titles,m.title).name,12}) end
 if not status then
  status={}
  for e in all(model_status(m)) do add(status,e.name) end
 end
 local w=150
 local stl=#status>0 and fb_wrap(join(status),w-8) or {}
 local h=6+#rows*8+#stl*8
 local mx,my=mouse()
 local x=min(mx+12,479-w)
 local y=my+12
 if y+h>269 then y=max(0,my-h-6) end
 panel(x,y,w,h,0,SIDE_COL[m.side])
 local ly=y+3
 for r in all(rows) do
  print(r[1],x+4,ly,r[2])
  local up=r[3]
  if up then
   for k=1,up.cap do
    local bx=x+w-4-k*4
    rectfill(bx,ly+1,bx+2,ly+4,k<=up.cap-up.dmg and 11 or 8)
   end
  end
  ly+=8
 end
 for l in all(stl) do print(l,x+4,ly,10) ly+=8 end
end

function draw_log()
 local y=TY+TABLE_H*S+3
 local n=#bt.logs
 for i=max(1,n-3),n do
  local l=bt.logs[i]
  print(sub(l.s,1,94),TX,y,l.c)
  y+=8
 end
end
:: src/battle_setup.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- battle setup scene: pick your fleet and the AI's
-- bs.ai: 0 = generate a random fleet, -1 = random saved fleet, k = saved fleet k
-- bs.aifac: faction for generated fleets, 0 = random, k = FACTION_ORDER[k]
-- bs.deploy: deployment style, 0 = random, k = DEPLOY_STYLES[k]

battle_setup_scene={}
bs={pi=1,ai=0,aifac=0,deploy=0,challenge=false}

function battle_setup_scene.enter()
 if not fleets then load_fleets() end
 bs.pi=mid(1,bs.pi,max(1,#fleets))
 if bs.ai>#fleets then bs.ai=0 end
 bs.msg=nil
 bs_build()
end

function battle_setup_scene.update()
 bs.gui:update_all()
 if bs.rebuild then bs.rebuild=false bs_build() end
end

function battle_setup_scene.draw()
 big_text("BATTLE SETUP",241,25,2,0)
 big_text("BATTLE SETUP",240,24,2,7)
 bs.gui:draw_all()
end

function bs_ai_label()
 if bs.ai==0 then return "Random fleet (generated)" end
 if bs.ai==-1 then return "Random saved fleet" end
 return fleets[bs.ai].name.." ("..faction_of(fleets[bs.ai]).name..")"
end

function bs_aifac_label()
 return bs.aifac==0 and "Random faction" or FACTION_ORDER[bs.aifac].name
end

-- little table map of a deployment style, a pixel per 2": zone A light, zone B dark
function bs_deploy_preview(x,y)
 local st=DEPLOY_STYLES[bs.deploy]
 rectfill(x,y,x+37,y+25,0)
 if st then
  for i=0,35 do
   for j=0,23 do
    local u,v=i*2+1,j*2+1
    if style_sd(st,"a",u,v)<=0 then pset(x+1+i,y+1+j,6)
    elseif style_sd(st,"b",u,v)<=0 then pset(x+1+i,y+1+j,5) end
   end
  end
 else
  print_centered("?",x+19,y+9,6)
 end
 rect(x,y,x+37,y+25,5)
end

function bs_build()
 local gui=create_gui()
 bs.gui=gui
 local x0,y0,w=100,50,280

 if #fleets==0 then
  gui:attach{
   x=x0,y=y0,width=w,height=60,
   draw=function(self)
    panel(0,0,self.width,self.height,0,5)
    print_centered("You don't have any fleets yet.",w\2,18,7)
    print_centered("Build one in the Fleet Builder first.",w\2,30,6)
   end
  }
  fb_button(gui,x0,y0+68,60,"Back",function() set_scene(menu_scene) end)
  return
 end

 local f=fleets[bs.pi]
 gui:attach{
  x=x0,y=y0,width=w,height=186,
  draw=function(self)
   panel(0,0,self.width,self.height,0,5)
   print("YOUR FLEET",8,8,13)
   print(f.name,24,22,7)
   local issues=fleet_issues(f)
   print(faction_of(f).name..", "..fleet_pts(f).."/"..f.limit.." pts",24,32,6)
   if #issues>0 then print("! "..issues[1],24,42,8) else print("Fleet ready",24,42,11) end
   print("AI FLEET",8,56,13)
   print(bs_ai_label(),24,70,7)
   if bs.ai==0 then print(bs_aifac_label(),24,84,6) end
   print("DEPLOYMENT",8,100,13)
   local st=DEPLOY_STYLES[bs.deploy]
   print(st and st.name or "Random style",24,114,7)
   print(st and st.desc or "Rolled when the battle starts",24,126,6)
   bs_deploy_preview(self.width-66,98)
   print("CHALLENGE BONUS",8,140,13)
   print("AI gets +1 to hit when not ahead",72,152,5)
   print("on objectives (+1 tou when behind)",72,160,5)
   if bs.msg then print(bs.msg,8,174,8) end
  end
 }

 fb_button(gui,x0+8,y0+20,12,"<",function() bs.pi=(bs.pi-2)%#fleets+1 bs.rebuild=true end)
 fb_button(gui,x0+w-20,y0+20,12,">",function() bs.pi=bs.pi%#fleets+1 bs.rebuild=true end)
 fb_button(gui,x0+8,y0+68,12,"<",function() bs.ai=bs.ai%(#fleets+2)-1 bs.rebuild=true end)
 fb_button(gui,x0+w-20,y0+68,12,">",function() bs.ai=(bs.ai+2)%(#fleets+2)-1 bs.rebuild=true end)
 if bs.ai==0 then
  local n=#FACTION_ORDER+1
  fb_button(gui,x0+8,y0+82,12,"<",function() bs.aifac=(bs.aifac-1)%n bs.rebuild=true end)
  fb_button(gui,x0+w-20,y0+82,12,">",function() bs.aifac=(bs.aifac+1)%n bs.rebuild=true end)
 end
 local nd=#DEPLOY_STYLES+1
 fb_button(gui,x0+8,y0+112,12,"<",function() bs.deploy=(bs.deploy-1)%nd bs.rebuild=true end)
 fb_button(gui,x0+w-20,y0+112,12,">",function() bs.deploy=(bs.deploy+1)%nd bs.rebuild=true end)
 fb_button(gui,x0+24,y0+152,40,bs.challenge and "On" or "Off",function()
  bs.challenge=not bs.challenge bs.rebuild=true
 end)

 fb_button(gui,x0,y0+194,60,"Back",function() set_scene(menu_scene) end)
 fb_button(gui,x0+w-90,y0+194,90,"Start Battle",function()
  if fleet_ship_count(f)==0 then bs.msg="Your fleet needs a ship that deploys normally." return end
  local af
  if bs.ai==0 then
   local fac=bs.aifac==0 and pick(FACTION_ORDER) or FACTION_ORDER[bs.aifac]
   af=gen_ai_fleet(f.limit,fac)
  elseif bs.ai==-1 then
   local opts={}
   for i,g in ipairs(fleets) do if i~=bs.pi and fleet_ship_count(g)>0 then add(opts,g) end end
   af=#opts>0 and pick(opts) or gen_ai_fleet(f.limit,pick(FACTION_ORDER))
  else
   af=fleets[bs.ai]
  end
  bt_start(f,af,bs.challenge,bs.deploy)
 end)
end
:: src/faction_browser.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- faction browser scene: pick a faction on the left and a category tab,
-- then scroll through its entries. built with picotron's gui library.

browser_scene={}
fbr={fi=1,tab=1}
BROWSER_TABS={"Ships","Systems","Weapons","Heroes","Titles","Keywords"}

function browser_scene.enter() fbr_build() end

function browser_scene.update()
 fbr.gui:update_all()
 if fbr.rebuild then fbr.rebuild=false fbr_build() end
end

function browser_scene.draw()
 fbr.gui:draw_all()
 draw_tips()
end

function sorted(t)
 for i=2,#t do
  local v,j=t[i],i-1
  while j>=1 and t[j]>v do t[j+1]=t[j] j-=1 end
  t[j+1]=v
 end
 return t
end

function join(t,sep)
 local s=""
 for e in all(t) do s..=(s=="" and "" or sep or ", ")..e end
 return s
end

function rule_names(fac,rules)
 local out={}
 for k in pairs(rules or {}) do add(out,keyword_name(fac,k)) end
 return sorted(out)
end

-- entries for one tab: tables {name,right,sub,text} or group heading strings
function fbr_entries(fac,tab)
 local out={}
 -- faction entries first, then the core rules ones, under headings
 local function grouped(list,fn)
  local last
  for e in all(list) do
   local g=e.faction_only and string.upper(fac.name) or "CORE RULES"
   if g~=last and (e.faction_only or last) then add(out,g) end
   last=g
   add(out,fn(e))
  end
 end
 local name=BROWSER_TABS[tab]
 if name=="Ships" then
  -- most expensive first (stable, so equal costs keep the sheet order)
  local ships={}
  for h in all(fac.ships) do
   local j=#ships
   while j>=1 and ships[j].pts<h.pts do j-=1 end
   add(ships,h,j+1)
  end
  for h in all(ships) do
   local text={
    "Move "..h.mv.."\"  Cruise "..h.cr.."\"   Turret "..(h.rng>0 and weapon_stats(h) or "none"),
    "Evasion "..h.eva.."+  Toughness "..h.tou.."+",
   }
   add(out,{name=h.name,right=h.pts.."pts",kws=kw_list(fac,h.rules),
    sub=h.class..(h.ups>0 and " ("..h.ups.." upgrade"..(h.ups==1 and "" or "s")..")" or ""),text=text})
  end
 elseif name=="Systems" or name=="Weapons" then
  local list={}
  for u in all(fac.upgrades) do
   if (u.weapon or false)==(name=="Weapons") then add(list,u) end
  end
  grouped(list,function(u)
   if not u.weapon then return {name=u.name,text={u.desc}} end
   local kws=kw_list(fac,u.rules)
   local text={}
   if not u.auto_desc or #kws==0 then add(text,u.desc) end
   return {name=u.name,right=weapon_stats(u),text=text,kws=kws}
  end)
 elseif name=="Heroes" or name=="Titles" then
  grouped(name=="Heroes" and fac.heroes or fac.titles,function(e)
   return {name=e.name,right=e.pts.."pts",text={e.desc}}
  end)
 else
  grouped(faction_keywords(fac),function(k) return {name=k.name,text={k.desc}} end)
 end
 return out
end

function fbr_count(fac,tab)
 local n=0
 for e in all(fbr_entries(fac,tab)) do if type(e)=="table" then n+=1 end end
 return n
end

function fbr_build()
 local gui=create_gui()
 fbr.gui=gui
 local fac=FACTION_ORDER[fbr.fi]

 gui:attach{
  x=0,y=0,width=430,height=20,
  draw=function(self)
   print("FACTION BROWSER",6,6,7)
   print(fac.name,96,6,12)
  end
 }
 fb_button(gui,440,4,36,"Back",function() set_scene(menu_scene) end)

 -- faction list
 local lp=gui:attach{
  x=4,y=22,width=130,height=244,
  draw=function(self) panel(0,0,self.width,self.height,0,5) end
 }
 for i,f in ipairs(FACTION_ORDER) do
  lp:attach{
   x=2,y=3+(i-1)*14,width=126,height=13,
   draw=function(self)
    local sel=i==fbr.fi
    if sel then rectfill(0,0,self.width-1,self.height-1,1) rectfill(0,0,1,self.height-1,8)
    elseif fb_hot(self) then rectfill(0,0,self.width-1,self.height-1,1) end
    print(f.name,5,3,sel and 7 or 6)
   end,
   tap=function() fbr.fi=i fbr.rebuild=true end
  }
 end

 -- category tabs
 -- size each tab to its label, then share out the spare width
 local labels,total={},0
 for i,t in ipairs(BROWSER_TABS) do
  labels[i]=t.." "..fbr_count(fac,i)
  total+=text_w(labels[i])
 end
 local pad=max(4,(338-total)\#BROWSER_TABS)
 local tx=138
 for i,t in ipairs(BROWSER_TABS) do
  local label=labels[i]
  local tw=text_w(label)+pad
  if i==#BROWSER_TABS then tw=476-tx end
  local x0=tx
  tx+=tw
  gui:attach{
   x=x0,y=22,width=tw-2,height=13,
   draw=function(self)
    local sel=i==fbr.tab
    rectfill(0,0,self.width-1,self.height-1,sel and 13 or (fb_hot(self) and 5 or 1))
    print_centered(label,self.width\2,3,sel and 0 or 6)
   end,
   tap=function() fbr.tab=i fbr.rebuild=true end
  }
 end

 -- entries
 local rp=gui:attach{
  x=138,y=36,width=338,height=230,
  draw=function(self) panel(0,0,self.width,self.height,0,5) end
 }
 local box=rp:attach{x=2,y=2,width=334,height=226}
 local tw2=box.width-8-12
 local rows={}
 local y=0
 for e in all(fbr_entries(fac,fbr.tab)) do
  if type(e)=="string" then
   add(rows,{y=y,h=12,head=e})
   y+=12
  else
   local lines={}
   for para in all(e.text or {}) do
    for l in all(fb_wrap(para,tw2)) do add(lines,l) end
   end
   local lay,kn
   if e.kws and #e.kws>0 then lay,kn=layout_tokens("Special:",e.kws,tw2) end
   local h=12+(e.sub and 8 or 0)+#lines*8+(kn or 0)*8+4
   add(rows,{y=y,h=h,e=e,lines=lines,lay=lay})
   y+=h
  end
 end
 local list=box:attach{x=0,y=0,width=box.width-8,height=max(box.height,y),clip_to_parent=true}
 for r in all(rows) do
  list:attach{
   x=0,y=r.y,width=list.width,height=r.h,clip_to_parent=true,
   draw=function(self)
    if r.head then
     print(r.head,6,4,12)
     line(text_w(r.head)+10,7,self.width-6,7,1)
     return
    end
    local e=r.e
    rectfill(4,1,self.width-5,self.height-2,1)
    print(e.name,8,4,7)
    if e.right then print_right(e.right,self.width-9,4,10) end
    local ly=13
    if e.sub then print(e.sub,8,ly,13) ly+=8 end
    for l in all(r.lines) do print(l,8,ly,6) ly+=8 end
    if r.lay then draw_tokens(r.lay,8,ly,6,12,self.sx,self.sy,box) end
   end
  }
 end
 box:attach_scrollbars{autohide=true}
end
:: src/factions.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- faction registry
--
-- each file in factions/ calls def_faction{...} with:
--  id, name
--  ships    list of {id,name,class,ups,pts,mv,cr,rng,att,str,eva,tou,rules,special}
--           class is Heavy/Medium/Light/Squadron; ups is the upgrade count
--           (0 for squadrons); special is the text shown in the builder.
--           optional: caps={front=,sides=,rear=} weapons per facing (default 1),
--           fit=n upgrades actually fitted (default ups), allowed={ids}
--  heroes   the faction's own heroes: {id,name,pts,desc}
--  titles   the faction's own titles: {id,name,pts,desc}
--  keywords the faction's special rules: {id,name,desc}, id = the rules flag
--  upgrades the faction's own systems and weapons: {id,name,desc} or
--           {id,name,weapon=true,rng,att,str,rules,desc}
-- the core rules heroes, titles and upgrades are added after the faction's
-- own automatically.
--
-- rules flags the battle engine understands:
--  weapons & turrets: anti_ship anti_sq deadly overheat blast boarding sniper
--                     twin broadside agitator guillotine lineage tainted vector
--  ships:             outbreak burrow detonation
-- systems, heroes and titles are recognised by id (see battle_rules.lua).

FACTIONS={}
FACTION_ORDER={}
DEFAULT_FACTION="human_defense_force" -- for fleets saved before factions existed

function def_faction(f)
 f.ship_ids={}
 for s in all(f.ships) do
  s.rules=s.rules or {}
  s.fit=s.fit or s.ups
  s.caps=s.caps or {front=1,sides=1,rear=1}
  f.ship_ids[s.id]=s
 end
 -- factions get their own upgrades, heroes and titles plus all the core ones
 f.upgrades=with_core(f.upgrades,CORE_UPGRADES)
 f.heroes=with_core(f.heroes,CORE_HEROES)
 f.titles=with_core(f.titles,CORE_TITLES)
 f.keywords=f.keywords or {}
 for u in all(f.upgrades) do
  u.rules=u.rules or {}
  if u.rules.broadside then u.facings={"sides"} end
  if u.rules.figurehead or u.rules.spinal then u.facings={"front"} end
  if u.rules.tail then u.facings={"rear"} end
  -- weapons with no written rules text describe their keywords instead
  if u.weapon and u.desc=="No special rules." and next(u.rules) then
   local s=""
   for k in all(kw_list(f,u.rules)) do s..=(s=="" and "" or " ")..k.name..": "..k.desc end
   u.desc,u.auto_desc=s,true
  end
 end
 FACTIONS[f.id]=f
 add(FACTION_ORDER,f)
 return f
end

-- every keyword a faction's list can show: its own, then the core ones its
-- ships and upgrades actually use
function faction_keywords(fac)
 local used={}
 for s in all(fac.ships) do for k in pairs(s.rules) do used[k]=true end end
 for u in all(fac.upgrades) do for k in pairs(u.rules) do used[k]=true end end
 local out={}
 for k in all(fac.keywords) do k.faction_only=true add(out,k) end
 for k in all(CORE_KEYWORDS) do
  if used[k.id] and not by_id(out,k.id) then add(out,k) end
 end
 return out
end

-- any keyword by rules flag, looking in the faction first
function find_keyword(id,fac)
 local k=(fac and by_id(fac.keywords,id)) or by_id(CORE_KEYWORDS,id)
 if k then return k end
 for f in all(FACTION_ORDER) do
  k=by_id(f.keywords,id)
  if k then return k end
 end
end

-- keyword tables for a rules flag set, sorted by name
function kw_list(fac,rules)
 local out={}
 for id in pairs(rules or {}) do
  add(out,find_keyword(id,fac) or {name=id,desc=""})
 end
 for i=2,#out do
  local v,j=out[i],i-1
  while j>=1 and out[j].name>v.name do out[j+1]=out[j] j-=1 end
  out[j+1]=v
 end
 return out
end

function keyword_name(fac,id)
 local k=by_id(fac.keywords,id) or by_id(CORE_KEYWORDS,id)
 return k and k.name or id
end

-- a faction's own entries (marked faction_only) followed by the core ones;
-- an own entry with the same id as a core one replaces it
function with_core(own,core)
 if own==core then return core end
 local out={}
 for e in all(own or {}) do e.faction_only=true add(out,e) end
 for e in all(core) do
  if not by_id(out,e.id) then add(out,e) end
 end
 return out
end


function faction_of(fleet) return FACTIONS[fleet.faction] or FACTIONS[DEFAULT_FACTION] end
function hull_of(fac,kind) return fac.ship_ids[kind] end

function by_id(list,id)
 for e in all(list) do if e.id==id then return e end end
end
:: src/fleet.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- fleets & units. a fleet belongs to one faction; its units refer to that
-- faction's ships, heroes, titles and upgrades by id.

FACINGS={"front","sides","rear"}

function weapon_stats(w)
 return w.rng.."\" A"..(w.rules and w.rules.guillotine and "X" or w.att).." S"..w.str
end

function upgrade_info(upg)
 if upg.weapon then
  return upg.name.." (weapon) - "..weapon_stats(upg)..". "..upg.desc
 end
 return upg.name.." (system) - "..upg.desc
end

-- units

function new_unit(kind) return {kind=kind,ups={}} end

function copy_unit(u)
 local c={kind=u.kind,hero=u.hero,title=u.title,ups={}}
 for up in all(u.ups) do add(c.ups,{id=up.id,facing=up.facing}) end
 return c
end

function unit_pts(u,fac)
 local h=hull_of(fac,u.kind)
 local p=h.pts
 local off=h.rules.rebel_hq and 5 or 0 -- Rebel HQ: heroes and titles -5pts
 if u.hero then p+=max(0,by_id(fac.heroes,u.hero).pts-off) end
 if u.title then p+=max(0,by_id(fac.titles,u.title).pts-off) end
 return p
end

function unit_has(u,id)
 for up in all(u.ups) do if up.id==id then return true end end
 return false
end

-- facings a weapon could be mounted on (ignoring 'except', so a mounted
-- weapon's own facing counts as free). caps is the hull's weapons per facing.
DEFAULT_CAPS={front=1,sides=1,rear=1}
function free_facings(ups,upg,except,caps)
 caps=caps or DEFAULT_CAPS
 local res={}
 for fc in all(upg.facings or FACINGS) do
  local used=0
  for up in all(ups) do
   if up~=except and up.facing==fc then used+=1 end
  end
  if used<(caps[fc] or 1) then add(res,fc) end
 end
 return res
end

function can_add_upgrade(u,upg,fac)
 local h=hull_of(fac,u.kind)
 if #u.ups>=h.fit or unit_has(u,upg.id) then return false end
 if h.allowed and not has_val(h.allowed,upg.id) then return false end
 return not upg.weapon or #free_facings(u.ups,upg,nil,h.caps)>0
end

function add_upgrade(u,upg,fac)
 local up={id=upg.id}
 local caps=fac and hull_of(fac,u.kind).caps
 if upg.weapon then up.facing=free_facings(u.ups,upg,nil,caps)[1] end
 add(u.ups,up)
end

function cycle_facing(u,up,fac)
 local opts=free_facings(u.ups,by_id(fac.upgrades,up.id),up,hull_of(fac,u.kind).caps)
 if #opts<2 then return end
 local i=1
 for k,fc in ipairs(opts) do if fc==up.facing then i=k end end
 up.facing=opts[i%#opts+1]
end

-- fleets

function new_fleet(n,faction)
 return {name="Fleet "..n,faction=faction,limit=300,force_org=true,units={}}
end

function fleet_pts(f)
 local fac=faction_of(f)
 local p=0
 for u in all(f.units) do p+=unit_pts(u,fac) end
 return p
end

function fleet_ship_count(f)
 local fac=faction_of(f)
 local n=0
 for u in all(f.units) do
  local h=hull_of(fac,u.kind)
  if h.ups>0 and not h.rules.outbreak then n+=1 end
 end
 return n
end

function fleet_issues(f)
 local fac=faction_of(f)
 local out={}
 local pts,L=fleet_pts(f),f.limit
 if pts>L then add(out,"Over points limit ("..pts.."/"..L..")") end
 local heroes,ships,sqds,copies=0,0,0,{}
 for u in all(f.units) do
  local h=hull_of(fac,u.kind)
  if u.hero then heroes+=1 end
  if h.ups==0 then
   sqds+=1
  else
   ships+=1
   copies[u.kind]=(copies[u.kind] or 0)+1
   if #u.ups<h.fit then
    add(out,h.name.." needs "..(h.fit-#u.ups).." more upgrade(s)")
   end
  end
 end
 if fleet_ship_count(f)==0 then add(out,"Fleet needs at least one ship that deploys normally") end
 if f.force_org then
  if heroes>L\200 then add(out,"Too many heroes (max "..(L\200)..")") end
  for h in all(fac.ships) do
   if (copies[h.id] or 0)>L\150 then
    add(out,"Too many "..h.name.."s (max "..(L\150)..")")
   end
  end
  if ships>L\50 then add(out,"Too many ships (max "..(L\50)..")") end
  if sqds>L\35 then add(out,"Too many squadrons (max "..(L\35)..")") end
 end
 return out
end

-- random legal-ish fleet for the AI, using only rules the AI can play
function gen_ai_fleet(L,fac)
 local f=new_fleet(1,fac.id)
 f.name,f.limit=fac.name,L
 local pts,ships,copies=0,0,{}
 local max_ships,max_copies=max(1,L\50),max(1,L\150)
 local function ship_opts(outbreak)
  local opts={}
  for h in all(fac.ships) do
   if h.ups>0 and (h.rules.outbreak or false)==outbreak and pts+h.pts<=L
    and ships<max_ships and (copies[h.id] or 0)<max_copies then add(opts,h) end
  end
  return opts
 end
 local function add_ship(h)
  local u=new_unit(h.id)
  for i=1,200 do
   if #u.ups>=h.fit then break end
   local upg=pick(fac.upgrades)
   if can_add_upgrade(u,upg,fac) then add_upgrade(u,upg,fac) end
  end
  add(f.units,u)
  pts+=h.pts ships+=1 copies[h.id]=(copies[h.id] or 0)+1
 end
 while true do
  local opts=ship_opts(false)
  if #opts==0 or (ships>=2 and rnd()<0.2) then break end
  add_ship(pick(opts))
 end
 -- outbreak ships only appear when enemies die, so keep them a side dish
 if ships>=2 and rnd()<0.6 then
  local opts=ship_opts(true)
  if #opts>0 then add_ship(pick(opts)) end
 end
 local heroes=0
 local ai_heroes,ai_titles={},{}
 for e in all(fac.heroes) do if e.ai~=false then add(ai_heroes,e) end end
 for e in all(fac.titles) do if e.ai~=false then add(ai_titles,e) end end
 for u in all(f.units) do
  local hr=#ai_heroes>0 and pick(ai_heroes)
  if hr and heroes<L\200 and pts+hr.pts<=L and rnd()<0.3 then u.hero=hr.id pts+=hr.pts heroes+=1 end
  local t=#ai_titles>0 and pick(ai_titles)
  if t and pts+t.pts<=L and rnd()<0.3 then u.title=t.id pts+=t.pts end
 end
 local sqds=0
 while sqds<L\35 do
  local opts={}
  for h in all(fac.ships) do
   if h.ups==0 and pts+h.pts<=L then add(opts,h) end
  end
  if #opts==0 then break end
  local h=pick(opts)
  add(f.units,new_unit(h.id))
  pts+=h.pts sqds+=1
 end
 return f
end

-- saving

SAVE_DIR="/appdata/warfleets"
SAVE_FILE=SAVE_DIR.."/fleets.pod"

-- drop anything the fleet's faction no longer has (and give old saves a faction)
function sanitize_fleet(f)
 if not FACTIONS[f.faction] then f.faction=DEFAULT_FACTION end
 local fac=faction_of(f)
 local units={}
 for u in all(f.units or {}) do
  if hull_of(fac,u.kind) then
   if u.hero and not by_id(fac.heroes,u.hero) then u.hero=nil end
   if u.title and not by_id(fac.titles,u.title) then u.title=nil end
   local ups={}
   for up in all(u.ups or {}) do
    if by_id(fac.upgrades,up.id) then add(ups,up) end
   end
   u.ups=ups
   add(units,u)
  end
 end
 f.units=units
end

-- import: army forge style text lists, e.g.
--  ++ Name - Infected Colonies (v2.0) [GFWF 300pts] ++
--  2x Cadaver Ship [Heavy 4] | Mov 4" ... | 85pts | Sprouting, Vector
--  Weapons: [F] Hull flinger (Ran 24" / Att 8 / Str 0, Overheating), ...
--  Systems: Pulse Engine, Proliferation Pustule
-- names match ignoring case, spaces and punctuation; heroes and titles are
-- picked out of the special rules list (the rest are the hull's own rules)

local function norm(s) return (string.lower(s):gsub("[^%w]","")) end
local function trim(s) return (s:gsub("^%s+",""):gsub("%s+$","")) end

-- other spellings a list might use = the name used in this game. matched the
-- same loose way as everything else, so case and punctuation don't matter.
-- works for any name: ships, upgrades, heroes, titles and factions.
IMPORT_ALIASES={
 ["Ablative Armour"]="Ablative Armor",
 ["Armoured Plating"]="Armored Plating",
 ["Code of Honor"]="Code of Honour",
 ["Honorable"]="Honourable",
 ["Human Defence Force"]="Human Defense Force",
 ["Specialized"]="Specialised",
}

local alias_map
local function alias(n)
 if not alias_map then
  alias_map={}
  for k,v in pairs(IMPORT_ALIASES) do alias_map[norm(k)]=norm(v) end
 end
 return alias_map[n]
end

local function by_name(list,name)
 local n=norm(name)
 local a=alias(n)
 for e in all(list) do
  local en=norm(e.name)
  if en==n or en==a then return e end
 end
end

IMPORT_FACING={f="front",s="sides",r="rear",b="rear"}

-- returns fleet, list of skipped things; or nil, error message
function import_fleet(txt)
 local f,fac,u,h
 local skipped={}
 local function skip(s) if not has_val(skipped,s) then add(skipped,s) end end

 -- add an upgrade to every copy of the current unit (facing may be nil)
 local function fit(name,facing)
  local upg=by_name(fac.upgrades,name)
  if not upg then skip("Unknown upgrade: "..name.." (on "..h.name..")") return end
  for c in all(u) do
   if not can_add_upgrade(c,upg,fac) then skip(upg.name.." doesn't fit on "..h.name) return end
   add_upgrade(c,upg,fac)
   local up=c.ups[#c.ups]
   if upg.weapon and facing and has_val(free_facings(c.ups,upg,up,h.caps),facing) then up.facing=facing end
  end
 end

 for ln in all(split(txt,"\n",false)) do
  ln=trim(ln)
  if not f then
   -- header: name - faction (version) [game limit]
   local inner=ln:match("^%+%+%s*(.-)%s*%+%+$")
   if inner then
    local name,fname=inner:match("^(.*)%s+%-%s+(.-)%s*[%(%[]")
    fac=fname and by_name(FACTION_ORDER,fname)
    if not fac then return nil,"Unknown faction: "..(fname or inner) end
    f=new_fleet(1,fac.id)
    f.name=name
    f.limit=tonum(inner:match("(%d+)%s*pts")) or 300
   end
  elseif ln:find(" | ",1,true) then
   -- unit line: [Nx] Hull Name [Class N] | stats | pts | rules
   local parts=split(ln,"|",false)
   local head=trim(parts[1])
   local n=tonum(head:match("^(%d+)x%s")) or 1
   local hname=trim(head:gsub("^%d+x%s+",""):gsub("%[.*%]",""))
   h=by_name(fac.ships,hname)
   u={}
   if not h then
    skip("Unknown ship: "..(n>1 and n.."x " or "")..hname)
   else
    for i=1,n do add(u,new_unit(h.id)) add(f.units,u[i]) end
    if h.ups>0 and parts[4] then
     for r in all(split(parts[4],",",false)) do
      local hero,title=by_name(fac.heroes,trim(r)),by_name(fac.titles,trim(r))
      for c in all(u) do
       if hero then c.hero=hero.id end
       if title then c.title=title.id end
      end
     end
    end
   end
  elseif h and h.ups>0 and ln:match("^Weapons:") then
   -- names stop at "(" so the commas inside the stats don't split them
   for fc,name in ln:gmatch("%[(%a)%]%s*([^%(]-)%s*%(") do
    fit(name,IMPORT_FACING[string.lower(fc)])
   end
  elseif h and h.ups>0 and ln:match("^Systems:") then
   for name in all(split(ln:sub(9),",",false)) do fit(trim(name)) end
  end
 end
 if not f then return nil,"No fleet list found (expected a line like ++ Name - Faction [... 300pts] ++)" end
 if #f.units==0 then return nil,"The list has no units this game knows" end
 return f,skipped
end

function load_fleets()
 fleets=fetch(SAVE_FILE)
 if type(fleets)~="table" then fleets={} end
 for f in all(fleets) do
  sanitize_fleet(f)
  f.name=unique_fleet_name(f) -- older saves could have duplicates
 end
end

-- name (default f.name) made unique among the other saved fleets, ignoring
-- case: "Fleet" -> "Fleet 2", "Fleet 3"... f may be nil for a new fleet
function unique_fleet_name(f,name)
 name=name or f.name
 if type(name)~="string" or name=="" then name="Fleet" end
 local try,n=name,1
 while true do
  local clash=false
  for o in all(fleets) do
   if o~=f and o.name and string.lower(o.name)==string.lower(try) then clash=true break end
  end
  if not clash then return try end
  n+=1
  try=name.." "..n
 end
end

function save_fleets()
 mkdir(SAVE_DIR)
 store(SAVE_FILE,fleets)
end
:: src/fleet_builder.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- fleet builder scene, built with picotron's gui library. the whole gui is
-- rebuilt whenever the fleet changes (fb.dirty) or the selection changes
-- (fb.rebuild); rebuilding is deferred until after update_all so callbacks
-- never tear down the tree they're running in.

fleet_scene={}
fb={fi=1,sel=1}

function cur_fleet() return fleets[fb.fi] end

function fleet_scene.enter()
 if not fleets then load_fleets() end
 -- fleets left with no units don't count, so with nothing built we start at
 -- the faction picker rather than an empty roster
 local n=#fleets
 for i=n,1,-1 do
  if #fleets[i].units==0 then deli(fleets,i) end
 end
 if #fleets<n then save_fleets() end
 fb.fi=mid(1,fb.fi,max(1,#fleets))
 fb.choosing=false
 fb_build()
end

function fleet_scene.update()
 fb.gui:update_all()

 -- ctrl-v imports, unless it's pasting into the name box
 local typing=fb.name_ed and fb.name_ed.has_keyboard_focus and fb.name_ed:has_keyboard_focus()
 if key("ctrl") and keyp("v") and not typing and not fb.report then fb_import() end

 -- the editor belongs to the fleet it was built for, not cur_fleet():
 -- the < > buttons change fb.fi before the editor is rebuilt
 local nf=fb.name_ed and fb.name_fleet
 local name=nf and fb.name_ed:get_text()[1]
 if name and name~=nf.name then
  nf.name=name
  fb.unsaved=true
 end
 -- red while the name clashes with another fleet (fixed up on commit)
 if nf then fb.name_ed.fgcol=unique_fleet_name(nf)==nf.name and 7 or 8 end

 -- ignore whatever is under an open pulldown
 fb.info=nil
 if not pulldown_drawn and not fb.report then
  for el in all(fb.hot) do
   if fb_hot(el) then fb.info=el.info end
  end
 end
 pulldown_drawn=false

 -- fix up a duplicate/empty name once the editor is about to be rebuilt
 -- (not while typing, or "Fleet 1" would clash on the way to "Fleet 12")
 if fb.dirty or fb.rebuild or fb.leaving then fb_commit_name() end

 if fb.dirty or fb.unsaved and fb.leaving then
  save_fleets()
  fb.unsaved=false
 end
 if fb.leaving then
  fb.leaving=false
  set_scene(menu_scene)
 elseif fb.dirty or fb.rebuild then
  fb.dirty,fb.rebuild=false,false
  fb_build()
 end
end

function fleet_scene.draw()
 fb.gui:draw_all()
 draw_tips()
end

function fb_change() fb.dirty=true end

-- a message shown in the info box (or under the faction picker) for a while
function fb_notice(s) fb.notice={s=s,t=time()} end
function fb_notice_text() return fb.notice and time()<fb.notice.t+10 and fb.notice.s end

-- picotron only sees the host clipboard after ctrl-v is pressed in it, so
-- an empty/stale clipboard gets a hint rather than a bare error
function fb_import()
 local f,res=import_fleet(get_clipboard() or "")
 if not f then
  fb.report={title="Import failed",lines={res,"","Copy a fleet list, then press Ctrl-V here to import it."}}
  fb.rebuild=true
 elseif #res>0 then
  -- let the player decide whether a partial fleet is worth keeping
  fb.report={title="Some of "..f.name.." couldn't be imported:",lines=res,fleet=f}
  fb.rebuild=true
 else
  fb_add_imported(f)
 end
end

function fb_add_imported(f)
 f.name=unique_fleet_name(f)
 add(fleets,f)
 fb.fi,fb.sel,fb.choosing=#fleets,1,false
 fb_change()
 fb_notice("Imported "..f.name..": "..#f.units.." units, "..fleet_pts(f).."pts.")
end

-- modal import report, on top of everything (see fb.report in fb_import)
function fb_build_report()
 local r=fb.report
 local gui=fb.gui
 -- full-screen blocker so nothing underneath can be clicked
 local blk=gui:attach{
  x=0,y=0,width=480,height=270,
  draw=function(self) for y=0,269,2 do line(0,y,479,y,0) end end, -- dim
  click=function() return true end,
  tap=function() return true end,
 }
 local pw=300
 local lines={}
 for s in all(r.lines) do
  if s=="" then add(lines,"") end
  for i,l in ipairs(fb_wrap(s,pw-20)) do add(lines,(r.fleet and i==1 and "- " or (r.fleet and "  " or ""))..l) end
 end
 local maxl=18
 if #lines>maxl then
  local more=#lines-(maxl-1)
  while #lines>maxl-1 do deli(lines) end
  add(lines,"...and "..more.." more line(s)")
 end
 local tl=fb_wrap(r.title,pw-12)
 local head=8+#tl*8+4
 local ph=head+#lines*8+26
 local x0,y0=(480-pw)\2,(270-ph)\2
 local box=blk:attach{
  x=x0,y=y0,width=pw,height=ph,
  draw=function(self)
   panel(0,0,self.width,self.height,0,8)
   for i,l in ipairs(tl) do print(l,6,5+(i-1)*8,7) end
   for i,l in ipairs(lines) do print(l,6,head+(i-1)*8,6) end
  end
 }
 local function close() fb.report=nil fb.rebuild=true end
 if r.fleet then
  fb_button(box,pw\2-94,ph-18,90,"Import anyway",function() close() fb_add_imported(r.fleet) end)
  fb_button(box,pw\2+4,ph-18,90,"Cancel",close)
 else
  fb_button(box,pw\2-30,ph-18,60,"OK",close)
 end
end

function fb_commit_name()
 local f=fb.name_fleet
 if not f then return end
 local name=unique_fleet_name(f)
 if name~=f.name then
  f.name=name
  fb.unsaved=true
 end
end

-- register an element whose info text shows in the info box on hover
function fb_info(el,info)
 el.info=info
 add(fb.hot,el)
 return el
end

function fb_build()
 fb.gui=create_gui()
 fb.hot={}
 fb.name_ed,fb.name_fleet=nil,nil
 if fb.choosing or #fleets==0 then
  fb.roster,fb.catalog=nil,nil
  fb_build_faction_picker()
  if fb.report then fb_build_report() end
  return
 end

 local f=cur_fleet()
 local fac=faction_of(f)
 fb.sel=mid(1,fb.sel,max(1,#f.units))

 -- keep scroll positions unless we're looking at something else
 local roster_y=(fb.roster and fb.built_fi==fb.fi) and fb.roster.y or 0
 local cat_y=(fb.catalog and fb.built_fi==fb.fi and fb.built_sel==fb.sel) and fb.catalog.y or 0
 fb.built_fi,fb.built_sel=fb.fi,fb.sel

 fb.roster,fb.catalog=nil,nil
 fb_build_topbar(f)
 fb_build_roster(f,fac)
 fb_build_editor(f,fac)
 if fb.roster then fb.roster.y=roster_y end
 if fb.catalog then fb.catalog.y=cat_y end
 if fb.report then fb_build_report() end
end

-- new fleets start by picking a faction
function fb_build_faction_picker()
 local gui=fb.gui
 gui:attach{
  x=0,y=0,width=480,height=40,
  draw=function(self)
   big_text("CHOOSE A FACTION",241,13,2,0)
   big_text("CHOOSE A FACTION",240,12,2,7)
  end
 }
 local cols,bw,bh=2,180,13
 local rows=ceil(#FACTION_ORDER/cols)
 local x0,y0=(480-cols*bw-8)\2,44
 for i,fac in ipairs(FACTION_ORDER) do
  local c,r=(i-1)\rows,(i-1)%rows
  local b=fb_button(gui,x0+c*(bw+8),y0+r*(bh+1),bw,fac.name,function()
   local nf=new_fleet(#fleets+1,fac.id)
   nf.name=unique_fleet_name(nf)
   add(fleets,nf)
   fb.fi,fb.sel,fb.choosing=#fleets,1,false
   fb_change()
  end)
 end
 if #fleets>0 then
  fb_button(gui,196,250,40,"Cancel",function() fb.choosing=false fb.rebuild=true end)
 else
  fb_button(gui,196,250,40,"Back",function() fb.leaving=true end)
 end
 fb_button(gui,244,250,40,"Import",fb_import)
 gui:attach{
  x=4,y=228,width=472,height=20,
  draw=function(self)
   local s=fb_notice_text()
   if not s then return end
   for i,ln in ipairs(fb_wrap(s,self.width)) do
    if i<=2 then print_centered(ln,self.width\2,(i-1)*8,8) end
   end
  end
 }
end

function fb_build_topbar(f)
 local gui=fb.gui

 fb_button(gui,4,4,12,"<",function()
  fb.fi=(fb.fi-2)%#fleets+1 fb.sel=1 fb_change()
 end)

 fb.name_ed=gui:attach_text_editor{
  x=20,y=4,width=100,height=12,max_lines=1,bgcol=0,fgcol=7
 }
 fb.name_ed:set_text({f.name})
 fb.name_fleet=f

 fb_button(gui,124,4,12,">",function()
  fb.fi=fb.fi%#fleets+1 fb.sel=1 fb_change()
 end)

 fb_button(gui,142,4,28,"New",function()
  fb.choosing=true fb.rebuild=true
 end)

 local imp=fb_button(gui,174,4,34,"Import",fb_import)
 fb_info(imp,"Import a fleet list (Army Forge text format) from the clipboard. Picotron only sees the clipboard after Ctrl-V, so you can also just press Ctrl-V here.")

 fb_button(gui,212,4,36,"Delete",function()
  fb_pulldown(212,17,110,{
   {label="Delete "..f.name,action=function()
    deli(fleets,fb.fi)
    fb.fi=mid(1,fb.fi,max(1,#fleets)) fb.sel=1 fb_change()
   end},
   {label="Cancel"},
  })
 end)

 -- points total; click to change the limit
 local pts_el=gui:attach{
  x=252,y=4,width=78,height=12,
  draw=function(self)
   local pts=fleet_pts(f)
   local hot=fb_hot(self)
   rectfill(0,0,self.width-1,self.height-1,hot and 13 or 1)
   print_centered(pts.." / "..f.limit.." pts",self.width\2,3,pts>f.limit and 8 or 7)
  end,
  tap=function()
   local items={}
   for lim in all({150,300,450,600}) do
    add(items,{label=lim.." pts",action=function() f.limit=lim fb_change() end})
   end
   fb_pulldown(252,17,78,items)
  end
 }
 fb_info(pts_el,"Fleet points / points limit. Click to change the limit. 300pts is a starter game, 450pts a full match.")

 local fo=fb_button(gui,334,4,90,"Force Org: "..(f.force_org and "On" or "Off"),function()
  f.force_org=not f.force_org fb_change()
 end)
 fb_info(fo,"Optional force org: 1 hero per 200pts, 1 copy of the same ship per 150pts, 1 ship per 50pts, 1 squadron per 35pts.")

 fb_button(gui,440,4,36,"Back",function() fb.leaving=true end)
end

function short_name(h)
 for suffix in all({" Ship"," Squadron"}) do
  if sub(h.name,-#suffix)==suffix then return sub(h.name,1,#h.name-#suffix) end
 end
 return h.name
end

function fb_build_roster(f,fac)
 local x,y,w,h=4,22,170,244
 local lp=fb.gui:attach{
  x=x,y=y,width=w,height=h,
  draw=function(self)
   panel(0,0,self.width,self.height,0,5)
   print(fac.name,4,3,13)
   local n=#f.units
   print_right(n.." unit"..(n==1 and "" or "s"),self.width-4,3,5)
  end
 }

 local add_rows=ceil(#fac.ships/3)
 local rh=20
 local box_h=h-13-add_rows*14-2-16
 local box=lp:attach{x=2,y=13,width=w-4,height=box_h}
 local list=box:attach{
  x=0,y=0,width=box.width-8,height=max(box_h,#f.units*rh),clip_to_parent=true
 }
 for i,u in ipairs(f.units) do
  list:attach{
   x=0,y=(i-1)*rh,width=list.width,height=rh-1,clip_to_parent=true,scroll_box=box,
   draw=function(self) fb_draw_roster_row(self,i,u,fac) end,
   tap=function() fb.sel=i fb.rebuild=true end
  }
 end
 box:attach_scrollbars{autohide=true}
 fb.roster=list

 -- add buttons
 local by=13+box_h+2
 local bw=(w-8)\3
 for k,hull in ipairs(fac.ships) do
  local bx=4+((k-1)%3)*bw
  local b=fb_button(lp,bx,by+((k-1)\3)*14,bw-2,"+"..short_name(hull),function()
   add(f.units,new_unit(hull.id))
   fb.sel=#f.units
   fb_change()
  end)
  fb_info(b,"Add a "..hull.name.." ("..hull.class..", "..hull.pts.."pts)"..(hull.special and ". "..hull.special or ""))
 end

 -- fleet status
 local issues=fleet_issues(f)
 local st=lp:attach{
  x=4,y=h-14,width=w-8,height=12,
  draw=function(self)
   if #issues==0 then
    print("Fleet ready",0,2,11)
   else
    print("! "..#issues.." issue"..(#issues==1 and "" or "s").." (hover)",0,2,8)
   end
  end
 }
 local txt="Fleet is battle ready."
 if #issues>0 then
  txt=""
  for s in all(issues) do txt..=(txt=="" and "" or "\n")..s end
 end
 fb_info(st,txt)
end

function fb_draw_roster_row(self,i,u,fac)
 local h=hull_of(fac,u.kind)
 local w=self.width
 if i==fb.sel then
  rectfill(0,0,w-1,self.height-1,1)
  rectfill(0,0,1,self.height-1,8)
 elseif fb_hot(self) then
  rectfill(0,0,w-1,self.height-1,1)
 end
 local name=h.name
 if u.title then name..=" '"..by_id(fac.titles,u.title).name.."'" end
 print(name,5,1,7)
 print_right(unit_pts(u,fac).."pts",w-3,1,6)
 if h.ups==0 then
  print(h.class,5,10,5)
 else
  local s=#u.ups.."/"..h.fit.." upgrades"
  print(s,5,10,#u.ups<h.fit and 8 or 5)
  if u.hero then print(" + "..by_id(fac.heroes,u.hero).name,5+text_w(s),10,12) end
 end
end

function fb_build_editor(f,fac)
 local W=298
 local rp=fb.gui:attach{
  x=178,y=22,width=W,height=244,
  draw=function(self)
   panel(0,0,self.width,self.height,0,5)
   line(4,self.height-44,self.width-5,self.height-44,5)
  end
 }

 -- info box (hover descriptions)
 local u=f.units[fb.sel]
 rp:attach{
  x=4,y=244-40,width=W-8,height=36,
  draw=function(self)
   local s=fb.info or fb_notice_text() or fb.default_info or ""
   local y=0
   for para in all(split(s,"\n",false)) do
    for ln in all(fb_wrap(para,self.width)) do
     if y+8>self.height then return end
     print(ln,0,y,(fb.info or fb_notice_text()) and 6 or 5)
     y+=8
    end
   end
  end
 }

 if not u then
  fb.default_info="Hover over anything for details."
  rp:attach{
   x=0,y=0,width=W,height=200,
   draw=function(self)
    print_centered("This fleet is empty.",W\2,80,6)
    print_centered("Add ships and squadrons with the",W\2,96,5)
    print_centered("buttons under the roster.",W\2,106,5)
   end
  }
  return
 end

 local h=hull_of(fac,u.kind)
 fb.default_info=h.special or "Hover over anything for details."

 -- header
 rp:attach{
  x=4,y=4,width=W-8,height=30,
  draw=function(self)
   print(h.name,0,0,7)
   print("  "..h.class..(h.ups>0 and " ("..h.ups..")" or "").." - "..unit_pts(u,fac).."pts",text_w(h.name),0,13)
   print("Move "..h.mv.."\"  Cruise "..h.cr.."\"   Turret "..weapon_stats(h),0,11,6)
   print("Evasion "..h.eva.."+  Toughness "..h.tou.."+",0,20,6)
  end
 }

 fb_button(rp,W-82,4,36,"Copy",function()
  add(f.units,copy_unit(u),fb.sel+1)
  fb.sel+=1
  fb_change()
 end)
 fb_button(rp,W-42,4,38,"Remove",function()
  deli(f.units,fb.sel)
  fb_change()
 end)

 if h.ups==0 then
  rp:attach{
   x=4,y=40,width=W-8,height=150,
   draw=function(self)
    print("Squadrons have no upgrades, heroes or titles.",0,0,5)
    if h.special then
     local y=14
     for ln in all(fb_wrap(h.special,self.width)) do print(ln,0,y,6) y+=9 end
    end
   end
  }
  return
 end

 -- hero & title
 local function picker(x,label,list,field)
  local cur=u[field] and by_id(list,u[field])
  local b=fb_button(rp,x,38,141,label..": "..(cur and cur.name.." +"..cur.pts or "None"),function()
   local items={{label="None",action=function() u[field]=nil fb_change() end}}
   local core_shown=false
   for e in all(list) do
    -- separate the core rules entries from the faction's own
    if not e.faction_only and not core_shown and list[1].faction_only then
     add(items,{label="-- core rules --"})
     core_shown=true
    end
    add(items,{label=e.name.." ("..e.pts.."pts)",tip_title=e.name,tip=e.desc,
     action=function() u[field]=e.id fb_change() end})
   end
   fb_pulldown(178+x,22+51,141,items)
  end)
  fb_info(b,cur and (cur.name..": "..cur.desc) or ("No "..string.lower(label)..". Click to choose one (costs points)."))
 end
 picker(4,"Hero",fac.heroes,"hero")
 picker(149,"Title",fac.titles,"title")

 -- upgrade slots
 rp:attach{
  x=4,y=56,width=W-8,height=10,
  draw=function(self)
   print("UPGRADES",0,0,13)
   print(#u.ups.."/"..h.fit,44,0,#u.ups<h.fit and 8 or 11)
  end
 }
 for k=1,h.fit do
  local up=u.ups[k]
  local upg=up and by_id(fac.upgrades,up.id)
  local row=rp:attach{
   x=4,y=66+(k-1)*13,width=W-8,height=12,
   draw=function(self)
    rectfill(0,0,self.width-1,self.height-1,1)
    if upg then
     print(upg.name,4,3,7)
     print(upg.weapon and weapon_stats(upg) or "system",110,3,5)
    else
     print("- empty slot -",4,3,5)
    end
   end
  }
  if upg then
   fb_info(row,upgrade_info(upg))
   if upg.weapon then
    local b=fb_button(row,row.width-62,0,44,up.facing,function()
     cycle_facing(u,up,fac) fb_change()
    end)
    fb_info(b,"Mounting: "..up.facing..". Click to move it to another free facing (one weapon per facing).")
   end
   fb_button(row,row.width-14,0,14,"x",function()
    del(u.ups,up) fb_change()
   end)
  end
 end

 -- catalog
 local cy=66+max(4,h.fit)*13+2
 rp:attach{
  x=4,y=cy,width=W-8,height=10,
  draw=function(self) print("ADD UPGRADE",0,0,13) end
 }
 local box_y=cy+10
 local box_h=244-44-2-box_y
 local box=rp:attach{x=4,y=box_y,width=W-8,height=box_h}
 local rh=11
 -- faction upgrades first, then the core rules ones, each under a heading
 local entries={}
 local last_group
 for upg in all(fac.upgrades) do
  local group=upg.faction_only and string.upper(fac.name) or "CORE RULES"
  if group~=last_group and (upg.faction_only or last_group) then add(entries,group) end
  last_group=group
  add(entries,upg)
 end
 local list=box:attach{
  x=0,y=0,width=box.width-8,height=max(box_h,#entries*rh),clip_to_parent=true
 }
 for i,upg in ipairs(entries) do
  if type(upg)=="string" then
   list:attach{
    x=0,y=(i-1)*rh,width=list.width,height=rh-1,clip_to_parent=true,
    draw=function(self)
     print(upg,4,2,12)
     line(text_w(upg)+8,5,self.width-4,5,1)
    end
   }
  else
   local ok=can_add_upgrade(u,upg,fac)
   local row=list:attach{
    x=0,y=(i-1)*rh,width=list.width,height=rh-1,clip_to_parent=true,scroll_box=box,
    draw=function(self)
     if ok and fb_hot(self) then rectfill(0,0,self.width-1,self.height-1,1) end
     print(upg.name,4,2,ok and 6 or 5)
     print_right(upg.weapon and weapon_stats(upg) or "system",self.width-4,2,ok and 13 or 5)
    end,
    tap=function()
     if ok then add_upgrade(u,upg,fac) fb_change() end
    end
   }
   local why=""
   if not ok then
    why=unit_has(u,upg.id) and " (already fitted)"
     or #u.ups>=h.fit and " (all slots full)"
     or (h.allowed and not has_val(h.allowed,upg.id)) and " (not allowed on this ship)"
     or " (no free facing)"
   end
   fb_info(row,upgrade_info(upg)..why)
  end
 end
 box:attach_scrollbars{autohide=true}
 fb.catalog=list
end

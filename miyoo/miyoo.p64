--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Infected Colonies v2.0

local OUTBREAK_TXT="Outbreak: not deployed at the start. Instead may be deployed in place of an enemy ship of the same type that is destroyed while it has boarding markers."
local VECTOR_TXT="Vector: ships take 1 boarding marker per damage from this ship's turret."

def_faction{
 id="infected_colonies",name="Infected Colonies",

 ships={
  {id="plague",name="Plague Ship",class="Heavy",ups=4,pts=35,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2,
   rules={outbreak=true},special=OUTBREAK_TXT},
  {id="cadaver",name="Cadaver Ship",class="Heavy",ups=4,pts=70,mv=4,cr=6,rng=24,att=1,str=2,eva=2,tou=3,
   rules={vector=true},special=VECTOR_TXT},
  {id="disease",name="Disease Ship",class="Medium",ups=3,pts=30,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={outbreak=true},special=OUTBREAK_TXT},
  {id="corpse",name="Corpse Ship",class="Medium",ups=3,pts=55,mv=6,cr=9,rng=18,att=1,str=1,eva=3,tou=4,
   rules={vector=true},special=VECTOR_TXT},
  {id="infection",name="Infection Ship",class="Light",ups=2,pts=25,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,
   rules={outbreak=true},special=OUTBREAK_TXT},
  {id="body",name="Body Ship",class="Light",ups=2,pts=35,mv=8,cr=12,rng=12,att=1,str=0,eva=4,tou=5,
   rules={vector=true},special=VECTOR_TXT},
  {id="blight",name="Blight Squadron",class="Squadron",ups=0,pts=15,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={burrow=true},
   special="Burrow Within: may use ram actions, but is destroyed when doing so. Instead of comparing upgrades, place 3 boarding markers on the target."},
  {id="bane",name="Bane Squadron",class="Squadron",ups=0,pts=15,mv=8,cr=12,rng=2,att=2,str=0,eva=5,tou=5,
   rules={vector=true},special=VECTOR_TXT},
  {id="bloat",name="Bloat Squadron",class="Squadron",ups=0,pts=5,mv=8,cr=12,rng=0,att=0,str=0,eva=4,tou=6,
   rules={detonation=true},
   special="Detonation: destroyed if it takes any damage. If overlapped or engaged it is destroyed, and the target takes 2 hits with Str 0."},
 },

 heroes={
  {id="late_stage",name="Late Stage",pts=20,desc="This ship may activate twice on the last round of the game."},
  {id="new_strain",name="New Strain",pts=20,
   desc="Starts with one evolution marker. When activated, may remove it and all damage from one disabled upgrade, then replace that upgrade with any other upgrade."},
  {id="patient_zero",name="Patient Zero",pts=10,desc="Whenever this ship overlaps an enemy ship, place a boarding marker on the enemy ship."},
 },

 titles={
  {id="rebirth",name="Rebirth",pts=10,desc="Friendly ships with the Outbreak rule may be deployed in place of this ship when it is destroyed."},
  {id="scent_of_death",name="Scent of Death",pts=10,
   desc="Whenever an enemy ship is destroyed within 18\", may pivot to face it and move up to 6\" towards it."},
  {id="sprouting",name="Sprouting",pts=15,
   desc="Whenever one of this ship's upgrades is disabled, may place 2 new Bloat Squadrons within 3\"."},
 },

 keywords={
  {id="agitator",name="Agitator",desc="Whenever this weapon deals any hits, the target must roll for each boarding marker on it as if it had just activated, instead of dealing any damage."},
  {id="burrow",name="Burrow Within",desc="May use ram actions, but is immediately destroyed when doing so. Instead of comparing upgrades, place 3 boarding markers on the target."},
  {id="detonation",name="Detonation",desc="This squadron is destroyed if it takes any damage. If this squadron is overlapped or engaged, it is destroyed, and the target takes 2 hits with Str 0."},
  {id="guillotine",name="Guillotine Gun",desc="Gets as many Att as boarding markers on the target."},
  {id="lineage",name="Lineage Author",desc="Whenever this weapon deals any hits, place a Bloat Squadron within 3\" of the target."},
  {id="outbreak",name="Outbreak",desc="May not be deployed at the start of the game, but instead may only be deployed in place of an enemy ship with boarding markers that is destroyed, as long as it has the same type as this ship."},
  {id="tainted",name="Tainted Victory",desc="May only be fired at enemy ships carrying objectives."},
  {id="vector",name="Vector",desc="Ships take 1 boarding marker per damage from this ship's turret."},
 },
 upgrades={
  {id="agitator_ram",name="Agitator Ram",desc="When ramming, the target must roll for each boarding marker on it as if it had just activated."},
  {id="bile_trail",name="Bile Trail",desc="Whenever this ship moves through a piece of terrain, it counts as dangerous terrain for enemies until the end of the game."},
  {id="crew_replenishment",name="Crew Replenishment",
   desc="This ship removes boarding markers on rolls of 3+, and removes 1 damage whenever a boarding marker is removed."},
  {id="proliferation_pustule",name="Proliferation Pustule",
   desc="Takes 2 damage to be disabled. When activated, may remove all damage from one disabled upgrade and replace it with a proliferation pustule."},
  {id="recruitment_tendrils",name="Recruitment Tendrils",desc="Whenever an enemy squadron is destroyed within 6\", remove 1 damage from this ship."},
  {id="revenge_creche",name="Revenge Creche",desc="Turret gets +1 attack whilst this upgrade is disabled."},
  {id="agitator",name="Agitator",weapon=true,rng=18,att=1,str=0,rules={agitator=true},
   desc="Agitator: whenever this weapon deals hits, the target rolls for each boarding marker on it as if it had just activated, instead of taking damage."},
  {id="bird_eater",name="Bird Eater",weapon=true,rng=6,att=3,str=0,rules={broadside=true,twin=true,anti_sq=true},
   desc="Broadside, Twin-Fire, Anti-Squadron: sides only, fires from both sides, twice each at different targets; +1 to hit squadrons, ships only on 6+."},
  {id="black_finger",name="Black Finger",weapon=true,rng=18,att=2,str=1,rules={deadly=true,overheat=true},
   desc="Deadly: +1 damage per unblocked hit. Overheating: on a to-hit roll of 1, this ship takes 1 damage."},
  {id="guillotine_gun",name="Guillotine Gun",weapon=true,rng=24,att=0,str=1,rules={guillotine=true},
   desc="Guillotine Gun: gets as many attacks as boarding markers on the target."},
  {id="hull_flinger",name="Hull Flinger",weapon=true,rng=24,att=8,str=0,rules={overheat=true},
   desc="Overheating: on a to-hit roll of 1, this ship takes 1 damage."},
  {id="lethal_injection",name="Lethal Injection",weapon=true,rng=6,att=4,str=0,rules={boarding=true},
   desc="Boarding Pod: ships only. Each hit gives a boarding marker instead of damage."},
  {id="lineage_author",name="Lineage Author",weapon=true,rng=18,att=1,str=3,rules={lineage=true},
   desc="Lineage Author: whenever this weapon deals hits, place a Bloat Squadron within 3\" of the target."},
  {id="tainted_victory",name="Tainted Victory",weapon=true,rng=18,att=5,str=0,rules={boarding=true,tainted=true},
   desc="Boarding Pod, Tainted Victory: may only be fired at enemy ships carrying objectives; hits give boarding markers."},
 },
}

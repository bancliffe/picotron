--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Havoc Brothers v2.0

local RUSH="Rift Rush: gets +4\" on move and +6\" on cruise/ram actions when activating inside your deployment zone."
local UNTETHERED="Untethered: whenever this model takes damage from shooting, you may move it up to 2\" in any direction."

def_faction{
 id="havoc_brothers",name="Havoc Brothers",

 ships={
  {id="vulture",name="Vulture Ship",class="Heavy",ups=4,pts=85,mv=4,cr=6,rng=18,att=2,str=2,eva=2,tou=2,
   rules={rift_rush=true},special=RUSH},
  {id="blasphemy",name="Blasphemy Ship",class="Heavy",ups=4,pts=80,mv=4,cr=6,rng=18,att=2,str=2,eva=2,tou=2,
   rules={untethered=true},special=UNTETHERED},
  {id="raptor",name="Raptor Ship",class="Medium",ups=3,pts=65,mv=6,cr=9,rng=12,att=2,str=1,eva=3,tou=3,
   rules={rift_rush=true},special=RUSH},
  {id="heresy",name="Heresy Ship",class="Medium",ups=3,pts=65,mv=6,cr=9,rng=12,att=2,str=1,eva=3,tou=3,
   rules={untethered=true},special=UNTETHERED},
  {id="shrike",name="Shrike Ship",class="Light",ups=2,pts=45,mv=8,cr=12,rng=6,att=2,str=0,eva=4,tou=4,
   rules={rift_rush=true},special=RUSH},
  {id="sin",name="Sin Ship",class="Light",ups=2,pts=45,mv=8,cr=12,rng=6,att=2,str=0,eva=4,tou=4,
   rules={untethered=true},special=UNTETHERED},
  {id="rake",name="Rake Squadron",class="Squadron",ups=0,pts=15,mv=8,cr=12,rng=6,att=2,str=0,eva=4,tou=4},
  {id="rogue",name="Rogue Squadron",class="Squadron",ups=0,pts=10,mv=6,cr=9,rng=2,att=3,str=0,eva=5,tou=5,
   rules={rogue=true,overheat=true},
   special="Rogue: may skip the squadrons phase to activate later, but then may only move or shoot. Overheating: rolls of 1 to hit deal 1 damage to it."},
  {id="hell_engine",name="Hell Engine Squadron",class="Squadron",ups=0,pts=10,mv=8,cr=12,rng=2,att=2,str=0,eva=5,tou=5,
   rules={crawl=true},special="Crawl Within: may ram, but is destroyed when doing so. Instead of comparing upgrades, place 2 boarding markers on the target."},
 },

 heroes={
  {id="champions_throne",name="Champion's Throne",pts=15,
   desc="Enemy ships within 18\" get -1 to morale tests. Friendly ships within 18\" get +1 to morale tests."},
  {id="rift_master",name="Rift Master",pts=10,
   desc="Once per game, at the end of its activation, this ship may place a rift marker within 3\". Friendly ships within 4\" of the marker count as being in your deployment zone for the Rift Rush and Rift Scanner rules."},
 },

 titles={
  {id="change_disciple",name="Change Disciple",pts=10,desc="Enemies may only shoot at this ship if it's within 12\" of at least one enemy ship."},
  {id="lust_disciple",name="Lust Disciple",pts=10,desc="May pivot +45 degrees when using cruise or ram actions."},
  {id="plague_disciple",name="Plague Disciple",pts=15,desc="This ship may ignore 1 damage every round."},
  {id="war_disciple",name="War Disciple",pts=5,desc="This ship always deals +1 damage from overlapping and takes +1 damage from overlapping."},
 },

 keywords={
  {id="casualty",name="Casualty Inverter",desc="Always hits on 2+."},
  {id="crawl",name="Crawl Within",desc="May use ram actions, but is immediately destroyed when doing so. Instead of comparing upgrades, place 2 boarding markers on the target."},
  {id="distortion_cannon",name="Distortion Cannon",desc="Ships take 1 boarding marker per damage from this weapon."},
  {id="oars",name="Lightning Oars",desc="May be fired after using cruise actions."},
  {id="wound",name="Reality Wound",desc="May be fired once at every model in range, in every facing."},
  {id="rift_rush",name="Rift Rush",desc="Gets +4\" on move and +6\" on cruise/ram actions when activating inside your deployment zone."},
  {id="spinal",name="Spinal Spiral",desc="May only be mounted on the front facing."},
  {id="untethered",name="Untethered",desc="Whenever this model takes any damage from shooting, you may move it up to 2\" in any direction."},
 },

 upgrades={
  {id="corruption_spreader",name="Corruption Spreader",
   desc="As long as this ship is inside of terrain, that terrain counts as dangerous for enemies."},
  {id="fulgent_huntsmen",name="Fulgent Huntsmen",desc="This ship may remove 1 damage whenever a boarding marker is removed from it."},
  {id="lightning_drive",name="Lightning Drive",desc="This ship may be moved 2\" sideways instead of pivoting."},
  {id="loose_bindings",name="Loose Bindings",
   desc="May choose to place 2 boarding markers on this ship to get +1 to hit when shooting during its activation."},
  {id="nemesis_evader",name="Nemesis Evader",desc="This ship counts as being 6\" further away when targeted in its rear facing."},
  {id="rift_scanner",name="Rift Scanner",
   desc="May choose not to be deployed at the start of the game, but instead may be deployed anywhere inside your deployment zone at the start of any round after the first."},
  {id="baryon_gun",name="Baryon Gun",weapon=true,rng=6,att=3,str=1,rules={anti_sq=true},desc="No special rules."},
  {id="casualty_inverter",name="Casualty Inverter",weapon=true,rng=12,att=1,str=3,rules={casualty=true},desc="No special rules."},
  {id="cluster_bombs",name="Cluster Bombs",weapon=true,rng=6,att=1,str=0,rules={blast=true,twin=true},desc="No special rules."},
  {id="distortion_cannon",name="Distortion Cannon",weapon=true,rng=6,att=2,str=1,rules={distortion_cannon=true},desc="No special rules."},
  {id="lightning_oars",name="Lightning Oars",weapon=true,rng=6,att=2,str=1,rules={broadside=true,anti_ship=true,oars=true},desc="No special rules."},
  {id="rattler",name="Rattler",weapon=true,rng=6,att=6,str=0,desc="No special rules."},
  {id="reality_wound",name="Reality Wound",weapon=true,rng=6,att=1,str=0,rules={wound=true},desc="No special rules."},
  {id="spinal_spiral",name="Spinal Spiral",weapon=true,rng=18,att=2,str=2,rules={sniper=true,spinal=true},desc="No special rules."},
 },
}
:: factions/high_elf_fleets.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - High Elf Fleets v2.0

local DRIFT="Drift: when taking move actions, may instead move sideways up to its move speed, then pivot to face any solar wind marker."

def_faction{
 id="high_elf_fleets",name="High Elf Fleets",

 ships={
  {id="colony",name="Colony Ship",class="Heavy",ups=5,pts=110,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2,
   rules={false_sun=true},special="False Sun Keeper: at the start of each round, you may unleash the false sun, and this ship counts as the only solar wind marker on the battlefield until the end of the round."},
  {id="gate",name="Gate Ship",class="Heavy",ups=4,pts=40,mv=4,cr=6,rng=0,att=0,str=0,eva=2,tou=2,
   fit=1,allowed={"spatial_superposition"},
   rules={warp_gate=true},special="Warp Gate: may only take the Spatial Superposition upgrade. A model with fewer upgrades that would overlap it is placed within 3\" of another Warp Gate ship instead."},
  {id="specter",name="Specter Ship",class="Medium",ups=3,pts=70,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={drift=true},special=DRIFT},
  {id="shade",name="Shade Ship",class="Medium",ups=3,pts=70,mv=8,cr=12,rng=18,att=2,str=1,eva=3,tou=4,
   rules={drift=true},special=DRIFT},
  {id="soul",name="Soul Ship",class="Light",ups=2,pts=50,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,
   rules={drift=true},special=DRIFT},
  {id="ghost",name="Ghost Ship",class="Light",ups=2,pts=50,mv=10,cr=15,rng=12,att=2,str=0,eva=4,tou=5,
   rules={drift=true},special=DRIFT},
  {id="hunter",name="Hunter Squadron",class="Squadron",ups=0,pts=15,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={striker=true},special="Striker: turret gets +1 strength until the end of the round if activated whilst not engaged."},
  {id="wraith",name="Wraith Squadron",class="Squadron",ups=0,pts=25,mv=10,cr=15,rng=2,att=2,str=3,eva=5,tou=5,
   rules={anti_ship=true,deadly=true},special="Anti-Ship, Deadly."},
  {id="titan",name="Titan Squadron",class="Squadron",ups=0,pts=30,mv=8,cr=12,rng=2,att=2,str=2,eva=4,tou=4,
   rules={deadly=true,wraith_frame=true},special="Deadly. Wraith Frame: takes 3 damage to be destroyed, and removes 1 damage at the end of each activation."},
 },

 heroes={
  {id="phantasm",name="Phantasm",pts=10,
   desc="When deploying this ship, you may deploy an identical copy of it at the same time. The first time one of them interacts with models, objectives or the battlefield, remove the other copy."},
  {id="ring_master",name="Ring Master",pts=5,desc="This ship may make drift moves when taking cruise actions, moving up to its cruise value."},
  {id="wind_reader",name="Wind Reader",pts=5,
   desc="After deployment, place a solar wind marker anywhere in contact with the rear edge of the enemy deployment zone."},
 },

 titles={
  {id="falconer",name="Falconer",pts=10,desc="Gets +1 to hit for each facing of the target that has a friendly unengaged squadron within 2\"."},
  {id="mirth",name="Mirth",pts=5,desc="At the end of its activation, this ship may move 3\" backwards."},
  {id="reaper",name="Reaper",pts=10,desc="Gets +1 to hit when shooting targets from its front facing into their side or rear facing."},
 },

 keywords={
  {id="destructor",name="Destructor",desc="This weapon deals +2 damage per unblocked hit. If you roll a 1 to hit, then this ship takes 2 damage."},
  {id="distortion_lance",name="Distortion Lance",desc="If this weapon inflicts damage, push the target 3\" in any direction."},
  {id="drift",name="Drift",desc="When taking move actions, this ship may make a drift move instead of moving normally. First, move the ship sideways by up to its move speed, then pivot it to face any solar wind marker."},
  {id="false_sun",name="False Sun Keeper",desc="At the start of each round, you may unleash the false sun, and this ship counts as the only solar wind marker on the battlefield until the end of the round."},
  {id="gravity_hook",name="Gravity Hook",desc="Pivot the target by up to 45 degrees per damage from this weapon."},
  {id="shard6",name="Shard Cannons",desc="Unmodified hits of 6 get +2 Str."},
  {id="stream",name="Stream Missile",desc="Gets as many Att as upgrades on the target."},
  {id="striker",name="Striker",desc="Turret gets +1 strength until the end of the round if this squadron activated whilst not engaged."},
  {id="warp_gate",name="Warp Gate",desc="This ship may only get the spatial superposition upgrade. When a model with less upgrades than this ship would overlap it, place that ship within 3\" of any other ship with the warp gate rule instead."},
  {id="wraith_frame",name="Wraith Frame",desc="Takes 3 damage to be destroyed. Remove 1 damage from this squadron at the end of each activation."},
 },

 upgrades={
  {id="companion_vanes",name="Companion Vanes",
   desc="Whenever this ship makes a drift move, any friendly squadron it passes within 6\" of may be placed within 2\" of its final position."},
  {id="gravity_pulse",name="Gravity Pulse",desc="Once per activation, pick one ship within 8\", and push that ship D6+1\" directly away."},
  {id="perfection_drive",name="Perfection Drive",desc="Gets +4\" on move and +6\" on cruise/ram actions as long as this ship has not taken any damage."},
  {id="phase_components",name="Phase Components",desc="This ship may activate during the phase directly before the phase it would normally activate in."},
  {id="regenerative_skin",name="Regenerative Skin",
   desc="This upgrade takes 3 damage to be disabled. At the end of this ship's activation, if this upgrade is damaged but not disabled, remove a point of damage from it."},
  {id="spatial_superposition",name="Spatial Superposition",desc="When this upgrade is disabled, you may place this ship anywhere within 6\"."},
  {id="destructor",name="Destructor",weapon=true,rng=12,att=1,str=4,rules={destructor=true},desc="No special rules."},
  {id="distortion_lance",name="Distortion Lance",weapon=true,rng=24,att=1,str=3,rules={distortion_lance=true},desc="No special rules."},
  {id="fusion_lance",name="Fusion Lance",weapon=true,rng=6,att=2,str=3,rules={deadly=true,anti_ship=true},desc="No special rules."},
  {id="gravity_hook",name="Gravity Hook",weapon=true,rng=12,att=2,str=1,rules={gravity_hook=true},desc="No special rules."},
  {id="he_shard_cannons",name="Shard Cannons",weapon=true,rng=18,att=3,str=0,rules={anti_sq=true,shard6=true},desc="No special rules."},
  {id="spinnerette",name="Spinnerette",weapon=true,rng=6,att=3,str=1,rules={twin=true,anti_sq=true},desc="No special rules."},
  {id="star_cannon",name="Star Cannon",weapon=true,rng=12,att=4,str=1,desc="No special rules."},
  {id="stream_missile",name="Stream Missile",weapon=true,rng=18,att=0,str=1,rules={anti_ship=true,stream=true},desc="No special rules."},
 },
}
:: factions/human_defense_force.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Human Defense Force v2.0

def_faction{
 id="human_defense_force",name="Human Defense Force",

 ships={
  {id="praetorian",name="Praetorian Ship",class="Heavy",ups=5,pts=100,mv=4,cr=6,rng=6,att=1,str=0,eva=2,tou=2,
   rules={arsenal=true},caps={front=3,sides=2,rear=1},
   special="Arsenal Vessel: may mount up to 3 weapons in its front facing, and up to 2 weapons in its sides facing."},
  {id="centurion",name="Centurion Ship",class="Heavy",ups=4,pts=80,mv=4,cr=6,rng=6,att=1,str=0,eva=2,tou=2,
   rules={siege=true},special="Siege Vessel: weapons mounted in this ship's front facing get the Deadly rule."},
  {id="legionary",name="Legionary Ship",class="Medium",ups=3,pts=50,mv=6,cr=9,rng=6,att=1,str=0,eva=3,tou=3,
   rules={line=true},caps={front=0,sides=1,rear=1},
   special="Line Vessel: may not mount weapons in its front facing. Its broadside weapons get Twin-Fire, and its Twin-Fire weapons get Broadside."},
  {id="princeps",name="Princeps Ship",class="Medium",ups=3,pts=50,mv=8,cr=12,rng=6,att=1,str=0,eva=3,tou=3,
   rules={artillery=true},special="Artillery Vessel: weapons mounted in this ship's front facing get +6\" range."},
  {id="vulpes",name="Vulpes Ship",class="Light",ups=2,pts=40,mv=8,cr=12,rng=6,att=1,str=0,eva=4,tou=4,
   rules={strike_vessel=true},caps={front=2,sides=1,rear=1},
   special="Strike Vessel: may mount up to two different weapons in its front facing."},
  {id="senator",name="Senator Ship",class="Light",ups=1,pts=15,mv=8,cr=12,rng=6,att=1,str=0,eva=4,tou=4,
   rules={support=true},caps={front=0,sides=0,rear=0},
   special="Support Vessel: may not take any weapon upgrades. Enemies get -1 to hit when shooting at this ship if it's not the closest enemy model."},
  {id="traex",name="Traex Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=3,str=1,eva=5,tou=5,
   rules={fragile=true},special="Fragile: the first time it takes damage each round it takes +1 damage."},
  {id="myrmillo",name="Myrmillo Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=3,str=0,eva=5,tou=6,
   rules={anti_ship=true},special="Anti-Ship: +1 to hit ships, but only hits squadrons on 6+."},
  {id="retarius",name="Retarius Squadron",class="Squadron",ups=0,pts=10,mv=8,cr=12,rng=2,att=1,str=2,eva=4,tou=5,
   rules={anti_sq=true,deadly=true},special="Anti-Squadron, Deadly."},
 },

 heroes={
  {id="barrage_master",name="Barrage Master",pts=15,
   desc="Once per round, when a friendly ship within 12\" fires a weapon, it may immediately fire it again, and then that weapon is disabled."},
  {id="communications_master",name="Communications Master",pts=15,
   desc="Once per activation, this ship may place a targeting token on an enemy ship within 12\". Targeting tokens may be removed from a ship when it fails to block a hit, dealing +1 damage to the target."},
  {id="obliteration_master",name="Obliteration Master",pts=20,
   desc="This ship may fire its weapons in facings they are not mounted on, but they get the Overheating rule when doing so."},
 },

 titles={
  {id="delegatus",name="Delegatus",pts=5,desc="When a friendly ship with a hero is destroyed, the closest ship with this rule gains that ship's hero."},
  {id="disciplined",name="Disciplined",pts=5,desc="If this ship fails a morale test, it takes 1 damage instead of being removed from play."},
  {id="risk_doctrine",name="Risk Doctrine",pts=5,desc="This ship ignores the first point of overheating damage it takes each round."},
 },

 keywords={
  {id="arsenal",name="Arsenal Vessel",desc="This ship may mount up to 3 weapons in its front facing, and up to 2 weapons in its sides facing."},
  {id="artillery",name="Artillery Vessel",desc="Weapons mounted in this ship's front facing get +6\" range."},
  {id="deck_shaker",name="Deck Shaker",desc="Must pass a morale test in order to fire this weapon."},
  {id="line",name="Line Vessel",desc="This ship may not mount weapons in its front facing. This ship's broadside weapons get the twin-fire rule, and its twin-fire weapons get the broadside rule."},
  {id="profile",name="Profile Gun",desc="This weapon can only be fired at ships with more non-disabled upgrades."},
  {id="siege",name="Siege Vessel",desc="Weapons mounted in this ship's front facing get the deadly rule."},
  {id="strike_vessel",name="Strike Vessel",desc="This ship may mount up to two different weapons in its front facing."},
  {id="support",name="Support Vessel",desc="This ship may not take any weapon upgrades. Enemies get -1 to hit when shooting at this ship, if it's not the closest enemy model."},
 },

 upgrades={
  {id="coolant_tether",name="Coolant Tether",
   desc="Once per activation, place a coolant token on a friendly ship within 4\". Coolant tokens may be removed from a ship when it fires a weapon to ignore the overheating rule."},
  {id="repair_shuttles",name="Repair Shuttles",desc="Once per activation, pick one other friendly ship within 12\", which may remove 1 damage."},
  {id="security_systems",name="Security Systems",desc="Once per activation, pick one other friendly ship within 12\", which may remove D3 boarding markers."},
  {id="targeting_array",name="Targeting Array",desc="Weapons get +1 to hit when shooting at targets that are 12\" or further away."},
  {id="telemetry_banks",name="Telemetry Banks",desc="Once per activation, pick one other friendly ship within 12\", which may pivot by up to 45 degrees."},
  {id="unity_channel",name="Unity Channel",desc="Once per activation, pick one other friendly ship within 12\", which may move directly forward by up to 4\"."},
  {id="arc_generator",name="Arc Generator",weapon=true,rng=12,att=4,str=1,rules={overheat=true,twin=true},desc="No special rules."},
  {id="deck_shaker",name="Deck Shaker",weapon=true,rng=12,att=6,str=1,rules={deck_shaker=true},desc="No special rules."},
  {id="glitter_bomb",name="Glitter Bomb",weapon=true,rng=12,att=2,str=2,rules={blast=true,anti_sq=true},desc="No special rules."},
  {id="iron_wing",name="Iron Wing",weapon=true,rng=12,att=1,str=4,rules={broadside=true},desc="No special rules."},
  {id="missile_banks",name="Missile Banks",weapon=true,rng=18,att=2,str=0,rules={blast=true,broadside=true},desc="No special rules."},
  {id="profile_gun",name="Profile Gun",weapon=true,rng=30,att=2,str=1,rules={profile=true},desc="No special rules."},
  {id="sunfinger",name="Sunfinger",weapon=true,rng=30,att=3,str=1,rules={overheat=true},desc="No special rules."},

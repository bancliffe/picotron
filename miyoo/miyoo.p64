  {id="tangle",name="Tangle Ship",class="Medium",ups=3,pts=60,mv=6,cr=9,rng=18,att=1,str=1,eva=3,tou=3,rules={ratpack=true},special=RATPACK},
  {id="nest",name="Nest Ship",class="Medium",ups=3,pts=70,mv=8,cr=12,rng=6,att=2,str=1,eva=3,tou=3,rules={ratpack=true},special=RATPACK},
  {id="claw",name="Claw Ship",class="Light",ups=2,pts=40,mv=8,cr=12,rng=12,att=1,str=0,eva=4,tou=4,rules={ratpack=true},special=RATPACK},
  {id="tooth",name="Tooth Ship",class="Light",ups=1,pts=40,mv=8,cr=12,rng=6,att=1,str=0,eva=4,tou=4,
   rules={ratpack=true,twin_ship=true},special=RATPACK.." Twin: when you purchase this ship, you receive a second identical one."},
  {id="suicide",name="Suicide Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={fragile=true,suicide=true},special="Fragile. "..SUICIDE},
  {id="experiment",name="Experiment Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={rogue=true},special="Rogue: may skip the squadrons phase to activate later, but then may only either move or shoot."},
  {id="evasion",name="Evasion Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=2,str=0,eva=6,tou=6,
   rules={fragile=true},special="Fragile: the first time it takes damage each round it takes +1 damage."},
 },

 heroes={
  {id="brood_ship",name="Brood Ship",pts=15,
   desc="Once per round, when a friendly squadron is destroyed, you may place that squadron within 2\" instead and remove all damage from it."},
  {id="mistress_of_retaliation",name="Mistress of Retaliation",pts=10,
   desc="Whenever a friendly ship is destroyed by enemy shooting, place a vengeance token on the attacking model. Vengeance tokens may be removed from the target when it fails to block a hit, giving that hit Deadly."},
  {id="warp_tunneler",name="Warp Tunneler",pts=10,
   desc="When this ship is destroyed, place a warp marker in its place. At the end of any round, you may remove the marker, and place any living friendly ship in its place."},
 },

 titles={
  {id="slinking",name="Slinking",pts=5,desc="At the end of this ship's activation, you may pivot 45 degrees."},
  {id="slippery",name="Slippery",pts=5,desc="When this ship overlaps with enemy ships, neither take damage."},
  {id="throne_master",name="Throne Master",pts=10,
   desc="Whenever one of this ship's upgrades is disabled, enemies get -1 to hit and -1 strength against it until the end of the round."},
 },

 keywords={
  {id="gnaw",name="Gnaw Gun",desc="Gets +1 strength when targeting enemies in their rear facing."},
  {id="neutron",name="Neutron Cannon",desc="May only be fired when taking hold actions."},
  {id="predator",name="Predator cannon",desc="Gets Deadly when targeting enemies with disabled upgrades."},
  {id="ratpack",name="Ratpack",desc="This ship's turret gets +1 to hit and +1 strength, if another friendly ship with this rule is within 12\" of the target, in the opposite facing that is being targeted."},
  {id="spike",name="Spike Projector",desc="Once per round, this weapon may be fired at one enemy overlapping ship."},
  {id="suicide",name="Suicide Run",desc="May use ram actions (counts as having 0 upgrades), but is immediately destroyed when doing so."},
  {id="tail",name="Tail Gun",desc="Only mountable in rear facing."},
  {id="tandem",name="Tandem Destroyer",desc="Counts as a turret for the purpose of the Ratpack rule, and may only be fired when getting modifiers from it."},
  {id="twin_ship",name="Twin",desc="When you purchase this ship, you receive a second identical one."},
 },

 upgrades={
  {id="grav_trap_launcher",name="Grav-Trap Launcher",desc="When activated, place a grav-trap marker within 6\". All enemies within 4\" of it halve their speed."},
  {id="no_escape_module",name="No-Escape Module",desc="Enemy squadrons within 4\" may not move further away than 4\" from this ship."},
  {id="salvage_commune",name="Salvage Commune",
   desc="Whenever a friendly ship within 6\" is destroyed, roll one die for each upgrade that ship had. For each 4+, remove 1 damage from this ship."},
  {id="tether_emitter",name="Tether Emitter",desc="When activated, pick 1 enemy ship within 8\", and move this ship D6+1\" towards it."},
  {id="treachery_relay",name="Treachery Relay",
   desc="When activated pick one enemy squadron within 6\", and you may immediately activate and control it once as if it was your own squadron."},
  {id="vector_analysis_lab",name="Vector Analysis Lab",desc="This ship's weapons get +6\" range when taking hold actions."},
  {id="gnaw_gun",name="Gnaw Gun",weapon=true,rng=6,att=3,str=0,rules={gnaw=true},desc="No special rules."},
  {id="he_rockets",name="HE-Rockets",weapon=true,rng=12,att=3,str=2,rules={overheat=true},desc="No special rules."},
  {id="neutron_cannon",name="Neutron Cannon",weapon=true,rng=12,att=2,str=2,rules={deadly=true,neutron=true},desc="No special rules."},
  {id="precision_laser",name="Precision Laser",weapon=true,rng=18,att=4,str=0,rules={anti_sq=true},desc="No special rules."},
  {id="predator_cannon",name="Predator Cannon",weapon=true,rng=12,att=2,str=1,rules={predator=true},desc="No special rules."},
  {id="spike_projector",name="Spike Projector",weapon=true,rng=6,att=2,str=0,rules={spike=true},desc="No special rules."},
  {id="tail_gun",name="Tail Gun",weapon=true,rng=12,att=3,str=2,rules={tail=true},desc="No special rules."},
  {id="tandem_destroyer",name="Tandem Destroyer",weapon=true,rng=12,att=3,str=2,rules={tandem=true},desc="No special rules."},
 },
}

--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Battle Brothers v2.0

def_faction{
 id="battle_brothers",name="Battle Brothers",

 ships={
  {id="god_king",name="God-King Ship",class="Heavy",ups=5,pts=100,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2},
  {id="greatsword",name="Greatsword Ship",class="Heavy",ups=3,pts=80,mv=4,cr=6,rng=30,att=3,str=2,eva=2,tou=2},
  {id="helm",name="Helm Ship",class="Medium",ups=3,pts=70,mv=6,cr=9,rng=12,att=3,str=1,eva=3,tou=2},
  {id="rapier",name="Rapier Ship",class="Medium",ups=3,pts=65,mv=6,cr=9,rng=24,att=2,str=1,eva=3,tou=3},
  {id="buckler",name="Buckler Ship",class="Light",ups=2,pts=50,mv=10,cr=15,rng=12,att=2,str=0,eva=4,tou=3},
  {id="gladius",name="Gladius Ship",class="Light",ups=2,pts=40,mv=10,cr=15,rng=6,att=3,str=1,eva=4,tou=4},
  {id="dagger",name="Dagger Squadron",class="Squadron",ups=0,pts=15,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={striker=true},
   special="Striker: if this squadron is activated whilst not engaged, its turret gets +1 strength until the end of the round."},
  {id="arrow",name="Arrow Squadron",class="Squadron",ups=0,pts=15,mv=15,cr=20,rng=2,att=3,str=0,eva=5,tou=6,
   rules={anti_sq=true},
   special="Anti-Squadron: +1 to hit squadrons, but only hits ships on 6+."},
  {id="hammer",name="Hammer Squadron",class="Squadron",ups=0,pts=15,mv=6,cr=10,rng=2,att=2,str=2,eva=4,tou=4,
   rules={anti_ship=true,deadly=true},
   special="Anti-Ship: +1 to hit ships, but only hits squadrons on 6+. Deadly: +1 damage per unblocked hit."},
 },

 heroes={
  {id="contempt",name="Contempt",pts=15,desc="Enemy squadrons and light ships get -1 to hit against this ship."},
  {id="formation_expert",name="Formation Expert",pts=5,ai=false,
   desc="After all ships have been deployed, this ship may be removed and deployed again."},
  {id="lord_of_glory",name="Lord of Glory",pts=15,
   desc="This ship and all friendly ships within 24\" automatically pass morale tests."},
 },

 titles={
  {id="honourable",name="Honourable",pts=10,
   desc="Turret gets +1 to hit when targeting models which have not been damaged this round."},
  {id="hunter",name="Hunter",pts=10,desc="Turret gets +1 strength when targeting enemy ships carrying objective markers."},
  {id="prime_crew",name="Prime Crew",pts=5,
   desc="When this ship takes the final point of damage that would destroy it, roll one die. On a 4+ that point of damage is ignored."},
  {id="reflex",name="Reflex",pts=10,desc="May shoot before moving."},
 },

 keywords={
  {id="brutality",name="Brutality Emitter",desc="Gets up to Att 5 when shooting."},
  {id="mass_acc",name="Mass Accelerator",desc="Gets +1 to hit when fired."},
  {id="side_blast",name="Mass Cascade Gun",desc="Gets Blast when targeting enemies in their side facing."},
  {id="side_deadly",name="Particle Cannon",desc="Gets Deadly when targeting enemies in their side facing."},
  {id="proximity",name="Proximity Guns",desc="May be fired once at every squadron in range."},
  {id="striker",name="Striker",desc="If this squadron is activated whilst not engaged, its turret gets +1 strength until the end of the round."},
 },
 upgrades={
  {id="control_center",name="Control Center",desc="Friendly squadrons within 12\" may move even if engaged."},
  {id="deflection_screen",name="Deflection Screen",desc="This ship ignores difficult and dangerous terrain when taking cruise actions."},
  {id="emergency_thrusters",name="Emergency Thrusters",
   desc="This ship may pivot once by up to 45 degrees at any point when using move actions."},
  {id="flexible_payload",name="Flexible Payload",desc="When firing its turret, this ship may choose to get +1 strength but -1 to hit rolls."},
  {id="over_engineered",name="Over-Engineered",
   desc="Enemies shooting at this ship in the rear arc don't get +1 to hit, and it doesn't get -1 to block when taking hits in the rear arc."},
  {id="reinforced_spine",name="Reinforced Spine",desc="Takes -1 damage when ramming or being rammed."},
  {id="run_deck",name="Run Deck",
   desc="Friendly squadrons ending their activation within 12\" may move directly towards this ship by up to their move speed."},
  {id="seeker_rounds",name="Seeker Rounds",desc="May target enemies not in line of sight when shooting."},
  {id="bolt_cannon",name="Bolt Cannon",weapon=true,rng=18,att=2,str=1,desc="No special rules."},
  {id="brutality_emitter",name="Brutality Emitter",weapon=true,rng=6,att=5,str=1,rules={overheat=true,brutality=true},
   desc="Brutality Emitter: gets up to 5 attacks when shooting (you choose how many). Overheating: on a to-hit roll of 1, this ship takes 1 damage."},
  {id="flank_guard_array",name="Flank Guard Array",weapon=true,rng=12,att=2,str=0,rules={broadside=true,twin=true},
   desc="Broadside, Twin-Fire: sides only, fires from both sides, twice each at different targets."},
  {id="focus_laser",name="Focus Laser",weapon=true,rng=24,att=3,str=0,desc="No special rules."},
  {id="mass_accelerator",name="Mass Accelerator",weapon=true,rng=18,att=1,str=4,rules={mass_acc=true},
   desc="Mass Accelerator: gets +1 to hit when fired."},
  {id="mass_cascade_gun",name="Mass Cascade Gun",weapon=true,rng=12,att=2,str=1,rules={side_blast=true},
   desc="Mass Cascade Gun: gets Blast when targeting enemies in their side facing."},
  {id="particle_cannon",name="Particle Cannon",weapon=true,rng=12,att=3,str=0,rules={side_deadly=true},
   desc="Particle Cannon: gets Deadly when targeting enemies in their side facing."},
  {id="proximity_guns",name="Proximity Guns",weapon=true,rng=4,att=2,str=0,rules={anti_sq=true,proximity=true},
   desc="Anti-Squadron, Proximity Guns: may be fired once at every squadron in range."},
 },
}

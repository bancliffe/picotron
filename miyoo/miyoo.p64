  {id="dosojin",name="Dosojin Ship",class="Medium",ups=3,pts=65,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={flicker=true},special=FLICKER},
  {id="tengu",name="Tengu Ship",class="Light",ups=2,pts=45,mv=8,cr=12,rng=12,att=2,str=0,eva=5,tou=5,
   rules={flicker=true},special=FLICKER},
  {id="yatagarasu",name="Yatagarasu Ship",class="Light",ups=2,pts=45,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,
   rules={flicker=true},special=FLICKER},
  {id="hunter",name="Hunter Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={beacon=true},special="Impact Beacon: targets take 1 beacon marker per hit instead of damage. Friendly ships may spend beacons on a target to count as having +1 upgrade each when ramming it."},
  {id="oni",name="ONI Squadron",class="Squadron",ups=0,pts=10,mv=8,cr=12,rng=2,att=2,str=0,eva=5,tou=5,
   rules={boarding_robot=true},special="Boarding Robot: may ram, but is destroyed when doing so. Instead of comparing upgrades, place 1 boarding marker on the target, and you may replace all its beacon markers with boarding markers."},
  {id="ninja",name="Ninja Squadron",class="Squadron",ups=0,pts=20,mv=10,cr=15,rng=2,att=2,str=1,eva=6,tou=6,
   rules={shadow=true},special="Shadow: not deployed at the start; instead deploys anywhere over 12\" from enemies at the start of any round after the first."},
 },

 heroes={
  {id="flame_emperor",name="Flame Emperor",pts=25,desc="Place a beacon marker on the target for each point of damage this ship inflicts."},
  {id="shadow_emperor",name="Shadow Emperor",pts=15,
   desc="Friendly models with Shadow may ignore distance restrictions from enemies if they are deployed within 6\" of this ship."},
  {id="steel_emperor",name="Steel Emperor",pts=15,
   desc="This ship gets +1 to hit when attacking enemy heroes, and +1 strength when attacking enemy ships with a title."},
 },

 titles={
  {id="art_of_war",name="Art of War",pts=10,
   desc="Whenever this ship uses Flicker whilst in the rear facing of an enemy ship within 6\" of it, you may place it +4\" away from its final position."},
  {id="boarding_dynasty",name="Boarding Dynasty",pts=5,desc="When ramming, you may replace all beacon markers on the target with boarding markers."},
  {id="code_of_honour",name="Code of Honour",pts=5,
   desc="This ship automatically passes morale tests, but may not target enemies in the rear facing."},
 },

 keywords={
  {id="latice",name="Beam Latice",desc="May be fired in a facing it's not mounted on, but gets -1 to hit."},
  {id="boarding_robot",name="Boarding Robot",desc="May use ram actions, but is immediately destroyed when doing so. Instead of comparing upgrades, place 1 boarding marker on the target, and you may replace all beacon markers on the target with boarding markers."},
  {id="decapitator",name="Decapitator",desc="Gets Deadly when targeting enemies in their rear facing."},
  {id="figurehead",name="Figurehead",desc="May only be mounted on the front facing."},
  {id="flicker",name="Flicker",desc="At the end of this ship's activation, you may place it anywhere within 2\" of its final position."},
  {id="grand_battleship",name="Grand Battleship",desc="Weapons mounted in this ship's front facing get +6\" range and +1 strength."},
  {id="beacon",name="Impact Beacon",desc="Targets take 1 beacon marker per hit instead of damage (don't roll to block). Friendly models may remove beacon markers from their target to count as having +X upgrades for the purpose of ramming, where X is the number of removed markers."},
  {id="shadow",name="Shadow",desc="May choose not to be deployed at the start of the game, but instead may be deployed anywhere over 12\" away from enemies at the start of any round after the first."},
  {id="shishi",name="Shi-Shi Missiles",desc="Ignores cover."},
  {id="switch",name="Switch Gun",desc="Gets +2 attacks when firing at the same enemy facing as the facing this weapon is mounted on."},
 },

 upgrades={
  {id="artificial_malevolence",name="Artificial Malevolence",
   desc="When activated, pick 1 enemy ship within 12\", which must take a morale test. If failed, place 2 beacon markers on it."},
  {id="castle_compound",name="Castle Compound",
   desc="This ship removes boarding markers on rolls of 3+. When this ship is rammed, place 2 boarding markers on the ramming ship."},
  {id="flicker_dancer",name="Flicker Dancer",desc="Whenever this ship uses the Flicker rule, you may swap which facing its weapons are mounted on."},
  {id="hunting_refit",name="Hunting Refit",desc="This ship's turret gets the Impact Beacon rule."},
  {id="shadow_caster",name="Shadow Caster",desc="Whenever this ship overlaps any squadrons, you may place them anywhere within 6\"."},
  {id="warlord_shield",name="Warlord Shield",desc="Enemies shooting at this ship in any facing that has a weapon get -1 strength."},
  {id="beam_latice",name="Beam Latice",weapon=true,rng=12,att=2,str=1,rules={latice=true},desc="No special rules."},
  {id="decapitator",name="Decapitator",weapon=true,rng=18,att=1,str=1,rules={sniper=true,decapitator=true},desc="No special rules."},
  {id="figurehead",name="Figurehead",weapon=true,rng=6,att=3,str=1,rules={figurehead=true},desc="No special rules."},
  {id="mono_wire",name="Mono Wire",weapon=true,rng=6,att=1,str=2,rules={deadly=true,twin=true,anti_sq=true},desc="No special rules."},
  {id="shatter_sponsons",name="Shatter Sponsons",weapon=true,rng=12,att=1,str=3,rules={broadside=true,deadly=true},desc="No special rules."},
  {id="shishi_missiles",name="Shi-Shi Missiles",weapon=true,rng=18,att=2,str=1,rules={shishi=true},desc="No special rules."},
  {id="strike_arrow",name="Strike Arrow",weapon=true,rng=24,att=2,str=0,rules={boarding=true},desc="No special rules."},
  {id="switch_gun",name="Switch Gun",weapon=true,rng=18,att=1,str=3,rules={switch=true},desc="No special rules."},
 },
}

:: main.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- grimdark future: warfleets

-- include a cart file. paths are relative to the cart; fall back to
-- /ram/cart in case the working directory is somewhere else.
function req(path)
 if not fstat(path) and fstat("/ram/cart/"..path) then path="/ram/cart/"..path end
 include(path)
end

-- factions: core lists first, then one file per faction (in picker order)
req "src/factions.lua"
req "factions/core.lua"
for f in all({
 "alien_hives","battle_brothers","blessed_sisters","dao_union",
 "dark_elf_raiders","dwarf_guilds","eternal_dynasty","havoc_brothers",
 "high_elf_fleets","human_defense_force","infected_colonies","machine_cults",
 "orc_marauders","ratmen_clans","rebel_guerrillas","robot_legions",
 "saurian_starhosts",
}) do req("factions/"..f..".lua") end

req "src/ui.lua"
req "src/starfield.lua"
req "src/fleet.lua"
req "src/fleet_builder.lua"
req "src/battle_setup.lua"
req "src/battle_rules.lua"
req "src/battle_extra.lua"
req "src/battle_extra2.lua"
req "src/battle_flow.lua"
req "src/battle_ai.lua"
req "src/battle_scene.lua"
req "src/replay.lua"
req "src/faction_browser.lua"
req "src/menu.lua"

function _init()
 vid(0)
 -- pauseable=false: stop the wm grabbing ESC for the pause menu so the cart sees it
 window({cursor=1,pauseable=false})
 init_starfield()
 set_scene(menu_scene)
end

function _update()
 update_starfield()
 input_update()
 scene.update()
end

function _draw()
 cls(1)
 draw_starfield()
 scene.draw()
end

-- binary exports mount the cart at /ram/expcart; there exit() only closes the
-- workspace, so shut picotron down to quit to the host instead
function quit_game()
 if fstat("/ram/expcart") then
  create_process("/system/util/shutdown.lua")
 else
  exit()
 end
end

-- switch screens; input is locked until all buttons are released
-- so the press that triggered the switch doesn't leak into the new scene
function set_scene(s)
 scene=s
 if s.enter then s.enter() end
 input_lock()
end

--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Blessed Sisters v2.0

local MANIA="Mania: +1 to morale tests."
local SPITE="Spite: turret doubles its attacks if this ship has any disabled upgrades."

def_faction{
 id="blessed_sisters",name="Blessed Sisters",

 ships={
  {id="adoration",name="Adoration Ship",class="Heavy",ups=4,pts=90,mv=4,cr=6,rng=24,att=2,str=2,eva=3,tou=2,
   rules={mania=true},special=MANIA},
  {id="confession",name="Confession Ship",class="Heavy",ups=4,pts=95,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2,
   rules={spite=true},special=SPITE},
  {id="obligation",name="Obligation Ship",class="Medium",ups=3,pts=70,mv=6,cr=9,rng=18,att=2,str=1,eva=4,tou=3,
   rules={mania=true},special=MANIA},
  {id="suplication",name="Suplication Ship",class="Medium",ups=3,pts=75,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={spite=true},special=SPITE},
  {id="reception",name="Reception Ship",class="Light",ups=2,pts=50,mv=8,cr=12,rng=12,att=2,str=0,eva=5,tou=4,
   rules={mania=true},special=MANIA},
  {id="ingratiation",name="Ingratiation Ship",class="Light",ups=2,pts=50,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,
   rules={spite=true},special=SPITE},
  {id="burial",name="Burial Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=1,str=0,eva=5,tou=5,
   rules={anti_sq=true,mad=true},
   special="Anti-Squadron: +1 to hit squadrons, ships only on 6+. M.A.D.: when destroyed, all enemy squadrons within 2\" take 3 hits."},
  {id="cremation",name="Cremation Squadron",class="Squadron",ups=0,pts=15,mv=8,cr=12,rng=2,att=2,str=0,eva=5,tou=6,
   rules={pyre=true},
   special="Pyre: may use ram actions, but is destroyed when doing so. Instead of comparing upgrades, the target becomes blazing (1 damage at the end of each round)."},
  {id="entomb",name="Entomb Squadron",class="Squadron",ups=0,pts=20,mv=8,cr=12,rng=2,att=4,str=1,eva=5,tou=4},
 },

 heroes={
  {id="agressor_prima",name="Agressor Prima",pts=10,desc="Turret gets +1 to hit when targeting enemies within 2\"."},
  {id="phoenix_mark",name="Phoenix Mark",pts=25,
   desc="The first time this ship would be destroyed, you may place it in your deployment zone at least 3\" away from other ships, and remove all damage from it."},
  {id="saints_pulpit",name="Saint's Pulpit",pts=15,
   desc="Enemies can only hit this ship on rolls of 5-6 as long as it hasn't taken any damage."},
 },

 titles={
  {id="sacrificial_skin",name="Sacrificial Skin",pts=10,
   desc="This ship gets +2\" on move and +3\" on cruise/ram actions, as long as it has any disabled upgrades."},
  {id="ship_of_martyrs",name="Ship of Martyrs",pts=10,
   desc="Starts the game with a blazing marker (1 damage at the end of each round) and gets +1 to hit and block rolls."},
  {id="unchained",name="Unchained",pts=10,
   desc="May take a morale test when taking move actions; if passed, it may pivot one additional time during its activation, even before half its move."},
 },

 keywords={
  {id="blazing",name="Blazing",desc="This model takes 1 damage at the end of each round, as long as it has one or more blazing markers on it."},
  {id="branding",name="Branding Beam",desc="Gets +3 strength when targeting enemies that are blazing."},
  {id="flagellation",name="Flagellation Gun",desc="Gets +2 strength when targeting enemies with disabled upgrades."},
  {id="ignition",name="Ignition",desc="Whenever this weapon deals any hits, the target becomes blazing, instead of dealing any damage."},
  {id="mad",name="M.A.D.",desc="When this squadron is destroyed, all enemy squadrons within 2\" take 3 hits."},
  {id="mania",name="Mania",desc="This ship gets +1 to morale tests."},
  {id="pyre",name="Pyre",desc="May use ram actions, but is immediately destroyed when doing so. Instead of comparing upgrades, the target becomes blazing."},
  {id="ring",name="Ring of Fire",desc="May be fired once at every model in range, in every facing."},
  {id="spite",name="Spite",desc="Turret doubles its attacks if this ship has any disabled upgrades."},
  {id="symphonium",name="Symphonium",desc="Ships take 1 boarding marker per damage from this weapon."},
  {id="unity",name="Unity Enforcer",desc="Gets +2 strength when targeting enemies with boarding markers."},
 },
 upgrades={
  {id="chain_prow",name="Chain Prow",desc="This ship deals 2 hits with strength 1 when ramming."},
  {id="faith_of_the_broken",name="Faith of the Broken",
   desc="After ramming, place as many boarding markers on the target as this ship has disabled upgrades."},
  {id="fanatic_engineers",name="Fanatic Engineers",
   desc="When activated, may take a morale test. If passed, gets +4\" on move and +6\" on cruise/ram actions until the end of the round."},
  {id="fanatic_gunners",name="Fanatic Gunners",
   desc="When activated, may take a morale test. If passed, its turret gets +1 attack until the end of the round."},
  {id="orders_of_grief",name="Orders of Grief",desc="Once per activation, this ship may take a morale test. If passed, remove 2 damage from it."},
  {id="retaliation_cherubs",name="Retaliation Cherubs",
   desc="If this upgrade is disabled, this ship may immediately fire its turret with +1 to hit and +1 strength."},
  {id="branding_beam",name="Branding Beam",weapon=true,rng=12,att=3,str=0,rules={branding=true},
   desc="Branding Beam: +3 strength when targeting enemies that are blazing."},
  {id="configator",name="Configator",weapon=true,rng=18,att=1,str=0,rules={ignition=true},
   desc="Ignition: whenever this weapon deals hits, the target becomes blazing (1 damage at the end of each round) instead of taking damage."},
  {id="flagellation_gun",name="Flagellation Gun",weapon=true,rng=12,att=3,str=0,rules={flagellation=true},
   desc="Flagellation Gun: +2 strength when targeting enemies with disabled upgrades."},
  {id="flying_coffin",name="Flying Coffin",weapon=true,rng=24,att=2,str=0,rules={boarding=true},
   desc="Boarding Pod: ships only. Hits give boarding markers instead of damage."},
  {id="omni_array",name="Omni Array",weapon=true,rng=6,att=4,str=0,rules={broadside=true,twin=true},
   desc="Broadside, Twin-Fire: sides only, fires from both sides, twice each at different targets."},
  {id="ring_of_fire",name="Ring of Fire",weapon=true,rng=6,att=1,str=0,rules={ignition=true,anti_sq=true,ring=true},
   desc="Ignition, Anti-Squadron, Ring of Fire: fired once at every model in range in every facing; hits make the target blazing."},
  {id="symphonium",name="Symphonium",weapon=true,rng=12,att=4,str=0,rules={symphonium=true},
   desc="Symphonium: ships take 1 boarding marker per damage from this weapon."},
  {id="unity_enforcer",name="Unity Enforcer",weapon=true,rng=12,att=3,str=0,rules={unity=true},
   desc="Unity Enforcer: +2 strength when targeting enemies with boarding markers."},
 },
}
:: factions/core.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- core rules ships, heroes, titles and upgrades (GFWF core rules v2.2.0).

CORE_SHIPS={
 {id="cruiser",  name="Cruiser",  class="Heavy",   ups=4,pts=80,mv=4, cr=6, rng=24,att=2,str=2,eva=2,tou=2},
 {id="destroyer",name="Destroyer",class="Medium",  ups=3,pts=60,mv=6, cr=9, rng=18,att=2,str=1,eva=3,tou=3},
 {id="corvette", name="Corvette", class="Light",   ups=2,pts=40,mv=8, cr=12,rng=12,att=2,str=0,eva=4,tou=4},
 {id="gunship",  name="Gunship",  class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2, att=2,str=0,eva=5,tou=5},
 {id="fighter",  name="Fighter",  class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2, att=3,str=0,eva=5,tou=6,
  rules={anti_sq=true},
  special="Anti-Squadron: +1 to hit squadrons, but only hits ships on 6+."},
 {id="bomber",   name="Bomber",   class="Squadron",ups=0,pts=10,mv=8, cr=12,rng=2, att=1,str=2,eva=4,tou=5,
  rules={anti_ship=true,deadly=true},
  special="Anti-Ship: +1 to hit ships, but only hits squadrons on 6+. Deadly: +1 damage per unblocked hit."},
}

-- ai=false: the AI doesn't know how to play it, so generated fleets skip it
CORE_HEROES={
 {id="tactical_master",name="Tactical Master",pts=15,ai=false,
  desc="May skip deployment, then deploy anywhere over 9\" from enemies at the start of any round after the first."},
 {id="ace_carrier",name="Ace Carrier",pts=10,ai=false,
  desc="Up to one squadron per upgrade may skip deployment. Once per game on activation, deploy them within 2\" and they may activate immediately."},
 {id="expert_sapper",name="Expert Sapper",pts=10,
  desc="On activation, may place a mine within 4\". Enemies moving within 3\" of it take 2 damage and remove it."},
}

CORE_TITLES={
 {id="avenger",name="Avenger",pts=10,ai=false,desc="When activated, may be placed anywhere within D3+1\"."},
 {id="vanguard",name="Vanguard",pts=5,desc="When deployed, may immediately move straight by up to its move speed."},
 {id="defiant",name="Defiant",pts=5,desc="Whenever a friendly ship within 6\" is destroyed, may remove 2 damage from this ship."},
}

-- special rules from the core rulebook. a faction's keyword list shows the
-- ones its ships and upgrades use. ids match the rules flags.
CORE_KEYWORDS={
 {id="anti_ship",name="Anti-Ship",desc="Gets +1 to hit against ships, but only hits squadrons on 6+."},
 {id="anti_sq",name="Anti-Squadron",desc="Gets +1 to hit against squadrons, but only hits ships on 6+."},
 {id="blast",name="Blast",desc="If the target is hit, all models within 4\" of it are also hit by this weapon."},
 {id="boarding",name="Boarding Pod",desc="May only target ships, and targets take 1 boarding marker per hit instead of damage (don't roll to block). Roll one die for each marker when the ship is activated. On 4+ the marker is removed, else the target takes 1 damage."},
 {id="broadside",name="Broadside",desc="May only be mounted on the sides facing, and may be fired from both side facings at once."},
 {id="deadly",name="Deadly",desc="This weapon deals +1 damage per unblocked hit on the target."},
 {id="fragile",name="Fragile",desc="The first time this model takes damage each round it takes +1 damage."},
 {id="overheat",name="Overheating",desc="If you roll a 1 to hit, then this model takes 1 damage."},
 {id="twin",name="Twin-Fire",desc="This weapon may be fired twice, picking two different targets."},
 {id="rogue",name="Rogue",desc="This squadron may skip activating during the squadrons phase to activate in another phase, but may only either move or shoot when activating in another phase."},
 {id="sniper",name="Sniper",desc="Attacker may assign damage from this weapon to one upgrade of choice."},
}

-- systems and weapons, in catalog order. upgrades are free.
CORE_UPGRADES={
 {id="ablative_armor",name="Ablative Armor",desc="Enemies ramming this ship take +1 damage. Never takes damage from overlapping enemy ships."},
 {id="armored_plating",name="Armored Plating",desc="This upgrade takes 4 damage to be disabled."},
 {id="gravity_bumper",name="Gravity Bumper",desc="Enemy ships are pushed +D6\" when rammed by this ship."},
 {id="nuclear_ammo",name="Nuclear Ammo",desc="Turret gets +1 strength."},
 {id="pulse_engine",name="Pulse Engine",desc="+2\" on move and +3\" on cruise/ram actions."},
 {id="reinforced_ram",name="Reinforced Ram",desc="Deals +1 damage when ramming enemy ships."},
 {id="repair_bay",name="Repair Bay",desc="When activated, may remove 1 damage from another ship within 4\"."},
 {id="shield_booster",name="Shield Booster",desc="When taking a point of damage roll a die; on 5+ it is ignored."},
 {id="stealth_rig",name="Stealth Rig",desc="Always counts as in cover when targeted from over 12\" away."},
 {id="tracking_servo",name="Tracking Servo",desc="Turret gets +1 to hit."},
 {id="tractor_beam",name="Tractor Beam",desc="When activated, pick an enemy ship within 8\" and move it D6+1\" toward this ship."},
 {id="energy_cannon",name="Energy Cannon",weapon=true,rng=12,att=3,str=1,rules={anti_ship=true},
  desc="Anti-Ship: +1 to hit ships, but only hits squadrons on 6+."},
 {id="giga_cannon",name="Giga Cannon",weapon=true,rng=6,att=1,str=4,rules={deadly=true},
  desc="Deadly: +1 damage per unblocked hit."},
 {id="linked_railgun",name="Linked Railgun",weapon=true,rng=24,att=3,str=1,rules={overheat=true},
  desc="Overheating: on a to-hit roll of 1, this ship takes 1 damage."},
 {id="missile_cluster",name="Missile Cluster",weapon=true,rng=18,att=1,str=1,rules={blast=true},
  desc="Blast: if the target is hit, all models within 4\" of it are also hit."},
 {id="plasma_cannon",name="Plasma Cannon",weapon=true,rng=18,att=2,str=3,rules={overheat=true},
  desc="Overheating: on a to-hit roll of 1, this ship takes 1 damage."},
 {id="pod_launcher",name="Pod Launcher",weapon=true,rng=6,att=2,str=0,rules={boarding=true},
  desc="Boarding Pod: ships only. Each hit gives a boarding marker instead of damage; on activation roll per marker, 4+ removes it, else 1 damage."},
 {id="precision_cannon",name="Precision Cannon",weapon=true,rng=24,att=1,str=2,rules={sniper=true},
  desc="Sniper: attacker may assign the damage to an upgrade of choice."},
 {id="rapid_cannon",name="Rapid Cannon",weapon=true,rng=12,att=3,str=0,rules={twin=true},
  desc="Twin-Fire: may be fired twice, at two different targets."},
 {id="weapon_batteries",name="Weapon Batteries",weapon=true,rng=6,att=2,str=2,rules={broadside=true},
  desc="Broadside: sides only, and may fire from both sides at once."},
}

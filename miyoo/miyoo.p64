-- GFWF - Dark Elf Raiders v2.0

local SHADOW="Shadow Walker: whenever this ship overlaps an enemy ship, place a boarding marker on the enemy ship instead of dealing damage."

def_faction{
 id="dark_elf_raiders",name="Dark Elf Raiders",

 ships={
  {id="clan",name="Clan Ship",class="Heavy",ups=5,pts=120,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2,
   rules={raid_master=true},
   special="Raid Master: whenever an enemy ship with boarding markers is destroyed within 12\", you may move those markers to another enemy ship within 12\" of it."},
  {id="tribe",name="Tribe Ship",class="Heavy",ups=4,pts=80,mv=6,cr=9,rng=24,att=1,str=2,eva=2,tou=2},
  {id="pack",name="Pack Ship",class="Medium",ups=3,pts=60,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,
   rules={shadow_walker=true},special=SHADOW},
  {id="gang",name="Gang Ship",class="Medium",ups=3,pts=70,mv=8,cr=12,rng=18,att=1,str=1,eva=3,tou=3},
  {id="circle",name="Circle Ship",class="Light",ups=2,pts=40,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,
   rules={shadow_walker=true},special=SHADOW},
  {id="company",name="Company Ship",class="Light",ups=2,pts=50,mv=10,cr=15,rng=12,att=1,str=0,eva=4,tou=4},
  {id="shredder",name="Shredder Squadron",class="Squadron",ups=0,pts=15,mv=10,cr=15,rng=2,att=1,str=2,eva=5,tou=5,
   rules={anti_sq=true,deadly=true},
   special="Anti-Squadron: +1 to hit squadrons, ships only on 6+. Deadly: +1 damage per unblocked hit."},
  {id="raven",name="Raven Squadron",class="Squadron",ups=0,pts=15,mv=10,cr=15,rng=2,att=4,str=0,eva=5,tou=5,
   rules={anti_ship=true},special="Anti-Ship: +1 to hit ships, but only hits squadrons on 6+."},
  {id="raider",name="Raider Squadron",class="Squadron",ups=0,pts=30,mv=8,cr=12,rng=6,att=2,str=0,eva=4,tou=4,
   rules={raiding_barge=true},
   special="Raiding Barge: at any point during this squadron's activation, you may place a boarding marker on a ship within 2\"."},
 },

 heroes={
  {id="ex_nihilo",name="Ex-Nihilo",pts=30,
   desc="May skip deployment, then deploy at the start of any round after the first in the rear facing of an enemy ship, within 6\" of it, and not in the front facing of other enemy ships."},
  {id="pirate_royalty",name="Pirate Royalty",pts=15,
   desc="Enemy ships with only one non-disabled upgrade count as destroyed for the purpose of morale tests."},
  {id="specter",name="Specter",pts=10,
   desc="Enemies may not shoot at this ship until it shoots for the first time, takes damage, or carries an objective."},
 },

 titles={
  {id="alchemical_crew",name="Alchemical Crew",pts=5,
   desc="When this ship takes the final point of damage that would destroy it, roll one die. On a 4+ that point of damage is ignored."},
  {id="predatory_instinct",name="Predatory Instinct",pts=10,
   desc="This ship may activate during the phase directly before its type's phase, instead of during its type's phase."},
  {id="vulture",name="Vulture",pts=15,
   desc="Whenever this ship rams an enemy ship and destroys it, it takes no ram damage and may remove 1 damage."},
 },

 keywords={
  {id="carving",name="Carving Lances",desc="Gets +2 strength when targeting enemies with disabled upgrades."},
  {id="erosion",name="Erosion Missiles",desc="Instead of rolling to block, models must roll as many dice as points of damage it would take to destroy them, and for each roll of 1 they take 1 damage."},
  {id="inversion",name="Inversion Beam",desc="Use the target's tough value when rolling to hit, and the target's evasion value when rolling to block."},
  {id="phantom",name="Phantom Bombs",desc="Ships must take a morale test per hit, instead of rolling to block. For each failed test, they take 1 damage."},
  {id="raid_master",name="Raid Master",desc="Whenever an enemy ship with boarding markers on it is destroyed within 12\", you may place those markers on another enemy ship within 12\" of it."},
  {id="raiding_barge",name="Raiding Barge",desc="At any point during this squadron's activation, you may place a boarding marker on a ship within 2\"."},
  {id="shadow_walker",name="Shadow Walker",desc="Whenever this ship overlaps an enemy ship, place a boarding marker on the enemy ship, instead of dealing damage."},
  {id="shard",name="Shard Cannons",desc="If the target rolls a 1 to block, then it takes +1 damage."},
  {id="soul",name="Soul Syphon",desc="May be fired once at every model in range, in every facing."},
 },

 upgrades={
  {id="fury_inhibitor",name="Fury Inhibitor",
   desc="Enemy ships within 6\" that activate with this ship in their rear facing get -2 to their boarding marker rolls."},
  {id="jump_scare_drive",name="Jump Scare Drive",
   desc="After ramming, place this ship back in the same position in which it started its activation."},
  {id="razor_shield",name="Razor Shield",
   desc="This ship removes boarding markers on rolls of 3+, and this upgrade takes 3 damage to be disabled."},
  {id="star_gills",name="Star Gills",desc="When this ship overlaps enemy squadrons, they take 1 damage each."},
  {id="violent_whisper",name="Violent Whisper",
   desc="When activated, pick one enemy ship within 12\", which must make a boarding marker roll as if it had just been activated."},
  {id="wormhole_door",name="Wormhole Door",desc="When activated, place a boarding marker on an enemy ship within 12\"."},
  {id="carving_lances",name="Carving Lances",weapon=true,rng=24,att=2,str=0,rules={carving=true},desc="No special rules."},
  {id="erosion_missiles",name="Erosion Missiles",weapon=true,rng=12,att=1,str=0,rules={blast=true,erosion=true},desc="No special rules."},
  {id="forked_punishment",name="Forked Punishment",weapon=true,rng=24,att=1,str=3,rules={overheat=true,twin=true},desc="No special rules."},
  {id="inversion_beam",name="Inversion Beam",weapon=true,rng=12,att=3,str=1,rules={inversion=true},desc="No special rules."},
  {id="phantom_bombs",name="Phantom Bombs",weapon=true,rng=6,att=2,str=0,rules={phantom=true},desc="No special rules."},
  {id="reality_overlay",name="Reality Overlay",weapon=true,rng=6,att=4,str=0,rules={boarding=true},desc="No special rules."},
  {id="shard_cannons",name="Shard Cannons",weapon=true,rng=12,att=3,str=0,rules={anti_sq=true,shard=true},desc="No special rules."},
  {id="soul_syphon",name="Soul Syphon",weapon=true,rng=6,att=1,str=0,rules={soul=true},desc="No special rules."},
 },
}

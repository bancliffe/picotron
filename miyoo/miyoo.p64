   rules={fragile=true,suicide=true},special="Fragile. "..SUICIDE},
  {id="scram",name="Scram Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=2,str=1,eva=5,tou=6,
   rules={anti_ship=true,scram=true},special="Anti-Ship. Scram: may move even if engaged, but may not shoot when doing so."},
 },

 heroes={

-- GFWF - Orc Marauders v2.0

local ORC="Orc Crew: counts as having +1 upgrade for the purpose of ramming, but gets -1 to hit when shooting at targets that are 12\" or further away."
local GOBLIN="Goblin Crew: at the end of its activation may move 3\" backwards, but gets -1 to hit when shooting at targets within 12\"."
local SUICIDE="Suicide Run: may use ram actions (counts as having 0 upgrades), but is immediately destroyed when doing so."

def_faction{
 id="orc_marauders",name="Orc Marauders",


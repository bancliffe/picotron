--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Robot Legions v2.0

local BLINK="Blink: when taking move actions, may instead be placed within 2\" of its current position, or within 2\" of a friendly ship it is connected to via Nexus."
local NEXUS="Nexus: friendly squadrons within 12\", and friendly ships within 12\" with a clear line between centres, count as connected to this ship."
local DESTROYER="Destroyer: may fire its weapons from the position of a friendly ship connected via Nexus."

def_faction{
 id="robot_legions",name="Robot Legions",

 ships={
  {id="monolith",name="Monolith Ship",class="Heavy",ups=4,pts=80,mv=0,cr=3,rng=24,att=2,str=2,eva=2,tou=2,
   rules={blink=true,nexus=true},special=BLINK.." "..NEXUS},
  {id="obelisk",name="Obelisk Ship",class="Heavy",ups=4,pts=80,mv=2,cr=3,rng=24,att=2,str=2,eva=2,tou=2,
   rules={destroyer=true,nexus=true},special=DESTROYER.." "..NEXUS},
  {id="menhir",name="Menhir Ship",class="Medium",ups=3,pts=60,mv=0,cr=6,rng=18,att=2,str=1,eva=3,tou=3,
   rules={blink=true,nexus=true},special=BLINK.." "..NEXUS},
  {id="dolmen",name="Dolmen Ship",class="Medium",ups=3,pts=60,mv=4,cr=6,rng=18,att=2,str=1,eva=3,tou=3,
   rules={destroyer=true,nexus=true},special=DESTROYER.." "..NEXUS},
  {id="icon",name="Icon Ship",class="Light",ups=2,pts=40,mv=0,cr=9,rng=12,att=2,str=1,eva=4,tou=4,
   rules={blink=true,nexus=true},special=BLINK.." "..NEXUS},
  {id="idol",name="Idol Ship",class="Light",ups=2,pts=40,mv=6,cr=9,rng=12,att=2,str=0,eva=4,tou=4,
   rules={destroyer=true,nexus=true},special=DESTROYER.." "..NEXUS},
  {id="spider_robot",name="Spider Robot Squadron",class="Squadron",ups=0,pts=10,mv=8,cr=12,rng=2,att=2,str=0,eva=5,tou=5,
   rules={crawl=true},special="Crawl Within: may ram, but is destroyed when doing so. Instead of comparing upgrades, place 2 boarding markers on the target."},
  {id="scythe",name="Scythe Squadron",class="Squadron",ups=0,pts=15,mv=0,cr=9,rng=2,att=2,str=0,eva=5,tou=6,
   rules={anti_sq=true,blink=true},special="Anti-Squadron. "..BLINK},
  {id="barge",name="Barge Squadron",class="Squadron",ups=0,pts=15,mv=0,cr=9,rng=2,att=1,str=2,eva=4,tou=5,
   rules={anti_ship=true,blink=true,deadly=true},special="Anti-Ship, Deadly. "..BLINK},
 },

 heroes={
  {id="distortion_lord",name="Distortion Lord",pts=20,
   desc="This ship counts as being +6\" further away when targeted by enemy weapons, upgrades and rules."},
  {id="kingly_throne",name="Kingly Throne",pts=10,
   desc="This ship and all friendly ships connected to it via the nexus rule get +2 to morale tests."},
  {id="nexus_lord",name="Nexus Lord",pts=15,
   desc="All friendly ships connected to this ship via the nexus rule count as being connected to each other."},
 },

 titles={
  {id="flesh_eater",name="Flesh-Eater",pts=10,
   desc="At the end of this ship's activation, place one boarding marker on each enemy ship within 4\"."},
  {id="hyperspace_hunter",name="Hyperspace Hunter",pts=10,
   desc="When this ship is placed over 6\" away from its initial position via the blink rule, its turret gets +1 to hit and +1 strength until the end of the round."},
  {id="spider_nodes",name="Spider Nodes",pts=10,
   desc="When activated, roll as many dice as damage on this ship, and for each 6+ remove 1 damage."},
 },

 keywords={
  {id="blink",name="Blink",desc="When taking move actions, instead of moving normally, you may place this model within 2\" of its current position, or within 2\" of a friendly ship's position which it is connected to via the nexus rule, without overlapping."},
  {id="cascade",name="Cascade Resonator",desc="Whenever a model is destroyed by this weapon, all models within 4\" take 2 hits with Str 0."},
  {id="crawl",name="Crawl Within",desc="May use ram actions, but is immediately destroyed when doing so. Instead of comparing upgrades, place 2 boarding markers on the target."},
  {id="destroyer",name="Destroyer",desc="This ship may fire its weapons from the position of a friendly ship connected via the nexus rule."},
  {id="disintegrator",name="Disintegrator",desc="This weapon deals +2 damage per unblocked hit on the target."},
  {id="gauss",name="Gauss Banks",desc="Enemies that roll 1 to block hits from this weapon take +1 damage."},
  {id="hyper_scyth",name="Hyper Scyth",desc="Always hits on 2+."},
  {id="nexus",name="Nexus",desc="Friendly squadrons within 12\" count as being connected to this ship, and if you can draw a clear straight line from this ship's center to another friendly ship's center within 12\", then they count as being connected to each other."},
  {id="protocol",name="Protocol Convent",desc="Gets +1 Att, +1 Str, Deadly or Twin-Fire when shooting (pick one)."},
 },

 upgrades={
  {id="deconstruction_engram",name="Deconstruction Engram",
   desc="Once per activation, this ship may take a morale test when shooting one weapon, and if passed that weapon gets +1 attack."},
  {id="fade_drive",name="Fade Drive",desc="This ship may shoot all of its weapons before moving."},
  {id="gravity_shunt",name="Gravity Shunt",desc="Once per activation, pick one ship within 8\", and move this ship D6+1\" directly away from it."},
  {id="matter_recombinator",name="Matter Re-Combinator",
   desc="Whenever this ship destroys an enemy ship, roll as many dice as upgrades on the target, and for each 4+ remove 1 damage."},
  {id="shift_module",name="Shift Module",desc="This ship may fire its turret from the position of a friendly ship connected via the nexus rule."},
  {id="vassal_link",name="Vassal Link",
   desc="Whenever friendly ships connected to this ship via the nexus rule take damage, you may put that damage on this upgrade instead."},
  {id="antimatter_cannon",name="Antimatter Cannon",weapon=true,rng=12,att=2,str=1,rules={blast=true},desc="No special rules."},
  {id="cascade_resonator",name="Cascade Resonator",weapon=true,rng=12,att=3,str=0,rules={anti_sq=true,cascade=true},desc="No special rules."},
  {id="disintegrator",name="Disintegrator",weapon=true,rng=18,att=1,str=2,rules={disintegrator=true},desc="No special rules."},
  {id="flux_acumulator",name="Flux Acumulator",weapon=true,rng=6,att=4,str=0,rules={twin=true},desc="No special rules."},
  {id="gauss_banks",name="Gauss Banks",weapon=true,rng=18,att=3,str=0,rules={gauss=true},desc="No special rules."},
  {id="hyper_scyth",name="Hyper Scyth",weapon=true,rng=30,att=1,str=4,rules={hyper_scyth=true},desc="No special rules."},
  {id="protocol_convent",name="Protocol Convent",weapon=true,rng=12,att=2,str=0,rules={protocol=true},desc="No special rules."},
  {id="rod_caster",name="Rod Caster",weapon=true,rng=24,att=2,str=1,rules={broadside=true},desc="No special rules."},
 },
}
:: factions/saurian_starhosts.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- GFWF - Saurian Starhosts v2.0

local VASSAL="Vassal: when taking morale tests, may count as having as many non-disabled upgrades as another friendly Vassal ship within 18\"."
local PROW="Shell Prow: enemy attacks from the front facing get -1 Str (to a min. of 0). This ship's turret can't be fired in the front facing."
local SPIRIT="Spirit: at the end of its activation, if not engaged, you may place it within 2\" of a friendly Vassal ship within 18\"."

def_faction{
 id="saurian_starhosts",name="Saurian Starhosts",

 ships={
  {id="prophecy",name="Prophecy Ship",class="Heavy",ups=4,pts=90,mv=4,cr=6,rng=12,att=3,str=2,eva=2,tou=2,rules={vassal=true},special=VASSAL},
  {id="mosasaur",name="Mosasaur Ship",class="Heavy",ups=4,pts=80,mv=4,cr=6,rng=24,att=2,str=2,eva=2,tou=2,rules={shell_prow=true},special=PROW},
  {id="fate",name="Fate Ship",class="Medium",ups=3,pts=70,mv=6,cr=9,rng=9,att=3,str=1,eva=3,tou=3,rules={vassal=true},special=VASSAL},
  {id="megaladon",name="Megaladon Ship",class="Medium",ups=3,pts=60,mv=6,cr=9,rng=18,att=2,str=1,eva=3,tou=3,rules={shell_prow=true},special=PROW},
  {id="destiny",name="Destiny Ship",class="Light",ups=2,pts=50,mv=8,cr=12,rng=6,att=3,str=0,eva=4,tou=4,rules={vassal=true},special=VASSAL},
  {id="icthyosaur",name="Icthyosaur Ship",class="Light",ups=2,pts=40,mv=8,cr=12,rng=12,att=2,str=0,eva=4,tou=4,rules={shell_prow=true},special=PROW},
  {id="piranha",name="Piranha Squadron",class="Squadron",ups=0,pts=15,mv=8,cr=12,rng=2,att=4,str=0,eva=5,tou=5,
   rules={anti_ship=true,spirit=true},special="Anti-Ship. "..SPIRIT},
  {id="jaguar",name="Jaguar Squadron",class="Squadron",ups=0,pts=15,mv=8,cr=12,rng=2,att=2,str=4,eva=5,tou=6,
   rules={anti_sq=true,spirit=true},special="Anti-Squadron. "..SPIRIT},
  {id="serpent",name="Serpent Squadron",class="Squadron",ups=0,pts=15,mv=8,cr=12,rng=2,att=2,str=0,eva=5,tou=5,
   rules={invade=true,spirit=true},special="Invade: may ram, but is destroyed when doing so; instead place 3 boarding markers on the target. "..SPIRIT},
 },

 heroes={
  {id="divine_frog",name="Divine Frog",pts=90,
   desc="Once per activation, place 2 new Piranha, Jaguar or Serpent Squadrons fully within 2\" of this ship."},
  {id="heart_eater",name="Heart Eater",pts=10,desc="Whenever an enemy ship is destroyed within 18\", remove 1 damage from this ship."},
  {id="primal_bellower",name="Primal Bellower",pts=15,desc="When activated, pick a friendly squadron within 6\" and immediately activate it."},
 },

 titles={
  {id="beast_home",name="Beast Home",pts=5,desc="This ship removes boarding markers on rolls of 2+."},
  {id="spirit_shaman",name="Spirit Shaman",pts=10,
   desc="When activated, may take a morale test. If passed, pick a friendly squadron within 2\" and immediately activate it."},
  {id="tyrant_vessel",name="Tyrant Vessel",pts=5,desc="When activated, turret gets +1 strength if it was not fired during this ship's last activation."},
 },

 keywords={
  {id="arc_tongue",name="Arc Tongue",desc="May only target the closest enemy model."},
  {id="god_talon",name="God Talon",desc="Must pass a morale test in order to fire this weapon."},
  {id="invade",name="Invade",desc="May use ram actions, but is immediately destroyed when doing so. Instead of comparing upgrades, place 3 boarding markers on the target."},
  {id="obsidian",name="Obsidian Flechettes",desc="Gets +2 Att when targeting enemies within 12\"."},
  {id="psi_shock",name="Psi-Shock",desc="Must pass a morale test in order to fire this weapon."},
  {id="quad",name="Quad Beam",desc="This weapon may be fired at four different targets at once."},
  {id="shell_prow",name="Shell Prow",desc="Enemy attacks from the front facing get -1 Str (to a min. of 0). This ship's turret can't be fired in the front facing."},
  {id="spirit",name="Spirit",desc="At the end of its activation, if this squadron is not engaged, you may place it within 2\" of a friendly ship with Vassal within 18\"."},
  {id="tempest_portal",name="Tempest Portal",desc="Must pass a morale test in order to fire this weapon."},
  {id="toxin",name="Toxin Battery",desc="Whenever a model is destroyed by this weapon, all models within 4\" take 2 hits with Str 2."},
  {id="vassal",name="Vassal",desc="When taking morale tests, may count as having as many non-disabled upgrades as another friendly ship with Vassal within 18\"."},
 },

 upgrades={
  {id="defense_claw",name="Defense Claw",
   desc="When activated, may immediately fire its turret at a squadron within 2\" (may still fire its turret again after moving)."},
  {id="event_horizon",name="Event Horizon",
   desc="Once per activation, may take a morale test. If passed, pick up to 2 ships within 12\" and move them 6\" directly towards this ship."},
  {id="grand_spine",name="Grand Spine",desc="Turret gets Twin-Fire but may only be fired from the sides facing."},
  {id="shell_shield",name="Shell Shield",desc="Enemies get -1 to hit when targeting this ship in a facing in which it doesn't have a mounted weapon."},
  {id="star_drive",name="Star Drive",
   desc="When activated, may take a morale test. If passed, instead of moving normally, place this ship anywhere within its cruise speed in the same facing, not overlapping any models."},
  {id="wrath_spines",name="Wrath Spines",
   desc="When activated, may take a morale test. If passed, its turret gets +2 attacks until the end of the round. If failed the turret can't fire this round."},
  {id="arc_tongue",name="Arc Tongue",weapon=true,rng=12,att=3,str=2,rules={arc_tongue=true},desc="No special rules."},
  {id="god_talon",name="God Talon",weapon=true,rng=6,att=6,str=0,rules={god_talon=true},desc="No special rules."},
  {id="lightning_javelin",name="Lightning Javelin",weapon=true,rng=12,att=1,str=2,rules={blast=true,sniper=true},desc="No special rules."},
  {id="obsidian_flechettes",name="Obsidian Flechettes",weapon=true,rng=24,att=2,str=0,rules={obsidian=true},desc="No special rules."},
  {id="psi_shock",name="Psi-Shock",weapon=true,rng=18,att=1,str=1,rules={blast=true,twin=true,psi_shock=true},desc="No special rules."},
  {id="quad_beam",name="Quad Beam",weapon=true,rng=18,att=1,str=3,rules={quad=true},desc="No special rules."},
  {id="tempest_portal",name="Tempest Portal",weapon=true,rng=12,att=4,str=0,rules={boarding=true,tempest_portal=true},desc="No special rules."},
  {id="toxin_battery",name="Toxin Battery",weapon=true,rng=12,att=2,str=1,rules={toxin=true},desc="No special rules."},

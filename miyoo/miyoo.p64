  {id="scrap_king",name="Scrap King",pts=15,desc="The first time this ship would be destroyed, restore 1 disabled upgrade instead."},
  {id="war_chanter",name="War Chanter",pts=10,desc="Once per round, when an enemy ship within 12\" makes a boarding marker roll, it gets -1 to its roll."},
 },

 titles={
  {id="impetuous",name="Impetuous",pts=5,desc="Ignores difficult and dangerous terrain."},
  {id="ravager",name="Ravager",pts=10,desc="May pivot twice when using cruise or ram actions."},
  {id="speed_freak",name="Speed Freak",pts=10,desc="When using cruise actions, enemies get -1 to hit against this ship until its next activation."},
 },

 keywords={

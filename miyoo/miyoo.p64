--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- main menu

menu_scene={}

function menu_scene.enter()
 if menu_scene.menu then return end -- keep selection when returning
 local W,H=get_display():width(),get_display():height()
 local items={
  {label="Fleet Builder", action=function() set_scene(fleet_scene) end},
  {label="Faction Browser", action=function() set_scene(browser_scene) end},
  {label="Play against AI", action=function() set_scene(battle_setup_scene) end},
  {label="Replays", action=function() set_scene(replay_scene) end},
 }
 -- centre the buttons between the title rule (y=106) and the footer text
 local bw,bh,gap=150,20,10
 local block=#items*bh+(#items-1)*gap
 local y=(106+(H-24)-block)\2
 menu_scene.menu=new_menu(items,(W-bw)\2,y,bw,bh,gap)
end

function menu_scene.update()
 if keyp("escape") then quit_game() return end
 menu_update(menu_scene.menu)
end

function menu_scene.draw()
 local W,H=get_display():width(),get_display():height()
 local cx=W\2

 print_centered("GRIMDARK FUTURE",cx,44,8)
 big_text("WARFLEETS",cx+2,60,4,0)
 big_text("WARFLEETS",cx+1,59,4,5)
 big_text("WARFLEETS",cx,58,4,7)
 line(cx-100,104,cx+100,104,13)
 line(cx-60,106,cx+60,106,5)

 menu_draw(menu_scene.menu)

 print_centered("arrows/mouse: navigate   z: select   esc: quit",cx,H-24,13)
 print_centered("Based on OPR Grimdark Future: Warfleets - onepagerules.com",cx,H-12,5)
end
:: src/replay.lua
--[[pod_format="raw",created="2026-10-27 15:00:00",modified="2026-10-27 15:00:00",revision=0]]
-- replays: a battle is recorded as a list of steps. a step is taken whenever
-- the battle pauses (player input, an AI pause, a dice roll) and something
-- changed since the last one. it holds the log lines written in between, the
-- shot lines on screen, and only the models and markers that changed.
-- each battle is saved to its own file, named by the date and time it began,
-- and index.pod keeps a summary of each for the list screen.

REPLAY_DIR=SAVE_DIR.."/replays"
REPLAY_INDEX=REPLAY_DIR.."/index.pod"
REPLAY_SPEED=20 -- frames per step when playing

-- viewer layout below the table
local BAR_Y,CTRL_Y,NAMES_Y=TY+TABLE_H*S+4,248,262

local function r2(v) return flr((v or 0)*100+0.5)/100 end

-- recording

-- bt.rec is what gets saved. the recorder's working state lives beside it:
--  rec_ids       model -> replay id (not stored on the model: make_twin copies every field)
--  rec_msig      replay id -> that model's signature at the last step
--  rec_wsig      the markers' signature at the last step
--  rec_log       log lines written since the last step
--  rec_paths     replay id -> the path it moved along since the last step
function rec_start(pf)
 local terrain={}
 for t in all(bt.terrain) do add(terrain,{kind=t.kind,x=t.x,y=t.y,r=t.r,bits=t.bits}) end
 bt.rec={
  date=date(),style=bt.style.name,pzone=bt.pzone,
  you=pf.name.." ("..faction_of(pf).name..")",ai=bt.ai_name,
  terrain=terrain,models={},steps={},
 }
 bt.rec_file=(bt.rec.date:gsub(":","-"):gsub(" ","_"))..".pod"
 bt.rec_ids,bt.rec_msig,bt.rec_wsig,bt.rec_log,bt.rec_paths={},{},"",{},{}
end

-- note a move's path (every 4th point, about 1" apart, plus the end) so
-- the replay can animate it
function rec_path(m,path)
 if not bt.rec then return end
 local id=rec_id(m)
 local out=bt.rec_paths[id] or {}
 for i,p in ipairs(path) do
  if i%4==1 or i==#path then add(out,{x=r2(p.x),y=r2(p.y),h=r2(p.h)}) end
 end
 bt.rec_paths[id]=out
end

-- a model's replay id, registering it the first time it's seen
function rec_id(m)
 local id=bt.rec_ids[m]
 if id then return id end
 add(bt.rec.models,{name=m.name,side=m.side,fac=m.fac.id,kind=m.kind,sq=m.sq,r=m.r,hero=m.hero,title=m.title})
 id=#bt.rec.models
 bt.rec_ids[m]=id
 return id
end

-- everything about a model that can change, as one compact string
-- (rp_model() reads it back)
function rec_model_sig(m)
 local u={}
 for up in all(m.ups) do add(u,up.id.."/"..(up.dis and "x" or up.dmg).."/"..up.cap) end
 return join({r2(m.x),r2(m.y),r2(m.h),m.state,m.activated and 1 or 0,m.dmg or 0,m.markers or 0,
  m.held and 1 or 0,m.blazing and 1 or 0,m.boarding or 0,m.lasers or 0,m.beacons or 0,
  m.scrap or 0,m.targeting or 0,"u"..join(u,";")},",")
end

-- markers on the table, named as draw_board() expects, plus bile trails
-- as one character per terrain piece
function rec_world()
 local function pts(list)
  local out={}
  for o in all(list) do add(out,{x=r2(o.x),y=r2(o.y),side=o.side}) end
  return out
 end
 local w={objs=pts(bt.objs),mines=pts(bt.mines),rifts=pts(bt.rifts),spores=pts(bt.spores),
  winds=pts(bt.winds),suns=pts(bt.suns),bile=""}
 for t in all(bt.terrain) do w.bile..=t.bile=="p" and "p" or t.bile and "a" or "-" end
 return w
end

-- take a step if anything changed since the last one
function rec_check()
 local r=bt.rec
 if not r then return end
 local st,any={m={}},false
 for m in all(bt.models) do
  local id,s=rec_id(m),rec_model_sig(m)
  if s~=bt.rec_msig[id] then bt.rec_msig[id],st.m[id],any=s,s,true end
 end
 local w=rec_world()
 local ws=pod(w)
 if ws~=bt.rec_wsig then bt.rec_wsig,st.w,any=ws,w,true end
 if #bt.rec_log>0 then st.log,bt.rec_log,any=bt.rec_log,{},true end
 if next(bt.rec_paths) then st.paths,bt.rec_paths,any=bt.rec_paths,{},true end
 if not any then return end
 st.r,st.p=bt.round,bt.phase
 if bt.sel then st.sel=rec_id(bt.sel) end
 for f in all(bt.flashes) do
  st.f=st.f or {}
  add(st.f,{r2(f.x1),r2(f.y1),r2(f.x2),r2(f.y2),f.c})
 end
 add(r.steps,st)
end

function rec_save()
 local r=bt.rec
 if not r or #r.steps==0 then return end
 r.result=bt.result
 mkdir(SAVE_DIR)
 mkdir(REPLAY_DIR)
 store(REPLAY_DIR.."/"..bt.rec_file,r)
 local idx=fetch(REPLAY_INDEX)
 if type(idx)~="table" then idx={} end
 idx[bt.rec_file]={date=r.date,you=r.you,ai=r.ai,style=r.style,result=r.result,round=bt.round}
 store(REPLAY_INDEX,idx)
end

-- viewer: a list of saved replays, then a step-by-step view of one

replay_scene={}
rp={sel=1}

function replay_scene.enter()
 rp.r,rp.del,rp.msg=nil,nil,nil
 rp.idx=fetch(REPLAY_INDEX)
 if type(rp.idx)~="table" then rp.idx={} end
 rp.files={}
 for f in all(ls(REPLAY_DIR) or {}) do
  if sub(f,-4)==".pod" and f~="index.pod" then add(rp.files,f) end
 end
 -- file names are dates, so newest first is reverse order
 sorted(rp.files)
 local n=#rp.files
 for i=1,n\2 do rp.files[i],rp.files[n+1-i]=rp.files[n+1-i],rp.files[i] end
 rp.sel=mid(1,rp.sel,max(1,n))
 rp_build_list()
end

function replay_scene.update()
 rp.gui:update_all()
 if rp.rebuild then
  rp.rebuild=false
  if rp.r then rp_build_view() else rp_build_list() end
 end
 if rp.r then rp_update_view() return end
 if input_back() then set_scene(menu_scene) return end
 if input_up() then rp.sel=max(1,rp.sel-1) rp.del=nil end
 if input_down() then rp.sel=min(#rp.files,rp.sel+1) rp.del=nil end
 if not input.locked and btnp(4) and rp.files[rp.sel] then rp_open(rp.files[rp.sel]) end
end

function replay_scene.draw()
 if rp.r then rp_draw_view() return end
 big_text("REPLAYS",241,25,2,0)
 big_text("REPLAYS",240,24,2,7)
 rp.gui:draw_all()
 if rp.msg then print_centered(rp.msg,240,236,8) end
end

-- result text and colour for a list entry
function rp_result(info)
 local res=info and info.result
 if not res then return "Unfinished"..(info and info.round and info.round>0 and " (round "..info.round..")" or ""),5 end
 if res.winner=="p" then return "Victory",11 end
 if res.winner=="ai" then return "Defeat",8 end
 return "Draw",10
end

function rp_build_list()
 local gui=create_gui()
 rp.gui=gui
 local x0,y0,w,h=60,50,360,160
 local outer=gui:attach{
  x=x0,y=y0,width=w,height=h,
  draw=function(self)
   panel(0,0,self.width,self.height,0,5)
   if #rp.files==0 then
    print_centered("No replays yet.",w\2,h\2-10,7)
    print_centered("Every battle you play is recorded here.",w\2,h\2+2,6)
   end
  end
 }
 local box=outer:attach{x=2,y=2,width=w-4,height=h-4}
 local rh=22
 local list=box:attach{x=0,y=0,width=box.width-8,height=max(box.height,#rp.files*rh),clip_to_parent=true}
 for i,f in ipairs(rp.files) do
  local info=rp.idx[f]
  list:attach{
   x=0,y=(i-1)*rh,width=list.width,height=rh-1,clip_to_parent=true,scroll_box=box,
   draw=function(self)
    local sel=i==rp.sel
    rectfill(2,1,self.width-3,self.height-1,(sel or fb_hot(self)) and 1 or 0)
    if sel then rect(2,1,self.width-3,self.height-1,12) end
    print(info and info.date or sub(f,1,-5),6,4,7)
    if info then
     print_right(info.style or "",self.width-6,4,13)
     print(sub(info.you.." vs "..info.ai,1,52),6,13,6)
    end
    local s,c=rp_result(info)
    print_right(s,self.width-6,13,c)
   end,
   -- first click selects, a second click opens
   tap=function()
    if rp.sel==i then rp_open(f) else rp.sel,rp.del,rp.msg=i,nil,nil end
   end
  }
 end
 box:attach_scrollbars{autohide=true}

 fb_button(gui,x0,y0+h+8,60,"Back",function() set_scene(menu_scene) end)
 if #rp.files==0 then return end
 fb_button(gui,x0+w\2-30,y0+h+8,60,"Delete",function()
  local f=rp.files[rp.sel]
  if rp.del~=f then rp.del,rp.msg=f,"Click Delete again to remove this replay." return end
  rm(REPLAY_DIR.."/"..f)
  rp.idx[f]=nil
  store(REPLAY_INDEX,rp.idx)
  replay_scene.enter()
 end)
 fb_button(gui,x0+w-90,y0+h+8,90,"Watch",function() rp_open(rp.files[rp.sel]) end)
end

-- load a replay and rebuild the full table state at every step
function rp_open(f)
 local r=fetch(REPLAY_DIR.."/"..f)
 if type(r)~="table" or type(r.steps)~="table" or #r.steps==0 then
  rp.msg="Couldn't read "..f
  return
 end
 rp.frames={}
 local cur,w={},{}
 for st in all(r.steps) do
  local fr={}
  for id,m in pairs(cur) do fr[id]=m end
  for id,s in pairs(st.m or {}) do fr[id]=rp_model(r.models[id],s) end
  w=st.w or w
  add(rp.frames,{m=fr,w=w,st=st})
  cur=fr
 end
 for i,fr in ipairs(rp.frames) do fr.changes=rp_changes(r,i) end
 -- zone_setup() measures against bt, so give it a stand-in battle
 local style=DEPLOY_STYLES[1]
 for s in all(DEPLOY_STYLES) do if s.name==r.style then style=s end end
 bt={style=style,pzone=r.pzone}
 zone_setup()
 rp.zdots=bt.zdots
 rp.stars={}
 for i=1,140 do add(rp.stars,{x=rnd(TABLE_W*S),y=rnd(TABLE_H*S),c=rnd()<0.2 and 6 or 5}) end
 rp.r,rp.i,rp.play,rp.t,rp.msg,rp.anim=r,1,false,0,nil,nil
 explosions={}
 rp.rebuild=true
end

-- a stand-in model from a rec_model_sig() string, with just what
-- draw_model() and draw_status_tip() read
function rp_model(s,sig)
 local v=split(sig,",")
 local fac=FACTIONS[s.fac]
 local hull=fac and hull_of(fac,s.kind) or {rules={},class="?"}
 local m={name=s.name,side=s.side,sq=s.sq,r=s.r,hull=hull,fac=fac,
  hero=fac and by_id(fac.heroes,s.hero) and s.hero,title=fac and by_id(fac.titles,s.title) and s.title,
  x=v[1],y=v[2],h=v[3],state=v[4],activated=v[5]==1,dmg=v[6],markers=v[7],held=v[8]==1,
  blazing=v[9]==1,boarding=v[10],lasers=v[11],beacons=v[12],scrap=v[13],targeting=v[14],ups={}}
 local u=sub(tostring(v[15] or "u"),2)
 if u~="" then
  for e in all(split(u,";",false)) do
   local p=split(e,"/",false)
   local upg=fac and by_id(fac.upgrades,p[1]) or {name=p[1]}
   add(m.ups,{upg=upg,dis=p[2]=="x",dmg=tonum(p[2]) or 0,cap=tonum(p[3]) or 2})
  end
 end
 return m
end

-- what step i changed, worked out by comparing it with the step before:
-- the battle log doesn't mention plain moves, turns, activations or
-- deployments. unchanged models share the same table between frames.
function rp_changes(r,i)
 local fr=rp.frames[i]
 local before=i>1 and rp.frames[i-1].m or {}
 local out={}
 for id=1,#r.models do
  local m,o=fr.m[id],before[id]
  if m and m~=o and m.state=="table" then
   local c=SIDE_COL[m.side]
   if not o or o.state~="table" then
    add(out,{s=m.name..(o and o.state=="off" and " returns to the table" or " deploys"),c=c})
   else
    if m.activated and not o.activated then add(out,{s=m.name.." activates",c=c}) end
    local path=fr.st.paths and fr.st.paths[id]
    local len=path and path_len(path)+dist(path[#path].x,path[#path].y,m.x,m.y) or dist(o.x,o.y,m.x,m.y)
    if len>=0.05 then
     add(out,{s=m.name.." moves "..flr(len*10+0.5)/10 .."\"",c=c})
    elseif abs(nturn(m.h-o.h))>0.001 then
     add(out,{s=m.name.." turns",c=c})
    end
   end
  end
 end
 if fr.st.r==0 and i>1 and #(fr.w.objs or {})>#(rp.frames[i-1].w.objs or {}) then
  add(out,{s="An objective is placed",c=10})
 end
 return out
end

-- conditions shown in the hover box (the battle's model_status() needs a live battle)
function rp_status(m)
 local st={}
 if m.markers>0 then add(st,m.markers.." objective(s)") end
 if m.held then add(st,"easy target") end
 if m.blazing then add(st,"blazing") end
 if m.boarding>0 then add(st,m.boarding.." boarders") end
 if m.activated then add(st,"activated") end
 return st
end

-- show step i. stepping forward one animates that step: models slide
-- along their recorded paths (or straight, for older replays) and
-- destroyed ones explode
function rp_go(i)
 i=mid(1,i,#rp.frames)
 rp.anim=nil
 if i==rp.i+1 then
  local before,st=rp.frames[rp.i].m,rp.frames[i].st
  local moves,len={},0
  for id,m in pairs(rp.frames[i].m) do
   local o=before[id]
   if o and o.state=="table" then
    if m.state=="dead" then explode(o.x,o.y,o.r) end
    if m.state=="table" and (o.x~=m.x or o.y~=m.y or o.h~=m.h) then
     local path={}
     for p in all(st.paths and st.paths[id] or {{x=o.x,y=o.y,h=o.h}}) do add(path,p) end
     add(path,{x=m.x,y=m.y,h=m.h})
     moves[id]=path
     len=max(len,path_len(path))
    end
   end
  end
  if next(moves) then rp.anim={moves=moves,t=0,frames=move_frames(len)} end
 end
 rp.i=i
end

-- where to draw a model: part way along its move while the step animates
function rp_drawn(id,m)
 local path=rp.anim and rp.anim.moves[id]
 if not path then return m end
 local x,y,h=path_at(path,ease(rp.anim.t/rp.anim.frames))
 return setmetatable({x=x,y=y,h=h},{__index=m})
end

function rp_play(on)
 rp.play,rp.t=on,0
 if on and rp.i==#rp.frames then rp.i=1 end
 rp.rebuild=true -- relabel Play/Pause
end

function rp_build_view()
 local gui=create_gui()
 rp.gui=gui
 fb_button(gui,442,1,34,"Back",function() rp.r=nil rp.rebuild=true end)
 local bx=TX+(TABLE_W*S)\2-95
 fb_button(gui,bx,CTRL_Y,30,"|<",function() rp_go(1) end)
 fb_button(gui,bx+34,CTRL_Y,30,"<",function() rp_go(rp.i-1) end)
 fb_button(gui,bx+68,CTRL_Y,54,rp.play and "Pause" or "Play",function() rp_play(not rp.play) end)
 fb_button(gui,bx+126,CTRL_Y,30,">",function() rp_go(rp.i+1) end)
 fb_button(gui,bx+160,CTRL_Y,30,">|",function() rp_go(#rp.frames) end)
end

function rp_update_view()
 if input_back() then rp.r=nil rp.rebuild=true return end
 if not input.locked and btnp(4) then rp_play(not rp.play) end
 if btnp(0) then rp_go(rp.i-1) end
 if btnp(1) then rp_go(rp.i+1) end
 update_explosions()
 local mx,my,mb,wx,wy=mouse()
 local W,H=TABLE_W*S,TABLE_H*S
 -- progress bar: click or drag to jump
 if (mb or 0)&1==1 and not input.locked and point_in(mx,my,TX,BAR_Y,W,8) then
  rp_go(1+flr((mx-TX)/W*#rp.frames))
 end
 if wy and wy~=0 and point_in(mx,my,TX,TY,W,H) then rp_go(rp.i-sgn(wy)) end
 -- a step's move animation plays out before Play counts towards the next
 if rp.anim then
  rp.anim.t+=1
  if rp.anim.t>=rp.anim.frames then rp.anim=nil end
 elseif rp.play then
  rp.t+=1
  if rp.t>=REPLAY_SPEED then
   rp.t=0
   if rp.i<#rp.frames then rp_go(rp.i+1) else rp_play(false) end
  end
 end
 -- model under the mouse
 rp.hover=nil
 if point_in(mx,my,TX,TY,W,H) then
  local x,y=(mx-TX)/S,(my-TY)/S
  for id,m in pairs(rp.frames[rp.i].m) do
   if m.state=="table" and dist(x,y,m.x,m.y)<=m.r+0.4 then rp.hover=m end
  end
 end
end

function rp_draw_view()
 local r,fr=rp.r,rp.frames[rp.i]
 local st,w=fr.st,fr.w
 local W,H=TABLE_W*S,TABLE_H*S
 for i,t in ipairs(r.terrain) do
  local c=sub(w.bile or "",i,i)
  t.bile=c=="p" and "p" or c=="a" and "ai" or nil
 end
 draw_board{stars=rp.stars,zdots=rp.zdots,terrain=r.terrain,
  mines=w.mines,rifts=w.rifts,spores=w.spores,objs=w.objs,winds=w.winds,suns=w.suns}
 for id=1,#r.models do
  local m=fr.m[id]
  if m and m.state=="table" then draw_model(rp_drawn(id,m)) end
 end
 local sel=st.sel and fr.m[st.sel]
 if sel and sel.state=="table" then
  sel=rp_drawn(st.sel,sel)
  circ(px(sel.x),py(sel.y),sel.r*S+3,7)
 end
 for f in all(st.f or {}) do line(px(f[1]),py(f[2]),px(f[3]),py(f[4]),f[5]) end
 draw_explosions()
 rect(TX-1,TY-1,TX+W,TY+H,5)

 local mk={p=0,ai=0}
 for id,m in pairs(fr.m) do if m.state~="dead" then mk[m.side]+=m.markers end end
 draw_top_bar(st.r,st.p,mk.p,mk.ai,#(w.objs or {}))

 -- side panel: what happened in this step
 local x,y,pw=PX,TY,476-PX
 panel(x-2,y,pw+4,H,0,5)
 print("STEP "..rp.i.."/"..#rp.frames,x+2,y+3,7)
 print_right(r.style,x+pw-2,y+3,13)
 print(r.date,x+2,y+12,5)
 line(x,y+21,x+pw-1,y+21,5)
 -- the battle log for this step, then the changes it didn't mention
 local ly=y+25
 local function lines(list,prefix)
  for l in all(list) do
   for s in all(fb_wrap(prefix..l.s,pw-4)) do
    if ly>y+H-10 then return end
    print(s,x+2,ly,l.c)
    ly+=8
   end
  end
 end
 lines(st.log or {},"")
 if st.log and #fr.changes>0 then ly+=3 end
 lines(fr.changes,"> ")
 if not st.log and #fr.changes==0 then print("(nothing changed on the table)",x+2,ly,5) end

 -- under the table: progress bar, controls, then who fought
 rectfill(TX,BAR_Y,TX+W-1,BAR_Y+7,1)
 rectfill(TX,BAR_Y,TX+(W-1)*rp.i/#rp.frames,BAR_Y+7,12)
 print(r.you,TX,NAMES_Y,SIDE_COL.p)
 print_right(r.ai,TX+W-1,NAMES_Y,SIDE_COL.ai)
 rp.gui:draw_all()
 if rp.hover then draw_status_tip(rp.hover,rp_status(rp.hover)) end
end
:: src/starfield.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
function init_starfield()
 stars={}
 for i=0, 500 do
  local star=create_star()
  star.x=rnd(get_display():width()) -- randomize the start location
  add(stars, star)
 end
end

function update_starfield()
 for s in all(stars) do
  if s.x>get_display():width()+s.r then
   del(stars, s)
   add(stars, create_star())
  else
   s.x+=s.spd
  end
 end
end

function draw_starfield()
 for s in all(stars) do
  circfill(s.x,s.y,s.r,s.c)
 end
end

function create_star()
 return {
  x=0,
  y=rnd(get_display():height()),
  r=rnd(1)+1,
  spd=0.5+rnd(1),
  c=5+rnd(2)
  }
end
:: src/ui.lua
--[[pod_format="raw",created="2026-10-26 15:00:00",modified="2026-10-26 15:00:00",revision=0]]
-- input: unified mouse + buttons
-- btn 2/3 = up/down, 4 = O (z/c), 5 = X (x/v)

input={mx=0,my=0,click=false,moved=false,locked=false}
local last_mb=0

function input_update()
 local mx,my,mb=mouse()
 mb=mb or 0
 input.moved=(mx~=input.mx or my~=input.my)
 input.mx,input.my=mx,my
 input.click=(mb&1==1 and last_mb&1==0)
 last_mb=mb
 if input.locked then
  input.click=false
  if mb==0 and not (btn(4) or btn(5)) then input.locked=false end
 end
end

function input_lock() input.locked=true end

function input_confirm() return not input.locked and (btnp(4) or btnp(5)) end
function input_back() return not input.locked and btnp(5) end
function input_up() return not input.locked and btnp(2) end
function input_down() return not input.locked and btnp(3) end

function point_in(px,py,x,y,w,h)
 return px>=x and px<x+w and py>=y and py<y+h
end

-- text

function text_w(s)
 local x=print(s,0,-1000)
 return x or #s*5
end

function print_centered(s,cx,y,c)
 print(s,cx-text_w(s)\2,y,c)
end

-- scaled text: render once to a userdata, then sspr it up
local big_cache={}
function big_text(s,cx,y,sc,col)
 local ud=big_cache[s]
 if not ud then
  local w=text_w(s)
  ud=userdata("u8",w,10)
  set_draw_target(ud)
  cls(0)
  print(s,0,0,7)
  set_draw_target()
  big_cache[s]=ud
 end
 local w,h=ud:width(),ud:height()
 pal(7,col)
 sspr(ud,0,0,w,h,cx-w*sc\2,y,w*sc,h*sc)
 pal()
end

-- panel with clipped corners
function panel(x,y,w,h,bg,border)
 rectfill(x+1,y,x+w-2,y+h-1,bg)
 rectfill(x,y+1,x+w-1,y+h-2,bg)
 line(x+1,y,x+w-2,y,border)
 line(x+1,y+h-1,x+w-2,y+h-1,border)
 line(x,y+1,x,y+h-2,border)
 line(x+w-1,y+1,x+w-1,y+h-2,border)
end

function draw_button(label,x,y,w,h,selected)
 if selected then
  local border=(time()*4)\1%2==0 and 12 or 7
  panel(x,y,w,h,0,border)
  rectfill(x+2,y+2,x+3,y+h-3,8)
  print(">",x-10+sin(time()*2)*2,y+(h-7)\2,7)
  print_centered(label,x+w\2,y+(h-7)\2,7)
 else
  panel(x,y,w,h,0,13)
  print_centered(label,x+w\2,y+(h-7)\2,6)
 end
end

-- vertical button list, driven by mouse or d-pad
-- items: {label=..., action=function() ... end}

function new_menu(items,x,y,w,h,gap)
 return {items=items,sel=1,x=x,y=y,w=w,h=h,gap=gap or 6}
end

function menu_rect(m,i)
 return m.x,m.y+(i-1)*(m.h+m.gap),m.w,m.h
end

function menu_update(m)
 local n=#m.items
 if input_up() then m.sel=(m.sel-2)%n+1 end
 if input_down() then m.sel=m.sel%n+1 end

 local hover
 for i=1,n do
  local x,y,w,h=menu_rect(m,i)
  if point_in(input.mx,input.my,x,y,w,h) then hover=i end
 end
 if hover and input.moved then m.sel=hover end

 local chosen
 if input.click and hover then chosen=hover
 elseif input_confirm() then chosen=m.sel end
 if chosen then
  m.sel=chosen
  local it=m.items[chosen]
  if it.action then it.action() end
 end
end

function menu_draw(m)
 for i,it in ipairs(m.items) do
  local x,y,w,h=menu_rect(m,i)
  draw_button(it.label,x,y,w,h,i==m.sel)
 end
end

-- helpers for picotron's gui library, shared by the gui-based scenes

function fb_button(parent,x,y,w,label,fn)
 return parent:attach_button{
  x=x,y=y,width=w,height=12,label=label,
  bgcol=0x0d01,fgcol=0x0706,
  tap=function() fn() end
 }
end

-- gui defaults to the fleet builder's; other scenes pass their own.
-- items with a .tip (and optional .tip_title) show it beside the menu when hovered
-- (the scene must call draw_tips() after drawing its gui)
function fb_pulldown(x,y,w,items,gui)
 local pd=(gui or fb.gui):attach_pulldown{x=x,y=y,width=w}
 for it in all(items) do pd:attach_pulldown_item(it) end
 -- the pulldown draws its own items, so hook its draw: that also means the
 -- tips only exist while the menu is open
 local d=pd.draw
 pd.draw=function(self,...)
  if d then d(self,...) end
  pulldown_drawn=true
  for i,it in ipairs(items) do
   if it.tip then
    -- use the item element's rect if the gui exposes it, else the
    -- pulldown's layout (4px top margin, 12px rows)
    local c=self.child and self.child[i]
    local ix,iy,iw,ih=self.sx,self.sy+4+(i-1)*12,self.width,12
    if c and c.sy then ix,iy,iw,ih=c.sx,c.sy,c.width,c.height end
    tip_area(ix,iy,iw,ih,it.tip_title or it.label,it.tip,nil,self)
   end
  end
 end
end

-- true if a pulldown was drawn last frame (reset by the caller)
pulldown_drawn=false

-- is the pointer over el (and inside its scroll box, if any)?
function fb_hot(el)
 if not el.sx then return false end
 local mx,my=mouse()
 if not point_in(mx,my,el.sx,el.sy,el.width,el.height) then return false end
 local box=el.scroll_box
 return not box or point_in(mx,my,box.sx,box.sy,box.width,box.height)
end

local wrap_cache={}
function fb_wrap(s,w)
 local key=w..":"..s
 local lines=wrap_cache[key]
 if lines then return lines end
 lines={}
 local cur=""
 for word in all(split(s," ",false)) do
  local t=cur=="" and word or cur.." "..word
  if cur~="" and text_w(t)>w then
   add(lines,cur)
   cur=word
  else
   cur=t
  end
 end
 if cur~="" then add(lines,cur) end
 wrap_cache[key]=lines
 return lines
end

function print_right(s,x,y,c) print(s,x-text_w(s),y,c) end

-- hover tooltips: screens register hot rectangles (screen coords) while
-- they draw, then draw_tips() shows the one under the mouse on top.
-- clip is an optional gui element (e.g. a scroll box) the mouse must be in.
-- beside is an optional gui element (e.g. an open menu) to put the tip next
-- to, instead of under the pointer.

tips={}

function tip_area(x,y,w,h,title,text,clip,beside)
 add(tips,{x=x,y=y,w=w,h=h,title=title,text=text,clip=clip,beside=beside})
end

function draw_tips()
 local list=tips
 tips={}
 local mx,my=mouse()
 local hit
 for t in all(list) do
  local c=t.clip
  if point_in(mx,my,t.x,t.y,t.w,t.h)
   and (not c or (c.sx and point_in(mx,my,c.sx,c.sy,c.width,c.height))) then hit=t end
 end
 if not hit or not hit.text or hit.text=="" then return end
 local w=200
 local b=hit.beside
 local left
 if b then
  -- prefer the left side of the menu, else whichever side has more room
  local lroom,rroom=b.sx-4,476-(b.sx+b.width)
  left=lroom>=w or lroom>=rroom
  w=min(w,left and lroom or rroom)
 end
 local lines={}
 for para in all(split(hit.text,"\n",false)) do
  for l in all(fb_wrap(para,w-8)) do add(lines,l) end
 end
 local h=14+#lines*8
 local x,y
 if b then
  x=left and b.sx-2-w or b.sx+b.width+2
  y=min(hit.y,269-h)
 else
  x=min(mx+8,479-w)
  y=my+12
  if y+h>269 then y=max(0,my-h-4) end
 end
 panel(x,y,w,h,0,12)
 print(hit.title,x+4,y+3,12)
 for i,l in ipairs(lines) do print(l,x+4,y+12+(i-1)*8,6) end
end

-- lay out "prefix tok1, tok2, ..." wrapping at width w. tokens are
-- {name,desc} tables and become hoverable when drawn.
function layout_tokens(prefix,toks,w)
 local out,x,ln={},0,0
 local function place(s,tok)
  local tw=text_w(s)
  if x>0 and x+tw>w then x,ln=0,ln+1 end
  add(out,{s=s,x=x,line=ln,tok=tok})
  x+=tw
 end
 if prefix~="" then place(prefix.." ") end
 for i,t in ipairs(toks) do place(t.name..(i<#toks and ", " or ""),t) end
 return out,ln+1
end

-- draw a layout at (x,y); ox,oy turn those into screen coords for the tips
function draw_tokens(lay,x,y,col,tcol,ox,oy,clip)
 for p in all(lay) do
  local tx,ty=x+p.x,y+p.line*8
  print(p.s,tx,ty,p.tok and tcol or col)
  if p.tok then
   local nw=text_w(p.tok.name)
   tip_area(ox+tx,oy+ty-1,nw,8,p.tok.name,p.tok.desc,clip)
  end
 end
end

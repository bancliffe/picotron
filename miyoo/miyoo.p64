  {id="school",name="School Ship",class="Medium",ups=3,pts=55,mv=6,cr=9,rng=6,att=3,str=0,eva=3,tou=3},
  {id="silt",name="Silt Ship",class="Light",ups=2,pts=35,mv=8,cr=12,rng=18,att=1,str=0,eva=4,tou=4},
  {id="shoal",name="Shoal Ship",class="Light",ups=1,pts=30,mv=10,cr=15,rng=0,att=0,str=0,eva=4,tou=4,
   rules={missile_ship=true},
   special="Missile Ship: once per activation, when not using a cruise/ram action, place 2 Smart Missile Squadrons fully within 2\" of this ship."},
  {id="smart_missile",name="Smart Missile Squadron",class="Squadron",ups=0,pts=5,mv=8,cr=12,rng=0,att=0,str=0,eva=4,tou=6,
   rules={smart=true},
   special="Smart Detonation: destroyed if it takes any damage. If overlapped or engaged it is destroyed; the target takes 1 hit with Str 0, plus 1 hit per laser marker removed from it."},
  {id="support_drone",name="Support Drone Squadron",class="Squadron",ups=0,pts=10,mv=10,cr=15,rng=2,att=2,str=0,eva=5,tou=5,
   rules={spotting=true},
   special="Spotting Laser: targets take 1 laser marker per hit instead of damage. Friendly models may remove markers from their target for +1 to hit each."},
  {id="battle_suit",name="Battle Suit Squadron",class="Squadron",ups=0,pts=35,mv=8,cr=12,rng=2,att=3,str=1,eva=4,tou=4,
   rules={battle_suit=true},
   special="Battle Suit: may move even if engaged, and may shoot before moving."},
 },

 heroes={
  {id="digital_master",name="Digital Master",pts=15,
   desc="When activated, pick 1 enemy ship within 18\" and remove 2 laser markers from it. Then that ship must fire its turret or one weapon at one target of your choice."},
  {id="master_of_missile",name="Master of Missile",pts=25,
   desc="All friendly squadrons get +1 strength when dealing hits from the Smart Detonation rule."},
  {id="strike_leader",name="Strike Leader",pts=15,
   desc="When activated, may take a morale test. If passed, up to 3 friendly squadrons within 12\" can move by up to their move speed."},
 },

 titles={
  {id="confirmation_bias",name="Confirmation Bias",pts=5,
   desc="Whenever this ship disables an enemy upgrade, place 1 laser marker on the target."},
  {id="reflex",name="Reflex",pts=10,desc="This ship may shoot all of its weapons before moving."},
  {id="shadow_fleet",name="Shadow Fleet",pts=10,
   desc="Enemies may only shoot at this ship if it's within 12\" of at least one enemy ship."},
 },

 keywords={
  {id="arc_missiles",name="Arc Missiles",desc="May be fired once at every enemy in range that has a laser marker on it, ignoring cover and line of sight. (Here: 1 attack per laser marker on the target.)"},
  {id="battle_suit",name="Battle Suit",desc="May move even if engaged, and may shoot before moving."},
  {id="keel_breaker",name="Keel Breaker",desc="Gets -2 to hit when fired."},
  {id="missile_ship",name="Missile Ship",desc="Once per activation, when not using a cruise/ram action, place 2 Smart Missile Squadrons fully within 2\" of this ship."},
  {id="rail_lock",name="Rail Lock Array",desc="May only be fired when taking hold actions."},
  {id="smart",name="Smart Detonation",desc="This squadron is destroyed if it takes any damage. If this squadron is overlapped or engaged, it is destroyed, the target takes 1 hit with Str 0, and you may remove laser markers from the target to deal +X hits, where X is the number of removed markers."},
  {id="spotting",name="Spotting Laser",desc="Targets take 1 laser marker per hit instead of damage (don't roll to block). Friendly models may remove markers from their target to get +X to hit rolls when shooting, where X is the number of removed markers."},
  {id="threat",name="Threat Array",desc="May be fired once at every enemy in range in any facing."},
 },

 upgrades={
  {id="evacuation_pulse",name="Evacuation Pulse",
   desc="When activated, may push all ships within 8\" (friend or foe) directly away by D3+1\"."},
  {id="extremis_arc",name="Extremis Arc",desc="May target enemies not in line of sight with laser markers on them when shooting."},
  {id="precision_teleporter",name="Precision Teleporter",
   desc="When activated, pick one enemy ship within 12\" and replace all laser markers on it with boarding markers."},
  {id="rocket_shells",name="Rocket Shells",desc="Turret gets the Deadly rule when shooting at targets that are 18\" or further away."},
  {id="support_refit",name="Support Refit",desc="This ship's turret gets the Spotting Laser rule."},
  {id="tide_shield",name="Tide Shield",desc="On any round after the second, when taking a point of damage roll one die; on a 4+ it is ignored."},
  {id="arc_missiles",name="Arc Missiles",weapon=true,rng=18,att=0,str=1,rules={arc_missiles=true},
   desc="Fired once at every enemy in range with laser markers, ignoring cover and line of sight; 1 attack per laser marker on the target."},
  {id="cross_guns",name="Cross Guns",weapon=true,rng=18,att=2,str=0,rules={broadside=true},desc="No special rules."},
  {id="keel_breaker",name="Keel Breaker",weapon=true,rng=12,att=1,str=4,rules={deadly=true,sniper=true,keel_breaker=true},
   desc="No special rules."},
  {id="macro_missile",name="Macro Missile",weapon=true,rng=12,att=1,str=3,rules={blast=true},desc="No special rules."},
  {id="rail_lock_array",name="Rail Lock Array",weapon=true,rng=36,att=2,str=2,rules={rail_lock=true},desc="No special rules."},
  {id="range_finder",name="Range Finder",weapon=true,rng=18,att=3,str=0,rules={spotting=true},desc="No special rules."},
  {id="rotation_guns",name="Rotation Guns",weapon=true,rng=12,att=3,str=0,rules={twin=true,anti_sq=true},desc="No special rules."},
  {id="threat_array",name="Threat Array",weapon=true,rng=6,att=1,str=0,rules={spotting=true,threat=true},desc="No special rules."},
 },

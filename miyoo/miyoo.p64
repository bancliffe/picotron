  {id="scram",name="Scram",desc="This squadron may choose to move even if engaged, but may not shoot when doing so."},
  {id="suicide",name="Suicide Run",desc="May use ram actions (counts as having 0 upgrades), but is immediately destroyed when doing so."},
 },

 upgrades={
